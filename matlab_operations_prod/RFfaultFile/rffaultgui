if (!(-d /afs/slac/g/spear)) then
    setenv SPEAR_PRODUCTION
    unsetenv MATLAB_DEV
endif
if (!(-d /prod/epics)) then
    unsetenv SPEAR_PRODUCTION
    setenv MATLAB_DEV
endif
if ($?MATLAB_DEV) then
  source /afs/slac/g/spear/epics/epicsReset
else
  source /prod/epics/epicsReset
endif
cd $MATLABDATAFILES
umask 000
rm -f rffaultgui.log
nice +10 matExeRun faultFile | tee rffaultgui.log

#
file rf_fbck.db
{
  {S=$(RRRS)}
}
file rf_hvps.db
{
  {S=$(RRRS)}
}
file rf_sumy_hvps.db
{
  {S=$(RRRS)}
}
file rf_klys.db
{
  {S=$(RRRS)}
}
file rf_sumy_klys.db
{
  {S=$(RRRS)}
}
file rf_sumy_circ.db
{
  {S=$(RRRS)}
}
file rf_sumy_wg.db
{
#	           Wave  Water Supply Water Flow
#	   STN     Guide   Temp       Circuit     
  pattern { S     , C  ,    W       ,   F       }
	  {$(RRRS),WG01,   CIRC     ,  HCW1     }
}
file rf_cav.db
{
#	               Step Mtr Ana Inp
#	   STN     CAV  Card     Card   
  pattern { S     , C  , M    ,   AI  }
	  {$(RRRS),CAV1, 0    ,  R1G0 }
	  {$(RRRS),CAV2, 2    ,  R1G0 }
}
file rf_sumy_cav.db
{
#	                   Step Mtr Ana Inp TC Inp TC Inp TC Inp
#	   STN     CAV  IQA Card     Card   Card 1 Card 2 Card 3
  pattern { S     , C  , I , M    ,   AI  ,  T1  ,  T2  ,  T3  }
	  {$(RRRS),CAV1, 2 , 0    ,  R1G0 , R0G2 , R0G3 , R0G4 }
	  {$(RRRS),CAV2, 2 , 2    ,  R1G0 , R0G5 , R0G6 , R0G7 }
}
file rf_interlock_arc.db
{
#	   STN     COMP Quantity Description   BIT   Next
  pattern { S     , C  ,   Q    ,   D          , B ,  N  }
	  {$(RRRS),KLYS,":ARC"  ,"Arc"         , 0 ,:SUMY}
	  {$(RRRS),CIRC,":ARC"  ,"Arc"         , 1 ,:SUMY}
}



@



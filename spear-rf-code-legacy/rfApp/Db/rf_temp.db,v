log
@Set alarm hysterisis on temperatures from 2 to 1 degrees.
Remove ADEL and MDEL and just monitor on any change since resolution is
1 degree anyway.
@
text
@grecord(ai,"$(S):$(C)$(Q):TEMP:ULIM") {
	field(DESC,"$(C) $(D)")
	field(SCAN,"I/O Intr")
	field(DTYP,"AB-1771DCM AI I to F")
	field(INP,"@@$(S):STN:DCM:MODU.T$(TU)[$(W)]")
	field(EGUF,"400")
	field(EGU,"C")
	field(HOPR,"$(HO)")
	field(ADEL,"0.9")
	field(MDEL,"0.9")
}
grecord(ai,"$(S):$(C)$(Q):TEMP") {
	field(DESC,"$(C) $(D)")

/***************************************************************************
  sysIntFxn/sysIntCtrl.c

  This module provides VXI system interrupt control.
***************************************************************************/

#include <vxWorks.h>

#include <portable.h>
#include <kscvxi.h>
#include <libvar.h>
#include <bus.h>

/*==========================================================================
  AssertSysreset
==========================================================================*/

/*/INT16 AssertSysreset( INT16 controller, UINT16 mode )*/
void SYSRESET_Others ( void )
{
   UINT32 reg;

/*/   if (controller != -1)
      return -2; Invalid controller*/

   reg = vxiUnivRegRd( VXI_UNIV_MISC_CTL );

   vxiUnivRegWr( VXI_UNIV_MISC_CTL, VXI_UNIV_MISC_CTL_SW_SYSRST | reg );

#ifdef KSC_DEBUG
   printf ("AssertSysreset():\nMisc Control reg:\nBefore:0x%x after:0x%x\n", 
           reg, vxiUnivRegRd( VXI_UNIV_MISC_CTL ) );
#endif

   return;
}

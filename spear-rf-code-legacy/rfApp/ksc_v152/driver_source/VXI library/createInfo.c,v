/***************************************************************************
  infoFxn/createInfo.c

  This module provides the createInfo routine.
***************************************************************************/

#include <vxWorks.h>
#include <stdLib.h>
#include <string.h>

#include <kscvxi.h>
#include <devinfo.h>

#include <libvar.h>

/*==========================================================================
  CreateDevInfo
==========================================================================*/

INT16  CreateDevInfo ( INT16 la )
{
   UserLAEntry* entry;

   if ( la < 0 || la > 511 )
      return -2;   /*la out of range 0 - 511*/

   /*Search device list to see if an entry already exists for the current la*/
   for (entry = vxiDevHead; entry; entry = entry->next)
      if (entry->la == la)
         return -1;  /*la already exists*/

   /*Create a new entry and add it to the head of the device list*/
   entry = (UserLAEntry*) malloc ( sizeof(UserLAEntry) );
   bzero ( (char*)entry, sizeof(UserLAEntry) );
   entry -> la = la;

   entry -> next = vxiDevHead;
   vxiDevHead = entry;

   return 0;
}


#include <vxWorks.h>
#include <vxLib.h>
#include <vme.h>
#include <sysLib.h>

#include <kscvxi.h>
#include <busacc.h>

#include <bus.h>

#define  VXI_DEF_A32	VME_AM_EXT_SUP_DATA
#define  VXI_DEF_A24	VME_AM_STD_SUP_DATA
#define  VXI_DEF_A16	VME_AM_SUP_SHORT_IO


/*==========================================================================
  GetContext
==========================================================================*/

INT16 GetContext (UINT32 window, UINT32* context)
{
  /*------------------------------------------------------------------------
    NO HARDWARE SUPPORT FOR MULTIPLE "ACCESS WINDOWS"; THEREFORE
    NO NEED TO MAINTAIN WINDOW CONTEXT.
  ------------------------------------------------------------------------*/

  *context = 0;
  return (0);
}


/*==========================================================================
  SetContext
==========================================================================*/

INT16 SetContext (UINT32 window, UINT32 context)
{
  /*------------------------------------------------------------------------
    NO HARDWARE SUPPORT FOR MULTIPLE "ACCESS WINDOWS"; THEREFORE
    NO NEED TO MAINTAIN WINDOW CONTEXT.
  ------------------------------------------------------------------------*/

  return (0);
}


/*==========================================================================
  GetVXIbusStatus
==========================================================================*/

INT16 GetVXIbusStatus (INT16 controller, BusStatus* status)
{
  status->BusError = 0;		/** NO HW **/
  status->Sysfail = 0;		/** NO HW **/
  status->ACfail = 0;		/** NO HW **/
  status->SignalIn = 0;		/** NO HW **/
  status->VXIints = 0;		/** NO HW **/
  status->ECLtrigs = (GET_MY_REG(0x2E) >> 8) & 0x03;
  status->TTLtrigs = (GET_MY_REG(0x2E) >> 0) & 0xFF;

  return (0);
}


/*==========================================================================
  MapVXIAddress
==========================================================================*/

void* MapVXIAddress (UINT16 accessparms, UINT32 address, INT32 timo,
		     UINT32* window, INT16* ret)

{
  void* winaddr;
  int amCode;

  static int amCodeTab [4] = {
    0, VXI_DEF_A16, VXI_DEF_A24, VXI_DEF_A32
  };

  if (((accessparms >> 7) & 1) == 1) {
    *ret = (-5);  /** INTEL byte order not supported **/
    return 0;
  }

  amCode = amCodeTab [accessparms & 0x03];
#ifdef KSC_DEBUG
   printf("MapVXIAddress: calling sysBusToLocalAdrs\n");
   printf("parameters   amCode: 0x%x,address: 0x%x\n",amCode,address);
#endif
  if (sysBusToLocalAdrs (amCode, address, &winaddr) != OK) {
    *ret = (-6);  /** Address offset unsupported **/
    return 0;
  }

  *window = 1;

  *ret = 0;
  return winaddr;
}


/*==========================================================================
  UnMapVXIAddress
==========================================================================*/

INT16 UnMapVXIAddress (UINT32 window)
{
  return 0;
}


/*==========================================================================
  VXIpeek
==========================================================================*/

void VXIpeek (void* addr, UINT16 width, void* value)
{
  switch (width) {
  case 1:
    * (UINT8*) value = * (UINT8*) addr;
    break;
  case 2:
    * (UINT16*) value = * (UINT16*) addr;
    break;
  case 4:
    * (UINT32*) value = * (UINT32*) addr;
    break;
  }
}


/*==========================================================================
  VXIpoke
==========================================================================*/

void VXIpoke (void* addr, UINT16 width, UINT32 value)
{
  switch (width) {
  case 1:
    * (UINT8*) addr = (UINT8) value;
    break;
  case 2:
    * (UINT16*) addr = (UINT16) value;
    break;
  case 4:
    * (UINT32*) addr = (UINT32) value;
    break;
  }
}



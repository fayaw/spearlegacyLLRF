/***************************************************************************
  intFxn/intCtrl.c

  This module provides VXI interrupt control.
***************************************************************************/

#include <vxWorks.h>
#include <sysLib.h>

#include <kscvxi.h>
#include <libvar.h>
#include <bus.h>


/*==========================================================================
  AcknowledgeVXIint
==========================================================================*/

INT16 AcknowledgeVXIint (INT16 controller, UINT16 level, UINT32* statusId)
{
  return (-1);  /** no hardware support **/
}


/*==========================================================================
  AssertVXIint
==========================================================================*/

INT16 AssertVXIint (INT16 controller, UINT16 level, UINT32 statusId)
{
  return (-1);
}


/*==========================================================================
  DisableVXIint
==========================================================================*/

INT16 DisableVXIint (INT16 controller, UINT16 levels)
{
  int k;

  for (k=0; k < 7; k++)
    if (levels & (1 << k))  sysIntDisable (k+1);

  return 0;
}


/*==========================================================================
  EnableVXIint
==========================================================================*/

INT16 EnableVXIint (INT16 controller, UINT16 levels)
{
  int k;

  for (k=0; k < 7; k++)
    if (levels & (1 << k))  sysIntEnable (k+1);

  return 0;
}


/*==========================================================================
  GetVXIintHandler
==========================================================================*/

NIVXI_HVXIINT* GetVXIintHandler (UINT16 level)
{
  return (NIVXI_HVXIINT*) vxiIntHandler[level-1];
}


/*==========================================================================
  RouteVXIint
==========================================================================*/

INT16 RouteVXIint (INT16 controller, UINT16 sroute)
{
  if ((sroute & 0x7F) != 0)
    return (-1);  /** no hardware support for signal routing **/

  vxiIntRoute = sroute;
  return 0;
}


/*==========================================================================
  SetVXIintHandler
==========================================================================*/

INT16 SetVXIintHandler (UINT16 levels, NIVXI_HVXIINT* func)
{
  int k;

  for (k=0; k < 7; k++)
  {
    if (levels & (1 << k)) 
    {
  	   vxiIntHandler[k] = (VOIDFUNCPTR) func;	/*/orig*/
/*/         printf("levels: %d, k: %d, func: 0x%x\n",levels,k,func);*/
    }
  }

  return 0;
}

/*==========================================================================
  DefaultVXIintHandler
==========================================================================*/

void DefaultVXIintHandler (INT16 controller, UINT16 level, UINT32 statusId)
{
#ifdef DEBUG_INTR
  logMsg ("VXI INTR: level %d, id %08X\n", level, statusId);
#endif

/*/printf("Default handler called for level %d\n",level);*/
}

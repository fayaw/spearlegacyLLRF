int memRqmtCompare( const struct map* a, const struct map* b );

void getMfrNames(char *, mfrName_t **);
void getModelNames(char *, mfrName_t **);
void getDeviceNames(char *, mfrName_t **);
void createMfrEntry(mfrName_t **, char *, unsigned short);
void createModelEntry(mfrName_t **, char *, char *, unsigned short);
void createDeviceEntry(mfrName_t **, char *, char *, char *,
	unsigned short, unsigned short, unsigned short, unsigned short);
sharedMem_t* getsharedMem( char* path );
void rmReadSharedMem(sharedMem_t* ptrSharedMem);
nonVxi_t *getnonVxi(char *, mfrName_t **, mfrName_t **, mfrName_t **);

UINT32 rmUnivRegRd ( UINT16 offset );
void rmUnivRegWr ( UINT16 offset, UINT32 value );

void freeConfigList ( config_t* );
void freeNameList ( mfrName_t* );

#endif /** DEFINED **/

/***************************************************************************
  bus.h

  Fundamental VXI bus access routines.
***************************************************************************/

#ifndef vxiLib_bus_DEFINED
#define vxiLib_bus_DEFINED

#define VXIBUS_OK		0
#define VXIBUS_ERR		(-1)


#define  MY_LOG_ADDR		0
#define  MY_BASE_ADDR		(0xC000 + (MY_LOG_ADDR << 6))

#define  GET_MY_REG(x)	    	PEEK16 (VXIBUS_A16, MY_BASE_ADDR+(x))
#define  PUT_MY_REG(x,v)    	POKE16 (VXIBUS_A16, MY_BASE_ADDR+(x), (v))


extern void* vxiBusBase16;
extern void* vxiBusBase24;
extern void* vxiBusBase32;

#define VXIBUS_A32		((unsigned char*) vxiBusBase32)
#define VXIBUS_A24		((unsigned char*) vxiBusBase24)
#define VXIBUS_A16		((unsigned char*) vxiBusBase16)

#define VXIBUS_D8(adr,ofs)	(* (unsigned char*)  ((adr)+(ofs)))
#define VXIBUS_D16(adr,ofs)	(* (unsigned short*) ((adr)+(ofs)))
#define VXIBUS_D32(adr,ofs)	(* (unsigned long*)  ((adr)+(ofs)))

#define PEEK8(adr,ofs)		VXIBUS_D8(adr,ofs)
#define PEEK16(adr,ofs)		VXIBUS_D16(adr,ofs)
#define PEEK32(adr,ofs)		VXIBUS_D32(adr,ofs)

#define POKE8(adr,ofs,val)	(VXIBUS_D8(adr,ofs) = (val))
#define POKE16(adr,ofs,val)	(VXIBUS_D16(adr,ofs) = (val))
#define POKE32(adr,ofs,val)	(VXIBUS_D32(adr,ofs) = (val))


int vxiBusInit (void);

#endif /** DEFINED **/


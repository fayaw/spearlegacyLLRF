/***************************************************************************
  portable.c

  This file contains routines to make resman portable across the multiple
  SBC's used in the V151.
***************************************************************************/
#include <stdio.h>
#include <vxWorks.h>
#include "resman.h"

#define X32(x)          ((((UINT32)(x) << 24) & 0xff000000) | \
                         (((UINT32)(x) <<  8) & 0x00ff0000) | \
                         (((UINT32)(x) >>  8) & 0x0000ff00) | \
                         (((UINT32)(x) >> 24) & 0x000000ff))

UINT32 rmUnivRegRd ( UINT16 offset )
{
    UINT32 value = 0xffffffff;

    value = *( (UINT32*) (RM_UNIV_BASE + offset) );

    value = X32(value);

    return value;
}

void rmUnivRegWr ( UINT16 offset, UINT32 value )
{
    value = X32(value);

    *( (UINT32*) (RM_UNIV_BASE + offset) ) = value;
}

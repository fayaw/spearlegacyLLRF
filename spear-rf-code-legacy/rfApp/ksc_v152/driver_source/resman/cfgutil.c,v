/***************************************************************************
  cfgutil.c

  Writes MXI Trigger & Utility configuration registers per section F.6
  of Mainframe Extender Specification VXI-6, Rev. 1.0; 2/7/91

  NOTE: We only set registers for MXI's that are listed in trigutil.cfg.
  Any others will NOT be serviced.
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>

#include "resman.h"


/*
 * Entry point
 */

#if 0
int rmConfigureUtil( void )
{
   config_t  *thisLA;
   utilCfg_t *thisUC;

   unsigned short status;
   unsigned short data;
   unsigned short base;

   /* For all MXI extenders listed in trigutil.tbl file
    * (which we see here as each element of utilCfg_t list)
    */
   for( thisUC = rootUC; thisUC != NULL; thisUC = thisUC->next )
   {
      /* IS THIS EXTENDER IN THIS NODE? */
      if( thisUC->giNode == giNode )
      {
         /* Find its config_t entry, if possible  (6mar96 rcd) */
         if( (thisLA = findLAConfig( thisUC->extndrLA, root )) == NULL )
         {
            /* If device not actually seen, skip it & go on to next one */
            continue;
         }

         /* IF DEVICE IS A MXI EXTENDER  (6mar96 rcd) */
         if( (thisLA->devClass == DEVCL_EXTENDED) &&
             (thisLA->subclass == VXI_MXI_DEVICE)   )
         {
            base = VXI_LA2PA(thisUC->extndrLA);

/* Future:  check Util register first (read either linked list or register)
 *          to see which of these is supported.
 */
#ifdef KSC_DEBUG_
   printf("Setting MXI (LA %d) registers (from file)\n",
          thisUC->extndrLA );
#endif
            /* WRITE TTL TRIGGER REGISTER */
            status = mxiOut( pHdl, giNode,
                             base + MXI_TTLTRIG_CONFIG,
                             (thisUC->ttlTrigLines << 8) | thisUC->ttlTrigDirns );

            /* WRITE ECL TRIGGER REGISTER 
             * Bits 6, 7, 14, and 15 are reserved and must be written with 1's.
             */
            data = 0xC0C0 | (thisUC->eclTrigLines << 8) | thisUC->eclTrigDirns;
            status = mxiOut( pHdl, giNode, base + MXI_ECLTRIG_CONFIG, data );

            /* WRITE UTILITY BUS REGISTER 
             * Bits 6 thru 11 are reserved and must be written with 1's.
             */
            status = mxiOut( pHdl, giNode,
                             base + MXI_UTILBUS_CONFIG,
                             0x0FC0 | thisUC->utilMode );
         }   /* endif MXI */
      } /* endif node matches */

/* ENDFOR all extenders */
   }
   return( 0 );
}
#endif


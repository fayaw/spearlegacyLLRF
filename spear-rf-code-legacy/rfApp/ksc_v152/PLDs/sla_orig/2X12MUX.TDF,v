@TITLE "2 By 12 Mux";

SUBDESIGN 2X12MUX (

		SELECT,
		TSRC[11..0],
		TI_SRC[11..0]		:INPUT;

		OUTD[15..0]		:OUTPUT;
		)

BEGIN

	CASE SELECT IS
		WHEN 0 => OUTD[11..0] = TSRC[11..0];
                  OUTD[15..12] = B"0000";
		WHEN 1 => OUTD[11..0] = TI_SRC[11..0];
                  OUTD[15..12] = B"0000";
	END CASE;
END;



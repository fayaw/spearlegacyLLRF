@TITLE "V150 INTERRUPT DTACK GENERATOR		REV A.0";

SUBDESIGN INT_ACK (
	CLOCK,
	RESET,
	INT_MATCH,
	INT_REQ,
	IACKIN,
	DS		:INPUT;

	DTACK,
	ENA_VECT,
	IACKOUT,
	CLR_INTS		:OUTPUT; )

VARIABLE

CONTROL : MACHINE OF BITS (DTACK,ENA_VECT,IACKOUT,CLR_INTS)
		WITH STATES (

	POWER_UP = B"0000",
	 	ST0 = B"0000",
		ST1 = B"0000",
		ST2 = B"0100",
		ST3 = B"0100",
		ST4 = B"0101",
		ST5 = B"1100",
		ST6 = B"0010",
		ST7 = B"0000");

BEGIN

	 CONTROL.CLK = CLOCK;
	 CONTROL.RESET = RESET;

CASE (CONTROL) IS

	WHEN POWER_UP =>
		CONTROL = ST0;
	WHEN ST0 =>
		IF (IACKIN & !INT_REQ) THEN
			CONTROL = ST6;
		ELSIF (DS & INT_REQ & IACKIN & INT_MATCH) THEN
			CONTROL = ST1;
		ELSE
			CONTROL = ST0;
		END IF;
	WHEN ST1 =>
		IF (DS & INT_MATCH) THEN
			CONTROL = ST2;
		ELSE
			CONTROL = ST0;
		END IF;
	WHEN ST2 =>
		CONTROL = ST3;
	WHEN ST3 =>
		CONTROL = ST4;
	WHEN ST4 =>
		CONTROL = ST5;
	WHEN ST5 =>
		IF (DS) THEN
			CONTROL = ST5;
		ELSE
			CONTROL = ST7;
		END IF;
	WHEN ST6 =>
		IF (IACKIN) THEN
			CONTROL = ST6;
		ELSE 
			CONTROL = ST0;
		END IF;
	WHEN ST7 =>
		IF (IACKIN) THEN
			CONTROL = ST7;
		ELSE
			CONTROL = ST0;
		END IF;
	END CASE;
END;

	
	


@TITLE "V150 2X8 MUX									REV A.0";

SUBDESIGN 2X8_MUX (

	SELECT,
	A[7..0],
	B[7..0]		:INPUT;

	OUT[7..0]	:OUTPUT;)

BEGIN

	CASE SELECT IS

		WHEN 0 =>
			OUT[7..0] = A[7..0];
		WHEN 1 =>
			OUT[7..0] = B[7..0];
	
	END CASE;
END;

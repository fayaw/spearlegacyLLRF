text
@Name      int_mod;
Partno    ATF16V8B-10SC;
Date      10-17-2002;
Revision  A;
Designer  John Dusatko;
Company   SLAC;
Assembly  A;
Location  Stanford;
Device    G16V8;

/****************************************************************/
/*		Stanford Linear Accelerator Center			    */
/*			PEP-II / SPEAR3					    */
/*		Low Level RF System Upgrade				    */
/*										    */
/* 										    */
/*										    */
/* This design is to modify the interrupt response on the HP    */
/* model E1407A VME <--> VXI adapter module                     */
/*										    */
/* This device will replace U102, a 74ALS541 on the E1407A      */
/*										    */
/* This has been done to allow D8(O) IACK cycles to be performed*/
/* when using the Kinetic Systems V152 VXI CPU which has been   */
/* modified to perform ONLY D16 cycles by connecting its DS1* to*/
/* to DS0*. The Allen-Bradley VSC1 Scanner Module which plugs   */
/* into the E1407A can only respond to D8(0) IACK* cycles	    */
/*										    */
/*										    */
/* This design modification gates DS1* using IACKIN*. When	    */
/* IACKIN* is asserted, DS1* is disabled and will always by     */
/* high, allowing the board sitting on the adapter to "see"	    */
/* a D8(O) IACK cycle. When IACKIN* is de-asserted, DS1* flows  */
/* through normally.							    */
/****************************************************************/



/*  inputs  */

/* tri-state enables */
pin 1 = g1;
pin 19 = g2;

/* VME/VXI inputs */
pin 2 = as_n;
pin 3 = ds0_n;
pin 4 = ds1_n;

/* the follwing pins are connected to GND externally */
pin 5 = a4;
pin 6 = a5;
pin 7 = a6;
pin 8 = a7;
pin 9 = a8;

/* VXI IACKIN* signal */
pin 11 = biackin_n;


/*  outputs  */

pin 18 = bas_n; 	/* buffered version of as_n */
pin 17 = bds0_n;	/* buffered version of ds0_n */
pin 16 = bds1_n;	/* special gated version of ds1_n */


pin 15 = nop; /* unused output */



/* equations */

bas_n = as_n;   /* buffer as_n */

bds0_n = ds0_n;   /* buffer ds0_n */

bds1_n = ds1_n # !biackin_n; /* the special IACK feature */


nop = a4 # a5 # a6 # a7 # a8 # g1 # g2; /* doing someting with the unused signals */
@



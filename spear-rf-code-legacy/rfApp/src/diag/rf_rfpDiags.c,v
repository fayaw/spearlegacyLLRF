#include <vxWorks.h>
#include <stdioLib.h>

#include "sglLib.h"
#include "busLib.h"
#include "mtlLib.h"
#include "dtl.msg"
#include "memTest.h"

#define NIL   (void *)(0)
/*#define NULL           0 */
#define TRUE           1
#define FALSE          0
#define SUCCESS        0
#define FAILURE        1

#define Min(a,b)       ((a) < (b) ? (a) : (b))
#define Max(a,b)       ((a) > (b) ? (a) : (b))
#define lsizeof(var)   (sizeof (var) >> 2)


#define DSP_K_DATASPACE  SPC_K_A24
#define DSP_K_DATASIZE   SIZ_K_SHORT



Status DspDiags (unsigned int adx,
                 unsigned int loop)
/*
   Description
   -----------
   Diagnostic suite for the SLAC DSP boards.

   Parameter
   ---------
        loop - Number of times to loop over each test.  Zero implies once.

   Returns
   -------
   SUCCESS or some failure status.
*/
{
  unsigned long   address = (unsigned long) adx;
  unsigned int    count   = 8 * 1024;


  /* Sanity checks */
  if (loop == 0) loop = 1;

  SGL_Status ((Status) "Memory test start address in A24 space: %08x, length %0x\n",
              address, count);

  /* Memory tests */
  SGL_Status (DTL_MEMTST, "Constant");
  if (MemTest (DSP_K_DATASPACE, address, count, DSP_K_DATASIZE,
               MTL_K_CONSTANT,   0xcafe, loop, TRUE))
    return (SGL_Error (DTL_MEMFLD, "Constant",   adx));

  SGL_Status (DTL_MEMTST, "Bit");
  if (MemTest (DSP_K_DATASPACE, address, count, DSP_K_DATASIZE,
               MTL_K_BIT,        0x0001, loop, TRUE))
    return (SGL_Error (DTL_MEMFLD, "Bit",        adx));

  SGL_Status (DTL_MEMTST, "Increment");
  if (MemTest (DSP_K_DATASPACE, address, count, DSP_K_DATASIZE,
               MTL_K_INCREMENT,  0x1248, loop, TRUE))
    return (SGL_Error (DTL_MEMFLD, "Increment",  adx));

  SGL_Status (DTL_MEMTST, "Complement");
  if (MemTest (DSP_K_DATASPACE, address, count, DSP_K_DATASIZE,
               MTL_K_COMPLEMENT, 0xa5a5, loop, TRUE))
    return (SGL_Error (DTL_MEMFLD, "Complement", adx));

  return (SUCCESS);
}
@



static long DdfInit (void           *drvPvt,
                     unsigned short  chanMask)
/*
   Description
   -----------
   Initialize the DDFs by enabling their clocking, asserting their reset
   lines and then reenabling them.  RESET# must be held low (active) for
   at least 4 clocks of the slowest clock, according to Harris TechBrief
   TB309.  This value is 47.2 KHz / 256 = 6 mSec = 1/60th second (lowest
   resolution of most VxWorks clocks).  Similarly, one is supposed to wait
   for the "RESET# recovery time" before accessing the DDF registers.
   This time is specified as 8 ticks of the input clock, which is
   8 / 19.63 MHz / 16 = 6.5 uSecs.  To be conservative, we delay 1/60th
   second before returning from this routine to allow for the reset recovery.

   Parameters
   ----------
       drvPvt - A pointer to the driver-private block
     chanMask - Mask of channels to initialize

   Returns
   -------
   OK
*/
{
  unsigned short reg;

  /* Clear the start and stop bits of the interesting channels */
  chanMask = (chanMask << IQA_V_DDFNRST) & IQA_M_DDFNRST;

  /* Get the current state of the DDF control register */
  P2RF_ReadVme (drvPvt, IQA_I_DDFCTL, &reg);

  /* Reset the DDF(s) */
  reg &= ~((chanMask << IQA_V_DDFSTRT) | (chanMask << IQA_V_DDFNRST));
#if 0
  reg &= ~(0xff);                  /* Kludge for bit 0 being bits 0-7 on SN 1*/
#endif
  P2RF_WriteVme (drvPvt, IQA_I_DDFCTL, reg);
  taskDelay (sysClkRateGet () / 60);         /* Allow DDFs to settle */

  /* Remove Reset* from the DDF(s) */
  reg |= chanMask << IQA_V_DDFNRST;
#if 0
  reg |= 0xff;                    /* Kludge for bit 0 being bits 0-7 on SN 1 */
#endif
  P2RF_WriteVme (drvPvt, IQA_I_DDFCTL, reg);
  taskDelay (sysClkRateGet () / 60);         /* Allow DDFs to settle */

  return (OK);
}



static long DdfLoad (void           *drvPvt,
                     unsigned short  chanMask,
                     IqaDdfPrm      *prm)
/*
   Description
   -----------
   Load the DDF chips with coefficients

   Parameters
   ----------
       drvPvt - A pointer to the driver-private block
     chanMask - Mask of channels to initialize
          prm - Pointer to a structure containing the DDF parameters

   Returns
   -------
   OK
*/
{
  int             chan;

  for (chan = 0; chan < IQA_K_CHANCNT; prm++, chan++)
  {
    if (chanMask & 0x0001)
      P2RF_LoadDdf (drvPvt, prm->iIndex, prm->qIndex, &prm->ddf);
    chanMask >>= 1;
  }

  return (OK);
}



static long DdfStart (void           *drvPvt,
                      unsigned short  chanMask)
/*
   Description
   -----------
   Start the DDF chips

   Parameters
   ----------
       drvPvt - A pointer to the driver-private block
     chanMask - Mask of channels to initialize

   Returns
   -------
   OK
*/
{
  unsigned short reg;


  /* Make sure the channel mask is okay */
  chanMask = (chanMask << IQA_V_DDFNRST) & IQA_M_DDFNRST;

  /* Get the current state of the DDF control register */
  P2RF_ReadVme (drvPvt, IQA_I_DDFCTL, &reg);

  reg |= (((chanMask << IQA_V_DDFNRST) & IQA_M_DDFNRST) |
          ((chanMask << IQA_V_DDFSTRT) & IQA_M_DDFSTRT));
#if 0
  reg |= 0xff;                     /* Kludge for bit 0 being bits 0-7 on SN 1 */
#endif
  P2RF_WriteVme (drvPvt, IQA_I_DDFCTL, reg);

  return (OK);
}



static long Action (P2RfIqaRecord    *rec)
/*
   Description
   -----------
   This is the action routine for the IQA module.

   Parameters
   ----------
          rec - A pointer to the record structure

   Returns
   -------
   0 or 2 for successful returns, else a status
*/
{
  /*  Function ("Action");*/

  IqaBoard       *brd    = NULL;
  void           *drvPvt;
  unsigned short  iqpc;
  unsigned short  reg;


  /* If initialization failed let the system know */
  if ((brd = rec->dpvt) == NULL)  return (ERROR);
  drvPvt = brd->drvPvt;

  /* If processing was invoked by an interrupt, handle it */
  if (brd->intPrc)
  {
    unsigned short chanMask;


    if (rec->istt & IQA_M_AMPTHRFLT)
    {
      /* Read the Amplitude Fault register into the database */
      P2RF_ReadVme (drvPvt, IQA_I_FLTSTAT, &brd->ampThrFltMsk);
      /* Read the Amplitude Processing Control register and post it */
      P2RF_ReadVme (drvPvt, IQA_I_AMPCTL,    &rec->actl);
      db_post_events(rec,&rec->actl, DBE_VALUE | DBE_LOG);
    }

    /* Update client value of interrupt status field */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }

    /* Report enabled channels only */
    chanMask = (rec->fest & IQA_M_FLTENB) >> IQA_V_FLTENB;
    chanMask = (chanMask << IQA_V_LATFAULT) | (chanMask << IQA_V_CURFAULT);
    brd->ampThrFltMsk &= chanMask;

    /* Fold current into latched */
    brd->ampThrFltMsk |= (brd->ampThrFltMsk & IQA_M_CURFAULT) << IQA_V_LATFAULT;

    /* Update database amplitude threshold fault mask copy, if necessary */
    if (brd->ampThrFltMsk != rec->tfst)
    {
      rec->tfst = brd->ampThrFltMsk;
      db_post_events (rec, &rec->tfst, DBE_VALUE | DBE_LOG);
    }

    UpdateFirstFaultStatus(brd);

    /* Don't loose invocation count on multiple interrupts */
    brd->intPrc--;
    return (0);
  }

  /* Initialize the message buffer if we're not doing completion processing */
  if (!rec->pact)    strncpy (rec->val, "Success", sizeof (rec->val));

  /* If requested, do a "software reset" on the module */
  if (rec->mrst)  return (SpawnReset (rec, &brd->resetBlk));

  /* If operator disabled interrupts update interrupt status DB field */
  P2RF_ReadVme (brd->drvPvt, IQA_I_INTCTRL, &reg);
  if ((reg & IQA_INTSELECT(rec->verh)) == IQA_INTSELECT(rec->verh))
  {
    unsigned short chanMask;

    P2RF_ReadVme (brd->drvPvt, IQA_I_INTSTAT, &rec->istt);
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }

    /* Read the Amplitude Fault register into the database */
    P2RF_ReadVme (drvPvt, IQA_I_FLTSTAT, &brd->ampThrFltMsk);

    /* Report enabled channels only */
    chanMask = (rec->fest & IQA_M_FLTENB) >> IQA_V_FLTENB;
    chanMask = (chanMask << IQA_V_LATFAULT) | (chanMask << IQA_V_CURFAULT);
    brd->ampThrFltMsk &= chanMask;

    /* Fold current into latched */
    brd->ampThrFltMsk |= (brd->ampThrFltMsk & IQA_M_CURFAULT) << IQA_V_LATFAULT;

    /* Update database amplitude threshold fault mask copy, if necessary */
    if (brd->ampThrFltMsk != rec->tfst)
    {
      rec->tfst = brd->ampThrFltMsk;
      db_post_events (rec, &rec->tfst, DBE_VALUE | DBE_LOG);
    }

    UpdateFirstFaultStatus(brd);
  }

  /* Let the operator acknowledge that the interrupts have been seen */
  if (rec->iack)
  {
    rec->istt &= ~rec->iack;            /* Only take requested bits down */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
    rec->iack = 0;
    db_post_events (rec, &rec->iack, DBE_VALUE | DBE_LOG);
  }

  /* Update the interrupt control register if there was a change request */
  if (rec->imsk != rec->oimk)
  {
    rec->oimk = rec->imsk;
    rec->ictl = (rec->ictl & ~IQA_INTSELECT(rec->verh)) |
      ((~rec->imsk << IQA_V_INTSELECT) & IQA_INTSELECT(rec->verh));
    P2RF_WriteVme (drvPvt, IQA_I_INTCTRL,  rec->ictl);
    db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
  }

 
  /* To monitor change of ACTL caused by backplane fault and to update ACTL */
  {
      unsigned short actl;
      /* Read the Amplitude Processing Control register and post it */
      P2RF_ReadVme (drvPvt, IQA_I_AMPCTL,    &actl);
      if(actl != rec->actl) {
          rec->actl = actl;
          db_post_events(rec,&rec->actl, DBE_VALUE | DBE_LOG);
      }
   }

  /* Reset amplitude threshold faults */
  if (rec->caf)
  {
    rec->caf = 0;
    ResetAmpThrFault( brd );
  }

  /* Read the Amplitude Fault register into the database */
  {
    unsigned short chanMask;

    P2RF_ReadVme (drvPvt, IQA_I_FLTSTAT, &brd->ampThrFltMsk);

    /* Report enabled channels only */
    chanMask = (rec->fest & IQA_M_FLTENB) >> IQA_V_FLTENB;
    chanMask = (chanMask << IQA_V_LATFAULT) | (chanMask << IQA_V_CURFAULT);
    brd->ampThrFltMsk &= chanMask;

    /* Fold current into latched */
    brd->ampThrFltMsk |= (brd->ampThrFltMsk & IQA_M_CURFAULT) << IQA_V_LATFAULT;

    /* Update database amplitude threshold fault mask copy, if necessary */
    if (brd->ampThrFltMsk != rec->tfst)
    {
      rec->tfst = brd->ampThrFltMsk;
      db_post_events (rec, &rec->tfst, DBE_VALUE | DBE_LOG);
    }

    UpdateFirstFaultStatus(brd); 
  }

  /* Select the Amplitude scan mode */
  if((rec->verh<IQA_K_VER3VERN) && rec->ampm) {
    rec->ampm = 0;
    strncpy(rec->oval, rec->val, sizeof(rec->oval));
    strncpy(rec->val, "8CHN mode is NOT available",sizeof(rec->val));
    db_post_events(rec, &rec->val, DBE_VALUE | DBE_LOG );
  }
  if (rec->verh >= IQA_K_VER3VERN) {
      if(rec->ampm) rec->actl |= IQA_M_AMPMODE;   /* to set 8ch scan mode */
      else          rec->actl &= ~IQA_M_AMPMODE;  /* to set single ch scan mode */
      P2RF_WriteVme(drvPvt,IQA_I_AMPCTL, rec->actl &= ~IQA_M_CLRFAULT);
      db_post_events(rec,&rec->actl, DBE_VALUE | DBE_LOG);
  }


  /* Read the amplitude signal selection, if it's changed */
  if (rec->ass != rec->oass)
  {
    if ((rec->ass <= 0) || (rec->ass > IQA_K_CHANCNT))
    {
      if      (rec->ass <= 0)            rec->ass = 1;
      else if (rec->ass > IQA_K_CHANCNT) rec->ass = IQA_K_CHANCNT;
      db_post_events (rec, &rec->ass, DBE_VALUE | DBE_LOG);
    }
    rec->oass = rec->ass;
    rec->actl = (rec->actl & ~IQA_M_SIGSEL) |
                (((rec->ass - 1) << IQA_V_SIGSEL) & IQA_M_SIGSEL);
    P2RF_WriteVme (drvPvt, IQA_I_AMPCTL,  rec->actl &= ~IQA_M_CLRFAULT);
    db_post_events (rec, &rec->actl, DBE_VALUE | DBE_LOG);
  }

  /* Update the amplitude threshold(s), if requested */
  {
    register int     idx = IQA_I_AMPTHR0;
    register float  *at  = &rec->at0;
    register float  *oat = &brd->ampThr[0];

    for (idx = IQA_I_AMPTHR0; idx <= IQA_I_AMPTHR7; at++, oat++, idx++)
    {
      if (*at != *oat)
      {
        P2RF_WriteVme (drvPvt, idx,
                       (unsigned short)((*at*IQA_K_ATCNTPERV)) << IQA_V_AMPTHR);
        *oat = *at;
        db_post_events (rec, at, DBE_VALUE | DBE_LOG);
      }
    }
  }

  /* Update the database copy of the Fault Enable Status register */
  P2RF_ReadVme (drvPvt, IQA_I_FLTENBSTT, &reg);
  if (reg != rec->fest)
  {
    rec->fest = reg;
    db_post_events (rec, &rec->fest, DBE_VALUE | DBE_LOG);
  }

  /* Process request to read out the module's amplitude history buffer */
  if (rec->gahs)  return (SpawnGetHist (rec, &rec->gahs, &brd->histBlk,
                                        &brd->ampHistPrm, rec->ahsz, rec->ahfs,
                                        &rec->astt));

  /* Get the current state of the module */
  P2RF_ReadVme (drvPvt, IQA_I_IQCTL, &iqpc);

  /* Look at only those bits that are modifiable */
  iqpc &= ~(IQA_M_IFCHNSEL | IQA_M_IFMODE | IQA_M_LNKENB);

  /* Potentially change the IF channel selection */
  if      (rec->ifc <= 0)            rec->ifc = 1;
  else if (rec->ifc > IQA_K_CHANCNT) rec->ifc = IQA_K_CHANCNT;
  iqpc |= ((rec->ifc - 1) << IQA_V_IFCHNSEL) & IQA_M_IFCHNSEL;

  /* The new IQA module (ver.3) has Dual-port enable bit on IQCTL register.
   * So, the follwing statements do to set this bit to enable dual-port memory */
  if (rec->verh >= IQA_K_VER3VERN)
      iqpc |= ( IQA_M_IQDPMENB | IQA_M_IQMEMMOD );

  /* Check the IF mux mode bit to en/disable single channel mode */
  if (rec->ifm)  iqpc |= IQA_M_IFMODE;

  /* Check if the link with the RFP module is enabled. */
  if (rec->lenb) iqpc |= IQA_M_LNKENB;

  /* Update module and database versions of I/Q Processing Control register */
  /* Reset latched stop trigger, if so requested */
  if (rec->rlst || (iqpc != rec->iqpc))
  {
    if (rec->rlst)
    {
      rec->rlst = 0;
      /* We don't have to stop the trigger on new module.
        But, I am not sure about old modules.
        So, stopping trigger is still needed for old modules */
      if(rec->verh < IQA_K_VER3VERN )
            P2RF_WriteVme (drvPvt, IQA_I_IQCTL,  iqpc & ~IQA_M_IQMEMMOD);
      P2RF_WriteVme (drvPvt, IQA_I_IQCTL,  iqpc | IQA_M_IQMEMMOD);
      taskDelay(1);
    }
    else
    { 
      if(rec->verh >= IQA_K_VER3VERN && !(iqpc & IQA_M_IQHSTENB)) iqpc &= ~IQA_M_IQMEMMOD;   
      P2RF_WriteVme (drvPvt, IQA_I_IQCTL,  iqpc);
    }
    P2RF_ReadVme  (drvPvt, IQA_I_IQCTL, &rec->iqpc);
    db_post_events (rec, &rec->iqpc, DBE_VALUE | DBE_LOG);
  }

  /* Process request to read out the module's IQ history buffer */
  if (rec->giqh)  return (SpawnGetHist (rec, &rec->giqh, &brd->histBlk,
                                        &brd->iqHistPrm, rec->iqhs, rec->iqhf,
                                        &rec->iqst));

  /* Deal with load DDF coefficient file requests */
  {
    unsigned char  *lcf  = &rec->lcf0;
    int             chan;
    unsigned short  chanMask = 0;

    for (chan = 0; chan < IQA_K_CHANCNT; lcf++, chan++)
    {
      if (*lcf)
      {
        chanMask |= 1 << chan;
        *lcf      = 0;
        brd->ldDdfRqst = TRUE;
      }
    }

#if 0
    /* Since the DDFCTL register is brain dead, we load all DDFs every time */
    chanMask = 0x00ff;
#endif

    if (brd->ldDdfRqst)  return (SpawnLdDdf (rec, &brd->ldDdfRqst, &brd->ddfBlk,
                                             chanMask, brd->ddfPrm));
  }

  return (0);
}


static long SpawnReset (P2RfIqaRecord  *rec,
                        IqaRstBlk      *blk)
/*
   Description
   -----------
   This function initiates and completes the module reset.

   Parameters
   ----------
          rec - A pointer to the record
          blk - A pointer to the reset block

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnReset");


  if (!rec->pact)
  {
    /* Let operator know what's happening */
    strncpy (rec->val,  "Software Reset: active", sizeof (rec->val));
    strncpy (rec->oval, "Software Reset: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);

    /* Don't allow reprocessing of record before reset completes */
    rec->pact = TRUE;

    /* Disable module interrupts during software reset */
    P2RF_ModIntDisable (blk->drvPvt);

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
      strncpy (rec->val, "Attempt to initialize module failed", sizeof (rec->val));
      recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
    }
    else
    {
      /* Re-enable module interrupts */
      P2RF_ModIntEnable (blk->drvPvt);
      P2RF_ReadVme (blk->drvPvt, IQA_I_INTCTRL,  &rec->ictl);

      strncpy (rec->val, "Software reset: done", sizeof (rec->val));
    }

    /* Reset the reset request */
    rec->mrst = 0;
  }

  return (0);
}




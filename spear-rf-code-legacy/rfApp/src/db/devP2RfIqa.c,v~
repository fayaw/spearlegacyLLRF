static long InitRecord (P2RfIqaRecord  *rec)
/*
   Description
   -----------
   Initialize the record.  Many fields of the record are filled with data from
   the hardware.  Depending on the start-up type (cold or warm) some record
   fields will either set up the hardware or get their values from a restore
   file.  Interrupts from the board are enabled at the end of the
   initialization.

   Parameters
   ----------
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("InitRecord");

  struct vxiio   *vxiIo = NULL;
  IqaBoard       *brd;
  long            status;
  void           *drvPvt;
  char           *msg   = "IQA module initialization failed";
  int             startType;
  SEM_ID          sem;


  /* rec.out must be of type VXI_IO */
  if (rec->out.type != VXI_IO)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_db_badField, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "Illegal OUT field"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return(S_db_badField);
  }

  /* Allocate the device private block */
  if ((brd = calloc (1, sizeof (*brd))) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "No memory for IQA board descriptor"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Register the module to get a driver handle */
  vxiIo = &rec->out.value.vxiio;
  if ((status = P2RF_RegisterModule(vxiIo->flag, vxiIo->frame, vxiIo->slot,
                                    vxiIo->la,
                                    IQA_K_MODEL, IQA_K_NAME, IQA_K_DRAWING,
                                    IqaIsr, brd, IqaShutdown, brd,
                                    &drvPvt)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "P2RF_RegisterModule"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (status);
  }

  /* Set up the device private block and save a pointer to it in the record */
  brd->drvPvt = drvPvt;
  brd->rec    = rec;
  rec->dpvt   = brd;

  /* Initialize the callback facility for the reset function*/
  callbackSetCallback (ResetCallback, &brd->resetBlk.callback);
  callbackSetPriority (priorityHigh, &brd->resetBlk.callback);
  callbackSetUser     (rec, &brd->resetBlk.callback);
  brd->resetBlk.drvPvt = drvPvt;

  /* Initialize the callback facility for loading DDF coefficients */
  callbackSetCallback (LdDdfCallback, &brd->ddfBlk.callback);
  callbackSetPriority (priorityLow, &brd->ddfBlk.callback);
  callbackSetUser     (rec, &brd->ddfBlk.callback);
  brd->ddfBlk.drvPvt = drvPvt;

  /* Load the static part of the DDF coefficient parameter block */
  {
    IqaDdfPrm  *prm  = brd->ddfPrm;
    int         iIdx = IQA_I_I0F;
    int         qIdx = IQA_I_Q0F;
    int         chan;

    for (chan = 0; chan < IQA_K_CHANCNT; prm++, chan++)
    {
      prm->id     = IQA_K_DDFCOEFID;
      prm->iIndex = iIdx;
      prm->qIndex = qIdx;
      iIdx += 8;
      qIdx += 8;
    }
  }

  /* Initialize the callback facility for History Buffer */  
  brd->ampHistPrm.busy = 0x00;      /* KHKIM, 04-17-2003 */
  brd->iqHistPrm.busy  = 0x00;      /* KHKIM, 04-17-2003 */
  brd->histBlk.drvPvt = drvPvt;
  callbackSetCallback (GetHistCallback, &brd->histBlk.callback);
  callbackSetPriority (priorityLow, &brd->histBlk.callback);
  callbackSetUser     (rec, &brd->histBlk.callback);

  /* Load the static part of the history parameter block */
  {
    IqaMemPrm  *prm = &brd->ampHistPrm;

    prm->id    = IQA_K_AMPHISTID;
    prm->index = IQA_I_AMPMEM;
  }

  /* Load the static part of the history parameter block */
  {
    IqaMemPrm  *prm = &brd->iqHistPrm;

    prm->id    = IQA_K_IQHISTID;
    prm->index = IQA_I_IQMEM;
  }

  /* Figure out the restart type -- To be determined */
  startType = P2RF_K_COLDSTART;

  /* Initialize the module and the database fields depending on startup type */
  if ((status = InitFields (brd, startType)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Get us a coupla semaphores and hang if we don't get 'em */
  if ((sem = semBCreate (SEM_Q_FIFO, SEM_FULL)) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (-1, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "%s failed - id = %s",
                                     "semBCreate", "scanSem"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }
  rec->ssem = (long) sem;

  if ((sem = semBCreate (SEM_Q_FIFO, SEM_FULL)) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (-1, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "%s failed - id = %s",
                                     "semBCreate", "dRdySem"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }
  rec->rsem = (long) sem;

  /* Start up the scan task */
  brd->scanTid = taskSpawn (IQA_SCANNAME, IQA_SCANPRI, VX_FP_TASK, IQA_SCANSTK,
                            (FUNCPTR) IqaScanTask, (int) brd,
                            0, 0, 0, 0, 0, 0, 0, 0, 0);

  taskwdInsert (brd->scanTid, NULL, 0L);

  /* Enable module interrupts and update the database copy */
  P2RF_ModIntEnable (drvPvt);
  P2RF_ReadVme (brd->drvPvt, IQA_I_INTCTRL,  &rec->ictl);

  return (OK);
}



static long InitFields (IqaBoard *brd,
                        int       initType)
/*
   Description
   -----------
   Function to initialize the fields in the database record and/or the module,
   depending on the initialization type.

   I/Q channels can be disabled by setting the DDF file to NULL.

   Parameters
   ----------
          brd - A pointer to the device private block
     initType - Type of initialization.

   Returns
   -------
   Status
*/
{
  /*  Function ("InitFields");*/

  P2RfIqaRecord  *rec    = brd->rec;
  void           *drvPvt = brd->drvPvt;
  long            status;
  unsigned short  sernHi;
  unsigned short  sernLo; 


  /* Reset the module, if it's a cold startup.  This takes a while... */
  if (initType == P2RF_K_COLDSTART)  P2RF_ResetModule (drvPvt);

  /* Load the record fields with device data */
  P2RF_ReadVme (drvPvt, IQA_I_MANID,     &rec->mid );
  P2RF_ReadVme (drvPvt, IQA_I_MODELNO,   &rec->mtyp);
  P2RF_ReadVme (drvPvt, IQA_I_STATUS,    &rec->mstt);
  P2RF_ReadVme (drvPvt, IQA_I_OFFSET,    &rec->a24o);
  P2RF_ReadVme (drvPvt, IQA_I_ATTRIBUTE, &rec->vatt);
  P2RF_ReadVme (drvPvt, IQA_I_SERIALHI,  &sernHi   );
  P2RF_ReadVme (drvPvt, IQA_I_SERIALLO,  &sernLo   );
  rec->sern = (sernHi << 16) | sernLo;
  P2RF_ReadVme (drvPvt, IQA_I_VERSION,   &rec->vern);
  P2RF_ReadVme (drvPvt, IQA_I_SUBCLASS,  &rec->vscl);
  
  /* Take the hardware and software version and set the fields */
  rec->verh = P2RF_HWVER(rec->vern);
  rec->verf = P2RF_FWVER(rec->vern);
  rec->ssi  = IQA_K_SSI(rec->verh);
  rec->sti  = IQA_K_STI(rec->verh);

  /* Write some registers if we're doing a grounds-up initialization */
  if (initType == P2RF_K_COLDSTART)    status = ColdInit (brd, rec);
  else                                 status = WarmInit (brd, rec);

  /* Set mask to ignore ripple channel if it's on this board */
#ifdef ROTB_FLD_CREATED
  brd->rdyMsk = rec->rotb ? IQA_K_RDYNOTRIP : IQA_K_RDYALL;
#else
  brd->rdyMsk = TRUE ? IQA_K_RDYNOTRIP : IQA_K_RDYALL;
#endif

  /* Resman wrote 0xfffc to module control register; take down software int */
  rec->mctl = rec->mstt & (IQA_M_SFTRST | IQA_M_SYSFAILINH | IQA_M_A24A32);
  P2RF_WriteVme (drvPvt, IQA_I_CONTROL,  rec->mctl);
  P2RF_ReadVme  (drvPvt, IQA_I_STATUS,  &rec->mstt);

  /*
  |  Reading the Interrupt Status Register clears the outstanding Software
  |  Interrupt Status bit, but does not clear the pending interrupt.  Thus
  |  reading the register here would confuse the ISR when interrupts are
  |  enabled and the pending software interrupt is taken: the ISR would
  |  not be able to find the source of the interrupt.
  */

  /* Update DB copy of a few status and control registers */
  P2RF_ReadVme (drvPvt, IQA_I_FLTENBSTT, &rec->fest);
  P2RF_ReadVme (drvPvt, IQA_I_TRIGCTRL,  &rec->tctl);
  P2RF_ReadVme (drvPvt, IQA_I_AMPCTL,    &rec->actl);
  P2RF_ReadVme (drvPvt, IQA_I_DDFCTL,    &rec->dctl);
  P2RF_ReadVme (drvPvt, IQA_I_IQCTL,     &rec->iqpc);

  return (status);
}



static long ColdInit (IqaBoard      *brd,
                      P2RfIqaRecord *rec)
/*
   Description
   -----------
   Initialization file to run when starting up from scratch.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("ColdInit");

  register void  *drvPvt = brd->drvPvt;
  unsigned short  chanMask = 0;
  int             chan;
  unsigned short  reg;
  long            status;


  /* Don't allow database access to the interrupt level */
  reg = (P2RF_K_INTLEVEL << IQA_V_INTLEVEL) & IQA_M_INTLEVEL;

  /* Initialize the Interrupt Control Register from the database */
  rec->ictl = ~(reg | ((rec->imsk << IQA_V_INTSELECT) & IQA_INTSELECT(rec->verh)));
  P2RF_WriteVme (drvPvt, IQA_I_INTCTRL, rec->ictl);
  rec->oimk = rec->imsk;

  /* Initialize the Trigger Control Register */
  reg  = (rec->sti  << IQA_V_STPTRGSEL)  & IQA_M_STPTRGSEL;
  reg |= (rec->ssi  << IQA_V_SSITRGSEL)  & IQA_M_SSITRGSEL;
  reg |= (rec->fo   << IQA_V_FLTTRGSEL)  & IQA_M_FLTTRGSEL;
  reg |= (rec->rco  << IQA_V_RCKTRGSEL)  & IQA_M_RCKTRGSEL;
  reg |= IQA_M_STPTRGENB | IQA_M_SSITRGENB |
         IQA_M_FLTTRGENB;
  if (rec->lenb) reg |= IQA_M_RCKTRGENB;
  P2RF_WriteVme (drvPvt, IQA_I_TRIGCTRL, reg);
  rec->tctl = reg;

  /* Initialize the Amplitude Processing registers */
  {
    int    idx = IQA_I_AMPTHR0;
    float *at  = &rec->at0;
    float *oat = &brd->ampThr[0];

    for (idx = IQA_I_AMPTHR0; idx <= IQA_I_AMPTHR7; idx++)
    {
      P2RF_WriteVme (drvPvt, idx,
                     ((unsigned short)(*at * IQA_K_ATCNTPERV) << IQA_V_AMPTHR));
      *oat++ = *at++;
    }
  }
  /* Initialize the database amplitude data fields */
  {
    register int             sig  = 0;
    register float          *ad   = &rec->ad0;

    for (sig = 0; sig < IQA_K_CHANCNT; ad++, sig++)
    {
      *ad = IQA_K_AMPDATA_INIT;
      db_post_events (rec, ad, DBE_VALUE | DBE_LOG);
    }
  }

  if      (rec->ass <= 0)            rec->ass = 1;
  else if (rec->ass > IQA_K_CHANCNT) rec->ass = IQA_K_CHANCNT;

  /* Setup the amplitude control register in the database */
  rec->actl = (((rec->ass - 1) << IQA_V_SIGSEL) & IQA_M_SIGSEL) |
              IQA_M_AMPMEMMOD;
  /* Enable the amplitude dual-port memory and the
   * amplitude scan mode for ver3 of the iqa */
  if (rec->verh >= IQA_K_VER3VERN) {
    rec->actl |= (IQA_M_AMPDPMENB | AMPMODE(rec->ampm) << IQA_V_AMPMODE);
  }

  /* Reset amplitude threshold fault after the amplitued 
   * data register has been setup in A24. 
   * This function write the act register, so make
   * sure that the database field representation 
   * actl has been setup at this point.
   */
  ResetAmpThrFault( brd );
  
  /* Read the DDF data files for all channels */
  {
    IqaDdfPrm      *prm   = brd->ddfPrm;
    char           *file  = rec->dcf0;
    unsigned short *dst   = &rec->dst0;
    unsigned int    iqMsk = 0x0001;

    /* Read and load the DDF files */
    for (chan = 0; chan < IQA_K_CHANCNT; prm++, dst++, chan++)
    {
      *dst = NO_ALARM;

      /* Build the channel mask channels to enable */
      chanMask |= iqMsk;

      /* Null file names disable the I and Q channel */
      if (strlen (file) != 0)
      {
        *dst = UDF_ALARM;

        if ((status = P2RF_ReadDdfFile (drvPvt, file, prm->id, &prm->ddf,
                                        rec->val, sizeof (rec->val))) != OK)
        {
          char  buf[P2RF_K_BUFSIZE];

          recGblRecordError (status, rec,
                             P2RF_Sprintf (buf, __FILE__, FN,
                                           "%s failed - id = %s, file = %s, chan = %d",
                                           "P2RF_ReadDdfFile",
                                           prm->id, chan, file));
          chanMask ^= iqMsk;            /* Take enable down */
        }
        else
        {
          *dst = NO_ALARM;
        }
      }
      else
      {
        *dst = NO_ALARM;
        chanMask ^= iqMsk;              /* Take enable down */
      }

      iqMsk <<= 1;
      file   += sizeof (rec->dcf0);
    }
  }

  /* Enable fast clock */
  P2RF_WriteVme (drvPvt, IQA_I_IQCTL,  IQA_K_FSTCLKENB);

  /* Initialize the DDF control register */
  P2RF_WriteVme (drvPvt, IQA_I_DDFCTL, 0);

  /* Initialize the DDFs */
  DdfInit (drvPvt, chanMask);

  /* Load the DDFs */
  DdfLoad (drvPvt, chanMask, brd->ddfPrm);

  /* Start DDFs */
  DdfStart (drvPvt, chanMask);

  /* Set the I/Q Processing register according to the database */
  reg  = (rec->updt         << IQA_V_UPDRATE)  & IQA_M_UPDRATE;
  reg |= IQA_M_IQMEMMOD;
  if      (rec->ifc <= 0)            rec->ifc = 1;
  else if (rec->ifc > IQA_K_CHANCNT) rec->ifc = IQA_K_CHANCNT;
  reg |= ((rec->ifc - 1)    << IQA_V_IFCHNSEL) & IQA_M_IFCHNSEL;
  reg |= (rec->ifm          << IQA_V_IFMODE)   & IQA_M_IFMODE;
  reg |= (rec->lenb         << IQA_V_LNKENB)   & IQA_M_LNKENB;

  /* Enable IQ dual-port memory for the ver3 of the iqa. */
  if (rec->verh >= IQA_K_VER3VERN) 
    reg |= ( IQA_M_IQDPMENB | IQA_M_IQMEMMOD );

  P2RF_WriteVme (drvPvt, IQA_I_IQCTL, reg);
  rec->iqpc = reg;

  return (OK);
}




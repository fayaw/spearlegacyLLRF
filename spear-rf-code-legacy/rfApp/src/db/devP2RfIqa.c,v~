  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     (rec);
}



static long SpawnLdDdf (P2RfIqaRecord  *rec,
                        unsigned char  *request,
                        IqaDdfBlk      *blk,
                        unsigned short  chanMask,
                        IqaDdfPrm      *prm)
/*
   Description
   -----------
   This function initiates and completes the loading of DDF coefficients
   on the module.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the coefficient block
     chanMask - A mask of DDF channels to load
          prm - A pointer to the coefficient parameter block

   Returns
   -------
   0 for success
*/
{
  /*  Function ("SpawnLdDdf");*/

  char  buf[P2RF_K_BUFSIZE];


  if (!rec->pact)
  {
    sprintf (buf, "Load DDFs: active");

    /* Let operator know what's happening */
    strncpy(rec->val,  buf, sizeof(rec->val));
    strncpy(rec->oval, buf, sizeof(rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);

    /* Inhibit record reprocessing record before DDF-load completes */
    rec->pact = TRUE;

    /* Save the channel and file name in the parameter block */
    prm->chanMask = chanMask;

    /* Point the DDF coefficient block to the proper parameter block */
    blk->prm  = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    /* Update the database copy of the DDF control register */
    P2RF_ReadVme (blk->drvPvt, IQA_I_DDFCTL,  &rec->dctl);
    db_post_events (rec, &rec->dctl, DBE_VALUE | DBE_LOG);

    if (blk->status == 0)
    {
      sprintf (buf, "Load DDFs: done");
      strncpy (rec->val, buf, sizeof (rec->val));
    }

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}



static void LdDdfCallback (IqaDdfBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to read the modules history memory.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the load-coefficients block

   Returns
   -------
   nothing
*/
{
  Function ("LdDdfCallback");

  P2RfIqaRecord    *rec;
  struct rset      *rSet;
  char             *file;
  unsigned short   *dst;
  int               chan;
  IqaDdfPrm        *prm       = blk->prm;
  unsigned short    chanMask  = prm->chanMask;
  unsigned short    resetMask = 0;
  unsigned short    testMask  = 1;
  unsigned long     status    = 0;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback))  == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  file = rec->dcf0;
  dst  = &rec->dst0;

  blk->status = 0;

  for (chan = 0; chan < IQA_K_CHANCNT; prm++, dst++, chan++)
  {
    /* If if file name length went to zero leave IQ channel disabled */
    if (strlen (file) != 0)
    {
      *dst = UDF_ALARM;
      db_post_events (rec, dst, DBE_VALUE | DBE_LOG);

      /* Read and load the DDF coefficients */
      if ((status = P2RF_ReadDdfFile (blk->drvPvt,
                                      file, prm->id, &prm->ddf,
                                      rec->val, sizeof (rec->val))) != OK)
      {
        char  buf[P2RF_K_BUFSIZE];

        chanMask &= ~testMask;
        blk->status = status;
        recGblRecordError (status, rec,
                           P2RF_Sprintf (buf, __FILE__, FN,
                                         "%s failed - id = %s, file = %s, channel = %d",
                                         "P2RF_ReadDdfFile",
                                         prm->id, file, chan));
        *dst      = WRITE_ALARM;
      }
      else
      {
        *dst      = NO_ALARM;
      }
    }
    else
    {
      *dst      = NO_ALARM;

      chanMask  &= ~testMask;
      resetMask |=  testMask;
    }
    db_post_events (rec, dst, DBE_VALUE | DBE_LOG);

    testMask <<= 1;
    file      += sizeof (rec->dcf0);
  }

    /* Reset those DDF channels as requested */
  if (resetMask)
  {
    unsigned short  reg;

    P2RF_ReadVme (blk->drvPvt, IQA_I_DDFCTL, &reg);
    reg &= ~((resetMask << IQA_V_DDFSTRT) | (resetMask << IQA_V_DDFNRST));
#if 0
    reg &= ~(0xff);                /* Kludge for bit 0 being bits 0-7 on SN 1*/
#endif
    P2RF_WriteVme (blk->drvPvt, IQA_I_DDFCTL,  reg);
  }

  /* Initialize the DDF channel */
  DdfInit (blk->drvPvt, chanMask);

  /* Load the DDFs */
  DdfLoad (blk->drvPvt, chanMask, blk->prm);

  /* Start the IQ channel */
  DdfStart (blk->drvPvt, chanMask);

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}




static void GetHistCallback (IqaHistBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to read the module's history memory.
   It invokes completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the get-history block

   Returns
   -------
   nothing
*/
{
  /* Function ("GetHistCallback"); */

  P2RfIqaRecord    *rec;
  struct rset      *rSet;
  IqaMemPrm        *prm = blk->prm;
  unsigned short    reg;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  prm->busy |= IQA_M_HST_BUSY;   /* KHKIM, 04-17-2003 */
  dbScanLock       ((struct dbCommon *) rec);

  /* Disable recording to the history memory */
  if (prm->index == IQA_I_AMPMEM)
  {
    P2RF_ReadVme  (blk->drvPvt, IQA_I_AMPCTL, &reg);
    P2RF_WriteVme (blk->drvPvt, IQA_I_AMPCTL, reg & ~IQA_M_AMPMEMMOD);
  }
  else
  {
    P2RF_ReadVme  (blk->drvPvt, IQA_I_IQCTL,  &reg);
    P2RF_WriteVme (blk->drvPvt, IQA_I_IQCTL,  reg & ~IQA_M_IQMEMMOD);

    /* Allow DDFs to settle - is this really necessary? */
    taskDelay (sysClkRateGet () / 6);
  }


  /* Check up the status of history buffer 
   * We have to wait for stopping of history buffer
   * to take the value in history buffer */
  if(rec->verh >= IQA_K_VER3VERN) {
      unsigned short status_reg;
      unsigned short history_buff_mask = 0x8000;

      while(TRUE){
          if(prm->index == IQA_I_AMPMEM)
              P2RF_ReadVme (blk->drvPvt, IQA_I_AMPCTL, &status_reg);
          else
              P2RF_ReadVme (blk->drvPvt, IQA_I_IQCTL,  &status_reg);

          if( !(status_reg & history_buff_mask) ) break;

          taskDelay(sysClkRateGet());
      }
  }

  /* Read the history memory and record it */
  blk->status = P2RF_RecordMemory (blk->drvPvt, prm->id, prm->index,
                                   prm->count, prm->file, &blk->abortFlg,
                                   rec->val, sizeof (rec->val));

  /* Re-enable the history memory */
  if (prm->index == IQA_I_AMPMEM)
  {
    P2RF_WriteVme (blk->drvPvt, IQA_I_AMPCTL, reg);
  }
  else
  {
    P2RF_WriteVme (blk->drvPvt, IQA_I_IQCTL,  reg);
  }

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
  prm->busy &= ~IQA_M_HST_BUSY;  /* KHKIM, 04-17-2003 */
}


static long ResetAmpThrFault (IqaBoard *brd)
/*
   Description
   -----------
   This function resets the amplitude threshold fault.

   Parameters
   ----------
          brd - A pointer to an IqaBoard structure

   Returns
   -------
   OK    for success
   ERROR for failure
*/
{
  /*Function ("ResetAmpThrFault"); */

    long            status = OK;
    P2RfIqaRecord  *rec    = brd->rec;
    void           *drvPvt = brd->drvPvt;


    /* Acknowledge the interrupt if one has occurred. */
    if ( rec->istt & IQA_M_AMPTHRFLT ) {
      rec->istt &= ~IQA_M_AMPTHRFLT;
      rec->oist &= ~IQA_M_AMPTHRFLT;
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
    }

    /* Clear the fault */
    drvPvt = brd->drvPvt;
    if(rec->verh >=  IQA_K_VER3VERN)
          P2RF_WriteVme (drvPvt, IQA_I_AMPCTL, rec->actl | IQA_M_CLRFAULT);
    else
          P2RF_WriteVme (drvPvt, IQA_I_AMPCTL,
                         (rec->actl | IQA_M_CLRFAULT) & ~IQA_M_AMPMEMMOD);
    taskDelay(1);
    P2RF_WriteVme (drvPvt, IQA_I_AMPCTL, (rec->actl | IQA_M_AMPMEMMOD) & ~IQA_M_CLRFAULT);
    taskDelay(1);
    P2RF_ReadVme  (drvPvt, IQA_I_AMPCTL, &rec->actl);
    db_post_events (rec, &rec->actl, DBE_VALUE | DBE_LOG);
    return( status );
}


static long ReadAmpData(IqaBoard *brd)
/*
   Description
   -----------
   This function reads the Amplitude Data Channel(s),
   converts the raw data to volts and then updates the
   database.

   Parameters
   ----------
          brd          - A pointer to an IqaBoard structure

   Returns
   -------
    0 for success (always returned)
*/
{
#if 0 
    Function ("ReadAmpData");
#endif
    P2RfIqaRecord  *rec = brd->rec;
    unsigned short  rval=0;
    int             offset;


    /* Update the database amplitude data field 
     * Read the Amplitude data and updating the database.
     * The new module (ver. 3) can read with 8ch at once 
     * It loop will do one turn when it's running on the old IQA module */ 
    if (rec->verh >= IQA_K_VER3VERN) 
    {
       /* The new module (ver. 3) can read 8 channels. 
	* Note: the _A_ definitions indicate byte offsets while the _I_ definitions
	* in the p2RfIqaDef.h indicate word offset. In otherwords, if you are using _A_
	* then you increment by two, and if you are using the _I_ offset you increment
	* by one. */
       for(offset=IQA_A_AMPDATA0; offset<=IQA_A_AMPDATA7; offset+=2)
       {
          P2RF_ReadVme(brd->drvPvt, EXT2IDX(offset), (unsigned short *) &rval);

         /* Convert raw data and update the database fields */
          UpdateAmpData(rec, AMPCHAN(rval), AMPDATA(rval));
       }/* End of for loop */
    }
    else {
      /* The IQA module amplitude data for 1 channel only */
       P2RF_ReadVme (brd->drvPvt, IQA_I_AMPDATA, (unsigned short *) &rval);

       /* Convert raw data and update the database fields */
       UpdateAmpData(rec, AMPCHAN(rval), AMPDATA(rval));
    }
    return(OK);
}


static void UpdateAmpData(P2RfIqaRecord  *rec, short chan, short rval) 
/*
   Description
   -----------
   This function converts the raw data to volts and
   then updates the database. 

   Parameters
   ----------
          rec  - A pointer to the record
          rval - Raw amplitude data vaule

   Returns
   -------
    None
*/
{
  /*  Function ("UpdateAmpData"); */

    register float *ad = &rec->ad0;
    register float  delta;
    short           val = 0;  /* two's compliment value */
    
 
    if ( !AMPCHAN_VALID(chan) ) return;

    /* Convert from offset binary to two's complement */
    val = rval - IQA_K_AMPOS;

    /* Convert to floats and flip sign if conversion error made it negative */
    delta = ad[chan] - IQA_K_ADVPERCNT * val;
    if (delta < 0.0)  delta = -delta;
    if (delta > 0.0)
    {
        ad[chan] = IQA_K_ADVPERCNT * val;
        if (delta > rec->amd)  
          db_post_events (rec, &ad[chan], DBE_VALUE | DBE_LOG);
    }
    return;
}


static long ReadIqData(IqaBoard       *brd,
                       unsigned short  ripChanMsk, 
                       unsigned short *dataRdyMsk,
                       unsigned short *dataOflwMsk)
/*
   Description
   -----------
   This function reads the I & Q Output Data Registers and 
   then updates the corresponding database fields if the 
   changes change exceeds a delta value.. 

   Parameters
   ----------
          brd          - A pointer to an IqaBoard structure
          ripChanMsk   - Ripple channel mask
          dataRdyMsk   - A pointer to the Data Ready mask
          dataOflwMsk  - A pointer to the Data overflow fault mask

   Returns
   -------
    0 for success (always returned)
*/
{
#if 0
    Function ("ReadIqData");
#endif
    long              status    = OK;
    P2RfIqaRecord    *rec       = brd->rec;
    short            *idt       = &rec->idt0;
    short            *qdt       = &rec->qdt0;
    int               index     = 0;
    int               iIdx      = IQA_I_I0DATA;
    int               qIdx      = IQA_I_Q0DATA;
    int               chan      = IQA_K_CHANCNT;
    unsigned short    chanMask  = 0;
    unsigned short    testMask  = 0x0003;
    unsigned short    oflwMask  = 0x0000;
    short             iLast;
    short             qLast;
    short             i[IQA_K_CHANCNT];
    short             q[IQA_K_CHANCNT];
    unsigned short    iqInvalidValue = IQA_K_IQINVALIDVAL;


    if (rec->verh >= IQA_K_VER3VERN){

       /* Read the I/Q Data overflow fault register.
	* NOTE: this register must be read prior to reading
	* the I/Q data from dual port memory because the
	* dpr read-access clears the overflow bits for that
	* channel in the I/Q Data Overflow fault register. */
       P2RF_ReadVme (brd->drvPvt, IQA_I_DATAOFLW, &oflwMask);

       /* Read all I/Q data channels from dual port memory. 
	* Note: the index for I and Q are word offset's and not
	* byte offsets into A24 space. */
       for(index=0;index < IQA_K_CHANCNT; index++,iIdx+=2,qIdx+=2){
            P2RF_ReadVme (brd->drvPvt, iIdx, (unsigned short *) &i[index]);
            P2RF_ReadVme (brd->drvPvt, qIdx, (unsigned short *) &q[index]);
       } /* End of for loop */

       /* Read the I/Q Data not updated fault register.
	* NOTE: this register must be read after ALL fifo
	* locations the I/Q data from dual port memory has been
	* read because that is what clocks the individual bits
	* in the Data not updated fault register. */
       P2RF_ReadVme (brd->drvPvt, IQA_I_DATANOUPD, &chanMask);

       /* Check the I/Q data for new data and update the database. */
       for (index=0; 
            index < IQA_K_CHANCNT;
            index++,testMask<<=2,idt+=2,qdt+=2) {
           if (testMask & chanMask) continue;

	   if ((unsigned short) i[index] == iqInvalidValue ) continue;
	   if ((unsigned short) q[index] == iqInvalidValue ) continue;

	   DbPostIqData(rec,idt,qdt,i,q,index);

       } /* End of for loop */

       *dataRdyMsk   |= ~chanMask;
       *dataOflwMsk  |= oflwMask;

       return( status );
    } /* End of vers 3 or later */

    /* Old iqa modules earier than version 3 */

    /* Check which channels have data ready on them */
     P2RF_ReadVme (brd->drvPvt, IQA_I_DATARDY, &chanMask);
    if ( !chanMask ) return(status);


    while (chan--)
    {
       /* Do only those channels which claim to have data ready */
      if (chanMask & testMask)
      {
         int     cnt = 10;

         /* Prime by reading I & Q, once */
         P2RF_ReadVme (brd->drvPvt, iIdx, (unsigned short *) &i[0]);
         P2RF_ReadVme (brd->drvPvt, qIdx, (unsigned short *) &q[0]);                        

         /* Loop until 2 consecutive reads of I & Q give answer within delta */
         while (cnt--)
         {
            register short    iEqDelta;
            register short    qEqDelta;

            iLast = i[0];
            qLast = q[0];

            /* Read I  & Q data as a pair. If you don't do this then this incrementing
	     * register will get out of sync. */
            P2RF_ReadVme (brd->drvPvt, iIdx, (unsigned short *) &i[0]); 
            P2RF_ReadVme (brd->drvPvt, qIdx, (unsigned short *) &q[0]);
            
            /* Read Data Ready register */
            P2RF_ReadVme (brd->drvPvt, IQA_I_DATARDY,  &chanMask); 

	    /* Read I Data Overflow register */
            P2RF_ReadVme (brd->drvPvt, IQA_I_DATAOFLW, &oflwMask);
	     
            /* Calculate I & Q equivalence delta */
            iEqDelta = i[0] - iLast;
            qEqDelta = q[0] - qLast;

            /* Force deltas to be positive */
            if (iEqDelta < 0)  iEqDelta = -iEqDelta;
            if (qEqDelta < 0)  qEqDelta = -qEqDelta;

            /* Make sure I & Q get updated together, unless it's ripple chan */
            if ((testMask & ripChanMsk) ||
                ((iEqDelta <= rec->iqed) && (qEqDelta <= rec->iqed)))
            {
	      DbPostIqData(rec,idt,qdt,i,q,0);

              /* Build data-ready and data-overflow masks */
              *dataRdyMsk  |= testMask;
              *dataOflwMsk |= oflwMask & testMask;
              break;
            }
         }/* End of while (cnt) */

         /* Move on to the next channel */
         testMask <<= 2;
         iIdx += 2;
         qIdx += 2;
         idt  += 2;
         qdt  += 2;
      }
    }/* End of while (chan) */

    return( status );
}


static long UpdateFirstFaultStatus(IqaBoard    *brd)
/*
    Description
    -----------
    This function updates a first fault status field (FFLT).
    The FFLT is a new register for Hardware version 3 or later.
    If this routine is working in earlier version of HW,
    the latched amplitude threshold fault will be posted on FFLT.

    Parameters
    ----------
	  brd            - A pointer to an IqaBoard structure

    Returns
    -------
      0 for success (always returned)
*/


{
  /*  Function("UpdateFistFaultStatus"); */
      long                status = OK;
      p2RfIqaRecord       *rec   = brd->rec;
      unsigned short      firstFaultMask = 0xe3ff;
      unsigned short      firstFaultStat;
      unsigned short      ampThrFlt2firstFaultMsk = 0x00ff;
       

       /* IQA hardware version eariler then 3 doesn't have FFLT register.
	* So, this functin reads latched amplitude threshold fault register and
	* this value will be posted on FFLT.
	* The latched ampThr is using higher bits in ampThr register.
	* So, we have to shift it to lower bits.
        */
       if (rec->verh < IQA_K_VER3VERN) {
          firstFaultStat = brd->ampThrFltMsk >> IQA_V_LATFAULT;
          firstFaultStat &= ampThrFlt2firstFaultMsk;
       }
       else {
          P2RF_ReadVme (brd->drvPvt, IQA_I_FIRSTFLTSTAT, &firstFaultStat);
          firstFaultStat &= firstFaultMask;
       }
     
       if(rec->fflt != firstFaultStat){
           rec->fflt = firstFaultStat;
           db_post_events(rec,&rec->fflt, DBE_VALUE|DBE_LOG);
       }

       return (status);
}


static long DbPostIqData(P2RfIqaRecord     *rec,
			 short *idt, short *qdt,
			 short *i,   short *q,
			 int   index)

/* 
    Description
    -----------
    This function posts new I & Q values to epics db when its differences 
    from previous values are larger than monitoring dead band.

    Parameters
    ----------
	    rec           - A pointer to an Iqa record
	    idt           - A pointer to an I data field in record
	    qdt           - A pointer to a Q data field in record
	    i             - A pointer to an array for I reading value
	    q             - A pointer to an array for Q reading value
	    index         - An index to scribe interasting data position

    Returns
    -------
      0 for success (always returned)
*/
{
  /*    Function("DbPostIqData"); */
    long  status = OK;
    short iMonDelta;
    short qMonDelta;

    iMonDelta = *idt - i[index];
    qMonDelta = *qdt - q[index];
    *idt = i[index];
    *qdt = q[index];

    if(iMonDelta<0) iMonDelta = -iMonDelta;
    if(qMonDelta<0) qMonDelta = -qMonDelta;
    if(iMonDelta > rec->iqmd)
        db_post_events (rec, idt, DBE_VALUE | DBE_LOG);
    if(qMonDelta > rec->iqmd)
        db_post_events (rec, qdt, DBE_VALUE | DBE_LOG);

    return (status);
}



static long UpdateActlIqpc(IqaBoard *brd)
{
    long           status = OK;
    p2RfIqaRecord  *rec   = brd->rec;
    unsigned short actl;
    unsigned short iqpc;

    P2RF_ReadVme(brd->drvPvt, IQA_I_AMPCTL, &actl);
    P2RF_ReadVme(brd->drvPvt, IQA_I_IQCTL, &iqpc);

    if(actl != rec->actl) {
        rec->actl = actl;
        db_post_events(rec,&rec->actl, DBE_VALUE | DBE_LOG);
    }
    if(iqpc != rec->iqpc){
        rec->iqpc = iqpc;
        db_post_events(rec,&rec->iqpc, DBE_VALUE | DBE_LOG);
    }

    return status;
}

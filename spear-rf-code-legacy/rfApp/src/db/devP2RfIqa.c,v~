static void IqaIsr (void           *brdArg,
                    unsigned short  intStat)
/*
   Description
   -----------
   Device specific routine to handle interrupts generated by the module.
   It runs in the context of the Interrupt Service Routine.  Thus all
   the rules for coding at IPL apply.

   In this case, alarms are set depending on the interrupt type.

   Parameters
   ----------
       brdArg - A pointer to the device private structure
      intStat - The interrupt status mask

   Returns
   -------
   nothing
*/
{
#if DBG
  Function ("IqaIsr");
#endif

  IqaBoard       *brd    = (IqaBoard *) brdArg;
  P2RfIqaRecord  *rec    = brd->rec;


#if DBG
  if (intStat & IQA_M_INV20MHZ)
    logMsg("%s: Invalid 20 MHz clock\n", (int)FN,0,0,0,0,0);
  if (intStat & IQA_M_INV10MHZ)
    logMsg ("%s: Invalid 10 MHz clock\n", (int)FN,0,0,0,0,0);
  if (intStat & IQA_M_INVADX)
    logMsg ("%s: Invalid address or access\n", (int)FN,0,0,0,0,0);
  if (intStat & IQA_M_SOFTWARE)
    logMsg ("%s: Software interrupt\n", (int)FN,0,0,0,0,0);
#endif

  /* Only reflect a predefined a subset of the possible interrupts
   * in the database. 
   */
   
  intStat &= ~IQA_INTSTAT(rec->verh); 

  /* If AMPTHRFL or any other change do record processing */
  if ( /* (intStat & IQA_M_AMPTHRFLT) ||*/ (intStat & (intStat ^ rec->istt)) )
  {
    rec->istt |= intStat;

    /* Process forward links */
    brd->intPrc++;
    scanOnce (rec);
  }
}



static void IqaScanTask (IqaBoard  *brd)
/*
   Description
   -----------
   This function is run by the tIqaScan task.  Its purpose is to read the I,
   Q and A data from an IQA module and put a consistent set of data into the
   database.  The reason that this is not done in the Interrupt Service
   Routine is that the minimum rate of interrupts proclaiming I & Q data
   ready is about 50 Hz.  This is much faster than any software client of
   this data will ever need.  EPICS advertises a maximum data update rate
   (one field of one record) of about 10 Hz.  With multiple IQA modules in
   the system and eight channels of I and Q, this value is exceeded.  Thus
   we poll the data as requested by clients of the data.

   To allow clients to get reliable data, two semaphores are stored in the
   record.  When a client wants data, it "gives" the scan semaphore and
   then waits on the data-ready semaphore.  Multiple clients can do this.
   The data-ready semaphore is given when all IQA data has been collected.

   Each I and Q channel is read at least twice.  The reason for this is
   to ensure that the I and Q that ends up in the database actually belong
   together.  Thus the requirement is that two consecutive reads of I and
   Q each must return the same data.  There is a check so that if this isn't
   achievable for a channel that is updating too quickly, it is skipped.

   Parameters
   ----------
          brd - A pointer to an IqaBoard structure

   Returns
   -------
   Doesn't
*/
{
  /* Function ("IqaScanTask"); */

  P2RfIqaRecord  *rec = brd->rec;
  SEM_ID          scanSem;
  SEM_ID          dRdySem;
  unsigned short  dataRdyMsk;
  unsigned short  dataOflwMsk;
  unsigned short  ripChanMsk;
  unsigned long   tickNow;

  /* Check if we have semaphores and hang if we don't get 'em */
  scanSem = (SEM_ID)rec->ssem;
  dRdySem = (SEM_ID)rec->rsem;
  if ((scanSem == NULL) || (dRdySem == NULL))
  {
    taskSuspend (0);
  }

  /* Build the ripple channel mask - this should be found from hdw iqpc reg? */
  ripChanMsk = rec->lenb ? 1 << IQA_K_RIPCHAN : 0;

  /* Loop forever */
  while (TRUE)
  {
    /* Clear the data ready and data overflow masks */
    dataRdyMsk  = 0;
    dataOflwMsk = 0;

    /* Wait for a client's request for data */
    semTake (scanSem, WAIT_FOREVER);

    /* to avoid Queued SCAN processing */  
    /* Sometimes, the queued scan process which are caused by file dumping in other module
       can make DDF not ready */
    /* 07-15-2003, KHKIM */
    /* 
    tickNow = tickGet();
    if((float)(tickNow - brd->tickLastScan)/(float)sysClkRateGet() < .1 ) {
         brd->tickLastScan = tickNow;
         semGive(dRdySem);
         continue;
    }
    brd->tickLastScan = tickNow;
    */ 
 
    if(brd->ampHistPrm.busy || brd->iqHistPrm.busy ) { 
         if(brd->ampHistPrm.busy & IQA_M_HST_TRYNEXT) brd->ampHistPrm.busy &= ~IQA_M_HST_TRYNEXT;
         else                                         brd->ampHistPrm.busy |= IQA_M_HST_TRYNEXT;
         if(brd->iqHistPrm.busy & IQA_M_HST_TRYNEXT)  brd->iqHistPrm.busy &= ~IQA_M_HST_TRYNEXT;
         else                                         brd->iqHistPrm.busy |= IQA_M_HST_TRYNEXT;
         semGive(dRdySem); 
         continue; 
    } /* KHKIM, 04-17-2003 */

    /* Read the I/Q Data from dual port memory and update database */
     ReadIqData(brd,ripChanMsk,&dataRdyMsk,&dataOflwMsk);
  
    /* Let clients know which data we found */
    if (rec->niqr != dataRdyMsk)
    {
      rec->niqr = dataRdyMsk;
      db_post_events (rec, &rec->niqr, DBE_VALUE | DBE_LOG);
    }

    /* Let clients know which data we found overflowed */
    if (rec->iqof != dataOflwMsk)
    {
      rec->iqof = dataOflwMsk;
      db_post_events (rec, &rec->iqof, DBE_VALUE | DBE_LOG);
    }
     
    /* Read the amplitude data,convert to volts and update the database */ 
    ReadAmpData(brd); 

    /* To monitor change of ACTL and IQPC caused by backplane fault and to update it */
    UpdateActlIqpc(brd);

    /* Let clients know we have data ready for them */
    semGive (dRdySem);
  }
}




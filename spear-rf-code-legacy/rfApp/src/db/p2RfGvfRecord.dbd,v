recordtype(p2RfGvf) {
	include "dbCommon.dbd"
	field(VAL,DBF_STRING) {
		prompt("Status message")
		asl(ASL0)
		pp(TRUE)
		size(40)
	}
	field(OVAL,DBF_STRING) {
		prompt("Previous Value")
		special(SPC_NOMOD)
		interest(3)
		size(40)
	}
	field(OUT,DBF_OUTLINK) {
		prompt("Output Specification")
		promptgroup(GUI_OUTPUT)
		special(SPC_NOMOD)
		interest(1)
	}
	field(PREC,DBF_SHORT) {
		prompt("Display Precision")
		promptgroup(GUI_DISPLAY)
		interest(1)
	}
	field(MID,DBF_USHORT) {
		prompt("Manufacturer ID")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MTYP,DBF_USHORT) {
		prompt("Model Type")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MSTT,DBF_USHORT) {
		prompt("Module Status")
		special(SPC_NOMOD)
	}
	field(MCTL,DBF_USHORT) {
		prompt("Module Control")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(MRST,DBF_SHORT) {
		prompt("Module Reset")
		pp(TRUE)
		interest(2)
	}
	field(A24O,DBF_USHORT) {
		prompt("A24 Offset")
		special(SPC_NOMOD)
		interest(3)
	}
	field(VATT,DBF_USHORT) {
		prompt("VXI Attributes")
		special(SPC_NOMOD)
		interest(3)
	}
	field(SERN,DBF_ULONG) {
		prompt("Serial Number")
		special(SPC_NOMOD)
		interest(3)
	}
	field(VERN,DBF_USHORT) {
		prompt("Version Number")
		special(SPC_NOMOD)
		interest(3)
	}
#
#  Hardware version and Firmware versiona
#
        field(VERH,DBF_USHORT) {
                prompt("Hardware Version")
                special(SPC_NOMOD)
                interest(3)
        }
        field(VERF,DBF_USHORT) {
                prompt("Firmware Version")
                special(SPC_NOMOD)
                interest(3)
        }
#
#  end of modification
#
	field(ISTT,DBF_USHORT) {
		prompt("Interrupt Status")
		special(SPC_NOMOD)
		pp(TRUE)
		interest(2)
	}
	field(OIST,DBF_USHORT) {
		prompt("Old Interrupt Status")
		interest(3)
	}
	field(IACK,DBF_USHORT) {
		prompt("Interrupt Oper Ack")
		pp(TRUE)
		interest(2)
	}
	field(ICTL,DBF_USHORT) {
		prompt("Interrupt Control")
		special(SPC_NOMOD)
		pp(TRUE)
		interest(2)
	}
	field(IMSK,DBF_UCHAR) {
		prompt("Interrupt Mask")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		base(HEX)
		interest(1)
	}
	field(OIMK,DBF_UCHAR) {
		prompt("Old Interrupt Mask")
		interest(3)
	}
	field(VSCL,DBF_USHORT) {
		prompt("VXI Subclass")
		special(SPC_NOMOD)
		interest(3)
	}
#
	field(GCTL,DBF_USHORT) {
		prompt("Gap Control")
		special(SPC_NOMOD)
	}
	field(GST0,DBF_USHORT) {
		prompt("1st Gap Status Word")
		special(SPC_NOMOD)
		interest(1)
	}
	field(OST0,DBF_USHORT) {
		prompt("Old 1st Gap Status Word")
		interest(3)
	}
	field(GST1,DBF_USHORT) {
		prompt("2nd Gap Status Word")
		special(SPC_NOMOD)
		interest(1)
	}
	field(OST1,DBF_USHORT) {
		prompt("Last 2nd Gap Status Word")
		interest(3)
	}
	field(MTL,DBF_UCHAR) {
		prompt("Memory Trigger Sel")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(OTL,DBF_UCHAR) {
		prompt("Output Trigger Sel")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(DA,DBF_UCHAR) {
		prompt("Pre-DAC Data Alignmt")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(1)
	}
	field(EBS,DBF_UCHAR) {
		prompt("Eq Bank Select")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(1)
	}
	field(TF,DBF_UCHAR) {
		prompt("Xfer Fn")
		promptgroup(GUI_COMMON)
	}
	field(LFBL,DBF_UCHAR) {
		prompt("LFB Loop")
		promptgroup(GUI_COMMON)
	}
	field(GFFL,DBF_UCHAR) {
		prompt("GFF Loop")
		promptgroup(GUI_COMMON)
	}
	field(MODE,DBF_UCHAR) {
		prompt("Module Mode")
		promptgroup(GUI_COMMON)
		asl(ASL0)
		pp(TRUE)
	}
#
	field(LDSP,DBF_UCHAR) {
		prompt("Load DSP Exec File")
		pp(TRUE)
		interest(2)
	}
	field(DSPE,DBF_STRING) {
		prompt("DSP Exec File")
		promptgroup(GUI_COMMON)
		size(40)
	}
	field(DSTT,DBF_MENU) {
		prompt("DSP Exec Alarm Status")
		special(SPC_NOMOD)
		menu(menuAlarmStat)
		initial("17")
	}
	field(UDSP,DBF_UCHAR) {
		prompt("Update DSP Table")
		pp(TRUE)
		interest(2)
	}
	field(DSPT,DBF_STRING) {
		prompt("DSP Table File")
		promptgroup(GUI_COMMON)
		size(40)
	}
	field(DTST,DBF_MENU) {
		prompt("DSP Table Alarm Status")
		special(SPC_NOMOD)
		menu(menuAlarmStat)
		initial("17")
	}
	field(PDSP,DBF_UCHAR) {
		prompt("Ping DSP")
		pp(TRUE)
		interest(2)
	}
#
	field(LREF,DBF_UCHAR) {
		prompt("Load References")
		pp(TRUE)
		interest(2)
	}
#
#	field(AREF,DBF_FLOAT) {
#		prompt("Gap Algor Ampl Ref")
#		promptgroup(GUI_COMMON)
#	}
#	field(PREF,DBF_FLOAT) {
#		prompt("Gap Algor Phase Ref")

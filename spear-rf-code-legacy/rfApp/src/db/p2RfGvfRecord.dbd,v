#	}
#
	field(AVPH,DBF_FLOAT) {
		prompt("Gap Algor Ave Phase")
		special(SPC_NOMOD)
	}
#
	field(AMP,DBF_FLOAT) {
		prompt("Sin/Cos Amplitude")
		promptgroup(GUI_COMMON)
		initial("32752")
	}
	field(PHS,DBF_FLOAT) {
		prompt("Sin/Cos Phase Range")
		promptgroup(GUI_COMMON)
	}
	field(PHSM,DBF_FLOAT) {
		prompt("Sin/Cos Phase Range Max")
		promptgroup(GUI_COMMON)
	}
	field(PHSO,DBF_FLOAT) {
		prompt("Sin/Cos Phase Offset")
		promptgroup(GUI_COMMON)
	}
	field(LLUT,DBF_UCHAR) {
		prompt("Reload LUTs")
		pp(TRUE)
		interest(2)
	}
#
	field(ECTL,DBF_USHORT) {
		prompt("Equalizer Control")
		special(SPC_NOMOD)
		interest(3)
	}
	field(LE0C,DBF_UCHAR) {
		prompt("Load Eq 0 Coefs")
		pp(TRUE)
		interest(2)
	}
	field(E0CF,DBF_STRING) {
		prompt("Eq 0 Coefs File")
		promptgroup(GUI_COMMON)
		size(40)
	}
	field(E0AS,DBF_MENU) {
		prompt("Eq 0 Alarm Status")
		special(SPC_NOMOD)
		menu(menuAlarmStat)
		initial("17")
	}
	field(LE1C,DBF_UCHAR) {
		prompt("Load Eq 1 Coefs")
		pp(TRUE)
		interest(2)
	}
	field(E1CF,DBF_STRING) {
		prompt("Eq 1 Coefs File")
		promptgroup(GUI_COMMON)
		size(40)
	}
	field(E1AS,DBF_MENU) {
		prompt("Eq 1 Alarm Status")
		special(SPC_NOMOD)
		menu(menuAlarmStat)
		initial("17")
	}
#
	field(FO,DBF_FLOAT) {
		prompt("FIFO Offset")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
	field(OFO,DBF_FLOAT) {
		prompt("Old FIFO Offset")
		special(SPC_NOMOD)
		interest(3)
	}
	field(FD,DBF_SHORT) {
		prompt("FIFO Data")
		promptgroup(GUI_COMMON)
		interest(3)
	}
#
	field(GRB,DBF_UCHAR) {
		prompt("Get Record Buffer")
		pp(TRUE)
		interest(2)
	}
	field(RSIZ,DBF_ULONG) {
		prompt("Record Buffer Size")
		promptgroup(GUI_COMMON)
		initial("512")
	}
	field(RFIL,DBF_STRING) {
		prompt("Record File")
		promptgroup(GUI_COMMON)
		size(40)
	}
	field(RSTT,DBF_MENU) {
		prompt("Record Alarm Status")
		special(SPC_NOMOD)
		menu(menuAlarmStat)
	}
#
	field(LPB,DBF_UCHAR) {
		prompt("Load Play Buffer")
		pp(TRUE)
		interest(2)
	}
	field(PFIL,DBF_STRING) {
		prompt("Play File")
		promptgroup(GUI_COMMON)
		size(40)
	}
	field(PSTT,DBF_MENU) {
		prompt("Play Alarm Status")
		special(SPC_NOMOD)
		menu(menuAlarmStat)
	}
	field(IREF,DBF_SHORT) {
		prompt("Gap Algor I Ref")
		promptgroup(GUI_COMMON)
	}
	field(QREF,DBF_SHORT) {
		prompt("Gap Algor Q Ref")
		promptgroup(GUI_COMMON)
	}
	field(TMCK,DBF_UCHAR) {
		prompt("Timed register check")
		pp(TRUE)
		interest(2)
	}
}

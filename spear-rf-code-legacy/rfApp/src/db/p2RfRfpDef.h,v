 * or cleared based on the value of bit2 of fsmx.
 */
#define FBSIGMUXA2(rec)      (((rec)->mstt & RFP_M_FBSIGMUX2) >> 6)
#define FBSIGMUX(rec)        (((rec)->rstt & RFP_M_FBSIGMUX) >> RFP_V_FBSIGMUX)

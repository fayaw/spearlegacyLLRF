 *                        is empty for niCpu030 and this function is only
 *                        temporary until Kinetic Systems fixes their 
 *                        interrupt handler
 * .04 19-Dec-2003      Kristi Luchini (LUCHINI)
 *                        enable D16 IACK cycle for V152 with new register.
 */


#include <vxWorks.h>
#include <stdlib.h>              /* getenv()   */
#include <string.h>              /* strtol()   */
#include <stdio.h>               /* printf()   */
#include <logLib.h>              /* logMsg ()  */
#include <taskLib.h>             /* taskDelay ()       */

#include <drvP2RfVxi.h>          /* P2RF_IntEnable()   */
#include <initHooks.h>
#include <save_restore.h>        /* restoreFile()      */


/* Prototypes */
long p2RfInitClk( long slot );
int reset_kscIsr(void);          /* reset Kinetic Systems isr */
#if CPU_FAMILY == PPC
#define HAS_IACK_CTRL_REG 0x5300
int v152_wt_iack_ctrl(unsigned short data);
int v152_rd_iack_ctrl(unsigned short *data);
#endif

/*
 * INITHOOKS
 *
 * called by iocInit at various points during initialization
 *
 */

/* If this function (initHooks) is loaded, iocInit calls this function
 * at certain defined points during IOC initialization */
void initHooks(callNumber)
initHookState	callNumber;
{
       long      status;
       char     *clkmacro_ps;         /* Pointer to clock macro definition */
       char     *slot_ps;             /* Pointer to slot definition in CLKMACROS */
       long      slot = 0;            /* Clock slot. Make default illegal */
       unsigned short data;

	switch (callNumber) {
	case INITHOOKatBeginning :
#ifdef DBG
            printf ("INITHOOKatBeginning\n");
#endif
     	    /*
	    ** Get slot of clock module. 
	    ** Don't do this logic if CLKMACROS is not defined (not defined
            ** for our test IOC).
	    */
            clkmacro_ps = getenv ("CLKMACROS");
            if ( !clkmacro_ps )  break;
   
            slot_ps = strstr (clkmacro_ps, "S=");
            if (slot_ps != NULL) {
              slot_ps += 2;    /* Clock slot value */
              slot = strtol(slot_ps, NULL, 10);
            }
            if ((slot == 0) || (slot > 12))
	    {
              logMsg("!!CLKMACROS not defined or invalid macro syntax!!\n",0,0,0,0,0,0);
              status = 99;  
            }
            else {
               /* Initialize the clock module */
               status = p2RfInitClk( slot );
               if ( status!=OK ) 
                  logMsg("Failed to Initialize Clock Module in slot %hd\n",(int)slot,0,0,0,0,0);
               else
                  logMsg("Successfully Initialzied Clock Module in slot %hd\n",(int)slot,0,0,0,0,0); 
	    }
	    break;

	case INITHOOKafterGetResources :
#ifdef DBG
            printf ("INITHOOKafterGetResources\n");
#endif
	    break;
	case INITHOOKafterLogInit :
#ifdef DBG
            printf ("INITHOOKafterLogInit\n");
#endif
	    break;
	case INITHOOKafterCallbackInit :
#ifdef DBG
            printf ("INITHOOKafterCallbackInit\n");
#endif
	    break;
	case INITHOOKafterCaLinkInit :
#ifdef DBG
            printf ("INITHOOKafterCaLinkInit\n");
#endif
	    break;
	case INITHOOKafterInitDrvSup :
#ifdef DBG
            printf ("INITHOOKafterInitDrvSup\n");
#endif
	    break;
	case INITHOOKafterInitRecSup :
#ifdef DBG
            printf ("INITHOOKafterInitRecSup\n");
#endif
	    break;
	case INITHOOKafterInitDevSup :
#ifdef DBG
            printf ("INITHOOKafterInitDevSup\n");
#endif
	    break;
	case INITHOOKafterTS_init :
            /*
            **  Restore data before init_record (this is either data 
            **  used by init_record or data that will not be 
            **  overwritten by init_record).
            **/
	    restoreFile( "RESTORE_AB" );
	    restoreFile( "RESTORE_VXI" );
#ifdef DBG
            printf ("INITHOOKafterTS_init\n");
#endif
	    break;
	case INITHOOKafterInitDatabase :
	    /*
            **  Restore data that was overwritten by init_record
            **  (ie, inputs to calc and subroutine records).
            */
	    restoreFile( "RESTORE_INP" );

#ifdef DBG
            printf ("INITHOOKafterInitDatabase\n");
#endif
	    break;
	case INITHOOKafterFinishDevSup :
#ifdef DBG
            printf ("INITHOOKafterFinishDevSup\n");
#endif
	    break;
	case INITHOOKafterScanInit :
#ifdef DBG
            printf ("INITHOOKafterScanInit\n");
#endif
	    break;
	case INITHOOKafterInterruptAccept :
#ifdef DBG
            printf ("INITHOOKafterInterruptAccept\n");
#endif
 
           /* Set a D16 interrupt acknowledge for the desired interrupt level 
            * in the interrupt acklowledge regsiter of the V152 cpu
            */
#if CPU_FAMILY == PPC
	    reset_kscIsr();   /* This does nothing for the niCpu030 */
 	    status = v152_rd_iack_ctrl( &data );
            if (status==OK) {
	      if ((data & 0xff00)==HAS_IACK_CTRL_REG) {
                data |= (1 << P2RF_K_INTLEVEL) | 0x1;  
                status = v152_wt_iack_ctrl( data );
	      }
            }
#endif
      	    P2RF_IntEnable ();
            
            /* Wait a couple of seconds before the CA server starts.
             * Gives time for all PVs to go to good status.
             */
            taskDelay(sysClkRateGet()*2);
	    break;
	case INITHOOKafterInitialProcess :
#ifdef DBG
            printf ("INITHOOKafterInitialProcess\n");
#endif
	    break;
	case INITHOOKatEnd :
#ifdef DBG
            printf ("INITHOOKatEnd\n");
#endif
	    break;
	default:
	    break;
	}
	return;
}

@



/*----------------------------------------------------------------
 * common code (was just the old version)
 *----------------------------------------------------------------
 */
Status P2RF_RecordMemory_common (void           *hndl,
				 char           *id,
				 int             index,
				 int             count,
				 char           *file,
				 int            *abortFlg,
				 char           *msgBuf,
				 int             msgBufLen,
				 int             doPreRead)	/* 0=no, !0=yes */
/*
   Description
   -----------
   Function to record data from a module's memory to a binary file.

   Since file operations are buffered, some errors can't be detected until
   several file operations have taken place.  This can result in misleading
   status messages being reported.  Additionally, it has been observed that
   some (e.g., fclose) file functions output messages (presumably messages
   reported by the host) themselves and are thus not capturable for reporting
   to the caller.

   The scheme employed below involves double buffering to minimize the overhead
   incurred by calling fwrite.  Experimentation revealed that with buffers
   larger than 16 shorts didn't significantly improve the average file
   access rate.

   Since the module owns the addressing of the memory, multiple clients
   should not be allowed to go after the memory at the same time.  The
   module can't know which client is requesting what.  For this reason
   all access routines must recognize when the memory is in use by another
   client.  This mutual exclusion is handled via a semaphore.  Thus, this
   routine will block execution whilst another client "owns" the memory
   by calling this or one of the other memory access routines.  (Perhaps
   we should add a timeout for this at some point?)

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
           id - An identification string to put at the top of the file
        index - The VME address index at which the memory resides
        count - The number of words of memory to record
         file - The file to record the data in
     abortFlg - A pointer to an abort flag
       msgBuf - A pointer to a buffer in which to return formated status msgs
    msgBufLen - The maximum allowed space status messages may take up

   Returns
   -------
   ERROR if an error condition was encountered, OK otherwise
*/
{
  Function ("P2RF_RecordMemory_common");

  Status                   status = OK;
  char                    *msg    = "Success";
  P2RfPvt                 *p2Rf   = hndl;
  FILE                    *fp;


  /* If there are multiple clients, lock out other RAM access attempts */
  if (p2Rf->sharedCnt)  semTake (p2Rf->shrSem, WAIT_FOREVER);/* Needs Timeout */

  /* Check that the file was opened.  May have failed even with non-null fp! */
  if ((fp = fopen (file, "wb")) == 0)
  {
    msg = "Can't open file for writing";
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    goto OpenErr;
  }

  /* Write the ID string to the file */
  if (fwrite (id, strlen (id), 1, fp) == 1)
  {
    unsigned short    dblBuf[DBLBUFSZ];	/* what's DBL about it... */

    register vxi16_t        *ext = &p2Rf->ext[index];
    register int             cnt = P2RF_K_BLKSIZE * count / DBLBUFSZ;
    register unsigned short *dbp = dblBuf;

    if (doPreRead) *dbp = *ext;               /* 1 read to get hdw ptr to last val */

    /* Read the memory and write it to the file */
    while (cnt-- && (*abortFlg == FALSE))
    {
      dbp = dblBuf;
      while (dbp < &dblBuf[DBLBUFSZ])  *dbp++ = *ext;
      if (fwrite (dblBuf, sizeof (*dblBuf), DBLBUFSZ, fp) < 1)  goto ErrorOut;
    }
  }
  else
  {
ErrorOut:
    msg    = "File write failed";
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    status = ERROR;
  }

  /* Close the file.  Will fail if fopen didn't really open the file */
  if (fclose (fp) == EOF)    msg = "File close failed";

OpenErr:
  /* Save status message in caller's buffer */
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);

  /* If there are multiple clients free the next one */
  if (p2Rf->sharedCnt)  semGive (p2Rf->shrSem);

  return (status);
}




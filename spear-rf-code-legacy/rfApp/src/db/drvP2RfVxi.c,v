Status P2RF_ReadConstsFile (void            *hndl,
                            char            *id,
                            char            *file,
                            register int     count,
                            register short  *consts,
                            char            *msgBuf,
                            int              msgBufLen,
                            int              q14)

/*
   Description
   -----------
   Function for loading integer constants from a file into memory.

  Since file operations are buffered, some errors can't be detected until
  several file operations have taken place.  This can result in misleading
  status messages being reported.  Additionally, it has been observed that some
  (e.g., fclose) file functions output messages (presumably messages reported
  by the host) themselves and are thus not capturable for reporting to the
  caller.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
           id - The ID that the file must contain
         file - The constants file to read
        count - The number of constants expected in the file
        consts - The constants array to fill
       msgBuf - A pointer to a buffer in which to return formated status msgs
    msgBufLen - The maximum allowed space status messages may take up
        q14   - If true, read as float and convert to Q14 for Rfp DSP.
                If false, read as hex.

   Returns
   -------
   ERROR if an error condition was encountered, OK otherwise */
{
  Function ("P2RF_ReadConstsFile");

  P2RfPvt        *p2Rf   = hndl;
  register FILE  *fp     = fopen (file, "r");
  long            status = OK;
  char            msg[P2RF_K_BUFSIZE];
  char            buf[P2RF_K_BUFSIZE];
  float           afloat[4];
  char            line[132];       /* A line to read */
  int             i;

  strcpy (msg,"Success");
  /* Check that the file was opened */
  if (fp == 0)
  {
    strcpy (msg,"Can't open const file");
    P2RF_Printf (__FILE__, FN, "%s: %s %s", p2Rf->model.name, msg, file);
    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
    return (ERROR);
  }

  /* Check that the ID string matches the expected value */
  if (fgets (buf, sizeof (buf), fp) != NULL)
  {
    if (strstr (buf, id) == NULL)
    {
      strcpy (msg,"File ID string mismatch");
      P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                   p2Rf->model.name, msg, file);
      P2RF_Printf (__FILE__, FN, "Expected ID      |%s|", id);
      P2RF_Printf (__FILE__, FN, "not contained in |%s|", buf);
      status = ERROR;
    }
    else
    {
      /* Load constants from file. Read as float and convert or as hex */
      while (count > 0)
      {
        if (q14)
	{
	  /* Read four values/line so we can have trailing comments */
          fgets (line, 132, fp);
          if (sscanf (line, "%f %f %f %f", &afloat[0], &afloat[1],
                                           &afloat[2], &afloat[3]) != 4)
          {
            strcpy (msg,"Unexpected EOF encountered");
            goto ErrorOut;
          }
          for (i=0; i<4; i++)
	  {
            if (fabs(afloat[i]) >= 2.0)    /* +/- 1.9999... is max for Q14 */
	    {
              strcpy (msg,"Q14 value >= +/-2.0");
              goto ErrorOut;
            }
            *consts++ =  (short) (afloat[i] * (float) (1 << 14)); /* Q14 */;
            count--;
	  }
	}
        else
	{
          count--;
          fgets (line, 132, fp);
          if (sscanf (line, "%hi", consts++) != 1)
          {
            strcpy (msg,"Unexpected EOF encountered");
            goto ErrorOut;
          }
        }    /* if (q14)  */
      }      /* while (count > 0) */
    }
  }
  else
  {
    strcpy (msg,"EOF while reading ID string");
ErrorOut:
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    status = ERROR;
  }

  /* Close the file */
  if (fclose (fp) == EOF)    strcpy (msg,"File close failed");

  /* Save status message in caller's buffer */
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);

  return (status);
}



Status P2RF_LoadCoefs (void                *hndl,
                       register float      *coefs,
                       register int         count,
                       register int         index,
                       register P2RfCvtBlk *blk)
/*
   Description
   -----------
   Function to load coefficients onto a module.  The coefficients are first
   converted from floats to shorts.  The caller may supply a callback routine
   to further convert the integer coefficient.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
        coefs - An array of coefficients to load
        count - The number of coefficients to load from the coefs array
        index - The starting index of the VME location to load the coefs at
          blk - A pointer to a block containing coefficient conversion params

   Returns
   -------
   ERROR if the input values are suspect, VXI_SUCCESS otherwise.
*/
{
  /*Function ("P2RF_LoadCoefs");*/

  register P2RfPvt  *p2Rf = hndl;


  /* Return ERROR if inputs cause problems */
  if (((blk->iMax - blk->iMin) == 0) || ((blk->fMax - blk->fMin) == 0.0))
    return (ERROR);

  while (count--)
  {
    register float   fCoef = *coefs;
    register short   iCoef;

    /* Convert the coefficients from floats to shorts */
    if (fCoef <= blk->fMin)  fCoef = blk->fMin;
    if (fCoef >  blk->fMax)  fCoef = blk->fMax;
#if (CPU==PPC604)
    iCoef = (((blk->iMax - blk->iMin) /
                     (blk->fMax - blk->fMin)) * fCoef) + blk->iOff;
#else
    iCoef = iround (((blk->iMax - blk->iMin) /
                     (blk->fMax - blk->fMin)) * fCoef) + blk->iOff;
#endif
    /* Apply caller defined conversion, if specified */
    if (*blk->cvtRtn)  iCoef = (*blk->cvtRtn) (blk->cvtArg, iCoef);

#if 0
    epicsPrintf ("%s: idx = %h04x, fCoef = %f, iCoef = %h04x\n", FN,
                 index, fCoef, iCoef);
#endif

    /* Load the coefficient on the hardware */
    P2RF_WriteVme (p2Rf, index, iCoef);

    /* Next! */
    coefs++;
    index++;
  }

  return (VXI_SUCCESS);
}




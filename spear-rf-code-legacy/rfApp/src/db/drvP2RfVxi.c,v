/*
   Description
   -----------
   Function to load an executeable file onto a DSP.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
        index - The VME address index at which DSP memory starts
         file - The DSP executable file to load
       lderam - Logical if eram load desired
       msgBuf - A pointer to a buffer in which to return formated status msgs
    msgBufLen - The maximum allowed space status messages may take up


   Returns
   -------
   ERROR if an error condition was encountered, OK otherwise
*/
{
  Function ("P2RF_LoadDsp");

  P2RfPvt       *p2Rf = hndl;
  unsigned long  adx  = (unsigned long) &((vxi16_t *) p2Rf->ext)[index];
  char          *msg  = NULL;
  Status         status;

  status = DWN_LdDspExe(file, adx, FALSE, lderam);
  if (status)
  {
    if (status == DWN_UNAFIL)
    {  msg = "Can't open DSP file";  }
    else if (status == DWN_RDERR)
    {  msg = "DSP file read error";  }
    else if ((status == DWN_BADMAG) || (status == DWN_NOTEXE) ||
             (status == DWN_MINFIL) || (status == DWN_UPDFIL) ||
             (status == DWN_UNSSWP) || (status == DWN_SWPNOT) ||
             (status == DWN_NOTSWP) || (status == DWN_BADFLG))
    {  msg = "DSP file error";  }
    else
    {
      msg = "DSP download error";
      epicsPrintf ("%s: DWN_LdDspExe status = %08x\n", FN, (int)status);
    }

    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
  }

  return (status);
}



Status P2RF_LoadTblFile (void           *hndl,
                         char           *id,
                         int             index,
                         char           *file,
                         int             count,
                         int            *abortFlg,
                         char           *msgBuf,
                         int             msgBufLen)
/*
   Description
   -----------
   Function to load a table onto a module's table memory from a file.

   Since file operations are buffered, some errors can't be detected until
   several file operations have taken place.  This can result in misleading
   status messages being reported.  Additionally, it has been observed that
   some (e.g., fclose) file functions output messages (presumably messages
   reported by the host) themselves and are thus not capturable for reporting
   to the caller.

   The scheme employed below involves double buffering to minimize the overhead
   incurred by calling fwrite.  Experimentation revealed that with buffers
   larger than 16 shorts didn't significantly improve the average file
   access rate.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
           id - An identification string expected to be at the top of the file
        index - The VME address index at which the memory resides
         file - The file to read the data from
        count - Number of words to load on the module
     abortFlg - A pointer to an abort flag
       msgBuf - A pointer to a buffer in which to return formated status msgs
    msgBufLen - The maximum allowed space status messages may take up

   Returns
   -------
   ERROR if an error condition was encountered, OK otherwise */
{
  Function ("P2RF_LoadTblFile");

  P2RfPvt        *p2Rf   = hndl;
  FILE           *fp     = fopen (file, "rb");
  Status          status = OK;
  char           *msg    = "Success";
  char            buf[P2RF_K_BUFSIZE];


  /* Check that the file was opened.  May have failed even with non-null fp! */
  if (fp == 0)
  {
    msg = "Can't open table file";
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
    return (ERROR);
  }

  /* Check that the ID string matches the expected value */
  if (fread (buf, strlen (id), 1, fp) == 1)
  {
    if (strncmp (buf, id, strlen (id)) == 0)
    {
      register vxi16_t        *ext = &p2Rf->ext[index];
      register int             cnt = count / DBLBUFSZ;
      unsigned short           dblBuf[DBLBUFSZ];
      register unsigned short *dbp = dblBuf;

      /* Read the file and write the table memory */
      while (cnt-- && (*abortFlg == FALSE))
      {
        if (fread (dblBuf, sizeof (*dblBuf), DBLBUFSZ, fp) != DBLBUFSZ)  break;
        dbp = dblBuf;
        while (dbp < &dblBuf[DBLBUFSZ])  *ext = *dbp++;
      }

      /* If we weren't able to fit the whole file, let operator know */
      if ((fread (dblBuf, sizeof (*dblBuf), 1, fp) == 1) &&
          (*abortFlg == FALSE))
      {
        msg = "File too large for table memory";
        goto ErrorOut;
      }
    }
    else
    {
      msg = "File ID string mismatch";
      P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                   p2Rf->model.name, msg, file);
      buf[strlen (id)] = '\0';          /* Need to null term ids in files! */
      P2RF_Printf (__FILE__, FN, "Expected ID |%s|", id);
      P2RF_Printf (__FILE__, FN, "Read ID     |%s|", buf);
      status = ERROR;
    }
  }
  else
  {
    msg    = "EOF whilst reading ID string";
ErrorOut:
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    status = ERROR;
  }

  /* Close the file */
  if (fclose (fp) == EOF)
  {
    msg = "File close failed";
    P2RF_Printf (__FILE__, FN, "%s: %s: %s %s",
                 p2Rf->model.name, msg, file);
    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
    return (ERROR);
  }

  /* Save status message in caller's buffer */
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);

  return (status);
}



Status P2RF_DspFindComBlk (void            *hndl,
                           volatile void  **comBlk)
/*
   Description
   -----------

   Parameters
   ----------

   Returns
   -------

*/
{
  Function ("P2RF_DspFindComBlk");

  P2RfPvt        *p2Rf = hndl;
  unsigned short  comBlkPtr;


  /* Get the pointer to the communications block */
  comBlkPtr = p2Rf->ext[DSP_K_ESIZE - 1];

  /* Sorta check if the pointer value makes sense */
  if ((comBlkPtr >= DSP_A_ERAM) && (comBlkPtr < DSP_A_ETOP))
  {
    *comBlk = &p2Rf->ext[comBlkPtr - DSP_A_ERAM];
  }
  else
  {
    P2RF_Printf (__FILE__, FN, "DSP comBlk pointer has nonsense value %h04x",
                 comBlkPtr);
    return (ERROR);
  }

  return (OK);
}



Status P2RF_SaveDspMemory (void           *hndl,
                           int             startIdx,
                           int             begIdx,
                           int             endIdx,
                           char           *file,
                           char           *msgBuf,
                           int             msgBufLen)
/*
   Description
   -----------
   Function to save data from a module DSP memory to an ascii file.

   Since file operations are buffered, some errors can't be detected until
   several file operations have taken place.  This can result in misleading
   status messages being reported.  Additionally, it has been observed that
   some (e.g., fclose) file functions output messages (presumably messages
   reported by the host) themselves and are thus not capturable for reporting
   to the caller.

   The scheme employed below involves double buffering to minimize the overhead
   incurred by calling fwrite.  Experimentation revealed that with buffers
   larger than 16 shorts didn't significantly improve the average file
   access rate.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
     startIdx - The VME address index at which the memory resides
       begIdx - The VME address index at which to start saving
       endIdx - The VME address index at which to wrap to back to the beginning
         file - The file to record the data in
       msgBuf - A pointer to a buffer in which to return formated status msgs
    msgBufLen - The maximum allowed space status messages may take up

   Returns
   -------
   ERROR if an error condition was encountered, OK otherwise */
{
  Function ("P2RF_SaveDspMemory");

  P2RfPvt                 *p2Rf   = hndl;
  FILE                    *fp     = fopen (file, "w");
  Status                   status = OK;
  char                    *msg    = "Success";


  /* Check that the file was opened.  May have failed even with non-null fp! */
  if (fp == 0)
  {
    msg = "Can't open file for writing";
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
    return (ERROR);
  }

  if (TRUE)
  {
    vxi16_t                 *beg = &p2Rf->ext[begIdx];
    vxi16_t                 *end = &p2Rf->ext[endIdx];
    register vxi16_t        *ext = beg;

    /* Read the memory to the end */
    while (ext < end)
    {
      if (fprintf (fp, "%hi %hi\n", ext[0], ext[1]) < 0)  goto ErrorOut;
      ext += 2;
    }

    /* Reset the pointer back to the beginning of memory */
    ext = &p2Rf->ext[startIdx];

    /* Continue recording from the beginning to the start point */
    while (ext < beg)
    {
      if (fprintf (fp, "%hi %hi\n", ext[0], ext[1]) < 0)  goto ErrorOut;
      ext += 2;
    }
  }
  else
  {
ErrorOut:
    msg    = "File write failed";
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    status = ERROR;
  }

  /* Close the file.  Will fail if fopen didn't really open the file */
  if (fclose (fp) == EOF)    msg = "File close failed";

  /* Save status message in caller's buffer */
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);

  return (status);
}



Status P2RF_LoadRegFile (void       *hndl,
                         char       *id,
                         char       *file,
                         int         idx,
                         int         verify,
                         char       *msgBuf,
                         int         msgBufLen)
/*
   Description
   -----------
   Load register(s) from a data file.  The expected file format has the
   identification string on the first line.  Following lines can be either
   comments or data lines.  The comment characters are '!' and '#'.  Data
   lines start with two numbers: an index to the register that is added
   to the index supplied in the function argument idx, and the 16 bit value
   that is to be written to be written to the register.  Since C's %i format
   is used to decode both these numbers, they may entered in the file according
   to its rules: e.g., decimal and hexadecimal may be used interchangably.
   Characters following the second number are not interpreted and so the rest
   of the line may be used as a comment field.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
           id - An identification string expected to be at the top of the file
         file - The file to read the data from
          idx - The VME address index at which the memory resides
       verify - TRUE to check that register readback is what was written
       msgBuf - A pointer to a buffer in which to return formated status msgs
    msgBufLen - The maximum allowed space status messages may take up

   Returns
   -------
   SUCCESS or ERROR
*/
{
 Function ("P2RF_LoadRegFile");

  P2RfPvt        *p2Rf   = hndl;
  register FILE  *fp     = fopen (file, "r");
  long            status = OK;
  char           *msg    = "Success";
  char            buf[P2RF_K_BUFSIZE];


  /* Check that the file was opened */
  if (fp == 0)
  {
    msg = "Can't open register file";
    P2RF_Printf (__FILE__, FN, "%s: %s %s", p2Rf->model.name, msg, file);
    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
    return (ERROR);
  }

  /* Check that the ID string matches the expected value */
  if (fgets (buf, sizeof (buf), fp) != NULL)
  {
    if (strstr (buf, id) == NULL)
    {
      msg = "File ID string mismatch";
      P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                   p2Rf->model.name, msg, file);
      P2RF_Printf (__FILE__, FN, "Expected ID      |%s|", id);
      P2RF_Printf (__FILE__, FN, "not contained in |%s|", buf);
      status = ERROR;
    }
    else
    {
      int             i;
      unsigned short  reg;
      unsigned short  val;

      while (fgets (buf, sizeof (buf), fp) != NULL)
      {
        /* Continue if first character is a comment character or blank line */
        if ((buf[0] == '!') || (buf[0] == '#') || (buf[0] == '\n'))  continue;

        /* Read index and register value from the line */
        if (sscanf (buf, "%i %hi", &i, &reg) != 2)
        {
          msg = "Bad register file format";
          P2RF_Printf (__FILE__, FN, "%s: file = %s, buffer = %s",
                       msg, file, buf);
          status = ERROR;
          goto ErrorOut;
        }

#if 0
        epicsPrintf ("i = %hi, idx = %hi, value = %h04x\n", i, idx + i, reg);
#endif

        /* Write the value to the register */
        P2RF_WriteVme (p2Rf, idx + i, reg);

        /* If enabled, read it back and make sure it's the same */
        if (verify)
        {
          P2RF_ReadVme (p2Rf, idx + i, &val);
          if (val != reg)
          {
            msg = "Register verify error";
            P2RF_Printf (__FILE__, FN,
                         "%s: idx = %i, wrote %h04x, read %h04x, xor = %h04x",
                         msg, idx + i, reg, val, reg ^ val);
            status = ERROR;
            goto ErrorOut;
          }
        }
      }
    }
  }
  else
  {
    msg = "EOF whilst reading ID string";
ErrorOut:
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    status = ERROR;
  }

  /* Close the file */
  if (fclose (fp) == EOF)    msg = "File close failed";

  /* Save status message in caller's buffer */
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);

  return (status);

}

static Status P2RF_Init (void)
/*
   Description
   -----------
   Initialize all present PEP-II RF VXI modules

   Parameters
   ----------
   none

   Returns
   -------
   status
*/
{
  Function ("P2RF_Init");

  Status   status;
  P2RfBlk *blk;


  /* Do nothing if Resource manager didn't run (usually crates without VXI) */
  if (!epvxiResourceMangerOK)  return (VXI_SUCCESS);

  /* Install a reboot handler */
  if (rebootHookAdd (P2RF_Shutdown) != OK)
  {
    status = S_epvxi_internal;
    errPrintf (status, __FILE__, __LINE__, "%s: rebootHookAdd failed", FN);
    return (status);
  }

  /* Install a reboot handler */
  if (rebootHookAdd ((FUNCPTR)epicsExitCallAtExits) != OK)
  {
    status = S_epvxi_internal;
    errPrintf (status, __FILE__, __LINE__, "%s: rebootHookAdd failed", FN);
    return (status);
  }

  /* Before any init_records are called, set up the one and only P2RfBlk */
  blk = calloc (1, sizeof (*blk));

  /* Set the driver identifier */
  blk->driverId = epvxiUniqueDriverID ();
  P2RfDriverId  = blk->driverId;

  /* Find all the PEP-II RF VXI modules in the system and initialize them */
  {
    epvxiDeviceSearchPattern  dsp = {VXI_DSP_make, P2RF_K_MAKE};

    return (epvxiLookupLA (&dsp, P2RF_InitModule, (void *) blk));
  }
}



static void P2RF_InitModule (unsigned int  la,
                             void         *arg)
/*
   Description
   -----------
   Callback routine to initialize a PEP-II RF VXI module

   Parameters
   ----------
           la - The logical address of the module
          arg - A pointer to a callback argument

   Returns
   -------
   nothing
*/
{
  Function ("P2RF_InitModule");

  Status    status;
  P2RfBlk  *blk = (P2RfBlk *) arg;
  P2RfPvt  *p2Rf = NULL;


  /* Tell the VXI sub-system that this driver is in charge of this module */
  status = epvxiOpen (la, blk->driverId, sizeof (*p2Rf), P2RF_Report);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__,
               "%s: Device open failed, LA = 0X%X", FN, la);
    return;
  }

  Dbg (Printf (__FILE__, FN, "Module at LA 0x%02X", la));

  /* Allocate a private block for the module (This macro defines p2Rf!) */
  status = epvxiFetchPConfig (la, blk->driverId, p2Rf);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__, "%s: epvxiFetchPConfig", FN);
    epvxiClose (la, blk->driverId);
    return;
  }

  /* Save a pointer to the driver block */
  p2Rf->blk = blk;

  /* Save the module's logical address */
  p2Rf->la = la;

#if 0                                /* devRegisterAddress seems not to work */
  /* Get physical A16 base address of the module and protect it */
  if (status = devRegisterAddress ("drvP2RfVxi", atVMEA16, (void *) VXIBASE(la),
                                   sizeof (*p2Rf->csr), (void **) &p2Rf->csr))
  {
    errPrintf (status, __FILE__, __LINE__,
                "%s devRegisterAddress - la = %02x, A16, base = %08x, size = %08x", FN, la, VXIBASE (la), sizeof (*p2Rf->csr));
    return;
  }
#else
  p2Rf->csr = VXIBASE (la);
#endif

  /* Store a pointer to the device dependent registers */
  p2Rf->devDep = (volatile P2RfDevDep *) &p2Rf->csr->dir.r.dd;

  /* Get a pointer to the extended address space of the module and protect it */
  if (VXIMEMENBL (p2Rf->csr))
  {
    epicsAddressType  adxType = atVMEA16;
    long              vmeMod  = NULL;
    char             *vmeAddr = NULL;
    long              vmeSize = NULL;
    vxi16_t          *base;

    switch (VXIADDRSPACE (p2Rf->csr))
    {
      case VXI_ADDR_EXT_A24:
        adxType = atVMEA24;
        vmeMod  = VME_AM_STD_SUP_DATA;
        vmeAddr = (char *) (p2Rf->csr->dir.w.offset << 8);
        vmeSize = VXIA24MEMSIZE (VXIREQMEM (p2Rf->csr));
        break;

      case VXI_ADDR_EXT_A32:
        adxType = atVMEA32;
        vmeMod  = VME_AM_EXT_SUP_DATA;
        vmeAddr = (char *) (p2Rf->csr->dir.w.offset << 16);
        vmeSize = VXIA32MEMSIZE (VXIREQMEM (p2Rf->csr));
        break;
    }

    if (vmeMod)
    {
      status = sysBusToLocalAdrs (vmeMod, vmeAddr, (char **) &base);
      if (status >= 0)
      {
        Dbg (Printf (__FILE__, FN,
                     "la = %02x, ExtAdx = %08x, lclAdx = %08x, size = %08x\n",
                     la, vmeAddr, base, vmeSize));

#if 0                                 /* devRegisterAddress seems not to work */
        if (status = devRegisterAddress ("drvP2RfVxi", adxType,
                                         (void *) base, vmeSize,
                                         (void **) &p2Rf->ext))
        {
          errPrintf (status, __FILE__, __LINE__,
                     "%s devRegisterAddress - A24", FN);
          return;
        }
#else
        p2Rf->ext = base;
#endif
      }
      else
      {
        errPrintf (NULL, __FILE__, __LINE__,
                   "%s: sysBusToLocalAdrs failed: adx = %08x\n", FN, (int)vmeAddr);
      }
    }
  }

  /* Initialize mutual exclusion locks */
  FASTLOCKINIT (&p2Rf->lock);

  /* Set up the interrupt service routine */
#if defined (NIVXI)
  status = SetVXIintHandler ( 1 << (P2RfIntLevel - 1),(NIVXI_HVXIINT *)P2RF_IntServRtn);
  if (status)
  {
    errPrintf (S_dev_vecInstlFail, __FILE__, __LINE__,
"%s: Bad status returned when connecting ISR: %08x", FN, (unsigned int)status);
    return; 
  }
#elif defined (NICPU030)
  status = sysBusVXIIntConnect ((FUNCPTR) P2RF_IntServRtn);
  if (status)
  {
    errPrintf (S_dev_vecInstlFail, __FILE__, __LINE__,
"%s: Bad status returned when connecting ISR: %08x", FN, (unsigned int)status);
    return;
  }
#else
  status = devConnectInterrupt (intVXI, la, P2RF_IntServRtn, &la);
  if (status !=OK)
  {
    errPrintf (status, __FILE__, __LINE__, "%s: devConnectInterrupt", FN);
    return;
  }
#endif

  return;
}



Status P2RF_RegisterModule (int              dynStat,
                            int              frame,
                            int              slot,
                            int              logicalAdx,
                            int              model,
                            char            *name,
                            char            *drawing,
                            void           (*isrRtn) (void *, unsigned short),
                            void            *isrArg,
                            void           (*sdRtn) (void *),
                            void            *sdArg,
                            void           **drvPvt)
/*
   Description
   -----------
   Function to register a desire to use a module.  This function must be
   called by only one client (typically EPICS device or record support)
   to gain access to the module.  If the resource manager has found the
   requested module in the system, the caller is given a handle which
   is required to call other driver support functions.

   Parameters
   ----------
      dynStat - Type of module addressing to be used: 0 = dynamic, 1 = static
        frame - Frame number module is located in
         slot - Slot of the module in the frame
   logicalAdx - Logical address of the module if dynStat = 1
        model - Model number of the module
         name - Name of the module
      drawing - Drawing number of the module (as a string)
       isrRtn - Module-specific routine ISR is to call upon module's interrupt
       isrArg - Argument for the module-specific interrupt routine
        sdRtn - Module-specific shut-down routine to be called at shut-down
        sdArg - Argument for the module-specific shut-down routine
       drvPvt - A location in which to return a pointer to
                the module-specific driver-private block

   Returns
   -------
   Status codes from various routines or VXI_SUCCESS
*/
{
  Function ("P2RF_RegisterModule");

  Status        status = VXI_SUCCESS;
  unsigned int  la     = logicalAdx;
  P2RfPvt      *p2Rf   = 0;


  Dbg (Printf (__FILE__, FN, "dynStat = %d, frame = %d, slot = %d, LA = %d\nmodel = %d, name = %s, drawing = %s\n",
               dynStat, frame, slot, logicalAdx, model, name, drawing));

  /* If dynamic addressing is enabled, find the module's logical address */
  if (dynStat == FALSE)
  {
    status = P2RF_GetModuleLa (frame, slot, &la);
    if (status)
    {
      errPrintf (ERROR, __FILE__, __LINE__,
                 "%s: ResMan did not find a module in frame %d, slot %d",
                 FN, frame, slot);
      return (status);
    }
  }

  /* Find the driver private block */
  status = P2RF_PCONFIG (la, p2Rf);
  if (status)  return (status);

  Dbg (Printf (__FILE__, FN, "Module make = %04x, model = %04x",
               VXIMAKE (p2Rf->csr), VXIMODEL (p2Rf->csr)));

  /* Verify make and model are as expected for this module */
  if (p2Rf->model.name ||
      (P2RF_K_MAKE != VXIMAKE  (p2Rf->csr)) || (model != VXIMODEL (p2Rf->csr)))
  {
    errPrintf (ERROR, __FILE__, __LINE__,
               "%s: Request to register a %s in slot %d failed because\n"
               "a %s has previously been registered with make %04x, model # %04x",
               FN, name, slot, p2Rf->model.name ? p2Rf->model.name : "module",
               VXIMAKE (p2Rf->csr), VXIMODEL (p2Rf->csr));
    return (ERROR);
  }

  /* Register the module's model and make names for reporting purposes */
  p2Rf->model.name    = name;
  p2Rf->model.drawing = drawing;

  status = epvxiRegisterMakeName (P2RF_K_MAKE, P2RF_K_MANUFACTURER);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__,
               "%s: epvxiRegisterMakeName failed", FN);
  }

  status = epvxiRegisterModelName (P2RF_K_MAKE, model, name);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__,
               "%s: epvxiRegisterModelName failed", FN);
  }

  /* Store the module's ISR function and argument */
  p2Rf->isrRtn = isrRtn;
  p2Rf->isrArg = isrArg;

  /* Store the module's Shutdown function and argument */
  p2Rf->sdRtn = sdRtn;
  p2Rf->sdArg = sdArg;

  /* Default to single clients which don't need no steenking semaphore */
  p2Rf->sharedCnt = 0;
  p2Rf->shrSem    = NULL;

  /* Return  the driver handle */
  *drvPvt = p2Rf;

  return (status);
}



Status P2RF_RegisterClient (void   *drvPvt)
/*
   Description
   -----------
   Function to register a desire to share a module.  A call by an initial
   client to RegisterModule must have been previously made to get a driver
   handle.  This handle must then be passed to or findable by subsequent
   clients.  The client that called RegisterModule need not call
   RegisterClient, although it doesn't hurt (modulo a small hit on
   performance).  RegisterClient need not be called if there is only one client
   of the module in the system or the module has no features which have context
   associated with them that can become inconsistent when multiple clients
   intermingle their access calls.  The only such feature currently (1/97) on
   the modules are the 512K circulare buffer RAMs that are accessed through one
   address location.  For the cases of multiple clients of modules with such
   features, RegisterClient must be called in order to ensure mutual
   exclusivity whilst the feature is being accessed.

   Parameters
   ----------
       drvPvt - A location in which to return a pointer to
                the module-specific driver-private block

   Returns
   -------
   Status codes from various routines or VXI_SUCCESS */
{
  Function ("P2RF_RegisterClient");

  P2RfPvt      *p2Rf = (P2RfPvt *) drvPvt;
  SEM_ID        shrSem;


  /* Give the clients a semaphore with which to control resource access */
  if ((shrSem = semMCreate (SEM_Q_FIFO)) == NULL)
  {
    errPrintf (0, __FILE__, __LINE__, "%s: %s failed - id = %d", FN, "semMCreate", (int)shrSem);
    return (ERROR);
  }
  p2Rf->sharedCnt++;
  p2Rf->shrSem = shrSem;

  return (OK);
}



#if 0
Status P2RF_UnregisterClient (void           **drvPvt)
/*
   Description
   -----------
   Function to indicate that a client is no longer interested in sharing a
   module.

   This routine is dangerous and undebugged.  It's not clear that there is any
   real use for it since currently any client that registers to share a module
   does so for the life of the processor boot cycle.

   The danger in this routine is that I haven't thought through what happens
   when a client attempts to take the semaphore or new client registers while
   this routine is executing.

   Parameters
   ----------
       drvPvt - A location in which to return a pointer to
                the module-specific driver-private block

   Returns
   -------
   Status codes from various routines or VXI_SUCCESS */
{
  Function ("P2RF_UnregisterClient");


  /* If there are two clients, make sure we have the sem before deleting it */
  if (p2Rf->sharedCnt == 1)  semTake (p2Rf->shrSem, WAIT_FOREVER);

  /* Delete the semaphore if the count goes to zero */
  if ((--p2Rf->sharedCnt) == 0)
  {
    /* Unblock anyone hanging on this semaphore and force a context switch */
    semGive (p2Rf->shrSem);
    taskDelay (1);

    semDelete (p2Rf->shrSem);
    p2Rf->shrSem = NULL;
  }

  return (OK);
}
#endif



static int P2RF_Shutdown (void)
/*
   Description
   -----------
   Shut down the PEP-II RF VXI modules

   Parameters
   ----------
   none

   Returns
   -------
   status
*/
{
  Function ("P2RF_Shutdown");

  Status                    status;
  epvxiDeviceSearchPattern  dsp = {VXI_DSP_make, P2RF_K_MAKE};


  /* Find all the PEP-II RF VXI modules in the system and shut them down */
  status = epvxiLookupLA (&dsp, P2RF_ShutdownModule, (void *) NULL);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__,
               "%s: PEP-II RF module shutdown failed", FN);
  }

  /* Allow some time to print out messages */
  taskDelay (1 * sysClkRateGet ());

  return (OK);
}



static void  P2RF_ShutdownModule (unsigned int  la,
                                  void         *arg)
/*
   Description
   -----------
   Specific routine to shut down a PEP-II RF VXI module.

   Parameters
   ----------
           la - Logical address of the module

   Returns
   -------
   nothing
*/
{
  Function ("P2RF_ShutdownModule");

  Status      status;
  P2RfPvt    *p2Rf = NULL;


  /* Find the driver private block */
  status = P2RF_PCONFIG (la, p2Rf);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__, "%s: P2RF_PCONFIG failed", FN);
    return;
  }

  /* If a module specific shutdown function was specified, call it */
  if (p2Rf->sdRtn)  (*p2Rf->sdRtn) (p2Rf->sdArg);

  /* Disable interrupt generation from this module */
  p2Rf->devDep->intCtrl |= P2RF_M_INTMASK;   /* Complemented! */
}




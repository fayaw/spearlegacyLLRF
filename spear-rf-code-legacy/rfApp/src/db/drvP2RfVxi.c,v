ErrorOut:
    P2RF_Printf (__FILE__, FN, "%s: %s for %s",
                 p2Rf->model.name, msg, file);
    status = ERROR;
  }

  /* Close the file */
  if (fclose (fp) == EOF)    msg = "File close failed";

  /* Save status message in caller's buffer */
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);

  return (status);
}



Status P2RF_LoadDdf (void       *hndl,
                     int         iIdx,
                     int         qIdx,
                     P2RfDdf    *ddf)
/*
   Description
   -----------
   This function loads an I/Q channel's DDF chips' F, FC, H1 and H2 registers.

   It appears from the HSP43220 data sheet and Harris' TechBrief note TB309
   that the chip's registers can be written in any particular order

   For this function to work the FIR clock must be going.  It appears that
   we're safe because it does not look like the FIR clock is disablable.

   Parameters
   ----------
       drvPvt - A pointer to the driver-private block
         iIdx - Index to an I channel DDF (F) register
         qIdx - Index to a  Q channel DDF (F) register
          ddf - A pointer to a DDF block

   Returns
   -------
   OK
*/
{
  /* Function ("P2RF_LoadDdf"); */

  P2RfPvt   *p2Rf = hndl;


  /* Disable the FIR */
  P2RF_WriteVme (p2Rf, iIdx + DDF_I_H1, DDF_M_FDIS | DDF_M_HBYP);
  P2RF_WriteVme (p2Rf, qIdx + DDF_I_H1, DDF_M_FDIS | DDF_M_HBYP);

#if 0
  epicsPrintf ("H1(%08x, %08x) being loaded with %h04x\n",
               iIdx + DDF_I_H1, qIdx + DDF_I_H1, DDF_M_FDIS | DDF_M_HBYP);
#endif

  /* Load the F register with reset */
  P2RF_WriteVme (p2Rf, iIdx + DDF_I_F,  DDF_M_F0AD | DDF_M_FBYP);
  P2RF_WriteVme (p2Rf, qIdx + DDF_I_F,  DDF_M_F0AD | DDF_M_FBYP);

#if 0
  epicsPrintf ("F(%08x, %08x) being loaded with %h04x\n",
               iIdx + DDF_I_F, qIdx + DDF_I_F, DDF_M_F0AD | DDF_M_FBYP);
#endif

  /* Wait for at least two FIR clock cycles to go by */
  taskDelay (sysClkRateGet () / 60);

  /* Reload the H1 register to reenable FIR*/
  P2RF_WriteVme (p2Rf, iIdx + DDF_I_H1, ddf->h1);
  P2RF_WriteVme (p2Rf, qIdx + DDF_I_H1, ddf->h1);

#if 0
  epicsPrintf ("H1(%08x, %08x) being loaded with %h04x\n",
               iIdx + DDF_I_H1, qIdx + DDF_I_H1, ddf->h1);
#endif

  /* Load the H2 register (may cause HDF to glitch) */
  P2RF_WriteVme (p2Rf, iIdx + DDF_I_H2, ddf->h2);
  P2RF_WriteVme (p2Rf, qIdx + DDF_I_H2, ddf->h2);

#if 0
  epicsPrintf ("H2(%08x, %08x) being loaded with %h04x\n",
               iIdx + DDF_I_H2, qIdx + DDF_I_H2, ddf->h2);
#endif

  /* Write the F register */
  P2RF_WriteVme (p2Rf, iIdx + DDF_I_F, ddf->f);
  P2RF_WriteVme (p2Rf, qIdx + DDF_I_F, ddf->f);

#if 0
  epicsPrintf ("F(%08x, %08x) being loaded with %h04x\n",
               iIdx + DDF_I_F, qIdx + DDF_I_F, ddf->f);
#endif

  /* Load the coefficients through the FC register */
  {
    register P2RfFc   *fc    = ddf->fc;
    register int       fcCnt = ddf->fcCnt;
    register int       iFc   = iIdx + DDF_I_FC;
    register int       qFc   = qIdx + DDF_I_FC;

#if 0
    epicsPrintf ("FC(%08x, %08x) being loaded with: \n",
                 iIdx + DDF_I_FC, qIdx + DDF_I_FC);
#endif

    while (fcCnt--)
    {
#if 0
      epicsPrintf ("iHi = %h04x, iLo = %h04x, qHi = %h04x, qLo = %h04x\n",
                   fc->hi, fc->lo, fc->hi, fc->lo);
#endif

      P2RF_WriteVme (p2Rf, iFc, fc->hi);
      P2RF_WriteVme (p2Rf, iFc, fc->lo);
      P2RF_WriteVme (p2Rf, qFc, fc->hi);
      P2RF_WriteVme (p2Rf, qFc, fc->lo);
      fc++;
    }
  }

  return (OK);
}



Status P2RF_ReadDdfFile (void    *hndl,
                         char    *file,
                         char    *id,
                         P2RfDdf *ddf,
                         char    *msgBuf,
                         int      msgBufLen)
/*
   Description
   -----------
   This function reads DDF register data for an I/Q channel from a file.
   The file is expected to have a format like that put out by Harris'
   DECI-MATE coefficient generating software.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
         file - The file spec of the file to load
           id - ID string we expect to find at the top of the file
          ddf - A pointer to a DDF block
       msgBuf - A pointer to a buffer for returning status messages
    msgBufLen - The size of the passed message buffer

   Returns
   -------
   ERROR if a problem occured, OK otherwise
*/
{
  Function ("P2RF_ReadDdfFile");

  P2RfPvt   *p2Rf   = hndl;
  FILE      *fp;
  char       buf[P2RF_K_BUFSIZE];
  int        cnt;
  char      *msg = "File read error (EOF?)";


  /* Check that the file was opened */
  if ((fp = fopen (file, "r")) == 0)
  {
    msg = "Can't open file";
    errPrintf (NULL, __FILE__, __LINE__, "%s: %s: %s %s",
               FN, p2Rf->model.name, msg, file);
    if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
    return (ERROR);
  }

#if 0
  Dbg (Printf (__FILE__, FN, "fp = %0x", fp));
#endif

  /* Let's try a trick to keep error processing clean */
  do
  {
    /* Check that the ID string matches the expected value */
    if (fgets (buf, sizeof (buf), fp) != NULL)
    {
      if (strstr (buf, id))
      {
        /* Find and read the F register */
        if (FileScan (fp, DDF_K_FNAME)   != OK)  break;
        if (fgets (buf, sizeof (buf), fp) == 0)  break;
#if 0
        Dbg (epicsPrintf ("%s (%s): buf = %s", __FILE__, FN, buf));
#endif
        {
          int   zad, byp, esym, drate, taps;

          if (fscanf (fp, "%d%d%d%d%d", &zad, &byp, &esym, &drate, &taps) != 5)
            break;
#if 0
          Dbg (Printf (__FILE__, FN,
                       "zad = %d, byp = %d, esym = %d, drate = %d, taps = %d",
                       zad, byp, esym, drate, taps));
#endif
          ddf->f = ((taps  << DDF_V_FTAPS) | (drate << DDF_V_FDRATE) |
                    (esym  << DDF_V_FESYM) | (byp   << DDF_V_FBYP)   |
                    (zad   << DDF_V_F0AD));
        }

        /* Find and read the FC (coefficient) register data */
        if (FileScan (fp, DDF_K_FCNAME) != OK)  break;
        {
          int                coef;
          register P2RfFc   *fc = ddf->fc;
          register int       fcCnt = 0;

          while ((cnt = fscanf (fp, "%d", &coef)) == 1)
          {
            fc->lo = coef & 0x000f;
            fc->hi = coef >> 4;
#if 0
            Dbg (Printf (__FILE__, FN, "coef = %08x, hi = %h04x, lo = %h04x",
                         coef, fc->hi, fc->lo));
#endif
            fc++;
            fcCnt++;
          }
          ddf->fcCnt = fcCnt;
        }
        if (cnt == EOF)  break;

        /* Find and read the H1 register */
        if (FileScan (fp, DDF_K_H1NAME)   != OK)  break;
        if (fgets (buf, sizeof (buf), fp) == 0)   break;
#if 0
        Dbg (epicsPrintf ("%s (%s): buf = %s", __FILE__, FN, buf));
#endif
        {
          int   dis, cla, byp, drate;

          if (fscanf (fp, "%d%d%d%d", &dis, &cla, &byp, &drate) != 4)  break;
#if 0
          Dbg (Printf (__FILE__, FN, "dis = %d, cla = %d, byp = %d, drate = %d",
                       dis, cla, byp, drate));
#endif
          ddf->h1 = ((drate  << DDF_V_HDRATE) | (byp    << DDF_V_HBYP) |
                     (cla    << DDF_V_FCLA)   | (dis    << DDF_V_FDIS));
        }

        /* Find and read the H2 register */
        if (FileScan (fp, DDF_K_H2NAME)   != OK)  break;
        if (fgets (buf, sizeof (buf), fp) == 0)   break;
#if 0
        Dbg (epicsPrintf ("%s (%s): buf = %s", __FILE__, FN, buf));
#endif
        {
          int   growth, stages;

          if (fscanf (fp, "%d%d", &growth, &stages) != 2)  break;
#if 0
          Dbg (Printf (__FILE__, FN, "growth = %d, stages = %d",
                       growth, stages));
#endif
          ddf->h2 = ((stages << DDF_V_STAGES) | (growth << DDF_V_GROWTH));
        }
      }
      else
      {
        msg    = "File ID string mismatch";
        break;
      }
    }
    else
    {
      break;
    }

    /* Close the file */
    if (fclose (fp) == EOF)
    {
      msg = "File close failed";
      errPrintf (NULL, __FILE__, __LINE__, "%s: %s: %s %s",
                 FN, p2Rf->model.name, msg, file);
      if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
      return (ERROR);
    }

    return (OK);
  } while (FALSE);

  /* Errors occured */
  errPrintf (NULL, __FILE__, __LINE__, "%s: %s: %s for %s",
             FN, p2Rf->model.name, msg, file);
  if (msgBuf)  strncpy (msgBuf, msg, msgBufLen);
  fclose (fp);

  return (ERROR);
}




static void P2RF_Report (unsigned int      la,
                         int               level)
/*
   Description
   -----------
   Print report for a single PEP-II RF VXI module.

   Parameters
   ----------
           la - Logical address of the module
        level - Detail level of report desired

   Returns
   -------
   nothing
*/
{
  Function ("P2RF_Report");

  volatile VXICSR        *csr;
  vxi16_t                 reg;
  Status                  status;
  P2RfPvt                *p2Rf = NULL;

  static char  	*addrMode[] = {"A16",                "A24/A32"         };
  static char  	*modid[]    = {"modid-on",           ""                };
  static char  	*sftInt[]   = {"",                   "soft-int-on"     };
  static char  	*extSt[]    = {"extended-self-testing", ""             };
  static char  	*st[]       = {"self-testing",       ""                };
  static char  	*sysFail[]  = {"",                   "sys-fail-inhibit"};
  static char  	*sysReset[] = {"",                   "sys-reset"       };


  if (level == 0)  return;

  status = P2RF_PCONFIG (la, p2Rf);
  if (status)
  {
    errPrintf (status, __FILE__, __LINE__, "%s: P2RF_PCONFIG failed", FN);
    return;
  }

  csr = VXIBASE (la);

  if (vxMemProbe((char *) &csr->dir.r.status, READ,
                 sizeof (reg), (char *) &reg) != OK)  return;

  if (VXIMAKE (csr) != P2RF_K_MAKE)  return;

  epicsPrintf ("\tDrawing: %s\n", p2Rf->model.drawing);
  epicsPrintf ("\tla=%02x address-mode=%s %s %s %s %s %s %s\n", la,
               addrMode [(reg & P2RF_M_A24A32)     >> P2RF_V_A24A32],
               modid    [(reg & P2RF_M_MODIDCMPL)  >> P2RF_V_MODIDCMPL],
               sftInt   [(reg & P2RF_M_SFTINT)     >> P2RF_V_SFTINT],
               extSt    [(reg & P2RF_M_READY)      >> P2RF_V_READY],
               st       [(reg & P2RF_M_PASSED)     >> P2RF_V_PASSED],
               sysFail  [(reg & P2RF_M_SYSFAILINH) >> P2RF_V_SYSFAILINH],
               sysReset [(reg & P2RF_M_SOFTRESET)  >> P2RF_V_SOFTRESET]);
  epicsPrintf ("\tDriver private handle = 0x%08x\n", (int)p2Rf);

  return;
}




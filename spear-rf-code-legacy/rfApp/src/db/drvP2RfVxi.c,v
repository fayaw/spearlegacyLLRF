Status P2RF_IntEnable (void)
/*
   Description
   -----------
   Routine to be called to enable interrupts for the PEP-II VXI modules.
   Ideally this routine should be called only after the global variable
   interruptAccept goes TRUE, but we still need to figure out how to do
   that.  This routine may be called multiple times without adverse
   affects.

   Parameters
   ----------
   none

   Returns
   -------
   status
*/
{

  Function ("P2RF_IntEnable");
  Status status = OK;



  /* Enable Interrupts */
#ifdef NIVXI
  EnableVXIint (P2RF_K_CONTROLLER, 1 << (P2RfIntLevel - 1));
  RouteVXIint  (P2RF_K_CONTROLLER, 0);
#else
#  ifdef NICPU030
  sysBusIntMaskSet (1 << (P2RfIntLevel - 1));
# endif
  status = devEnableInterruptLevel (intVXI, P2RfIntLevel);
#endif
  if (status)
    errPrintf (status, __FILE__, __LINE__,
               "%s: devEnableInterruptLevel failed", FN);

  return (status);
}



Status P2RF_IntDisable (void)
/*
   Description
   -----------
   Routine to globally disable interrupts for all PEP-II VXI modules.

   Parameters
   ----------
   none

   Returns
   -------
   status
*/
{
  Function ("P2RF_IntDisable");
  Status status = OK;


  /* Disable Interrupts */
#ifdef NIVXI
  DisableVXIint (P2RF_K_CONTROLLER, 1 << (P2RfIntLevel - 1));
  RouteVXIint  (P2RF_K_CONTROLLER, 0);
#else
#  ifdef NICPU030
  sysBusIntMaskSet (sysBusIntMaskGet () & ~(1 << (P2RfIntLevel - 1)));
#  endif
  status = devDisableInterruptLevel (intVXI, P2RfIntLevel);
#endif
  if (status)
    errPrintf (status, __FILE__, __LINE__,
               "%s: devDisableInterruptLevel failed", FN);
  return (status);
}




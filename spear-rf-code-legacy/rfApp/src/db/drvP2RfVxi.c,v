   Description
   -----------
   Given the frame and slot number return the logical address of the module.

   Parameters
   ----------
        frame - Logical address of the slot 0 controller
         slot - Slot number of the module of interest in the frame
           la - The corresponding logical address of the module of interest

   Returns
   -------
   status
*/
{
  /* Function ("P2RF_GetModuleLa"); */

  Status                    status=OK;
  epvxiDeviceSearchPattern  dsp;


  dsp.flags        = VXI_DSP_slot | VXI_DSP_slot_zero_la;
  dsp.slot_zero_la = frame;

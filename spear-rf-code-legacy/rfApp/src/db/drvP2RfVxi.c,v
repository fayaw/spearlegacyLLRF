void P2RF_ResetModule (void         *hndl)
/*
   Description
   -----------
   Function to reset a PEP-II RF module.  Note that this routine blocks
   whilst the reset is in progress.

   The black magic in this routine follows Leonid's Comb example.
   In order to do the reset, Leonid first clears the device specific
   control register which puts some of the modules in the LOAD state.
   The CFM requires this or it will be hosed up.  It doesn't do harm
   on the other modules.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block

   Returns
   -------
   nothing
*/
{
  /* Function ("P2RF_ResetModule"); */

  P2RfPvt         *p2Rf = hndl;
  unsigned short   mstt;
  unsigned short   mctl;


  mstt = p2Rf->csr->dir.r.status;
  mctl = mstt & ~(P2RF_M_SYSFAILINH | P2RF_M_SOFTRESET);
  p2Rf->devDep->devCtrl    = 0;
  p2Rf->csr->dir.w.control = mctl;
  p2Rf->csr->dir.w.control = mctl | P2RF_M_SOFTRESET;
  p2Rf->csr->dir.w.control = 0;
  p2Rf->csr->dir.w.control = mstt;

  taskDelay (P2RF_K_RESETTMO * sysClkRateGet ());
}



void P2RF_ReadVme (void             *hndl,
                   int               reg,
                   unsigned short   *val)
/*
   Description
   -----------
   Function to read a register in one of the VME spaces

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
          reg - An encoded index to the register
          val - A pointer to the location in which to return the read value

   Returns
   -------
   nothing
*/
{
  /* Function ("P2RF_ReadVme"); */

  P2RfPvt   *p2Rf = hndl;


  /* Return the requested register */
  if (reg & P2RF_M_SPACE)
  {
    vxi16_t   *csrs = (vxi16_t *) p2Rf->csr;
    int        idx = reg & P2RF_M_A16;

    FASTLOCK (&p2Rf->lock);
    *val = csrs[idx];
    FASTUNLOCK(&p2Rf->lock);

#if 0
    Dbg (Printf (__FILE__, FN, "reg = %d, adx = %08x, val = %h04x",
                 idx, &csrs[idx], *val));
#endif
  }
  else
  {
    vxi16_t   *ext  = p2Rf->ext;

    FASTLOCK (&p2Rf->lock);
    *val = ext[reg];
    FASTUNLOCK(&p2Rf->lock);

#if 0
    Dbg (Printf (__FILE__, FN, "reg = %d, adx = %08x, val = %h04x",
                 reg, &ext[reg], *val));
#endif
  }
}




Status P2RF_CopyMemory (void           *hndl,
                        int             index,
                        P2RfBufDsc     *bufDsc)
/*
   Description
   -----------
   Function to copy data from a module's 512K RAM to a private buffer.
   These RAMs are accessed through a single register location on the module.
   The module takes care of addressing the RAMS with up counters on writes
   (via the register or internally generated) or down counters (via reads
   from the register or internally generated), or vice versa depending on
   the implementation.

   Since the module owns the addressing of the memory, multiple clients
   should not be allowed to go after the memory at the same time.  The
   module can't know which client is requesting what.  For this reason
   all access routines must recognize when the memory is in use by another
   client.  This mutual exclusion is handled via a semaphore.  Thus, this
   routine will block execution whilst another client "owns" the memory
   by calling this or one of the other memory access routines.  (Perhaps
   we should add a timeout for this at some point?)

   In order to prevent haphazard calls of this routine from writing onto
   non-allocated blocks of local memory, a valid memory block address
   must be passed through a buffer descriptor.  This doesn't guard
   against the possibility of stomping all over local memory, but you
   have to try harder.

   Parameters
   ----------
         hndl - A pointer to the module-specific driver-private block
        index - The VME address index at which the memory resides
       bufDsc - A pointer to a buffer descriptor

   Returns
   -------
   ERROR if an error condition was encountered, OK otherwise
*/
{
  Function ("P2RF_CopyMemory");

  P2RfPvt                 *p2Rf   = hndl;
  register vxi16_t        *ext    = &p2Rf->ext[index];
  long                     status = OK;


  /* If there are multiple clients, lock out other RAM access attempts */
  if (p2Rf->sharedCnt)  semTake (p2Rf->shrSem, WAIT_FOREVER);/* Needs Timeout */

  /* Check that this is not a bogus call - client must know what he's doing */
  if (bufDsc->self == bufDsc)
  {
    register int           count  = bufDsc->count;
    register short        *buffer = bufDsc->buffer;

    *buffer = *ext;                     /* 1 read to get hdw ptr to last val */

    /* Copy the memory to the private buffer */
    while (count--) *buffer++ = *ext;
  }
  else
  {
    errPrintf (-1, __FILE__, __LINE__, "%s: Bad copy request", FN);
    status = ERROR;
  }

  /* If there are multiple clients free the next one */
  if (p2Rf->sharedCnt)  semGive (p2Rf->shrSem);

  return (status);
}




recordtype(p2RfClk) {
	include "dbCommon.dbd"
	field(VAL,DBF_STRING) {
		prompt("Status message")
		asl(ASL0)
		pp(TRUE)
		size(40)
	}
	field(OVAL,DBF_STRING) {
		prompt("Previous Value")
		special(SPC_NOMOD)
		interest(3)
		size(40)
	}
	field(OUT,DBF_OUTLINK) {
		prompt("Output Specification")
		promptgroup(GUI_OUTPUT)
		special(SPC_NOMOD)
		interest(1)
	}
	field(PREC,DBF_SHORT) {
		prompt("Display Precision")
		promptgroup(GUI_DISPLAY)
		interest(1)
	}
	field(MID,DBF_USHORT) {
		prompt("Manufacturer ID")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MTYP,DBF_USHORT) {
		prompt("Model Type")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MSTT,DBF_USHORT) {
		prompt("Module Status")
		special(SPC_NOMOD)
	}
	field(MCTL,DBF_USHORT) {
		prompt("Module Control")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(MRST,DBF_SHORT) {
		prompt("Module Reset")
		pp(TRUE)
		interest(2)
	}
	field(VATT,DBF_USHORT) {
		prompt("VXI Attributes")
		special(SPC_NOMOD)
		interest(3)
	}
	field(SERN,DBF_ULONG) {
		prompt("Serial Number")
		special(SPC_NOMOD)
		interest(3)
	}
	field(VERN,DBF_USHORT) {
		prompt("Version Number")
		special(SPC_NOMOD)
		interest(3)
	}
#
#  Hardware version and Firmware versiona
#
        field(VERH,DBF_USHORT) {
                prompt("Hardware Version")
                special(SPC_NOMOD)
                interest(3)
        }
        field(VERF,DBF_USHORT) {
                prompt("Firmware Version")
                special(SPC_NOMOD)
                interest(3)
        }
#
#  end of modification
#
	field(ISTT,DBF_USHORT) {
		prompt("Interrupt Status")
		special(SPC_NOMOD)
		pp(TRUE)
		interest(2)
	}
	field(OIST,DBF_USHORT) {
		prompt("Old Interrupt Status")
		interest(3)
	}
	field(IACK,DBF_USHORT) {
		prompt("Interrupt Oper Ack")
		pp(TRUE)
		interest(2)
	}
	field(ICTL,DBF_USHORT) {
		prompt("Interrupt Control")
		special(SPC_NOMOD)
		interest(2)
	}
	field(IMSK,DBF_UCHAR) {
		prompt("Interrupt Mask")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		base(HEX)
		interest(1)
	}
	field(OIMK,DBF_UCHAR) {
		prompt("Old Interrupt Mask")
		interest(3)
	}
	field(VSCL,DBF_USHORT) {
		prompt("VXI Subclass")
		special(SPC_NOMOD)
		interest(3)
	}
#
	field(TCTL,DBF_USHORT) {
		prompt("Trigger Control")
		special(SPC_NOMOD)
	}
	field(AUXO,DBF_UCHAR) {
		prompt("Auxiliary Out Trigger Level")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(1)
	}
	field(AXOE,DBF_UCHAR) {
		prompt("Auxiliary Out Trigger Enable")
		pp(TRUE)
		interest(3)
	}
	field(AUXI,DBF_UCHAR) {
		prompt("Auxiliary In Trigger Level")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(1)
	}
	field(AXIE,DBF_UCHAR) {
		prompt("Auxiliary In Trigger Enable")
		pp(TRUE)
		interest(3)
	}
	field(SFTT,DBF_UCHAR) {
		prompt("Software Trigger Enable")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(1)
	}
#
	field(HNRB,DBF_FLOAT) {
		prompt("Harmonic Number Readback")
		special(SPC_NOMOD)
	}
#
# Version 2 registers.
#
	field(DCTL,DBF_USHORT) {
		prompt("Clock Delay Control")
		special(SPC_NOMOD)
	}
	field(SCTL,DBF_USHORT) {
		prompt("Synch/Calib Control")
		special(SPC_NOMOD)
	}
	field(P391,DBF_USHORT) {
		prompt("PLL 39MHz consts 1")
		special(SPC_NOMOD)
	}
	field(P392,DBF_USHORT) {
		prompt("PLL 39MHz consts 2")
		special(SPC_NOMOD)
	}
	field(P471,DBF_USHORT) {
		prompt("PLL 471MHz consts")
		special(SPC_NOMOD)
	}
	field(PCL1,DBF_USHORT) {
		prompt("PLL Calib consts 1")
		special(SPC_NOMOD)
	}
	field(PCL2,DBF_USHORT) {
		prompt("PLL Calib consts 2")
		special(SPC_NOMOD)
	}
	field(SNCH,DBF_FLOAT) {
		prompt("Synch Delay")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
	field(TCLK,DBF_FLOAT) {
		prompt("Turn clk Synch Delay")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
	field(CALN,DBF_UCHAR) {
		prompt("Calibrate on/off")
		promptgroup(GUI_COMMON)
	}
#
# end version 2 specific fields
#
	field(FDEL,DBF_FLOAT) {
		prompt("Fiducial Delay")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
	field(TCSL,DBF_UCHAR) {
		prompt("Turn Clock Select")
		promptgroup(GUI_COMMON)
	}
	field(C39D,DBF_FLOAT) {
		prompt("Clk39 Delay Select")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
	field(RSYN,DBF_UCHAR) {
		prompt("Resynchronize Clocks")
		pp(TRUE)
		interest(3)
	}
	field(PLL3,DBF_USHORT) {
		prompt("39.3 MHz PLL Constants")
		interest(2)
	}
	field(PLL4,DBF_USHORT) {
		prompt("471.1 MHz PLL Constants")
		interest(2)
	}
	field(P4CS,DBF_UCHAR) {
		prompt("471.1 MHz PLL Const Select")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
	field(OP4C,DBF_UCHAR) {
		prompt("Old 471.1 MHz PLL Const Select")
		interest(3)
	}
#
# RIST fields is used to read the Interrupt Status Id Registers.
# This should NOT be used if interrupts are enabled on this board.
#
        field(RIST,DBF_UCHAR) {
                prompt("Read Int Status ID Registers")
                pp(TRUE)
                interest(2)
        }
}
@



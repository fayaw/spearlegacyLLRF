/*====================================================

  Abs:  Subroutine record initialization

  Name: subSysInit

  Args: psub                       Subroutine record info
          Use:  pointer            
          Type: struct subRecord * 
          Acc:  read/write        
          Mech: reference

  Rem: General purpose initialization required since all 
       subroutine records require a non-NULL init routine 
       even if no initialization is required.  Note that most 
       subroutines in this file use this routine as an init
       routine.  If init logic is needed for a specific 
       subroutine, create a new routine for it - don't modify 
       this one.

  Side: None
   
  Ret: long  
            OK - Successful operation (Always)

=======================================================*/
static long subSysInit(struct subRecord *psub)
{
  return(OK);
}

static long subSysFreqOff(struct subRecord *psub)
{
  /*
   * Estimate cavity frequency offset.
   * Inputs:  A = Zeroth Polynomial Coefficient (p0)
   *          B = First  Polynomial Coefficient (p1)
   *          C = Second Polynomial Coefficient (p2)
   *          D = Third  Polynomial Coefficient (p3)
   *          E = Temperature       Coefficient (t1)
   *          F = Tuner Home    Position (mm)
   *          G = Tuner Current Position (mm)
   *          H = Cavity Voltage         (kV)
   *          L = Smoothing Factor (0 to 1)
   *          VAL = Previous Smoothed Value (kHz)
   *  Outputs:I = Position Difference    (mm)
   *          J = Polynomial  Term       (kHz)
   *          K = Unsmoothed Cavity Frequency Offset Estimate (kHz)
   *          VAL = Smoothed Cavity Frequency Offset Estimate (kHz)
   */
  /* Calculate position difference from home and the polynomial term. */
  psub->i = psub->g - psub->f;
  psub->j = psub->a + (psub->b * psub->i) + (psub->c * psub->i * psub->i) +
            (psub->d * psub->i * psub->i * psub->i);
  /* Calculate the raw (unsmoothed) frequency offset */
  psub->k = psub->j + (psub->e * psub->h * psub->h);
  /* Check for a valid smoothing factor and do the smoothing */
  if      (psub->l < 0.0) psub->l = 0.0;
  else if (psub->l > 1.0) psub->l = 1.0;
  psub->val = (psub->k * (1 - psub->l)) + (psub->val * psub->l);
  return (OK);
}

static long subSysFreqErr(struct subRecord *psub)
{
  /*
   * Calculate cavity park frequency error =
   * (90/(476e3*4))*Loaded Cavity Q*(Desired Park Frequency - Frequency Offset)
   * Inputs:  A = 90/(476e3*4)                  (degrees/kHz)
   *          B = Load Cavity Q (QL)
   *          C = Desired Cavity Park Frequency (kHz)
   *          D = Cavity Frequency Offset       (kHz)
   *  Outputs:L = Frequency Difference          (kHz)
   *          VAL = Cavity Park Frequency Error (degrees)
   */
  psub->l   = psub->c - psub->d;
  psub->val = psub->a * psub->b * psub->l;
  return (OK);
}

static long subSysFreqOAvg(struct subRecord *psub)
{
  /*
   * Calculate average cavity frequency offset.
   * Inputs:  A = Cavity A Freq     Offset (kHz)
   *          B = Cavity B Freq     Offset (kHz)
   *          C = Cavity C (HER)/Cavity A (LER) Freq Offset (kHz)
   *          D = Cavity D (HER)/Cavity B (LER) Freq Offset (kHz)
   *  Outputs:VAL = Average  Freq   Offset (kHz)
   */
  psub->val = (psub->a + psub->b + psub->c + psub->d)/4;
  return (OK);
}

static long subSysPhaseTot(struct subRecord *psub)
{
  /*
   * Calculate total direct loop phase.
   * Inputs:  A = Direct Loop On/Off       (0 = Off, >0 = On)
   *          B = Station Group Delay      (nsec)
   *          C = Direct Loop Phase        (degrees)
   *          D = Calibration Phase Offset (degrees)
   *          E = Direct Loop Tracking Flag (0 = Off, >0 = On)
   *          F = Average Cavity Freq Offset Conversion Constant
   *          G = Max Direct Loop Delta Phase (>0)   (degrees)
   *          H = Maximum Phase Change (>0)    (degrees)
   *          I = First Time flag              
   *          J = Average Cavity Freq Offset (kHz)
   *  Outputs:K = Direct Loop Delta Phase            (degrees)
   *          L = Unadjusted Total Direct Loop Phase (degrees)
   *          VAL = Adjusted Total Direct Loop Phase (degrees)
   */
  double temp;
  /* 
   * Calculate direct loop delta phase if both loop and tracking are on.
   * Limit-check.
   */
  if ((psub->e > 0.0001) && (psub->a > 0.001))
  {
     psub->k = -0.000360 * psub->b * psub->j * psub->f;
     if      (psub->k >  psub->g) psub->k =  psub->g;
     else if (psub->k < -psub->g) psub->k = -psub->g;
  }
  else
  {
     psub->k = 0.0;
  }
  /* If first time through then initialize l */
  if (psub->i < 0.001) {
    psub->l = psub->c + psub->d + psub->k;
    psub->i = 1.0;
  }
  /* Calculate the total direct loop phase and adjust. */ 
  temp = psub->c + psub->d + psub->k - psub->l;
  if (psub->h <= 0) psub->h = 0.1;  /* Set to a default value */
  if      (temp >  psub->h) temp =  psub->h;
  else if (temp < -psub->h) temp = -psub->h;
  psub->val = psub->l = psub->l + temp;
  if      (psub->val < -180.0) psub->val += 360.0;
  else if (psub->val >  180.0) psub->val -= 360.0;
  return (OK);
}

static long subSysPhaseCmb(struct subRecord *psub)
{
  /*
   * Calculate total comb loop phase.
   * Inputs:  A = Comb Loop Phase                  (degrees)
   *          B = Direct Loop Delta Phase          (degrees)
   *          C = Direct Loop Delta Phase Conversion Constant
   *          D = Calibration Phase Offset         (degrees)
   *  Outputs:K = Comb Loop Delta Phase            (degrees)
   *          L = Unadjusted Total Comb Loop Phase (degrees)
   *          VAL = Adjusted Total Comb Loop Phase (degrees)
   */
  /* Calculate the total comb loop phase and adjust. */
  psub->k = -psub->b * psub->c;
  psub->l = psub->a + psub->d + psub->k;
  psub->val = psub->l;
  if      (psub->val < -180.0) psub->val += 360.0;
  else if (psub->val >  180.0) psub->val -= 360.0;
  return (OK);
}

static long subSysPhaseStn(struct subRecord *psub)
{
  /*
   * Calculate station phase.
   * Inputs:  A = Phase Adjustment by the User (degrees)
   *          B = Maximum Phase Change (>0)    (degrees)
   *          C = Base Phase                   (degrees)
   *          D = Direct Loop Delta Phase      (degrees)
   *          I = First Time flag              
   * Outputs: K = Unadjusted Phase Difference  (degrees)
   *          L = Unadjusted Station Phase     (degrees)
   *          VAL = Station Phase              (degrees)
   */
  /* If first time through then initialize l */
  if (psub->i < 0.001) {
     psub->l = psub->a + psub->c + psub->d;
     psub->i = 1;
  }
  psub->k = psub->a + psub->c + psub->d - psub->l;
  if (psub->b <= 0.0) psub->b = 0.1;  /* Set to a default value */
  if      (psub->k >  psub->b) psub->k =  psub->b;
  else if (psub->k < -psub->b) psub->k = -psub->b;
  psub->val = psub->l = psub->l + psub->k;
  if      (psub->val < -180.0) psub->val += 360.0;
  else if (psub->val >  180.0) psub->val -= 360.0;

  return(OK);
}

static long subSysDCcoeff (struct subRecord *psub)
{
  /*
   * Calculate ripple loop DC gain coefficient for ripple loop gain tracking:
   *  DC coefficient = original DC coefficient *
   *                   (10**(delta klystron gain/20)) 
   *  where delta klystron gain = gain setpoint - klystron gain 
   *  with a user-supplied limit on the delta in one calculation cycle.
   * Inputs:  A = Ripple Loop Gain Tracking Flag (0 = Off, >0 = On)
   *          B = Klystron Gain                                (dB)     
   *          C = Desired Klystron Gain                        (dB)     
   *          D = Calculated Maximum DC Coefficient            (volts)
   *          E = Klystron Gain Deadband                       (dB)     
   *          F = Maximum Delta DC Coefficient                 (volts)       
   *          G = Current DC Coefficient                       (volts)
   *          H = Beam Abort      (0 = no beam abort, >0 = beam abort)
   *          K = Initial DC Coefficient                       (volts)
   *       HOPR = High DC Coefficient Limit                    (volts)
   *       LOPR = Low  DC Coefficient Limit                    (volts)       
   * Outputs: VAL = DC Coefficient                             (volts)
   *          I = Previous Delta Gain                          (dB)   
   *          J = Previous Gain Tracking Flag    (0 = Off, >0 = On)
   *          L = Delta DC Coefficient                         (volts)
   */
  /*
   * Find the difference between the current delta gain and the delta
   * gain used in the previous calculation.  Don't let that difference
   * be greater than the deadband.
   */
  if (psub->d < 0.001) psub->d = 0.001;
  if (psub->g < 0.001) psub->g = 0.001;
  psub->i = log10(psub->g/psub->d)*20.0;
  psub->l = psub->c - psub->b - psub->i;
  if      (psub->l >  psub->e) psub->l =  psub->e;
  else if (psub->l < -psub->e) psub->l = -psub->e;
  /*
   * Calculate the delta DC coefficient needed to reach the next
   * gain step.  Also, don't step the coefficient more than a reasonable 
   * amount.  Make sure the calculated maximum DC coefficient is something 
   *> 0 to prevent divide-by-zero error towards the end of this routine.
   */
  psub->l = (psub->i + psub->l)/20.0;
  psub->l = (psub->d * pow(10.0, psub->l)) - psub->g;
  if      (psub->l >  psub->f) psub->l =  psub->f;
  else if (psub->l < -psub->f) psub->l = -psub->f;
  /*
   * Don't set a new DC coefficient until the beam abort is reset.
   * Keep using the current value until then.
   * Also, if the tracking flag is off but was on the last time around,
   * reset the DC coefficient to the initial value.  If tracking
   * is off and has been off, we won't reset the value since the
   * user may be manually adjusting it (ie, with a slider).  If the
   * klystron gain is low (ie, we're in park), don't set a new coeff.
   */
  if ((psub->a < 0.5) || (psub->h > 0.5) || (psub->b < 0.1))
  {
     if (psub->j > 0.5) psub->val = psub->k;
     /* No previous tracking. */
     psub->j = 0.0;
  }
  /*
   * Otherwise, tracking is on so add delta coefficient to the current value.
   * Update the previous tracking flag.
   */
  else
  {
     psub->val = psub->g + psub->l;
     psub->j = psub->a;
  }
  /* 
   * Check against limits.  
   */
  if      (psub->val > psub->hopr) psub->val = psub->hopr;
  else if (psub->val < psub->lopr) psub->val = psub->lopr;
  return(OK);
}

static long subSysDrivSel (struct subRecord *psub)
{
  /*
   * Determine which drive power setpoint to use during ON_CW operation.
   * Inputs:  A = Klystron Output Forward Power              (kW)
   *          B = Limit on A for high beam current operation (kW)
   *          C = Hysterisis on Limit Check                  (kW)
   *          VAL = Previous Selection
   * Outputs: VAL = New Selection:
   *                0 = Use Lowest Setpoint for RF Station Turnon
   *                1 = Use Low  Beam Current Setpoint
   *                2 = Use High Beam Current Setpoint
   *                3 = Use Saturated Drive Power as Setpoint
   */
  /*
   * Check if klystron power is high or has been high and hasn't gone
   * low enough yet.
   */
  if ((psub->a >= psub->b) || 
      ((psub->val > 1.5) && (psub->a >= (psub->b - psub->c))))
  {
    psub->val = 2.0;
  }
  /*
   * Don't support 0 or 3 at this time.
   */
  else
  {
    psub->val = 1.0;
  }
  return(OK);
}

static long subSysLog (struct subRecord *psub)
{
  /*
   * Calculate value from the log of the value.  Used for vacuums and
   * ion pump currents.
   * Inputs:  A = Log of the Value
   *          B = Conversion Constant
   *          C = Last Monitored Value of the Log (MLST)
   *          D = Last Archived  Value of the Log (ALST)
   *          I = Previous Non-Zero Monitor Delta
   *          J = Previous Non-Zero Archive Delta
   *          K = Previous Monitored Value of the Log
   *          L = Previous Archived  Value of the Log
   *          MDEL = Monitor Delta
   *          ADEL = Archive Delta
   * Outputs: VAL  = Value from the Log
   *          I = Previous Non-Zero Monitor Delta
   *          J = Previous Non-Zero Archive Delta
   *          K = Previous Monitored Value of the Log
   *          L = Previous Archived  Value of the Log
   *          MDEL = Monitor Delta
   *          ADEL = Archive Delta
   */
  /*
   * Calculate value.
   */
  psub->val = psub->b * pow(10.0, psub->a);
  /*
   * Force a monitor if the log of the value had one.
   */
  if (psub->mdel != 0.0)    psub->i    = psub->mdel;
  if (psub->c == psub->k)   psub->mdel = psub->i;
  else { psub->k = psub->c; psub->mdel = 0.0; }
  /*
   * Force an archive if the log of the value had one.
   */
  if (psub->adel != 0.0)    psub->j    = psub->adel;
  if (psub->d == psub->l)   psub->adel = psub->j;
  else { psub->l = psub->d; psub->adel = 0.0; }

  return(OK);
}

static long subSysABreset(struct subRecord *psub)
{
  /*
   * Reset Allen-Bradley.
   */
  epicsPrintf("Allen-Bradley reset started\n");
  ab_reset();
  return(OK);
}


static void GvfIsr (void           *brdArg,
                    unsigned short  intStat)
/*
   Description
   -----------
   Device specific routine to handle interrupts generated by the module.
   It runs in the context of the Interrupt Service Routine.  Thus all
   the rules for coding at IPL apply.

   In this case, alarms are set depending on the interrupt type.

   Parameters
   ----------
       brdArg - A pointer to the device private structure
      intStat - The interrupt status mask

   Returns
   -------
   nothing
*/
{
#if 0
  Function ("GvfIsr");
#endif

  GvfBoard       *brd = (GvfBoard *) brdArg;
  P2RfGvfRecord  *rec = brd->rec;


#if 0
  if (intStat & GVF_M_SFTWERR)
    logMsg ("%s: Software error\n", (int)FN,0,0,0,0,0);
  if (intStat & GVF_M_HDWERR)
    logMsg ("%s: Hardware error\n",(int) FN,0,0,0,0,0 );
  if (intStat & GVF_M_TAXIERR)
    logMsg ("%s: TAXI error\n", (int)FN,0,0,0,0,0);
  if (intStat & GVF_M_TAXISYNC)
    logMsg ("%s: TAXI Synchronization error\n", (int)FN,0,0,0,0,0);
  if (intStat & GVF_M_LFBLINK)
    logMsg ("%s: LFB Link Error\n", (int)FN,0,0,0,0,0);
  if (intStat & GVF_M_XFRFNEND)
    logMsg ("%s: Transfer Function End\n",(int) FN,0,0,0,0,0);
  if (intStat & GVF_M_DSPMSG)
    logMsg ("%s: Message from DSP\n",(int) FN,0,0,0,0,0);
  if (intStat & GVF_M_SOFTWARE)
    logMsg ("%s: Software interrupt\n", (int)FN,0,0,0,0,0);
#endif

  /* Handle messages from the DSP */
  if (intStat & GVF_M_DSPMSG)
  {
    /* Invoke the DSP message handling callback */
    callbackRequest (&brd->dspMsgBlk.callback);

    /* Take the DSP message bit down in the interrupt mask */
    intStat ^= GVF_M_DSPMSG;
  }

  /* Update mask of interrupts set */
  if (intStat & (intStat ^ rec->istt))  /* Is bit already set in istt? */
  {
    rec->istt |= intStat;

    /* Process forward links */
    brd->intPrc++;
    scanOnce ((dbCommon *)rec);
  }
}



static long DspFindComBlk (void                *drvPvt,
                           volatile DspComBlk **comBlk)
/*
   Description
   -----------

   Parameters
   ----------

   Returns
   -------

*/
{
  Function ("DspFindComBlk");


  /* Get the pointer to the communications block */
  if (P2RF_DspFindComBlk (drvPvt, (volatile void **) comBlk) == OK)
  {
    /* Check the comBlk ID and version numbers */
    if ((*comBlk)->blkId != DSP_K_COMBLKID)
    {
      P2RF_Printf (__FILE__, FN,
                   "DSP has different comBlk ID %u than the expected %u",
                   (*comBlk)->blkId, DSP_K_COMBLKID);
      return (ERROR);
    }
    if ((*comBlk)->vers  != DSP_K_COMVERS)
    {
      P2RF_Printf (__FILE__, FN,
                   "DSP has different comBlk version %u than the expected %u",
                   (*comBlk)->vers, DSP_K_COMVERS);
      return (ERROR);
    }
  }

  return (OK);
}



static void DspMsgCallback (GvfDspMsgBlk *blk)
/*
   Description
   -----------
   This function handles messages from the on-board DSP.  It is invoked
   by the callback facility when a DSP message interrupt is received.

   Parameters
   ----------
          blk - A pointer to the DSP message handling block

   Returns
   -------
   nothing
*/
{
  Function ("DspMsgCallback");

  P2RfGvfRecord        *rec;
  volatile DspComBlk   *comBlk = blk->comBlk;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;

  /* If the comBlk pointer is not yet initialized, initialize it */
  if (comBlk == NULL)
  {
    if (DspFindComBlk (blk->drvPvt, &comBlk) != OK)
    {
      P2RF_Printf (__FILE__, FN, "Could not find a valid communications block");
      return;
    }

    blk->comBlk = comBlk;
  }

  /* Decide what to do, given the message */
  switch (comBlk->dspMsg)
  {
    /*
    ** The CMD_K_READY messages are used only during the initialization sequence.
    */
    case CMD_K_READY:
    {
      /*
      ** Send reference constants. Get OKAY response.
      */
      if (comBlk->dspArg == STT_WTREF)
      {
        GvfDspMsgPrm  *prm = blk->prm;
        long           status;

        epicsPrintf ("STT_READY message received from GVF DSP.\n");
        if ((status = P2RF_ReadConstsFile (blk->drvPvt, prm->id, rec->dspt,
                                           prm->count, prm->consts,
                                           rec->val, sizeof (rec->val), 0)) == OK)
        {
	  prm->consts[0] = (rec->iref << GVF_V_REF) & GVF_M_REF;
	  prm->consts[1] = (rec->qref << GVF_V_REF) & GVF_M_REF;
	  /*
	  ** Temp kludge check the buffer offset.
	  */
          if (prm->consts[6] < 0)
             prm->consts[6] = 0;
          if (prm->consts[6] > 143)
             prm->consts[6] = 143;
          P2RF_LoadConsts (blk->drvPvt, prm->consts, prm->count, prm->index);
          rec->dtst = NO_ALARM;
          /* Load the response: Reference table and address */
	  comBlk->cpuLbl = 0;           /* Init sequence number */
	  comBlk->cpuMsg = CMD_K_LDREF; /* Table type */
          comBlk->cpuArg = DSP_A_ERAM + (prm->index & 0xffff); /* Location it was loaded at */
          comBlk->cpuComLen = prm->count;

          /* 
	  ** Tell DSP to read our response. Don't lower line until DSP responds
	  ** with an OKAY since it polls the MSGTODSP line. After initialization
	  ** MSGTODSP generates an interrupt so we don't need this machination.
	  */
          P2RF_WriteVme (blk->drvPvt, GVF_I_GFFCTRL, rec->gctl | GVF_M_MSGTODSP);
        }
        else
        {
          char  buf[P2RF_K_BUFSIZE];

          recGblRecordError (status, rec,
                             P2RF_Sprintf (buf, __FILE__, FN,
                                           "%s failed - id = %s, file = %s",
                                           "P2RF_ReadConstsFile",
                                           prm->id, rec->dspt));
          rec->dtst = UDF_ALARM;
        }
      }
      /*
      ** OK Response to WTREF msg.
      */
      else if (comBlk->dspArg == STT_OKAY)
      {
         rec->gctl &= ~GVF_M_MSGTODSP;    /* Insure MSGTODSP line is low */
         P2RF_WriteVme (blk->drvPvt, GVF_I_GFFCTRL, rec->gctl); /* Lower MSGTODSP */
	 epicsPrintf ("STT_OKAY message received from GVF DSP.\n");
      }
      /*
      **  DSP is unhappy with our LDREF message.
      */
      else if (comBlk->dspArg == STT_INVCPUMSG)
      {
         epicsPrintf 
	   ("Gap Voltage DSP sent INVCPUMSG reponse during initialization.\n" );
      }
      else
      {
         P2RF_WriteVme (blk->drvPvt, GVF_I_GFFCTRL, rec->gctl); /* Lower MSGTODSP */
	 epicsPrintf ("Unexpected CMD_K_READY message from DSP in GVF module.\n");
      }
    }
    break;

#if 0                                   /* Needs timeout */
    case CMD_K_NFUNC:
      /* Delay a bit to let db_post_events flush */
      taskDelay (sysClkRateGet () / 10);

      /* Lock the record to prevent processing during critical times */
      dbScanLock       ((struct dbCommon *) rec);

      /* Complete the record processing */
      (*rSet->process) (rec);

      /* Unlock the record */
      dbScanUnlock     ((struct dbCommon *) rec);
      break;
#endif
      /*
      ** Error message from DSP.
      */
    case CMD_K_ERROR:
      strncpy (rec->val, "DSP crashed", sizeof (rec->val));
      P2RF_Printf (__FILE__, FN, "DSP crashed with error status %h04x",
                   comBlk->status);
      break;
      /*
      ** Unknown message from DSP.
      */
    default:
      epicsPrintf ("Unknown message 0x%X received from DSP.\n",comBlk->dspMsg);
      break;

  }
}




static void LdDspCallback (GvfDspBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to load and start the module's DSP.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the DSP block

   Returns
   -------
   nothing
*/
{
  /* Function ("LdDspCallback"); */

  P2RfGvfRecord    *rec;
  struct rset      *rSet;
  unsigned short    reg;
  GvfDspPrm        *prm = blk->prm;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Reset the DSP */
  P2RF_ReadVme  (blk->drvPvt, GVF_I_GFFCTRL, &reg);
  P2RF_WriteVme (blk->drvPvt, GVF_I_GFFCTRL, reg & ~GVF_M_NOTDSPRST);

  /* Load the DSP */
  if ((blk->status = P2RF_LoadDsp (blk->drvPvt, prm->index, prm->file, FALSE,
                                   rec->val, sizeof (rec->val))) == OK)
  {
    /* Boot the DSP */
    P2RF_WriteVme (blk->drvPvt, GVF_I_GFFCTRL, reg | GVF_M_NOTDSPRST);
  }

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}




    strncpy (rec->val,  "Load DSP: active", sizeof (rec->val));
    strncpy (rec->oval, "Load DSP: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);
    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before DSP-load completes */

void TIM_CmpDateWithEpics (void)
/*
   Description
   -----------
   Really a routine for testing, but we'll leave it for the time being.
   This routine reports the difference between the VxWorks and EPICS
   clock counters for both the seconds and nanoseconds parts of the structure.
   This is how I found the 20 year difference in counting styles even though
   the claim is that the VxWorks epoch = the Unix epoch = January 1, 1900 and
   the EPICS epoch is January 1, 1990.  It seems to me that the VxWorks epoch
   is really January 1, 1970.

   Parameters
   ----------
   none

   Returns
   -------
   none
*/
{
  void TIM_rdate (void);

  struct timespec tp1;
  struct timespec tp2;

  TIM_rdate ();

  clock_gettime (CLOCK_REALTIME, &tp1);
  TScurrentTimeStamp (&tp2);

  printf ("clock - epics: sec = %u, nsec = %u\n",

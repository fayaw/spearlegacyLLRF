void TIM_SetDate (unsigned long  secs)
/*
   Description
   -----------
   Set the clock according to user input

   Parameters
   ----------
         secs - Number of seconds since Jaunuary 1, 1900

   Returns
   -------
   none
*/
{
  /* Assume the time is in GMT */
  struct timespec tp;

  tp.tv_sec  = secs;
  tp.tv_nsec = 0;

  clock_settime (CLOCK_REALTIME, &tp);
  printf ("The new time is set to: ");
  TIM_date ();
}



void TIM_rdate (void)
/*
   Description
   -----------
   Routine like UNIX' rdate function.  This function gets the time from
   the boot host.

   Parameters
   ----------
   none

   Returns
   -------
   none
*/
{
  struct sockaddr_in  sockaddr;
  struct timespec     tp;
  int                 s;
  unsigned long       t;
  char               *buffer=NULL;
  char               *hostname=NULL;
  int                 nbytes;
  int                 nread;
  unsigned long       offset = 0x83AA7E80;  /* 2208988800 (dec)*/


  memset ((char *)(&sockaddr), NULL, sizeof (sockaddr));
  sockaddr.sin_family = AF_INET;

  buffer = getenv("TS_RDATE_IPPORT");
  if ( !buffer ) 
    /* use default port */
    sockaddr.sin_port   = htons (IPPORT_TIMESERVER);
  else 
    /* use the specified port */
    sockaddr.sin_port = (unsigned short)atoi(buffer);

  hostname = getenv("TS_RDATE_SERVER");
  if ( hostname==NULL ) {
    /* use boot host if the environment variable not set */
    sockaddr.sin_addr.s_addr = hostGetByName(SERVER);
    hostname = (char *)SERVER;
  }
  else 
    sockaddr.sin_addr.s_addr = hostGetByName(hostname);

  if ((s = socket (AF_INET, SOCK_STREAM, 0)) == ERROR)
  {
    perror ("TIM_rdate: socket () error");
    return;
  }

  if (connect (s, (struct sockaddr *) &sockaddr, sizeof (sockaddr)) == ERROR)
  {
    close (s);
    perror ("TIM_rdate: connect () to socket error");
#ifdef DBG
    printf("TIM_rdate: server=%s  ip=%ld port=%.2d  family=%.2d\n",
            hostname,
            sockaddr.sin_addr.s_addr,
            sockaddr.sin_port,
            sockaddr.sin_family);
#endif
    return;
  }
  buffer = (char *) &t;
  nbytes = sizeof (t);
  while (nbytes)
  {
    if ((nread = read (s, buffer, nbytes)) == ERROR )
    {
      close (s);
      perror ("TIM_rdate: read () error on socket");
      return;
    }
    nbytes -= nread;
    buffer += nread;
  }
  close (s);

  /*
  | There are 2208988800 = (70*365+17)*24*60*60 (17 leap years with 366 days)
  | seconds between 1/1/1900 (the UNIX epoch) and 1/1/1970 (the VxWorks epoch).
  */

  tp.tv_sec = (long) (ntohl (t) - offset);
  tp.tv_nsec = 0;
#ifdef DBG
  printf ("rdate: host secs since 1/1/1900 = %08lx, tgt secs since 1/1/1970 = %08lx\n", t, tp.tv_sec);
#endif
  clock_settime (CLOCK_REALTIME, &tp);
}


int TIM_SetRate( int rate ) 
/*
   Description
   -----------
   This function sets a new clock rate and ensures that
   time of dat clock stays in sync by calling clock_setres()
   after setting the new rate.

   Parameters
   ----------
        rate - Number of ticks per second.

   Returns
   -------
   long 
          OK    - Successful Operation
          ERROR - Operation Failed
          -2    - Warning, set odd clock rate          
*/
{
   int             status = ERROR;
   int             cur_rate;
   clockid_t       clock_id = CLOCK_REALTIME;
   struct timespec ts_s;

  /* Clock rate can only be set betweek 30Hz and 1000Hz */
   if ( (rate<30) || (rate>1000)) {
      logMsg("Attempt to set invalid clock rate of %dHz (30Hz-1000Hz)\n",
             rate,0,0,0,0,0);
   }
   else {  
     if ( rate & 1 ) 
        logMsg("Warning! Unexpected results occur when setting an odd % of ticks per second\n",
               0,0,0,0,0,0);
     cur_rate = sysClkRateGet();
     status   = sysClkRateSet( rate );
     if ( status!=OK ) 
       logMsg("Failed to set clock rate to %dHz\n",rate,0,0,0,0,0);
     else {
       ts_s.tv_sec  = 0;                       
       ts_s.tv_nsec = (long)(1000000000/rate);
       status = clock_setres(clock_id,&ts_s);
       if ( status!=OK )
         logMsg("Failed to set clock resolution\n",0,0,0,0,0,0);
       else
         logMsg("Successfully set clock rate from %dHz to %dHz\n",
                cur_rate,rate,0,0,0,0);
     }
   }
   return(status);
}


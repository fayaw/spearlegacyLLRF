#ifndef HBLIB_H
#define HBLIB_H

#include "sglLib.h"
#include "busLib.h"

#define HB_K_LINKCNT       4            /* Number of links */
#define HB_K_DEFVALUE      0x80         /* Default DAC value */

#define HB_K_CSRSPACE      SPC_K_A16    /* Space CSR registers reside in */
#define HB_K_CSRSIZE       SIZ_K_SHORT  /* Size of CSR space transactions */
#define HB_A_CSRS          0x8100       /* CSR register location */
#define HB_K_CSRCOUNT      3            /* Number of CSRs */

#define HB_K_LUTSPACE      SPC_K_A24    /* Space lookup table resides in */
#define HB_K_LUTSIZE       SIZ_K_LONG   /* Size of Lookup Table transactions */
#define HB_A_LUTABLE       0x810000     /* Lookup table location */
#define HB_K_LUTLEN        0x0800       /* Lookup table size in long words */

#define HB_K_BOARDID       0x0002       /* Hold Buffer board ID */
#define HB_K_REVISION      0x0000       /* Current expected rev level */

#define HB_A_CSR0          (volatile unsigned short *) (HB_A_CSRS + 0x0000)
#define HB_A_CSR1          (volatile unsigned short *) (HB_A_CSRS + 0x0002)
#define HB_A_CSR2          (volatile unsigned short *) (HB_A_CSRS + 0x0004)


/* Hold buffer data format */
#define HB_V_BCKT0          0
#define HB_M_BCKT0         (0x000000ff << HB_V_BCKT0)
#define HB_V_BCKT1          8
#define HB_M_BCKT1         (0x000000ff << HB_V_BCKT1)
#define HB_V_BCKT2         16
#define HB_M_BCKT2         (0x000000ff << HB_V_BCKT2)
#define HB_V_BCKT3         24
#define HB_M_BCKT3         (0x000000ff << HB_V_BCKT3)


/* CSR 0 - Master Status and Control Register */
#define HB_V_RUNENB         0
#define HB_M_RUNENB        (0x0001 << HB_V_RUNENB)
#define HB_V_DACENB         1
#define HB_M_DACENB        (0x0001 << HB_V_DACENB)
#define HB_V_RXENB          2
#define HB_M_RXENB         (0x0001 << HB_V_RXENB)
#define HB_V_IDL0ERR        3
#define HB_M_IDL0ERR       (0x0001 << HB_V_IDL0ERR)
#define HB_V_IDL1ERR        4
#define HB_M_IDL1ERR       (0x0001 << HB_V_IDL1ERR)
#define HB_V_IDL2ERR        5
#define HB_M_IDL2ERR       (0x0001 << HB_V_IDL2ERR)
#define HB_V_IDL3ERR        6
#define HB_M_IDL3ERR       (0x0001 << HB_V_IDL3ERR)
#define HB_V_BOARDID        8
#define HB_M_BOARDID       (0x003f << HB_V_BOARDID)
#define HB_V_REVISION      12
#define HB_M_REVISION      (0x0003 << HB_V_REVISION)

#define HB_V_SETRUNENB      0
#define HB_M_SETRUNENB     (0x0001 << HB_V_SETRUNENB)
#define HB_V_SETDACENB      1
#define HB_M_SETDACENB     (0x0001 << HB_V_SETDACENB)
#define HB_V_SETRXENB       2
#define HB_M_SETRXENB      (0x0001 << HB_V_SETRXENB)
#define HB_V_SETIDL0ERR     3
#define HB_M_SETIDL0ERR    (0x0001 << HB_V_SETIDL0ERR)
#define HB_V_SETIDL1ERR     4
#define HB_M_SETIDL1ERR    (0x0001 << HB_V_SETIDL1ERR)
#define HB_V_SETIDL2ERR     5
#define HB_M_SETIDL2ERR    (0x0001 << HB_V_SETIDL2ERR)
#define HB_V_SETIDL3ERR     6
#define HB_M_SETIDL3ERR    (0x0001 << HB_V_SETIDL3ERR)

#define HB_V_CLRRUNENB      8
#define HB_M_CLRRUNENB     (0x0001 << HB_V_CLRRUNENB)
#define HB_V_CLRDACENB      9
#define HB_M_CLRDACENB     (0x0001 << HB_V_CLRDACENB)
#define HB_V_CLRRXENB      10
#define HB_M_CLRRXENB      (0x0001 << HB_V_CLRRXENB)
#define HB_V_CLRIDL0ERR    11
#define HB_M_CLRIDL0ERR    (0x0001 << HB_V_CLRIDL0ERR)
#define HB_V_CLRIDL1ERR    12
#define HB_M_CLRIDL1ERR    (0x0001 << HB_V_CLRIDL1ERR)
#define HB_V_CLRIDL2ERR    13
#define HB_M_CLRIDL2ERR    (0x0001 << HB_V_CLRIDL2ERR)
#define HB_V_CLRIDL3ERR    14
#define HB_M_CLRIDL3ERR    (0x0001 << HB_V_CLRIDL3ERR)

#define HB_V_SETIDLERR      0
#define HB_V_CLRIDLERR     (HB_V_CLRIDL0ERR - HB_V_SETIDL0ERR)
#define HB_V_IDLERR         HB_V_IDL0ERR
#define HB_M_IDLERR        (HB_M_IDL0ERR | HB_M_IDL1ERR | HB_M_IDL2ERR | HB_M_IDL3ERR)

/* CSR 1 - Link Status Register */
#define HB_V_RCV0ERR        0
#define HB_M_RCV0ERR       (0x0001 << HB_V_RCV0ERR)
#define HB_V_XFR0ERR        1
#define HB_M_XFR0ERR       (0x0001 << HB_V_XFR0ERR)
#define HB_V_RCV1ERR        2
#define HB_M_RCV1ERR       (0x0001 << HB_V_RCV1ERR)
#define HB_V_XFR1ERR        3
#define HB_M_XFR1ERR       (0x0001 << HB_V_XFR1ERR)
#define HB_V_RCV2ERR        4
#define HB_M_RCV2ERR       (0x0001 << HB_V_RCV2ERR)
#define HB_V_XFR2ERR        5
#define HB_M_XFR2ERR       (0x0001 << HB_V_XFR2ERR)
#define HB_V_RCV3ERR        6
#define HB_M_RCV3ERR       (0x0001 << HB_V_RCV3ERR)
#define HB_V_XFR3ERR        7
#define HB_M_XFR3ERR       (0x0001 << HB_V_XFR3ERR)
#define HB_V_INTFRX0ERR     9
#define HB_M_INTFRX0ERR    (0x0001 << HB_V_INTFRX0ERR)
#define HB_V_INTFRX1ERR    11
#define HB_M_INTFRX1ERR    (0x0001 << HB_V_INTFRX1ERR)
#define HB_V_INTFRX2ERR    13
#define HB_M_INTFRX2ERR    (0x0001 << HB_V_INTFRX2ERR)
#define HB_V_INTFRX3ERR    15
#define HB_M_INTFRX3ERR    (0x0001 << HB_V_INTFRX3ERR)

#define HB_V_SETRCV0ERR     0
#define HB_M_SETRCV0ERR    (0x0001 << HB_V_SETRCV0ERR)
#define HB_V_SETXFR0ERR     1
#define HB_M_SETXFR0ERR    (0x0001 << HB_V_SETXFR0ERR)
#define HB_V_SETRCV1ERR     2
#define HB_M_SETRCV1ERR    (0x0001 << HB_V_SETRCV1ERR)
#define HB_V_SETXFR1ERR     3
#define HB_M_SETXFR1ERR    (0x0001 << HB_V_SETXFR1ERR)
#define HB_V_SETRCV2ERR     4
#define HB_M_SETRCV2ERR    (0x0001 << HB_V_SETRCV2ERR)
#define HB_V_SETXFR2ERR     5
#define HB_M_SETXFR2ERR    (0x0001 << HB_V_SETXFR2ERR)
#define HB_V_SETRCV3ERR     6
#define HB_M_SETRCV3ERR    (0x0001 << HB_V_SETRCV3ERR)
#define HB_V_SETXFR3ERR     7
#define HB_M_SETXFR3ERR    (0x0001 << HB_V_SETXFR3ERR)

#define HB_V_CLRRCV0ERR     8
#define HB_M_CLRRCV0ERR    (0x0001 << HB_V_CLRRCV0ERR)
#define HB_V_CLRXFR0ERR     9
#define HB_M_CLRXFR0ERR    (0x0001 << HB_V_CLRXFR0ERR)
#define HB_V_CLRRCV1ERR    10
#define HB_M_CLRRCV1ERR    (0x0001 << HB_V_CLRRCV1ERR)
#define HB_V_CLRXFR1ERR    11
#define HB_M_CLRXFR1ERR    (0x0001 << HB_V_CLRXFR1ERR)
#define HB_V_CLRRCV2ERR    12
#define HB_M_CLRRCV2ERR    (0x0001 << HB_V_CLRRCV2ERR)
#define HB_V_CLRXFR2ERR    13
#define HB_M_CLRXFR2ERR    (0x0001 << HB_V_CLRXFR2ERR)
#define HB_V_CLRRCV3ERR    14
#define HB_M_CLRRCV3ERR    (0x0001 << HB_V_CLRRCV3ERR)
#define HB_V_CLRXFR3ERR    15
#define HB_M_CLRXFR3ERR    (0x0001 << HB_V_CLRXFR3ERR)

#define HB_V_SETRCVERR      HB_V_SETRCV0ERR
#define HB_V_SETXFRERR      HB_V_SETXFR0ERR
#define HB_V_CLRRCVERR     (HB_V_CLRRCV0ERR - HB_V_SETRCV0ERR)
#define HB_V_CLRXFRERR     (HB_V_CLRXFR0ERR - HB_V_SETXFR0ERR)
#define HB_V_RCVERR         HB_V_RCV0ERR
#define HB_V_XFRERR         HB_V_XFR0ERR
#define HB_M_RCVERR        (HB_M_RCV0ERR|HB_M_RCV1ERR|HB_M_RCV2ERR|HB_M_RCV3ERR)
#define HB_M_XFRERR        (HB_M_XFR0ERR|HB_M_XFR1ERR|HB_M_XFR2ERR|HB_M_XFR3ERR)


/* CSR 2 - Default DAC Setting Register */
#define HB_V_DEFAULTDAC     0
#define HB_M_DEFAULTDAC    (0xffff << HB_V_DEFAULTDAC)


typedef struct _HbLuTbl
{
  unsigned long  data[HB_K_LUTLEN];
}  HbLuTbl;

typedef struct _HbCsrs
{
  unsigned short data[HB_K_CSRCOUNT];
}  HbCsrs;

typedef struct _HbBoard
{
  volatile unsigned short *csrs;
  volatile unsigned long  *data;
}  HbBoard;


#define HbPokeCsr(csr, data)  BusPokeCsr(HB_K_CSRSPACE, HB_K_CSRSIZE, csr, data)
#define HbPeekCsr(csr, data)  BusPeekCsr(HB_K_CSRSPACE, HB_K_CSRSIZE, csr, data)

Status HB_Reset              (unsigned int);
Status HB_Start              (void);
Status HB_Stop               (void);
Status HB_SetCsr0            (unsigned int);
Status HB_SetDefaultDac      (unsigned int);
Status HB_GetLinkStatus      (unsigned int *);
Status HB_GetLinkIdleStatus  (unsigned int *);
Status HB_ClearLut           (unsigned int);
int    HB_IsHb               (void);
Status HB_FindIt             (HbBoard **);

#endif
@



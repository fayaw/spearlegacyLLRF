#include <vxWorks.h>
#include <vxLib.h>
#include <stdio.h>
#include "genLib.h"



int MapAdx (unsigned long adx,
            unsigned long cnt,
            unsigned long size,
            unsigned long jmp)
/*
   Description
   -----------
   Do vxMemProbe operations on successive addresses until one of them
   returns something.  Use the jmp argument to jump along addresses in
   blocks.  If jmp is 0, then address is incremented by size.

   Parameters
   ----------
          adx - Address to start at
          cnt - Number of addresses to try
         size - Size of the operation to do
          jmp - Size of block to skip

   Returns
   -------
   SUCCESS
*/
{
  char   val[4];
  char  *valc = (char  *) val;
  short *vals = (short *) val;
  long  *vall = (long  *) val;


  if (size != 1 && size != 2 && size != 4)
  {
    printf ("MapAdx: Bad size parameter supplied.  Choose from 1, 2 or 4.\n");
    return (FAILURE);
  }

  if (jmp == 0)   jmp = size;

  while (--cnt && vxMemProbe ((char *) adx, READ, size, val))
  {
    adx += jmp;
  }

  if (cnt == 0)
  {
    printf ("MapAdx: No valid address found \n");
    return (FAILURE);
  }

  printf ("MapAdx: Address 0x%08lx returned value 0x", adx);

  switch (size)
  {
  case 1:
    printf ("%02x\n", *valc);
    break;

  case 2:
    printf ("%04x\n", *vals);
    break;

  case 4:
    printf ("%08lx\n", *vall);
    break;
  }

  return (SUCCESS);
}
@



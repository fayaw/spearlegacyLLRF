#include "genLib.h"

typedef int Status;



#ifndef VXWORKS


Status vxMemProbe (char *adrs,          /* address to be probed          */
                   int   mode,          /* READ or WRITE                 */
                   int   length,        /* 1, 2, or 4                    */
                   char *pVal)          /* Where to return value,        */
                                        /* or ptr to value to be written */
/*
   Description
   -----------
   Probe and address for bus error, Unix version.  Doesn't actually
   detect a bus error, but provides a VxWorks-like entry point.

   Returns
   -------
   OK
*/
{
  if (mode == READ)
  {
    switch (length)
    {
    case 1:
      *((unsigned char *)  pVal) = *((unsigned char *)  adrs);
      break;

    case 2:
      if ((long) adrs & 1) return (ERROR);
      *((unsigned short *) pVal) = *((unsigned short *) adrs);
      break;

    case 4:
      if ((long) adrs & 1) return (ERROR);
      *((unsigned long *)  pVal) = *((unsigned long *)  adrs);
      break;

    default:
      return (ERROR);
    }
  }
  else if (mode == WRITE)
  {
    switch (length)
    {
    case 1:
      *((unsigned char *)  adrs) = *((unsigned char *)  pVal);
      break;

    case 2:
      if ((long) adrs & 1) return (ERROR);
      *((unsigned short *) adrs) = *((unsigned short *) pVal);
      break;

    case 4:
      if ((long) adrs & 1) return (ERROR);
      *((unsigned long *)  adrs) = *((unsigned long *)  pVal);
      break;

    default:
      return (ERROR);
    }
  }
  else return (ERROR);

  return (OK);
}


#else



void MsgQFlush (MSG_Q_ID  msgQue)
/*
   Description
   -----------
   Routine to remove all messages from a message queue by receiving each one
   of them and pitching them in the bit bucket.

   Seems to me this is a missing msgLib routine.
   Need to do this in order to deallocate pkt memory.

   Parameters
   ----------
       msgQue - The message queue to flush

   Returns
   -------
   nothing
*/
{
  /* Receive messages from the message queue until it is empty */
  while (msgQReceive (msgQue, NIL, NULL, 1 * sysClkRateGet ()) != ERROR)  {}
}



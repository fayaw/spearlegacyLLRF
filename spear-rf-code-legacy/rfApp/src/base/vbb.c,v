static Status RdOut (VbbContext     *context,
                     unsigned long  *address,
                     unsigned long   count,
                     Status        (*busFn) ())
{
  unsigned int   space   = context->copy.space;
  unsigned int   size    = context->copy.size;
  int            columns = context->copy.columns;
  unsigned int   idx     = context->copy.radix >> 4;
  int            dLen    = Fmts[idx].dLen[size  - 1];
  char          *dFmt    = Fmts[idx].dFmt;
  int            jdx     = (space >> 3) - 2;
  int            aLen    = Fmts[idx].aLen[jdx < 0 ? 2 : jdx];
  char          *aFmt    = Fmts[idx].aFmt;
  unsigned long  loopCnt = context->copy.loop ? context->loopCnt : 1;
  unsigned int   loopDec = loopCnt ? 1 : (loopCnt++, 0);
  unsigned int   valSav  = context->value;
  unsigned char  nl      = '\0';
  int            cols;
  unsigned long  cnt;
  unsigned long  adx = 0;
  unsigned char  b;
  unsigned short w;
  unsigned long  l;
  Status         status = OK;

  if (columns == 0) columns = ((int) context->width - (aLen+2)) / (dLen+1);
  if (columns  < 1) columns = 1;

  while (loopCnt)
  {
    cols =  1;
    cnt  =  count;
    adx  = *address;
    while (cnt--)
    {
      if (--cols == 0)
      {
        VBB_Output ((const char *) aFmt, nl, aLen, adx, ':');
        nl   = '\n';
        cols = columns;
      }
      switch (size)
      {
      case 1:
        b = valSav;
        if ((status = (*busFn) (space, size, adx, &b)) == OK)
          VBB_Output ((const char *) dFmt, dLen, b);
        break;

      case 2:
        w = valSav;
        if ((status = (*busFn) (space, size, adx, &w)) == OK)
          VBB_Output ((const char *) dFmt, dLen, w);
        break;

      case 4:
        l = valSav;
        if ((status = (*busFn) (space, size, adx, &l)) == OK)
          VBB_Output ((const char *) dFmt, dLen, l);
        break;
      }
      if (status != OK)
      {
        VBB_Output ("\n");
        BUS_Error (status, space, size, adx);
        break;
      }
      adx += size;
    }
    if (status != OK) break;
    loopCnt -= loopDec;
  }
  VBB_Output ("\n");

  if (status == OK)  *address = adx;

  return (status);
}



static Status RdNoOut (VbbContext     *context,
                       unsigned long  *address,
                       unsigned long   count,
                       Status        (*busFn) ())
{
  register unsigned int  space   = context->copy.space;
  register unsigned int  size    = context->copy.size;
  register unsigned long loopCnt = context->copy.loop ? context->loopCnt : 1;
  register unsigned long valSav  = context->value;
  register unsigned long cnt     = count;
  register unsigned long adx     = *address;
  unsigned long          value   = NULL;
  Status                 status  = OK;

  if (loopCnt == 0)
  {
    if (cnt == 1)
    {
      do
      {
        value  = valSav;
        status = (*busFn) (space, size, adx, &value);
      }  while (TRUE);
    }
    else
    {
      do
      {
        while (cnt-- && TRUE)
        {
          value   = valSav;
          status  = (*busFn) (space, size, adx, &value);
          adx    += size;
        }
        cnt = count;
        adx = *address;
      }  while (TRUE);
    }
  }
  else
  {
    while (loopCnt-- && TRUE)
    {
      while (cnt-- && TRUE)
      {
        value   = valSav;
        status  = (*busFn) (space, size, adx, &value);
        adx    += size;
      }
      cnt =  count;
      adx = *address;
    }
  }

  if (status == OK)
    *address = adx;
  else
    BUS_Error (status, space, size, adx);

  return (status);
}



static void       *Search (void       *arg,
                           VbbContext *context,
                           LipWrdNode *verb,
                           void       *parm)
{
#ifdef DBG
  Function ("Search");
#endif

  LipWrdNode    *sbj  = LIP_First (verb->list);
  ModContext     ctxt = context->copy;
  unsigned long  pat  = context->pattern;
  unsigned int   cnt;
  unsigned long  adx;
  Status         status = OK;

  /* Loop while there is more to do */
  do
  {
    /* Get the address range to treat */
    if (Range (context, &sbj, &adx, &cnt)) return (LIP_Next (verb));

    /* Store count for next time */
    context->count = cnt;

    /* Get pattern to find */
    if (sbj)
    {
      ItemDsc item = {TYP_K_UNINITIALIZED, NULL};

      sbj = (*sbj->word->fn) (sbj->word->arg, context, sbj, &item);
      if (item.type == TYP_K_NUMBER)      pat = item.value;
      else      return (SGL_Error (VBB_BADTYP), NIL);
      context->pattern = pat;
    }

    /* Search for it */
    {
      int            idx  = context->copy.radix >> 4;
      int            jdx  = (context->copy.space >> 3) - 2;
      unsigned int   len  = Fmts[idx].aLen[jdx < 0 ? 0 : jdx];
      char          *fmt  = Fmts[idx].aFmt;
      unsigned int   spc  = context->copy.space;
      unsigned int   siz  = context->copy.size;
      int            fnd  = FALSE;
      unsigned char  b;
      unsigned short w;
      unsigned long  l;

      /* Search for it */
      switch (siz)
      {
      case 1:
        while (cnt--)
        {
          if ((status = BUS_Peek (spc, siz, adx, &b)) == OK)
          {
            if (b == (unsigned char) pat)
            {
              VBB_Output ((const char *) fmt, '\0', len, adx, '\n');
              fnd = TRUE;
            }
            adx += siz;
          } else  break;
        }
        break;

      case 2:
        while (cnt--)
        {
          if ((status = BUS_Peek (spc, siz, adx, &w)) == OK)
          {
            if (w == (unsigned short) pat)
            {
              VBB_Output ((const char *) fmt, '\0', len, adx, '\n');
              fnd = TRUE;
            }
            adx += siz;
          } else  break;
        }
       break;

      case 4:
        while (cnt--)
        {
          if ((status = BUS_Peek (spc, siz, adx, &l)) == OK)
          {
            if (l == (unsigned long) pat)
            {
              VBB_Output ((const char *) fmt, '\0', len, adx, '\n');
              fnd = TRUE;
            }
            adx += siz;
          } else  break;
        }
        break;
      }

      if (status == OK)
      {
        if (!fnd)   VBB_Output ("Pattern 0x%0x not found in range\n", pat);
      }
      else          BUS_Error  (status, spc, siz, adx);
    }

    /* Reset context */
    context->copy = ctxt;

  } while (sbj && status == OK);

  /* Save the finishing point for next time */
  if (status == OK)  context->address = adx;

  return (LIP_Next (verb));
}



static void       *Input (int         verb,
                          VbbContext *context,
                          LipWrdNode *sbj,
                          int         setShow)
{
#ifdef DBG
  Function ("Input");
#endif

  LipWrdNode *val;

  if (verb)
  {
    setShow = verb;
    val     = LIP_First (sbj->list);
  }
  else
  {
    /* Eat the subject's local modifiers */
    DoMods (context, sbj->list);

    val = LIP_Next (sbj);
  }

  switch (setShow)
  {
  case CMD_K_SET:
    if (val)
    {
      ItemDsc item = {TYP_K_UNINITIALIZED, NULL};

      /* Eat the value's local modifiers */
      DoMods (context, val->list);

      val = (*val->word->fn) (val->word->arg, context, val, &item);
      if ((item.type == TYP_K_FILENAME) || (item.type == TYP_K_STRING))
      {
        FILE *in;

        if ((in = fopen ((char *) item.value, "r")) != NIL)
        {
          FileNode *inNode;

          inNode           = (FileNode *) myMalloc (sizeof (*inNode),FN);
          inNode->stream   = context->in;
          inNode->fileName = context->inFile;
          lstAdd ((LIST *)context->inLst, (NODE *) inNode);
          context->in      = in;
          context->inFile  = (char *) item.value;
        }
        else
        {
          SGL_Error (VBB_UNAFIL, (char *) item.value);
          myFree ((void *) item.value,FN);
        }
      }
      else      SGL_Error (VBB_BADTYP);
    }
    else        SGL_Error (VBB_NOFIL);
    break;

  case CMD_K_SHOW:
    VBB_Output ((const char *) VBB_INFIL, context->inFile);
    break;

  default:
    SGL_Error (VBB_BADVRB);
    break;
  }

  return (val);
}



static void       *Output (int         verb,
                           VbbContext *context,
                           LipWrdNode *sbj,
                           int         setShow)
{
#ifdef DBG
  Function ("Output");
#endif
  LipWrdNode *val;

  if (verb)
  {
    setShow = verb;
    val     = LIP_First (sbj->list);
  }
  else
  {
    /* Eat the subject's local modifiers */
    DoMods (context, sbj->list);

    /* Pick off the next the subject of the subject */
    val = LIP_Next (sbj);
  }

  /* Set or show, depending */
  switch (setShow)
  {
  case CMD_K_SET:
    if (val)
    {
      ItemDsc item = {TYP_K_UNINITIALIZED, NULL};

      /* Eat the values's local modifiers */
      DoMods (context, val->list);

      /* Get a value */
      val = (*val->word->fn) (val->word->arg, context, val, &item);
      if (item.type == TYP_K_FILENAME || item.type == TYP_K_STRING)
      {
        FILE *out;

        if (context->out != stdout)
        {
          fclose (context->out);
          if (context->outFile != VBB_K_STDOUT)  myFree ((void *) context->outFile,FN);
        }
        if (strcmp ((char *) item.value, VBB_K_STDOUT) == NULL)
        {
          context->out     = stdout;
          context->outFile = VBB_K_STDOUT;
        }
        else if ((out = fopen ((char *) item.value, "w")) != NIL)
        {
          context->out     = out;
          context->outFile = (char *) item.value;
        }
        else
        {
          SGL_Error (VBB_UNAFIL, (char *) item.value);
          context->out     = stdout;
          context->outFile = VBB_K_STDOUT;
          myFree ((char *) item.value,FN);
        }
      }
      else      SGL_Error (VBB_BADTYP);
    }
    else
    {
      if (context->out != stdout)
      {
        fclose (context->out);
        if (context->outFile != VBB_K_STDOUT)  myFree ((void *) context->outFile,FN);
        context->out     = stdout;
        context->outFile = VBB_K_STDOUT;
      }
    }
    break;

  case CMD_K_SHOW:
    VBB_Output ((const char *) VBB_OUTFIL, context->outFile);
    break;

  default:
    SGL_Error (VBB_BADVRB);
    break;
  }

  return (val);
}




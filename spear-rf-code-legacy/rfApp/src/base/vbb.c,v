  while (!context->done)
  {
    /* Get a line of input */
    line = GetLine (hndl, &cmdLine);
    if (context->done) break;

    /* Compile the line into a list of instructions */
    if ((verbList = LIP_CompileLine (line, hndl->dict, hndl->oneChrDict)))
    {
      verb = LIP_First (verbList);

      /* Repeat last command if current line is blank and input is from kbd */
      if (context->in == stdin)
      {
        if (verb == NIL)
        {
          /* Blank line.  Use previous non-blank line */
          LIP_Free (verbList);
          if (saveList == NIL) continue;
          verbList = saveList;
          verb = LIP_First (verbList);
          VBB_Output ("repeated...\n");
        }
        else
        {
          if (verb->word->type == TYP_K_COMMENT)
          {
            /* Discard comment-only lines */
            LIP_Free (verbList);
            continue;
          }
          else
          {
            /* Save the current compiled line */
            LIP_Free (saveList);
            saveList = verbList;
          }
        }
      }
      else
      {
        LIP_Free (fileList);
        fileList = verbList;
      }

      /* Carry out the instruction list */
      while (verb)
      {
        /* Reset the modifier part of the context block */
        context->copy = context->save;

        /* Eat the verb's global and local modifiers */
        DoMods (context, verb->gblLst);
        DoMods (context, verb->lclLst);

        /* Munch on the verbs and their subjects */
        verb = (*verb->word->fn) (verb->word->arg, context, verb, NIL);
      }
    }
  }

  /* Clean up */
  LIP_Free (verbList);
  LIP_Free (fileList);
#ifdef VXWORKS
  ledClose (hndl->ledId);
#endif
  if (context->prompt  != VBB_K_PROMPT)   myFree ((void *) context->prompt,FN);
  if (context->inFile  != VBB_K_STDIN)    myFree ((void *) context->inFile,FN);
  if (context->outFile != VBB_K_STDOUT)   myFree ((void *) context->outFile,FN);
  if (context->logFile != VBB_K_LOGFILE)  myFree ((void *) context->logFile,FN);
  lstFree  (context->inLst);
  myFree     ((void *) hndl->line,FN);
#ifdef UNIX
  myFree     ((void *) address,FN);
#endif
  SGL_Free (sglHndl);

/*  memShow (0); */

  return (SUCCESS);
}




static void       *Read (void       *arg,
                         VbbContext *context,
                         LipWrdNode *verb,
                         void       *parm)
{
  LipWrdNode    *sbj    = LIP_First (verb->list);
  unsigned int   cnt;
  unsigned long  adx;
  ModContext     ctxt   = context->copy;
  Status         status;

  /* Loop while there is more to do */
  do
  {
    /* Get the range to treat */
    if (Range (context, &sbj, &adx, &cnt)) return (LIP_Next (verb));

    /* Save the count for next time */
    context->count = cnt;

    /* Read it with or without output */
    if (context->copy.output)   status = RdOut   (context, &adx, cnt, BUS_Peek);
    else                        status = RdNoOut (context, &adx, cnt, BUS_Peek);

    /* Reset context */
    context->copy = ctxt;

  } while (sbj && status == OK);


  /* Save the end address for next time */
  if (status == OK)  context->address = adx;

  return (LIP_Next (verb));
}



static void       *Write (void       *arg,
                          VbbContext *context,
                          LipWrdNode *verb,
                          void       *parm)
{
  LipWrdNode    *sbj  = LIP_First (verb->list);
  ModContext     ctxt = context->copy;
  unsigned int   cnt  = 0;
  unsigned long  adx;
  Status         status = OK;

  /* Loop while there is more to do */
  do
  {
    if (cnt != 1)
    {
      /* Get the address range to treat */
      if (Range (context, &sbj, &adx, &cnt)) return (LIP_Next (verb));

      /* Store count for next time */
      context->count = cnt;
    }

    /* Get the value to write */
    if (sbj)
    {
      ItemDsc item = {TYP_K_UNINITIALIZED, NULL};

      sbj = (*sbj->word->fn) (sbj->word->arg, context, sbj, &item);
      if (item.type == TYP_K_NUMBER)      context->value = item.value;
      else      return (SGL_Error (VBB_BADTYP), NIL);
    }

    /* Write it */
    {
      register unsigned int   space   = context->copy.space;
      register unsigned int   size    = context->copy.size;
      register unsigned long  loopCnt = context->copy.loop ? context->loopCnt : 1;
      register unsigned long  count   = cnt;
      register unsigned long  address = adx;
      register void          *value;
      unsigned char           b;
      unsigned short          w;
      unsigned long           l;

      switch (size)
      {
      default:
      case 1:        b = context->value;        value = &b;        break;
      case 2:        w = context->value;        value = &w;        break;
      case 4:        l = context->value;        value = &l;        break;
      }

      if (loopCnt == 0)
      {
        if (cnt == 1)
        {
          do
          {
            status = BUS_Poke (space, size, adx, value);
          } while (status == OK);
          adx += size;
        }
        else
        {
          do
          {
            adx = address;
            while (cnt-- && status == OK)
            {
              status  = BUS_Poke (space, size, adx, value);
              adx    += size;
            }
            cnt = count;
          }  while (status == OK);
        }
      }
      else
      {
        while (loopCnt-- && status == OK)
        {
          adx = address;
          while (cnt-- && status == OK)
          {
            status  = BUS_Poke (space, size, adx, value);
            adx    += size;
          }
          cnt = count;
        }
      }

      if (status != OK)
        BUS_Error (status, space, size, address);
    }

    /* Reset context */
    context->copy = ctxt;

  } while (sbj && status == OK);

  /* Save the finishing point for next time */
  if (status == OK)  context->address = adx;

  return (LIP_Next (verb));
}




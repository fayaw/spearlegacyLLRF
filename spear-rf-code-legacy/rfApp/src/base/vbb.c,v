static char *GetLine (VbbHndl   *hndl,
                      char     **cmdLine)
/*
   Description
   -----------
   Get a line of input.  Someday we'll maybe stick some code in here to
   handle continued lines.  The trouble is, if you don't know the line
   syntax, how can you find a line continuation character before a
   comment character?

   Parameter
   ---------
        hndl - A pointer to a VBB handle.
     cmdLine - Address of an initial command line to execute.

   Returns
   -------
   A NULL terminated line of input.
*/
{
#ifdef DBG
  Function ("GetLine");
#endif

  VbbContext *context = hndl->context;
  char       *line;

  /* Print the prompt and get a line */
  if (isatty (fileno (context->in)))
  {
    VBB_Output (context->prompt);
    if (!isatty (fileno (context->out)))
    {
      VBB_Output ("\n");
      printf (context->prompt);
    }

    /* Get a line from the keyboard */
    if (*cmdLine == NIL)
    {
#ifdef VXWORKS
      if (ledRead (hndl->ledId, hndl->line, hndl->maxCnt) == EOF)
      {
        context->done = TRUE;
        line = NIL;
      }
      else
      {
        line = hndl->line;
      }
#else
      if ((line = fgets (hndl->line, hndl->maxCnt, context->in)) == NIL)
      {
        context->done = TRUE;
      }
#endif
    }
    else                                /* Handle command line command */
    {
      VBB_Output (*cmdLine);
      VBB_Output ("\n");
      strncpy (hndl->line, *cmdLine, hndl->maxCnt);
      *cmdLine = NIL;
      line = hndl->line;
    }
  }
  else
  {
    /* Get a line from the file */
    line = fgets (hndl->line, hndl->maxCnt, context->in);

    /*
    |  Three cases on EOF:
    |    1) Input was redirected in a command file.  Close file and put previous
    |       stream back.
    |    2) Input was redirected from the Vbb prompt.  In this case the last
    |       nested input file generating EOF will cause stdin = tty to be put
    |       back and execution continues for keyboard case above.
    |    3) Input was redirected from the Vbb invocation line.  In this case
    |       the last nested input file to generate EOF will take the else case
    |       below, rewind stdin = a file, set the done flag and return.
    */
    if (line == NIL)
    {
      FileNode *inNode = (FileNode *) lstLast (context->inLst);

      if (inNode)
      {
        fclose (context->in);
        myFree   ((void *) context->inFile,FN);
        context->in     = inNode->stream;
        context->inFile = inNode->fileName;
        lstDelete (context->inLst, (NODE *) inNode);
        myFree ((void *) inNode,FN);
        return (GetLine (hndl, cmdLine));
      }
      else
      {
        rewind (context->in);           /* Can't close stdin so rewind */
        context->done = TRUE;
        return (NIL);
      }
    }

    /* Output line if verify set */
    if (context->verify)
    {
      VBB_Output (context->prompt);
      fprintf (context->out, "%s", line);
    }
  }

  /* Output line to log file if logging is enabled */
  if (context->log)
  {
    fprintf (context->log, "%s", line);
#ifdef VXWORKS
    fprintf (context->log, "\n");
#endif
  }

  /* Get rid of stupid newline character.  ARRGGGHHH what a waste of time! */
  if (line)
  {
    register char *c = line;
    while (*c && *c != '\n')  {  c++;  }
    if (*c) *c = '\0';
  }

  /* Don't return blank lines if input is not coming from stdin */
  if (!isatty (fileno (context->in)) && *line == '\0')
    return (GetLine (hndl, cmdLine));

  return (line);
}



static void       *Number (int         number,
                           VbbContext *context,
                           LipWrdNode *node,
                           ItemDsc    *item)
{
#ifdef DBG
  Function ("Number");
#endif
  if (number)
  {
    item->type    = TYP_K_NUMBER;
    item->value = number;
  }
  else
  {
    int        nmr;
    char       dmy;
    LipWrdDsc *word;
    char      *fmt;
    int        cnt;

    /* Eat the node's local modifiers */
    DoMods (context, node->list);

    word = node->word;
    fmt  = context->copy.radix == RAD_K_DEC || strchr (word->string, 'x') ?
      "%i%c" : "%x%c";

    /* Convert the number and look for terminator */
    cnt  = sscanf (word->string, fmt, &nmr, &dmy);

    /* If legal terminator return number in item descriptor */
    if (cnt == 2 && strchr (" \t;:/", dmy))  cnt = 1;
    if (cnt == 1)
    {
      item->value = nmr;
      item->type  = word->type;
    }
    else
    {
      SGL_Error  (VBB_BADNMR, word->string);
      item->type = TYP_K_UNKNOWN;
      return (NIL);
    }
  }

  return (LIP_Next (node));
}



static void       *String (void       *arg,
                           VbbContext *context,
                           LipWrdNode *node,
                           ItemDsc    *item)
{
#ifdef DBG
  Function ("String");
#endif
  int          length;
  char        *string;
  LipWrdDsc   *word = node->word;

  /* Eat the node's local modifiers */
  DoMods (context, node->list);

  /* Allocate space and make a private copy.  Scrape off quotes */
  length = word->size - 1;
  string = (char *) myMalloc (length,FN);
  strncpy (string, &word->string[1], length);
  string[length - 1] = '\0';

  /* Return the value in an item descriptor */
  item->type  = word->type;
  item->value = (unsigned long) string;

  return (LIP_Next (node));
}



static void       *File (void       *arg,

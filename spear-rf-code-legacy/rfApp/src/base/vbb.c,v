        /* Eat the value's local modifiers */
        DoMods (context, val->list);

        val = (*val->word->fn) (val->word->arg, context, val, &item);
        if (item.type == TYP_K_FILENAME || item.type == TYP_K_STRING)
        {
          FILE *log;

          if (context->log == NIL)
          {
            if ((log = fopen ((char *) item.value, "a")) != NIL)
            {
              if (context->logFile != VBB_K_LOGFILE)
                myFree ((void *) context->logFile,FN);
              context->log     = log;
              context->logFile = (char *) item.value;
            }
            else
            {
              SGL_Error (VBB_UNAFIL, (char *) item.value);
              context->log     = NIL;
              context->logFile = VBB_K_LOGFILE;
              myFree ((void *) item.value,FN);
            }
          }
          else
          {
            SGL_Error (VBB_LOGENA, context->logFile);
            myFree ((void *) item.value,FN);
          }
        }
        else      SGL_Error (VBB_BADTYP);
      }
      else
      {
        FILE *log;

        if (context->log == NIL)
        {
          if ((log = fopen (context->logFile, "a")) != NIL)
            context->log = log;
          else    SGL_Error (VBB_UNAFIL, context->logFile);
        }
        else      SGL_Error (VBB_LOGENA, context->logFile);
      }
    }
    else
    {
      if (context->log)
      {
        fclose (context->log);
        context->log     = NIL;
      }
    }
    break;

  case CMD_K_SHOW:
    if (context->log)
      VBB_Output ((const char *) VBB_LOG, "enabled", context->logFile);

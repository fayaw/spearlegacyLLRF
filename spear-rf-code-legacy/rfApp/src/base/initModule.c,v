Status SYS_InitModule ()
/*
   Description
   -----------
   Function to load module dependent initialization code.
   This function presumes that the NFS file systems have already been mounted.

   Parameter
   ---------
   none.

   Returns
   -------
   SUCCESS
*/
{
  void   SYS_HdwInit (void);

  static MIBblk  mib;

  char          *model = sysModel ();


  /* Publicize the location of the module information block */
  MIB_Info = &mib;

#if TARGET == NICPU030
  /* Initialize based on model type */
  if ((strcmp (model, "National Instrument VXIcpu-030") == NULL) ||
      (strcmp (model, "Nat'l Instruments VXIcpu-030")   == NULL))
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_NIVXICPU030;
  }
#elif TARGET == FRC40
  if (strcmp (model, "Force SYS68K/CPU-40") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_FCPU40B;
  }
#elif TARGET == MV166
  if (strcmp (model, "Motorola MVME166") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_MVME166;
  }
#elif TARGET == M68040
  if (strcmp (model, "Motorola MVME167") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_MVME167;
  }
#elif TARGET == M68060
  if (strcmp (model, "Motorola MVME177") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_MVME177;
  }
#elif TARGET == HKV4F
  if (strcmp (model, "Heurikon HK68/V4F") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_HKV4F;
  }
#elif TARGET == MPPC604
  if (strcmp (model, "Motorola MVME2401-1 - MPC 750") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_MVME2400;
  }
  else if (strcmp (model, "Motorola MVME2700 - MPC 750") == NULL)
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_MVME2700;
  }
#elif TARGET == UNKNOWN
  else
  {
    /* Save the module type in the module information block */
    MIB_Info->type = MOD_K_UNDEF;

    SGL_Error (SYS_BADMOD, model);
  }
#endif
  /* Do any required hardware setup */
  SYS_HdwInit ();

  return (SUCCESS);
}



void SYS_HdwInit (void)
/*
   Description
   -----------
   Routine to setup hardware registers.

   Parameter
   ---------
   none

   Returns
   -------
   SUCCESS
*/
{
#if TARGET == NICPU030
  /* Initialize VXI code */
  VXIinit ();
#elif TARGET == FRC40
  /*
  |  CTL5 controls mailbox access from VME.  If enabled, the address is at
  |  FBFF8000, right in the middle of VME A16 D32 space.  There is also a
  |  set at FCFF8000, in A16 D16 space.  The following diables them and a
  |  few other things as well.  See FGA-002 manual, pg 4-4 and register
  |  descriptions.
  */
  *FGA_CTL5 = NULL;
#endif
}

#ifndef E02LIB_H
#define E02LIB_H

#include <drv/multi/frcEagle02.h>

#define E02_K_CSR1IRQACK      0
#define E02_K_CSR1ALT         1
#define E02_K_CSR1IO          2
#define E02_K_CSR1SYS         3

#define E02_V_CSR1VSBSPC      0
#define E02_V_CSR1INHSRPROT   2
#define E02_V_CSR1VSBRELMODE  3
#define E02_V_CSR1INHSYSSPC   4
#define E02_V_CSR1INHALTSPC   5
#define E02_V_CSR1INHBLKXFR   6
#define E02_V_CSR1INHCACHING  7
#define E02_V_CSR1NEWADX      8
#define E02_V_CSR1CMPMASK    16
#define E02_V_CSR1VSBSLVADX  20

#define E02_M_CSR1VSBSPC     (0x00000003 << E02_V_CSR1VSBSPC    )
#define E02_M_CSR1INHSRPROT  (0x00000001 << E02_V_CSR1INHSRPROT )
#define E02_M_CSR1VSBRELMODE (0x00000001 << E02_V_CSR1VSBRELMODE)
#define E02_M_CSR1INHSYSSPC  (0x00000001 << E02_V_CSR1INHSYSSPC )
#define E02_M_CSR1INHALTSPC  (0x00000001 << E02_V_CSR1INHALTSPC )
#define E02_M_CSR1INHBLKXFR  (0x00000001 << E02_V_CSR1INHBLKXFR )
#define E02_M_CSR1INHCACHING (0x00000001 << E02_V_CSR1INHCACHING)
#define E02_M_CSR1NEWADX     (0x00000008 << E02_V_CSR1NEWADX    )
#define E02_M_CSR1CMPMASK    (0x00000004 << E02_V_CSR1CMPMASK   )
#define E02_M_CSR1VSBSLVADX  (0x0000000c << E02_V_CSR1VSBSLVADX )

#define E02_V_CSR2VSBGA      0
#define E02_V_CSR2SW401P1    3

#define E02_M_CSR2VSBGA      (0x00000007 << E02_V_CSR2VSBGA  )
#define E02_M_CSR2SW401P1    (0x00000001 << E02_V_CSR2SW401P1)

#define E02_A_CSR1 (volatile unsigned long *)FRC40_E002_CSR_BASE_ADRS
#define E02_A_CSR2 (volatile unsigned long *)FRC40_E002_CSR_BASE_ADRS + 1

#define E02SetSpc(spc)  *(E02_A_CSR1)=((*(E02_A_CSR1))&(~E02_M_CSR1VSBSPC))|((spc)<<E02_V_CSR1VSBSPC)
#define E02GetSpc()    ((*(E02_A_CSR1) & E02_M_CSR1VSBSPC) >> E02_V_CSR1VSBSPC)

#endif

#ifndef BUSLIB_H
#define BUSLIB_H

#include "sglLib.h"                     /* To define Status typdef */

#define SPC_K_LOCAL         1
#define SPC_K_VSBSYS        2
#define SPC_K_VSBALT        3
#define SPC_K_VSBIO         4
#define SPC_K_A16          16
#define SPC_K_A24          24
#define SPC_K_A32          32

#define SIZ_K_BYTE          sizeof (unsigned char)
#define SIZ_K_SHORT         sizeof (unsigned short)
#define SIZ_K_LONG          sizeof (unsigned long int)


#define BUS_K_SINGLE        1
#define BUS_K_BLOCK         2


typedef struct _BusHndl
{
  unsigned int     blkXfr;
  void            *offset;
  unsigned long    window;
  Status         (*read)  ();
  Status         (*write) ();
} BusHndl;


Status   BUS_Peek         (unsigned int, unsigned int, unsigned long, void *);
Status   BUS_Poke         (unsigned int, unsigned int, unsigned long, void *);
Status   BUS_Rmw          (unsigned int, unsigned int, unsigned long, void *);
Status   BUS_MapAddress   (unsigned int, unsigned int, unsigned long,
                           unsigned long *, unsigned long *);
Status   BUS_UnMapAddress (unsigned long);
BusHndl *BUS_Prepare      (unsigned int, unsigned int, unsigned int);
Status   BUS_Release      (BusHndl *);
Status   BUS_Error        (Status, unsigned int, unsigned int, unsigned long);

#define  BUSpeek(address,width,value)	*(value) = *(address)
#define  BUSpoke(address,width,value)	*(address) = (value)

#define BusPokeCsr(space, size, csr, data) \
({Status         _status_; \
  unsigned long  _csr_  = (unsigned long)  (csr); \
  unsigned short _data_ = (unsigned short) (data); \
  if (_status_ = BUS_Poke ((space), (size), _csr_, &_data_)) \
    return (BUS_Error (_status_, (space), (size), _csr_)); \
  _status_; })

#define BusPeekCsr(space, size, csr, data) \
({Status         _status_; \
  unsigned long  _csr_  = (unsigned long)  (csr); \
  if (_status_ = BUS_Peek ((space), (size), _csr_, (unsigned short *) (data))) \
    return (BUS_Error (_status_, (space), (size), _csr_)); \
  _status_;})

#endif

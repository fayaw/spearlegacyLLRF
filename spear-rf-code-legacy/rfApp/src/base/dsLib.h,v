#endif

typedef DSL_params DsLutDsc;

typedef struct _DsCsrs
{
  unsigned short data[DS_K_CSRCOUNT];
}  DsCsrs;

typedef struct _DsBoard
{
  volatile unsigned short *csrs;
  volatile unsigned long  *data;
  int revision;
  unsigned long int LutAddr;
  unsigned long int LutLen;
}  DsBoard;


#define DsPokeCsr(csr, data)  BusPokeCsr(DS_K_CSRSPACE, DS_K_CSRSIZE, csr, data)
#define DsPeekCsr(csr, data)  BusPeekCsr(DS_K_CSRSPACE, DS_K_CSRSIZE, csr, data)

Status DS_Reset              (void);

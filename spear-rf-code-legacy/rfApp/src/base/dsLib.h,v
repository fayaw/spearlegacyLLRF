Status DS_SetFilterNo        (unsigned int);
Status DS_SetBucketDelay     (unsigned int);
Status DS_ExcptnBcktEnable   (void);
Status DS_ExcptnBcktDisable  (void);
Status DS_SetExceptionBucket (unsigned int);
Status DS_GetLinkStatus      (unsigned int *);
Status DS_ClearLut           (void);
Status DS_GenTable           (DsLutDsc *, void **, DsBoard *);
Status DS_LoadTable          (void *, DsLutDsc *, int, int, int, char *);

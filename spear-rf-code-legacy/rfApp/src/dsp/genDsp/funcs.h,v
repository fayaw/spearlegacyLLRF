@/*
** ++
**
**  Facility:  DSP - DSP code
**
**  Abstract:
*	This file declares the DSP library functions and symbols.
**
**  Author:
**	Dmitry Teytelman
**
**  History:
**	1995-1-17: Created
**
** --
*/

#ifndef FUNCS_H
#define FUNCS_H

/*
   Description
   -----------
   Initializes the control registers of the DSP to disable interrupts,
   set up the ALU, PIO, BIO, ERAM wait states. Also zeroes some of the DAU
   registers.


   Registers used
   --------------
	      inc - Interrupt control
	      auc - Arithmetic unit control
	    mwait - wait states for the ERAM
	     pioc - PIO control
	     sbit - BIO status
	     cbit - BIO control
	        y - zeroed
	        p - zeroed
	       a0 - zeroed
               a1 - zeroed
                i - zeroed
*/
.extern InitReg

/*
   Description
   -----------
   Initialize the Communications Block by copying a template to the one
   that resides in external memory.

   Registers used
   --------------
	       r0 - Pointer to the external memory Communications Block
	       r1 - Pointer to the template communications block
	       a0 - Data to store
	    cloop - Loop counter
*/
.extern ComInit

/*
   Description
   -----------
   Routine to initialize unused interrupt vectors.  Unused vectors are
   loaded with the UnInitInt ISR above.

   Registers used
   --------------
	       r0 - Pointer into the vector table
               r1 - Pointer to the instruction template
	       a0 - Instruction template
	       a1 - scratch
*/
.extern InitVecTbl


/*
   Description
   -----------
   This routine flashes SOS on the LED.  It uses the timer interrupt to
   generate human scale delay times.  Since this routine doesn't return,
   it takes over the timer resource and installs it's own timer ISR.
   It also disables all but the timer interrupt.  It also turns off the
   DSP running CSR 4 bit and LED.

   Registers used
   --------------
              inc - For setting up interrupts
               r0 - Pointer to timer vector
               r1 - Pointer to timer vector instruction
               a0 - Flag set by the timer ISR
           timer0 - Delay times
*/
.extern SOS

#endif
@



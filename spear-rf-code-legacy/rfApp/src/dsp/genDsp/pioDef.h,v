#ifndef PIODEF_H
#define PIODEF_H

/* Define PIO control register fields */
#define PIO_V_STATUS          0         /* PIO status bits */
#define PIO_V_INT             5         /* PIO interrupt bits */
#define PIO_V_SC             10         /* Status/control mode */
#define PIO_V_PIDS           11         /* PIDS pin is an input,0 or output,1 */
#define PIO_V_PODS           12         /* PODS pin is an input,0 or output,1 */
#define PIO_V_STROBE         13         /* Strobe width of PIDS and PODS */
#define PIO_V_IBF            15         /* IBF interrupt status bit */

#define PIO_M_STATUS         (0x001f << PIO_V_STATUS)
#define PIO_M_INT            (0x001f << PIO_V_INT   )
#define PIO_M_SC             (0x0001 << PIO_V_SC    )
#define PIO_M_PIDS           (0x0001 << PIO_V_PIDS  )
#define PIO_M_PODS           (0x0001 << PIO_V_PODS  )
#define PIO_M_STROBE         (0x0003 << PIO_V_STROBE)
#define PIO_M_IBF            (0x0001 << PIO_V_IBF   )

#define PIO_V_INT0STT         0         /* INT0 status bit */
#define PIO_V_PODSSTT         1         /* PODS status bit */
#define PIO_V_PIDSSTT         2         /* PIDS status bit */
#define PIO_V_OBESTT          3         /* OBE  status bit (SIO) */
#define PIO_V_IBFSTT          4         /* IBF  status bit (SIO) */

#define PIO_M_INT0STT        (1 << PIO_V_INT0STT)
#define PIO_M_PODSSTT        (1 << PIO_V_PODSSTT)
#define PIO_M_PIDSSTT        (1 << PIO_V_PIDSSTT)
#define PIO_M_OBESTT         (1 << PIO_V_OBESTT )
#define PIO_M_IBFSTT         (1 << PIO_V_IBFSTT )

#define PIO_V_INT0INT         0         /* INT0 interrupt enable */
#define PIO_V_PODSINT         1         /* PODS interrupt enable */
#define PIO_V_PIDSINT         2         /* PIDS interrupt enable */
#define PIO_V_OBEINT          3         /* OBE  interrupt enable (SIO) */
#define PIO_V_IBFINT          4         /* IBF  interrupt enable (SIO) */

#define PIO_M_INT0INT        (1 << PIO_V_INT0INT)
#define PIO_M_PODSINT        (1 << PIO_V_PODSINT)
#define PIO_M_PIDSINT        (1 << PIO_V_PIDSINT)
#define PIO_M_OBEINT         (1 << PIO_V_OBEINT )
#define PIO_M_IBFINT         (1 << PIO_V_IBFINT )

#endif

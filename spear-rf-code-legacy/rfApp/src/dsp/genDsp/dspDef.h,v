#ifndef DSPDEF_H
#define DSPDEF_H

#define NULL                  0
#define FALSE                 0
#define TRUE                  1

#define DSP_A_ERAM       0x0000         /* Image of external RAM for linker */
#define DSP_K_ESIZE      0x4000		/* 0x2000 = 8k, 0x4000 = 16k        */
#define DSP_A_ETOP       (DSP_A_ERAM + DSP_K_ESIZE - 1)

#define DSP_A_ERAMACT    0x8000         /* Actual starting address of ERAM  */
#define DSP_A_ETOPACT    (DSP_A_ERAMACT + DSP_K_ESIZE - 1)

#define DSP_A_IRAM       0x0000         /* Image of internal RAM for linker */
#define DSP_K_ISIZE      0x2000		/* 0x1000 = 4k, 0x2000 = 8k         */
#define DSP_A_ITOP       (DSP_A_IRAM + DSP_K_ISIZE - 1)

#define DSP_A_IRAMACT    DSP_A_IRAM     /* Actual starting address of IRAM  */
#define DSP_A_ITOPACT    (DSP_A_IRAMACT + DSP_K_ISIZE - 1)

#define DSP_K_VECCNT       0x48         /* Number of vectors                */
#define DSP_A_VECTBL     0x0000         /* Location of vector table         */
#define DSP_A_YBASE      0x0050         /* Location of ybase base address   */
#define DSP_A_CODELOW    0x0070         /* Lowest address of code           */

#endif

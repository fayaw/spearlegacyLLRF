PAstart:

PhsTs0: int PhsO_0, PhsO_1, PhsO_2      /* Time Set 0 */
AmpTs0: int AmpO_0, AmpO_1, AmpO_2

PhsTs1: int PhsO_2, PhsO_0, PhsO_1      /* Time Set 1 */
AmpTs1: int AmpO_2, AmpO_0, AmpO_1

PhsTs2: int PhsO_1, PhsO_2, PhsO_0      /* Time Set 2 */
AmpTs2: int AmpO_1, AmpO_2, AmpO_0

PAend:                                  /* End of fast list marker */
/* End Struct */


/* Begin Slow harmonic time set pointers. Fields must remain contiguous */
SPAstart:

SPhsTs0: int SPhsO_0, SPhsO_1, SPhsO_2, Coefs_PhsS, SPhsZ12 /* Time Set 0 */
SAmpTs0: int SAmpO_0, SAmpO_1, SAmpO_2, Coefs_AmpS, SAmpZ12

SPhsTs1: int SPhsO_2, SPhsO_0, SPhsO_1, Coefs_PhsS, SPhsZ12  /* Time Set 1 */
SAmpTs1: int SAmpO_2, SAmpO_0, SAmpO_1, Coefs_AmpS, SAmpZ12

SPhsTs2: int SPhsO_1, SPhsO_2, SPhsO_0, Coefs_PhsS, SPhsZ12  /* Time Set 2 */
SAmpTs2: int SAmpO_1, SAmpO_2, SAmpO_0, Coefs_AmpS, SAmpZ12

SPAend:                                  /* End of slow list marker */
/* End Struct */

/*
** History arrays for fast and slow harmonics.
*/

PhsO_0:           int ZERO              /* out_DC(ts0) */
HistStart:
	NUMFHARMS*int ZERO              /* out_h(ts0) */
PhsO_1:           int PHS_0             /* out_DC(ts1) */
	NUMFHARMS*int PHS_0             /* out_h(ts1) */
PhsO_2:           int PHS_0             /* out_DC(ts2) */
	NUMFHARMS*int PHS_0             /* out_h(ts2) */

AmpO_0: NUMFHARMS*int AMP_0            /* out_h(ts0) */
AmpO_1: NUMFHARMS*int AMP_0            /* out_h(ts1) */
AmpO_2: NUMFHARMS*int AMP_0            /* out_h(ts2) */

/*
** The slow ones.
*/

SPhsO_0: NUMSHARMS*int ZERO            /* out_h(ts0) */
SPhsO_1: NUMSHARMS*int PHS_0           /* out_h(ts1) */
SPhsO_2: NUMSHARMS*int PHS_0           /* out_h(ts2) */

SAmpO_0: NUMSHARMS*int AMP_0           /* out_h(ts0) */
SAmpO_1: NUMSHARMS*int AMP_0           /* out_h(ts1) */
SAmpO_2: NUMSHARMS*int AMP_0           /* out_h(ts2) */

SPhsZ12: NUMSHARMS*int ZERO            /* in z-1 z-2 */ 
	 NUMSHARMS*int ZERO
SAmpZ12: NUMSHARMS*int ZERO
	 NUMSHARMS*int ZERO
HistEnd:

/* Phase reference offset and coefficients */
	
PhsRefOff:   int   0.0!12     /* Reference Phase Offset */
Coefs_PhsDC: int   0.0005,    1.0 /*  DC Phase gain */
Coefs_PhsF:                   /* Fast 23KHz Phase coefficients */
      NUMFHARMS4*int ZERO
	       4*int ZERO     /* Extra ZERO set to keep cache loop happy */
Coefs_PhsS:                   /* Slow 23KHz/NUMSHARMS Phase coefficients */
      NUMSHARMS4*int ZERO

/* Amplitude coefficients */
Coefs_AmpF:                   /* Fast 23KHz Amplitude coefficients */ 
      NUMFHARMS4*int ZERO
	       4*int ZERO     /* Extra ZERO set to keep cache loop happy */
Coefs_AmpS:                   /* Slow 23KHz/NUMSHARMS Amplitude coefficients */ 
      NUMSHARMS4*int ZERO
/* I/Q reference pipeline */
RefPipeStart:
      NUMREFPIPE2*int ZERO
RefPipeEnd:
Junk:   int

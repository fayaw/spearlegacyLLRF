#include <1610.h>

#include "dspDef.h"
#include "sttDef.h"
#include "dspCmdDef.h"

.global ComBlk, BlkId, Vers, ChkSum
.global Status, SttArg, DspMsg, DspArg, CpuMsg, CpuArg, ComLen
.global ComPtr
.global ComInit

#define COM_K_BLKID      0x0001         /* Communications block ID      */
#define COM_K_VERSION    0x0001         /* Communications block version */
#define COM_K_SIZE       0x0020         /* Amount to reserve for comm block */



#if 0
.rsect ".comm"

/*
   Define Communications Block addresses.  The communciations block can't
   be filled with data since it doesn't exist at DSP boot time.  This is
   because the external memory (where the communications block normally
   resides) is temporarily occupied by the .ram section at boot time. So
   all we can do is reserve space for the communications block and define
   its addresses.
*/
	.= 0  /* (DSP_A_ETOP - COM_K_SIZE)*/
ComBlk:
BlkId:  int                             /* Communications block ID */
Vers:   int                             /* Communications block version */
ChkSum: int                             /* Communications block checksum */
Status: int                             /* Status value of code */
SttArg: STT_K_ARGCNT * int              /* Location of 8 arguments for status */
DspMsg: int                             /* Message from DSP to Master */
DspArg: int                             /* A message argument */
CpuMsg: int                             /* Message from Master to DSP */
CpuArg: int                             /* A message argument */
ComLen: int                             /* Communications block size */

	.= COM_K_SIZE - 1  /* DSP_A_ETOP*/
ComPtr: int                             /* Pointer to communications block */
#endif



.rsect ".ram"

/*
   Template Communication block to be copied to the real communications
   block once the DSP boots.  Stick template data here.  Make sure that
   the structure is the same as the real one defined above!
*/
LclCom:
	int COM_K_BLKID                 /* Communications block ID */
	int COM_K_VERSION               /* Communications block version */
	int NULL                        /* Communications block checksum */
	int STT_NONE                    /* Status value of code */
	STT_K_ARGCNT * int NULL         /* Location of 8 arguments for status */
	int CMD_K_NOOP                  /* Message from DSP to Master */
	int NULL                        /* Msg argument from DSP to Master */
	int NULL                        /* Message from Master to DSP */
	int NULL                        /* Msg argument from Master to DSP */
Cnt:    int EndLcl - LclCom             /* Communications block size */
EndLcl:

#define COMSIZE  (EndLcl - LclCom)  /* Let linker calculate size of blk */



ComInit:
/*
   Description
   -----------
   Initialize the Communications Block by copying a template to the one
   that resides in external memory.

   Registers used
   --------------
	       r0 - Pointer to the external memory Communications Block
	       r1 - Pointer to the template communications block
	       a0 - Data to store
	    cloop - Loop counter
*/

/* Copy the local version of the communications block to ERAM */
	r0    = ComBlk                  /* Start address */
	r1    = LclCom                  /* Template address */
	do COMSIZE {                    /* Copy template to real block */
	  a0    = *r1++
	  *r0++ = a0
	}

/* Put the pointer to the communications block in the last location of ERAM */
	r0    = ComPtr                  /* Address of Communications Block */
	a0    = ComBlk                  /* Where it is located */
	*r0   = a0                      /* Store it */
	return


@



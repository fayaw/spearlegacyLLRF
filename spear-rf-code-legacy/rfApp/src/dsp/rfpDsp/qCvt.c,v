#include <stdio.h>
#include <unistd.h>

#define DEFAULT_Q_VALUE  14


int main (int    argc,
          char **argv)
{
  extern char   *optarg;
  int            c;
  float          f;
  long           s;
  int            fToS;
  int            q = DEFAULT_Q_VALUE;


  /* Process command line arguments */
  while ((c = getopt (argc, argv, "f:s:h")) != -1)
  {
    switch (c)
    {
      case 'f':
        sscanf (optarg, "%f", &f);
        fToS = 1;
        break;

      case 's':
        sscanf (optarg, "%i", &s);
        fToS = 0;
        break;

      case 'h':
      default:
        printf ("\nusage: %s [options] [Q value]\n"
"\twhere options include:\n\n"
"\t-f to convert a floating point number to the\n"
"\t   corresponding short integer in Q format\n"
"\t-s to convert a short integer  number in Q format to the\n"
"\t   corresponding floating point\n"
"\n\t <Q value> is the format to convert to and defaults to %i\n", argv[0], DEFAULT_Q_VALUE);
        exit (1);
    }
  }

  if (optind < argc)
  {
    sscanf (argv[optind++], "%i", &q);
  }

  if (fToS)
  {
    short i = (short) (f * (float) (1 << q));

    if ((((f >= 0.0) && (!(i & 0x8000))) || (((f < 0.0) && (i & 0x8000)))) &&
        (!((i == 0) && (f != 0.0))))
    {
      printf ("%f = 0x%0hhx = %hi\n", f, i, i);
    }
    else
    {
      printf ("%f can't be written in Q%d format\n", f, q);
    }
  }
  else
  {
    float a = (float) ((float) s / (float) (1 << q));

    printf ("%hi = 0x%04hx = %f\n", s, s, a);
  }

  exit (0);
}
@



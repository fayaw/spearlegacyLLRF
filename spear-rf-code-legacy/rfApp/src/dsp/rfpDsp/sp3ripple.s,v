/*
** Notes:
**      In the code below, Iref, Qref, I and Q are received as 16 bit 2's
**      complement numbers.  The arctan function doesn't care about the
**      magnitude of these numbers and properly returns the arc tangent of Q/I
**      in the range [-PI to PI] in q13 format.  
**
**      The code was written so that it is fairly easy to adjust the number
**      of harmonics treated.  However, there are some consequences outside
**      of the time the calculation takes.  The estimator loop accumulates
**      its answer in q11 format which runs from [-16.0 to 16.0[.  With
**      twelve harmonics this number may saturate for both the phase and
**      amplitude estimators.  This is not necessarily bad since the filter
**      manages to overcome this problem and comes out of saturation.  With
**      the expected signal levels, the problem of saturation should not occur.
**      Thus, note that it may be necessary to adjust the amount of head room
**      available to the accumulator by lowering its precision when changing
**      the number of harmonics.  The head room required is also a function
**      of the input signal levels.
**
**      The four functions "Message to DSP", "Open/Close Ripple Loop", "Ripple
**      Clock", and "Rear Panel Trigger" are implemented in hardware as both
**      interrupts and BIO bits on the RFP board.  "Message to DSP", "Ripple
**      Clock" and "Rear Panel Trigger" all need to be acted upon when there
**      has been an edge indicating that they are asserted.  "Open/Close Ripple
**      Loop" is a level sensitive signal.  Edge sensitive signals must be
**      handled by interrupt.  Polling BIO bits can not reliably detect an
**      edge.   So, unfortunately (since it takes more cycles) we have to
**      handle three of the four functions by setting a flag in an ISR.
**      Fortunately, we have enough unused registers (i, j, k) that can serve
**      the purpose of holding a flag.  At the moment there is nothing to do
**      for the "Rear Panel Trigger" signal, so nothing is implemented for it.
**
**      Debugging data can be made to appear in the ERAM by defining the DBG
**      macro.  The overall operation of the algorithm is not affected by this,
**      but the total time it takes clearly is.
**
**      Describe taking data and moving the ii file data source to whatever
**      point you want to test.  Oh, yeah, forgot about this.  Well, gotta
**      move on.  Maybe we'll get to this some day.  In the mean time: Sorry!
**
**      -- 4/18/97
**      I really oughta reread the above notes and cut out what's no longer
**      valid and update the rest, if necessary, but not now.
**
**      A word about the Reference I and Q acquisition:
**      Since the ADC used to digitize the reference signal is slow, data
**      won't be ready at the PDB until 7 CKOs later.  Thus the read from the
**      pdx register will load garbage the first time and upon completion load
**      the parallel input register with garbage from the changing data on the
**      PDB.  Thus the next read (after 7 CKOs) will load garbage but strobe
**      valid data into the parallel input register.  A third read is then
**      necessary to get a hold of the valid data.
**
**      Interlacing of the code to read the PDB:
**      To eliminate time wasted in a previous version of this code by doing
**      nops between setting up PSEL lines and reading the pdx register (for
**      Qref and Iref), I've interlaced the code in perhaps a nonobvious way.
**      We now set up the PSEL lines to read Qref during the strobe to update
**      the quad DACs.  Other work is then done before reading the pdx register
**      twice more (according to the method described above) to get valid data.
**      This other work must take at least 7 CKOs.
**
**      Next the klystron data is read since it is immediatly ready.  Before
**      launching into the data phase and amplitude calculations, we set up
**      the PSEL lines in preparation to reading Iref.  Since the data phase
**      and amplitude calculations take more then 7 CKOs, the Iref data will
**      be ready at the parallel port by the time they're completed.  Then
**      we read the corresponding pdx register twice more to get valid data.
**
**
*/


#include <1610.h>

#include "dspDef.h"
#include "aucDef.h"
#include "intDef.h"
#include "bioDef.h"
#include "pioDef.h"
#include "sttDef.h"
#include "timDef.h"
#include "vecDef.h"

#include "comDef.h"
#include "dspCmdDef.h"

.extern _sin
.extern _cos
.extern _atan
.extern _lusqrt
	
#define RIPPLE_CLOCK                    /* Use Ripple Clock to trigger algo */

/*#define DBG                           /* Turn this on to get output in ERAM */
/*
** A note about telling the IOC about how many harmonics we have. Because of the
** way the cache loop is done, because the Amplitude coefficients have no DC 
** term, there must be 4 extra zero coefficients after the fast terms. It's 
** in the array at the end. Just tell the IOC there is one more fast term 
** than we actually process.
*/
#define SIZFIR      10              /* Size of FIR filter for 4x decimation */
#define NUMFHARMS   34              /* Number of Fast harmonics     */
#define NUMFHARMS2  68              /* Number for double precision values */
#define NUMFHARMS4 136              /* Need 4 values for each Fast harmonic */
#define NUMSHARMS    4              /* Number of Slow harmonics     */
#define NUMSHARMS2   8              /* Number for double precision values */
#define NUMSHARMS4  16              /* Need 4 values for each Slow harmonic */
#define NUMSHARMSM1  (NUMSHARMS-1)  /* For 0 based decrementing */
#define Dacs  DSP_A_DACS            /* Location of DAC registers */
#define INT_MASK  (INT_M_MSG2DSP)

/* Open loop values: */
#define DAC_K_IQ_QI  0x0000         /* 0.00 V (changed to 2s comp) */

/* Some zeroes */
#define ZERO   0.0!13
#define PHS_0 ZERO


/*
** Nota Bene!!!
** Some notes on eram. When the DSP is booted, the code is initially loaded
** into eram starting at address 0. The DSP then loads it into its ram and
** we're off and running. Now messages twixt the IOC and the DSP are passed
** in this eram area but since code is initially loaded here you can't
** initialize anything here lest it's explicitly done in the DSP code.
** Furthermore, I needed to load a large data table into eram without
** adding a new message to do so.
**
** So what I did in lusqrt.s is to assemble this table at an eram address that 
** is beyond any code or DSP ram data. This could then get loaded with the 
** DSP code but since they would be separated, there would be no conflict. 
** At the present time, that value is 0x800 plus the end of this eram. 
** current ram length is ~0x600 words so if you add 0x200 more words of code 
** and/or data you'll have to increase that number.
*/

.rsect ".eram"

	.= DSP_A_ERAM
/*
** Buffers for data from VXI message interface. Both Phase and Ampl coefficients
** use the same space since they can't be simultaneously loaded. Turns out 
** that the VXI access is so much slower than the 23KHz rate that there's no 
** chance of conflict. The labels are here just for reference.
*/
Daco_IOC:          4*int              /* DAC offsets from IOC */
Coef_IOC: NUMFHARMS4*int              /* One array for Coefficients from IOC */
		   4*int              /* A dummy for the cache loop */
	  NUMSHARMS4*int
/*
** End of data from VXI interface. Since the IOC reads some of the following 
** data, start it at a fixed offset so we don't have to change indexes 
** whenever we change the number of harmonics. That also means if you fiddle 
** with any of these you must change the offsets in p2RfRfpDef.h.
*/
.=0x200
IQPArSav: 4*int 0.0                   /* Place to save reference I & Q (q15)*/
				      /* Phase (q13) & Amplitude (q15) */
IQPAkSav: 4*int 0.0                   /* Place to save Klystron I & Q (q15),*/
				      /* Phase (q13) & Amplitude (q15) Error*/

Wsave:    4*int 0.0                   /* II, IQ, QI, QQ DAC weights */

PhsErr:   int                         /* Phase Error is saved here */
	  int                         /* Phase Error modulo PI is here */
AmpErr:   int                         /* Amplitude Error is saved here */
PhsOut:   int                         /* Phase Estimate is saved here */
	  int                         /* Phase Estimate modulo PI is here */
AmpOut:   int                         /* Amplitude Estimate is saved here */
	  int                         /* Gain Adjusted Amplitude Estimate */
/* W.C.R: The following is added to hold now unused IQ&A klystron data */
IQAkSav:  2*int 0.0
	  int 0xdead


.rsect ".ram"

/*********** Interrupt and exception vectors ***********/
	.= VEC_A_RESET
start:  goto main                     /* Jump to main routine */

	.= VEC_A_MSG2DSP
	goto  Msg2Dsp                   /* 2 Message to DSP */

/* 
** We check the ins register for an interrupt in FinishUp so this ISR need 
** do nada.
*/
	.= DSP_A_CODELOW
Msg2Dsp:
	ireturn                         /* dismiss it */

/*********** Main program ************/
main:
	call    InitReg                 /* Initialize registers */
	call    InitVecTbl              /* Initialize vector table */
	call    ComInit                 /* Initialize comm. block */

	ybase = YBase                   /* Refer offsets to IRAM */
	ar0   = 1                       /* used for double precision */
	ar1   = 2                       /* To convert from q11 to q13 */
	ar2   = 3                       /* To convert from q10 to q13 */
	ar3   = 15                      /* used for double precision */

	ins   = 0xffff                  /* Clear all interrupts */

	cbit  = BIO_ON(BIO_V_DSPRUN)    /* DSP ready to run */

	r2    = Status                  /* Declare status OKAY    */
	a0    = STT_OKAY
	*r2   = a0

	r2    = SttArg                  /* Address of status arguments */
	a0    = 0x4DAC                  /* Declare ERAM to DACs capability */
	*r2   = a0

	r2    = DspMsg                  /* Send message to CPU */
	a0    = CMD_K_READY             /* Indicate DSP is ready & running */
	*r2   = a0
	cbit  = BIO_SET(BIO_V_MSG2CPU) 
	cbit  = BIO_CLEAR(BIO_V_MSG2CPU)  /* Interrupt CPU; we're ready */ 

	r0    = Junk                    /* Don't write on something useful */
	c1    = -NUMSHARMSM1        /* c1 is used for the slow harmonic index */

/****** Top of Ripple Loop ******/
Loop:
	cbit  = BIO_OFF(BIO_V_GEN1)     /* 2 LED off to measure loop time */

#ifdef RIPPLE_CLOCK
/****** Look for a low to high Ripple Clock transition ******/
RClow:  cbit  = BIO_TESTT(BIO_V_RIPCLK) /* 2 Get current state of Ripple Clock*/
	if allt goto RClow              /* 3 If high, wait for it to go low */

RChigh: cbit  = BIO_TESTT(BIO_V_RIPCLK) /* 2 Get current state of Ripple Clock*/
	if allf goto RChigh             /* 3 If low, wait for it to go high */
/*minT=7, maxT=12, meas'd*/

#else /* RIPPLE_CLOCK */
	goto    FinishUp                /* 2 Go handle message */
#endif /* RIPPLE_CLOCK */

Ripple:                                 /* Jump here if s/w ripple clock trig */
	cbit  = BIO_ON(BIO_V_GEN1)      /* 2 Light LED to measure loop time */


#ifdef RFP
	r2    = DSP_A_UPDDACS           /* 2+12 Register to update the DACs */
	*r2   = a0                      /* 2 Strobe it - value doesn't matter */
#endif /* RFP */

	cbit  = BIO_TESTT(BIO_V_RIPLOOP)/* 2 Check state of Ripple Loop */
	if allt goto Closed             /* 3 Jump if Loop is closed */

/****** Start of Ripple Loop with open loop values ******/
Open:   auc   = 0x8                     /* Set a0 for saturation on output */
                                        /*    and a1 for extract on output */
	a0    = *(AmpSet - YBase)       /* Amplitude Set-Point, q13 */
	a0l   = 0
	a1    = a1 - a1                 /* clear a1 */
	a0    = a0 << 2                 /* Make q15 for DAC output */
	p     = a0                      /* II, QQ, q15 */
	y     = DAC_K_IQ_QI             /* IQ, QI, q15 */
	
	r0    = DacOs                   /*   Point to DAC offsets */
	r2    = Dacs                    /*   Point to II DAC */
	
	a0    = *r0++                   /*   II offset */
	a0    = a0 + p                  /*   IIos + II */
	a1l   = a0                      /*   This applies saturation */
	a1    = a1l + 0x8000            /*   change to offset binary */
	*r2++ = a1l                     /*   save to II DAC w/o saturation*/
	
	a0    = *r0++                   /*   IQ offset */
	a0    = a0 + y                  /*   IQos + IQ */
	a1l   = a0                      /*   This applies saturation */
	a1    = a1l + 0x8000            /*   change to offset binary */
	*r2++ = a1l                     /*   save to IQ DAC w/o saturation*/
	
	a0    = *r0++                   /*   QI offset */
	a0    = a0 + y                  /*   QIos + QI */
	a1l   = a0                      /*   This applies saturation */
	a1    = a1l + 0x8000            /*   change to offset binary */
	*r2++ = a1l                     /*   save to QI DAC w/o saturation*/
	
	a0    = *r0++                   /*   QQ offset */
	a0    = a0 + p                  /*   QQos + QQ */
	a1l   = a0                      /*   This applies saturation */
	a1    = a1l + 0x8000            /*   change to offset binary */
	*r2++ = a1l                     /*   save to QQ DAC w/o saturation*/
	
	r1    = Wsave                   /*   Save results to ERAM */
	r2    = Dacs                    /*   Point to DAC IO */
	a0    = *r2++                   /*   Read II DAC */
	*r1++ = a0
	a0    = *r2++                   /*   Read IQ DAC */
	*r1++ = a0
	a0    = *r2++                   /*   Read QI DAC */
	*r1++ = a0
	a0    = *r2                     /*   Read QQ DAC */
	*r1   = a0
/*
** Clear history except for DC Phase
*/
	a1    = HistEnd                 /* Last of history */
	a0    = a1h - HistStart         /* # words to clear */
	a1    = ZERO
	r1    = HistStart
ClearL:
	*r1++ = a1                      /* zero a word */
	a0   = a0h - 1
	if ne goto ClearL               /* Until done */ 

	auc   = 0                       /* Restore auc */

	goto    FinishUp                /* 2 Finish up */
/*** End of Open Loop Ripple Loop ***/  /* 30 */


/****** Start of Ripple Loop with closed loop values ******/
Closed:

/* Retrieve data from parallel ports (now saved but not used) */

	r3    = IQAkSav                 /* 2 Adx to save kly I,Q from IQ&A */
	*r3   = pdx0                    /* 2 Set up to read Ikly */
	*r3++ = pdx1                    /* 2 Get Ikly from parallel port, q16 */
	                                /*   and set PSEL up to read Qkly */
	*r3   = pdx1                    /* 2 Get Qkly from parallel port, q16 */

/* Calculate atan2 (Qkly, Ikly) */
	r3    = IQPAk                   /* 2 Adx at which kly I, Q live */
	r1    = IQPAkSav
	a1    = *r3++                   /* Ikly */
	*r1++ = a1
	a0    = *r3                     /* Qkly (note, R3 value used later)*/
	*r1++ = a0
	a1    = a1 << 1                 /* 1 atan not good when inp near MSB */
	a0    = a0 << 1                 /* 1 atan not good when inp near MSB */

	call _atan    /* meas'd 155 */  /* 131 PhsKly=a0=atan2(Qkly/Ikly), q13*/
	                                /* modifies r0 and r2 */

	a1    = a0 >> 1                 /* 1 Convert to q12 to make room for */
	                                /*   Kly Phase, Ref Phase sum    */
	*r1   = a1                      /* Save PhsKly in ERAM */

	a1    = a1:aa1                  /* 1 Save PhsKly */
	
/* Calculate atan2 (Qref, Iref) */
	r0    = IQPAr                   /* 2 Adx at which ref I, Q live */
	r1    = IQPArSav
	a1    = *r0++                   /* Iref */
	*r1++ = a1
	a0    = *r0                     /* Qref */
	*r1++ = a0
	a1    = a1 << 2                 /* 1 atan not good when inp near MSB */
	a0    = a0 << 2                 /* 1 atan not good when inp near MSB */

	call _atan  /* meas'd 156 */    /* 131 PhsRef=a0=atan2(Qref/Iref), q13*/
	                                /* modifies r0 and r2 */

	a0    = a0 >> 1                 /* 1 Convert to q12 to make room for */
	                                /*   Phase, Ref Phase sum        */
	a1    = a1:aa1                  /* 1 Recall PhsKly */

	*r1   = a0                      /* Save PhsRef in ERAM */

	auc   = 0x70
	a1    = a0 - a1                 /* 1 PhsErr = PhsRef - PhsKly */

	r2    = PhsErr
	*r2   = a1                      /* Save PhsErr in ERAM */

/* Bring phase error into range [-Pi to Pi] */

	y     = 0x3243                  /* 2 Pi q12, double precision */
	yl    = 0xf6a8
	a0    = a1 - y                  /* 1 Phase less than Pi? */
	if le goto LessPi               /* 3 If not jump */
	a1    = a0 - y                  /* 1 Subtract another Pi */
	goto InRng                      /* 2 done */
LessPi: a0    = a1 + y                /* 1 Phase less than -Pi? */
	if gt goto InRng                /* 3 If not, we're done*/
	a1    = a0 + y                  /* 1 Add another Pi */
InRng:  a1    = a1 << 1               /* 1 Convert back to q13 */
				      /*   Phase Error in range [-Pi, Pi] */
	r2    = PhsErr + 1
	*r2   = a1                      /* Phase Error in range [-Pi, Pi] */

/* Calculate AmpKly = sqrt (Ikly**2 + Qkly**2) in range [-2.0 to 2.0[ */
	auc   = 0x70
		      y=*r3               /* 1 Recall Qkly (q15) */
		      x=*r3--             /* 1 Recall Qkly (q15) */
	    p=x*y y=*r3               /* 1 Qkly**2 (q14), Recall Ikly (q15) */
	a0=p          x=*r3++           /* 1 Accum Qkly**2 (q15), Recall Ikly */
		p=x*y   *r3++             /* 1 Ikly**2 (q14) */
	a0=a0+p       *r3++=a1          /* 1 Qkly**2+Ikly**2 q14; Save PhsErr */

      call _lusqrt  /* sqrt with lookup tbl.  AmpKly=sqrt(Qkly**2+Ikly**2) */

/* No need to calculate AmpRef since it isn't used */

	*r3   = a0                      /* 1 Store AmpErr = AmpKly */

	r2    = AmpErr
	*r2++ = a0                      /* Save AmpErr in ERAM */

	auc   = 0x30                    /* 2 Disable a0l and a1l clearing */

/* Phase estimator */

	r3    = *(PhsTs - YBase)        /* 2 Point to current Time Set */
	r0    = *r3++                   /* 2 Pointer to out_h(Z), q13 dbl */
	r1    = *r3++                   /* 2 Pointer to out_h(Z-1), q13 dbl */
	r2    = *r3++                   /* 2 Pointer to out_h(Z-2), q13 dbl */
	r3    = PhsI                    /* 2 in(Z-1), in(Z-2), q13 */
	pt    = Coefs_PhsDC             /* 2 Phase Coefs, start with DC, q14 */
	i     = -3                      /*   to reset pt back to num coefs */
	j     = 2                       /*   for incrementing rN pointer */

  /* Do DC term first, denominator multiply and output are double precision */
	
		      y=*r3   x=*pt++   /* 2                in(Z-1),   Coef 0*/
	        p=x*y y=*r1++ x=*pt++   /*   Coef0*in, LSW(out_h(Z-1), Coef2 */
	a1=p    p=x*y y=*r1++           /*   a1=Coef0*in,prod,MSW(out_h(Z-1) */
	a0=p    p=x*y   *r2++           /*   Coef2*LSW(out_h(Z-1), Coef2*MSW */
	a0    = a0 >> ar3               /*   shift Coef2*LSW into a0l */
	a0=a0+p         *r2++           /*   add in Coef2*MSW(out_h(Z-1) */
	a0=a0+a1                        /*   add in numerator term */

/* Bring DC compponent of phase estimator into range [-Pi to Pi] */

	y     = 0x1921                  /* 2 y = 3.141592654!11, double */
	yl    = 0xf654
PosDc:  a1    = a0 - y                  /* 1 Subtract 1st Pi, Phs > than Pi? */
	if le goto NegDc                /* 3 If not jump */
	a0    = a1 - y                  /* 2 Subtract second Pi */
	goto DoneDc                     /* 2 Done */
NegDc:  a1    = a0 + y                  /* 1 Add first Pi, Phase <= than -Pi? */
	if gt goto DoneDc               /* 3 If not, we're done */
	a0    = a1 + y                  /* 2 Add second Pi */
DoneDc:
	a0    = a0 << ar1               /* 1 Convert to q13 */
	a1 = a0                         /*   DC Q13 to a1  */

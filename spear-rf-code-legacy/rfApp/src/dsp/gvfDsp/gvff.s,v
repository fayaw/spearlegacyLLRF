.rsect ".ram"

	.= VEC_A_RESET

strt:	goto main	/* 0: reset vector */
	goto int0_isr	/* 1: INT0 and parallel port interrupts */
	goto err_isr	/* 2: software interrupt (icall) */
	goto err_isr	/* 3: trap from hardware devl. system */


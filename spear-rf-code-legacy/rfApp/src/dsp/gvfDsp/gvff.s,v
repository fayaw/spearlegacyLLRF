A_INT0_DEL:	int DSP_K_INT0_DEL	/* In-FIFO amount of fill before INT0*/ 
A_INTR_ERR:	int 0x0000		/* Number of unexpected interrupts */

/* The following 4 flags are set by interrupts 0 thru 3 respectively: */
A_DATA_RDY:	int 0x0000		/* Flag showing In-FIFO data available*/
A_START_TF:	int 0x0000		/* Flag showing TF mode went active */
A_START_TST:	int 0x0000		/* Flag showing TEST mode went active */
A_MSG_WAITING:	int 0x0000		/* Flag showing Host sent a message */

/* misc. program variables: */

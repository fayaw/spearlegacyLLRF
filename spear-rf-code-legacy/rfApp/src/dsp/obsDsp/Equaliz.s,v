#include <1610.h>
#include <dspDef.h>
#include <pioDef.h>
#include <bioDef.h>
#include <intDef.h>
#include <aucDef.h>
#include <gvffMisc.h>


.global equaliz
.extern EQUAL_COEF	

.rsect ".ram"

equaliz:
/*
   Description
   -----------
   Equalizer - function to compensate phase response for LPF.   
	Inputs:
	--------
		r2 -  pointer to data in
	Outputs:
	--------
		none
	Registers:
	---------
		pt  - pointer to coefficients
		r2 -  pointer to data in
		r3 -  pointer to data out
		a0 - scratch
		ar0 - scratch
		p - scratch
		j - scratch
		auc - scratch
		c0 - scratch



*/

	a0 = auc
	ar0 = a0			/* Save auc register */
	auc = 0x2
	a0 = r3
	r2 = a0
	pt = EQUAL_COEF
	j = EQUAL_TAPS_1	/* Should -EQUAL_TAPS, but function of implem*/

	a0 = a0 - a0
	p = a0
	 y = *r2++ x = *pt++

	do EQUAL_TAPS {
		a0=a0+p  p = y*x  y = *r2++  x = *pt++
	}
	*r3++ = a0		 	 /* write result back */

	c0 = BUF_SIZE_CNT
equaliz_1: 
	pt = EQUAL_COEF
	a0 = a0 -a0
	*r2++j		  /* return pointer back to next data for filtering */
	redo EQUAL_TAPS_R /* EQUAL_TAPS+1 times, a0=0, p=0 */
	*r3++ = a0	  /* write result back */
	if c0lt goto equaliz_1

	c0 = BUF_SIZE_CNT_1
equaliz_2: 
	pt = EQUAL_COEF
	a0 = a0 -a0
	*r2++j		  /* return pointer back to next data for filtering */
	redo EQUAL_TAPS_R /* EQUAL_TAPS+1 times, a0=0, p=0 */
	*r3++ = a0	  /* write result back */
	if c0lt goto equaliz_2

	a0 = ar0
	auc = a0			/* Restore auc register */
	
        return
@



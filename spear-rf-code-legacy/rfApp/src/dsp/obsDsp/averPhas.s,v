#include <1610.h>
#include <dspDef.h>
#include <pioDef.h>
#include <bioDef.h>
#include <intDef.h>
#include <aucDef.h>
#include <comDef.h>
#include <gvffMisc.h>


.global aver_phs	

.rsect ".ram"

aver_phs:
/*
   Description
   -----------
    Function add all phases in radian together. To convert to average has to be
    divided by 9 (144/16) and multiplyed by 16 (256/16)   

	Registers:
	---------

		r2 -  pointer to phase data
		y - scratch 
		a0 - output

*/
	a0 = a0 - a0
	y = a0
				/* Compute first 72 data points */	
	do BUF_SIZE {	
		yl = *r2++
		a0 = a0 + y
	}
					/* Compute second 72 data points */
	redo   BUF_SIZE
	a0 = a0 << 8
	r2 = AvPhase_OUT
	*r2 = a0
	return
@



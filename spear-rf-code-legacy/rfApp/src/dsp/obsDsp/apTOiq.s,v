#include <1610.h>
#include <dspDef.h>
#include <pioDef.h>
#include <bioDef.h>
#include <intDef.h>
#include <aucDef.h>
#include <gvffMisc.h>


.global AP2I
.global AP2Q
.extern	_sin
.extern	_cos

.rsect ".ram"

AP2I:
/*
   Description
   -----------
    Function convert A and P record into I record   

	Registers:
	---------

		r0 -  scratch
		r1 -  pointer to data out ( I )
		r2 -  pointer to data in A
		r3 -  pointer to data in P
		a0 - scratch
		aa0 - scratch
		a1 - scratch
		ybase - scratch
		c0 - scratch
		ar0 - scratch


*/

	ybase = DSP_A_YBASE
	a0 = auc
	*(2) = a0			/* Save auc register */
	auc = 0x0                       /* Clear low half of accum.     */
	*(1) = pr			/* location of storage of return addr */
					/* done in order save pr register     */
					/* required if subroutin call another */
					/* subrutin 			      */
	ar0 = 1
	c0 = BUF_SIZE_CNT	
AP2I_1:
	a1 = *r3++
	a1 = a1
	if  pl a1 = -a1			/* find -asb(a1)		*/
	f3 a0 = a1h + 0x6488		/* to check if a1 is greater pi/2 */
	a0h - 0x3244
	if mi a1 = a0		/* if true substruct pi/2	*/
	*(0) = a0			/* Save sign of a0		*/
	a1 = a1 << ar0			/* For proper alignment		*/
	call _cos			/* Call and execute cosine routine. */
	a1 = *(0)			/* Restore original argument 	*/
	a1h - 0x3244			/* Find right quadrant		*/
	if mi a0 = -a0
	y = a0
	auc = 0x2
	x =  *r2++
	p = y*x
	a0 = p
	*r1++ = a0                       /* Save the output to out.      */
	if c0lt goto AP2I_1
					/* Compute second 72 data points */
	c0 = BUF_SIZE_CNT	
AP2I_2:
	a1 = *r3++
	a1 = a1
	if  pl a1 = -a1			/* find -asb(a1)		*/
	f3 a0 = a1h + 0x6488		/* to check if a1 is greater pi/2 */
	a0h - 0x3244
	if mi a1 = a0		/* if true substruct pi/2	*/
	*(0) = a0			/* Save sign of a0		*/
	a1 = a1 << ar0			/* For proper alignment		*/
	call _cos			/* Call and execute cosine routine. */
	a1 = *(0)			/* Restore original argument 	*/
	a1h - 0x3244			/* Find right quadrant		*/
	if mi a0 = -a0
	y = a0
	auc = 0x2
	x =  *r2++
	p = y*x
	a0 = p
	*r1++ = a0                       /* Save the output to out.      */
	if c0lt goto AP2I_2
	a0 = *(2)
	auc = a0			/* Restore auc register */
	pr = *(1)			/* done in order restore pr register */
	return

AP2Q:
/*
   Description
   -----------
    Function convert A and P record into Q record   

	Registers:
	---------

		r0 -  scratch
		r1 -  pointer to data out ( Q )
		r2 -  pointer to data in A
		r3 -  pointer to data in P
		a0 - scratch
		a1 - scratch
		ybase - scratch
		c0 - scratch
		ar0 - scratch
*/

	ybase = DSP_A_YBASE
	a0 = auc
	*(2) = a0			/* Save auc register */
	auc = 0x0                       /* Clear low half of accum.     */
	*(1) = pr			/* location of storage of return addr */
					/* done in order save pr register     */
					/* required if subroutin call another */
					/* subrutin 			      */

					/* Compute first 72 data points */

	c0 = BUF_SIZE_CNT
	ar0 = 1	
AP2Q_1:
	a1 = *r3++
	*(0) = a1			/* Save a1			*/
	a1 = a1
	if  mi a1 = -a1			/* find -asb(a1)		*/
	f3 a0 = a1h - 0x6488		/* to check if a1 is greater pi/2 */
	a0h - 0xcdbc
	if pl a1 = -a0		/* if true substruct pi/2	*/
	a1 = a1 << ar0			/* For proper alignment		*/
	call _sin			/* Call and execute sine routine. */
	a1 = *(0)			/* Restore sign of original argument */
	a1 = a1
	if mi a0 = -a0
	auc = 0x2
	x = a0
	y = *r2++
	p = y*x
	a0 = p
	*r1++ = a0                       /* Save the output to out.      */
	if c0lt goto AP2Q_1
					/* Compute second 72 data points */
	c0 = BUF_SIZE_CNT	
AP2Q_2:
	a1 = *r3++
	*(0) = a1			/* Save a1			*/
	a1 = a1
	if  mi a1 = -a1			/* find -asb(a1)		*/
	f3 a0 = a1h - 0x6488		/* to check if a1 is greater pi/2 */
	a0h - 0xcdbc
	if pl a1 = -a0		/* if true substruct pi/2	*/
	a1 = a1 << ar0			/* For proper alignment		*/
	call _sin			/* Call and execute sine routine. */
	a1 = *(0)			/* Restore sign of original argument */
	a1 = a1
	if mi a0 = -a0
	auc = 0x2
	x = a0
	y = *r2++
	p = y*x
	a0 = p
	*r1++ = a0                       /* Save the output to out.      */
	if c0lt goto AP2Q_2
	a0 = *(2)
	auc = a0			/* Restore auc register */
	pr = *(1)			/* done in order restore pr register */
	return
@



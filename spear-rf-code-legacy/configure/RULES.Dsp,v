text
@# $Id: RULES.Dsp,v 1.1.1.1 2003/01/10 23:16:56 greg Exp $

ifdef SRCS.s
	$(DEPENDS_RULE.s)
endif

clean::
	@@echo "Cleaning"
	@@$(RM) *.i *.o *.a $(TARGETS) $(PROD) $(LIBNAME) $(INC)


#  The order of the following dependencies is
#  VERY IMPORTANT !!!!

%: %.o
	$(RM) $@@
	$(LINK.s) -o $@@ $(IFILE) $< $(LDLIBS)

%.o: %.s
	$(RM) $@@
	$(COMPILE.s) $<

%.o: ../%.s
	$(RM) $@@
	$(COMPILE.s) $<

$(LIBNAME):
	@@echo Building library $@@
	$(AR) $(ARFLAGS) $@@ $?

$(INSTALL_BIN)/%: %
	@@echo "Installing $@@"
	@@test -d $(INSTALL_LOCATION_BIN) || mkdir $(INSTALL_LOCATION_BIN)
	@@test -d $(INSTALL_BIN) || mkdir $(INSTALL_BIN)
	@@$(INSTALL) -m 555 $< $(INSTALL_BIN)

$(INSTALL_BIN)/%: ../%
	@@echo "Installing $@@"
	@@test -d $(INSTALL_LOCATION_BIN) || mkdir $(INSTALL_LOCATION_BIN)
	@@test -d $(INSTALL_BIN) || mkdir $(INSTALL_BIN)
	@@$(INSTALL) -m 555 $< $(INSTALL_BIN)

$(INSTALL_MAN)/man9/% \
$(INSTALL_MAN)/man8/% \
$(INSTALL_MAN)/man7/% \
$(INSTALL_MAN)/man6/% \
$(INSTALL_MAN)/man5/% \
$(INSTALL_MAN)/man4/% \
$(INSTALL_MAN)/man3/% \
$(INSTALL_MAN)/man2/% \
$(INSTALL_MAN)/man1/%: ../%
	@@echo "Installing $@@"
	@@test -d $(INSTALL_MAN) || mkdir $(INSTALL_MAN)
	@@test -d $(@@D) || mkdir $(@@D)
	@@$(INSTALL) -m 644 $< $(@@D)

$(INSTALL_INCLUDE)/%: %
	@@echo "Installing $@@"
	@@test -d $(INSTALL_INCLUDE) || mkdir $(INSTALL_INCLUDE)
	@@$(INSTALL) -m 644 $< $(INSTALL_INCLUDE)

$(INSTALL_INCLUDE)/%: ../%
	@@echo "Installing $@@"
	@@test -d $(INSTALL_INCLUDE) || mkdir $(INSTALL_INCLUDE)
	@@$(INSTALL) -m 644 $< $(INSTALL_INCLUDE)

$(INSTALL_DOC)/%: ../%
	@@echo "Installing $@@"
	@@test -d $(INSTALL_DOC) || mkdir $(INSTALL_DOC)
	@@$(INSTALL) -m 644 $< $(INSTALL_DOC)

.PRECIOUS: %.o %.s

include .DEPENDS

@

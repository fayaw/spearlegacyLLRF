log
@Rules for compiling RF IOC DSP code - used by rfApp only.
@
text
@DSP_AR   = $(DSP_DIR)/ar1600
DSP_AS   = $(DSP_DIR)/as1600
DSP_CMD  = $(DSP_DIR)/cmd1610
DSP_CPP  = $(DSP_DIR)/cpp16
DSP_HEAD = $(DSP_DIR)/head1600
DSP_LD   = $(DSP_DIR)/ld1600
DSP_LIST = $(DSP_DIR)/list1600

#    Include files
DSP_INCLUDES = -I$(DSP_DIR)

DSP_ASFLAGS = -r $(USR_INCLUDES) $(DSP_INCLUDES) $(USR_ASFLAGS)

DSP_LDFLAGS = $(USR_LDFLAGS)
DSP_LDLIBS  = $(USR_LDLIBS)
DSP_DEPLIBS = $(USR_DEPLIBS)

# Build compile line here
COMPILE.s = $(DSP_AS) $(DSP_ASFLAGS) $(CPPFLAGS)
LINK.s    = $(DSP_LD) $(DSP_LDFLAGS)

DEPENDS_RULE.s = $(COMPILE.c) $(DSP_ASFLAGS) -M $(SRCS.s) >> .DEPENDS
@

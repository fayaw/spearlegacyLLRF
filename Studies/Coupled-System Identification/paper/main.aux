\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Measured closed-loop responses, independent LPM estimates every \SI {352}{Hz} combined into data points as in the fits, through the carrier. (a) Magnitude and (b) phase over the full band (logarithmic offset axis, linear within \SI {0.5}{kHz}), the phase with \SI {630}{ns} of delay removed; colour: beam current; (I), (II): sessions. (c) The near band for the same records: the coupled mode appears as a resonance near $\pm f_s$ that moves down with current. (d) The near band at \SI {497}{mA} (session II) for three loop-gain settings, relative to the operating setting. Dotted: noise level, the standard deviation of the estimates, at 22 and \SI {497}{mA} (II) in (a) and (c) and for one record in (d); where it approaches $|H|$, near the carrier, the estimates scatter accordingly.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:data}{{4}{8}{Measured closed-loop responses, independent LPM estimates every \SI {\lpmWidth }{Hz} combined into data points as in the fits, through the carrier. (a) Magnitude and (b) phase over the full band (logarithmic offset axis, linear within \SI {0.5}{kHz}), the phase with \SI {630}{ns} of delay removed; colour: beam current; (I), (II): sessions. (c) The near band for the same records: the coupled mode appears as a resonance near $\pm f_s$ that moves down with current. (d) The near band at \SI {497}{mA} (session II) for three loop-gain settings, relative to the operating setting. Dotted: noise level, the standard deviation of the estimates, at 22 and \SI {497}{mA} (II) in (a) and (c) and for one record in (d); where it approaches $|H|$, near the carrier, the estimates scatter accordingly}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Effective parameters of record-by-record complex-linear fits: (a) loop gain at the operating gain setting, (b) loop delay, (c) loaded $Q$. Circles: session I; squares: session II, coloured at \SI {497}{mA} by the loop-gain setting as in Fig.~\ref {fig:mode}(b). Dashed: the station constants of the selected model (Sec.~\ref {sec:selected}); grey band in (c): $Q_L$ of the four cavities from their reflected power.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:effective}{{5}{8}{Effective parameters of record-by-record complex-linear fits: (a) loop gain at the operating gain setting, (b) loop delay, (c) loaded $Q$. Circles: session I; squares: session II, coloured at \SI {497}{mA} by the loop-gain setting as in Fig.~\ref {fig:mode}(b). Dashed: the station constants of the selected model (Sec.~\ref {sec:selected}); grey band in (c): $\QL $ of the four cavities from their reflected power}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Candidate explanations fitted to all records over the full band. The compressed-klystron models use the AM/PM conversion of the trip records unless stated. $n_p$: free parameters; $\chi ^2/\nu $ overall and in the loop band (\SIrange {25}{550}{kHz}) and the near band ($|f|<\SI {25}{kHz}$); $\Delta $AIC and $\Delta $BIC relative to the selected model~\cite  {Akaike1974,Schwarz1978}.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:models}{{II}{9}{Candidate explanations fitted to all records over the full band. The compressed-klystron models use the AM/PM conversion of the trip records unless stated. $n_p$: free parameters; $\chi ^2/\nu $ overall and in the loop band (\SIrange {\fSplit }{\fHi }{kHz}) and the near band ($|f|<\SI {\fSplit }{kHz}$); $\Delta $AIC and $\Delta $BIC relative to the selected model~\cite {Akaike1974,Schwarz1978}}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces (a) $\chi ^2/\nu $ of the candidate explanations of Table~\ref {tab:models} in the loop band and the near band (all records); the last three have the compression per operating point. (b) Squared normalized residuals per real component over the full band (shaded: near band), averaged over all records and over five adjacent data points; 1 is the noise level. The dips near $\pm \SI {22}{kHz}$ lie at interference lines, which raise the averaged noise level there.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:models}{{6}{9}{(a) $\chi ^2/\nu $ of the candidate explanations of Table~\ref {tab:models} in the loop band and the near band (all records); the last three have the compression per operating point. (b) Squared normalized residuals per real component over the full band (shaded: near band), averaged over all records and over five adjacent data points; 1 is the noise level. The dips near $\pm \SI {22}{kHz}$ lie at interference lines, which raise the averaged noise level there}{figure.6}{}}

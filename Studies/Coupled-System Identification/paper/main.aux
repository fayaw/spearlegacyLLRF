\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Records and operating-point parameters of the selected model. Sessions I and II were a month apart; $n$: number of records; $\Delta G$, $\Delta \phi $: loop-gain and loop-phase settings relative to the operating settings; $V_k$: HVPS voltage, not recorded, estimated from the power balance at the fixed drive (Sec.~\ref {sec:selected}); $g_A$: klystron compression (statistical errors); $\alpha $: noise angle in the cavity frame; $\Delta f$: detuning of each group of records taken minutes apart. The AM/PM conversion is fixed at $k_\mathrm  {AP}=\ensuremath  {-}0.10$ (trip records, Sec.~\ref {sec:trips}).}}{10}{table.3}\protected@file@percent }
\newlabel{tab:groups}{{III}{10}{Records and operating-point parameters of the selected model. Sessions I and II were a month apart; $n$: number of records; $\Delta G$, $\Delta \phi $: loop-gain and loop-phase settings relative to the operating settings; $V_k$: HVPS voltage, not recorded, estimated from the power balance at the fixed drive (Sec.~\ref {sec:selected}); $\gA $: klystron compression (statistical errors); $\alpha $: noise angle in the cavity frame; $\Delta f$: detuning of each group of records taken minutes apart. The AM/PM conversion is fixed at $\kAP =\kapTrip $ (trip records, Sec.~\ref {sec:trips})}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Recorded responses (grey) and the selected model (lines) for five operating points, labelled by beam current and, at \SI {497}{mA} (session II), loop-gain setting: magnitude and phase over the full band (top, middle; phase with \SI {630}{ns} removed) and magnitude in the near band (bottom; shaded: the model $\pm $ the standard deviation of the estimates, the scatter expected of the data). The model is averaged over the \SI {352}{Hz} of each estimate. One set of station constants describes all records.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:fits}{{7}{10}{Recorded responses (grey) and the selected model (lines) for five operating points, labelled by beam current and, at \SI {497}{mA} (session II), loop-gain setting: magnitude and phase over the full band (top, middle; phase with \SI {630}{ns} removed) and magnitude in the near band (bottom; shaded: the model $\pm $ the standard deviation of the estimates, the scatter expected of the data). The model is averaged over the \SI {\lpmWidth }{Hz} of each estimate. One set of station constants describes all records}{figure.7}{}}

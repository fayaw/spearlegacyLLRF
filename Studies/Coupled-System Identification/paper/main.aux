\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The coupled beam--cavity--klystron--loop mode. (a) Frequency and damping rate measured without a model (black, $1\sigma $ errors), predicted from the loop band alone by the effective linear model (grey) and by the compressed-klystron model with nominal ring parameters (orange), and given by the full-band model with the synchrotron frequency identified (blue). (b) Damping rate against beam current, measured (filled) and from the full-band model (open squares); at \SI {497}{mA} (session II) the colours mark the loop-gain setting relative to the operating setting. Dotted: radiation damping.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:mode}{{8}{12}{The coupled beam--cavity--klystron--loop mode. (a) Frequency and damping rate measured without a model (black, $1\sigma $ errors), predicted from the loop band alone by the effective linear model (grey) and by the compressed-klystron model with nominal ring parameters (orange), and given by the full-band model with the synchrotron frequency identified (blue). (b) Damping rate against beam current, measured (filled) and from the full-band model (open squares); at \SI {497}{mA} (session II) the colours mark the loop-gain setting relative to the operating setting. Dotted: radiation damping}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Held-out $\chi ^2/\nu $ (full band) of records predicted from models trained without them: gain transfer at \SI {497}{mA} (four records), phase transfer at \SI {22}{mA} (two), and three beam currents. Bars: one-station linear model, effective model with transferred parameters, one compressed klystron for all currents, compression per operating point (selected). Black ticks: in-sample values of the selected model.}}{12}{figure.9}\protected@file@percent }
\newlabel{fig:crossval}{{9}{12}{Held-out $\chi ^2/\nu $ (full band) of records predicted from models trained without them: gain transfer at \SI {497}{mA} (four records), phase transfer at \SI {22}{mA} (two), and three beam currents. Bars: one-station linear model, effective model with transferred parameters, one compressed klystron for all currents, compression per operating point (selected). Black ticks: in-sample values of the selected model}{figure.9}{}}

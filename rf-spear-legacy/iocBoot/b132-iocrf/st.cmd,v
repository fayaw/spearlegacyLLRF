1.18
log
@Changes for 3.14.11.
@
text
@#==============================================================
#
#  Abs:  vxWorks startup Script file for
#        Spear RF Station 1 (loads epics after st.cmd.noepics)
#  
#  Name: st.cmd.goepics (for Production System)
#
#  Facility:  SLAC/Spear Low-Level RF
#
#  Auth: 13-Nov-2002, Stephanie Allison (SAA)
#  Rev:  dd-mmm-yyyy, Reviewer's Name   (USERNAME)
#
#--------------------------------------------------------------
#  Mod:
#       dd-mmm-yyyy, First Lastname (USERNAME):
#          comments
#
#==============================================================
#
# Load base EPICS software
ld < bin/vxWorks-ppc604_long/rf.munch
#
# Initialize EPICS errlog message queue size.  This needs to be
# done here before any dbLoad call is made.  Note the default is
# 1260 bytes - too many messages are being discarded making it 
# hard to debug.
errlogInit(5000)
#
# Station specific database environment variables 
# for macros used in the database. The sequence
# rf_states.st needs IQA3MACROS.
putenv("IQA3MACROS=R=SRF1")
putenv("DATABASE_MACROS=STN=SRF1")
putenv("C1TUNRLOOP_MACROS=STN=SRF1,CAV=1,name=C1TUNRLOOP")
putenv("C2TUNRLOOP_MACROS=STN=SRF1,CAV=2,name=C2TUNRLOOP")
putenv("C3TUNRLOOP_MACROS=STN=SRF1,CAV=3,name=C3TUNRLOOP")
putenv("C4TUNRLOOP_MACROS=STN=SRF1,CAV=4,name=C4TUNRLOOP")
putenv("AB_CONFIG_FILE   = /cmd/config.ab")
putenv("RESTORE_AB       = /sav/savedataNone")
putenv("RESTORE_VXI      = /sav/savedataNone")
putenv("RESTORE_INP      = /sav/savedataNone")
putenv("RESTORE_FILENAME = /sav/savedataRDB")
#
# Load RF database and templates
dbLoadDatabase( "dbd/rf.dbd" )
rf_registerRecordDeviceDriver(pdbbase)
dbLoadRecords( "db/srf1.db" )
dbLoadRecords("db/iocAdminVxWorks.db","IOC=B132-IOCRF")
#
# Report database to PV server and load any setpoints it gives us.
dbRestore("spear1",0,-1)
dbRestore("/sav/savedataSRF1.sav",0,-1)
#dbRestore("/sav/savedataAB.sav")
#dbRestore("/sav/savedataVXI.sav")
#dbRestore("/sav/savedata.sav")
#
# Configure Allen Bradley
#ab_debug=5
#abDcmDebug=1
abConfigNlinks(1)
abConfigVme(0, 0xc00000, 0x60, 4)
abConfigScanListAscii( 0,getenv("AB_CONFIG_FILE"),1 )
#abConfigAuto(0)
#
# The following configures a 13 device
# window starting at logical address 1(excluding 
# the slot-0 controller which is defined with a
# logical address of zero).
_EPICS_VXI_LA_BASE  = (char)0x01
EPICS_VXI_LA_COUNT = (char) 13
#
# The following define a window in
# A24/A32 space where the EPICS 
# Resource Manager (in drvEpvxi)
# is allowed to place A24/A32 devices.
EPICS_VXI_A24_BASE = 0x00900000
EPICS_VXI_A24_SIZE = 0x00100000
EPICS_VXI_A32_BASE = 0x90000000
EPICS_VXI_A32_SIZE = 0x10000000
#
# Optionally disable logging
# NOTE: must be done before iocInit!
#iocLogDisable=1
#
# Start EPICS
#vxi_debug=5
iocInit()
#
# Start state sequence
seq(&rf_states,getenv("DATABASE_MACROS"))
#
# Start tuner loop sequences
seq(&rf_tuner_loop,getenv("C1TUNRLOOP_MACROS"))
seq(&rf_tuner_loop,getenv("C2TUNRLOOP_MACROS"))
seq(&rf_tuner_loop,getenv("C3TUNRLOOP_MACROS"))
seq(&rf_tuner_loop,getenv("C4TUNRLOOP_MACROS"))
#
# Start hvps loop sequence
seq(&rf_hvps_loop,getenv("DATABASE_MACROS"))
#
# Start dac loop sequence
seq(&rf_dac_loop,getenv("DATABASE_MACROS"))
#
# Start RFP Octal DAC calibration sequence
# NOTE: Does nothing until activated
seq(&P2RF_Calib,getenv("DATABASE_MACROS"))
#
# Start message logging of things not in bumpless reboot
seq(&rf_msgs,getenv("DATABASE_MACROS"))
#
# Override some values in the database
dbpf("SRF1:STN:ID"," ")
dbpf("SRF1:STN:SUMY:STATC.CALC","A?4:B?3:C?2:D>1?2:D?1:0")
#dbpf("SRF1:STN:RESET:COUNTER.DRVH","9999")
#
@



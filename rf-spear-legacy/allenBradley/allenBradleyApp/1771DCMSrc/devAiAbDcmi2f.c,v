static long ai_init(int after)
{
    if(!after) {
	STATUS		rtn;
	SYM_TYPE	type;

	rtn = symFindByNameEPICS(sysSymTbl,"_abDcmTable",(void *)&pabDcm,&type);
	if(rtn!=OK) errlogPrintf("devAiAbDcmi2f: cant locate abDcmTable\n");
    }
    return(0);
}

static long ai_init_record(struct aiRecord *precord, int maxCount)
{
    struct link 	*plink = &precord->inp;
    char		*parm=NULL;
    unsigned short	table,word;
    char		*period;
    abDcmStatus		dcmStatus;
    char                parmSmall[80];
    int                 parmSize=0;

    if(!pabDcm) {
	precord->pact = TRUE; goto done;
    }
    /* set linear conversion slope if desired*/
    if (maxCount > 0) precord->eslo = (precord->eguf -precord->egul)/
			              (float)maxCount;
    parmSize = strlen(plink->value.instio.string)+1;
    parm = ((parmSize<=80) ? &parmSmall[0] : (char *)malloc(parmSize));
    strcpy(parm,plink->value.instio.string);
    /*parm has the form pvname.Tx[word]*/
    period = strchr(parm,'.');
    if(!period) {
	errlogPrintf("record %s INP %s is illegal\n",precord->name,parm);
	precord->pact = TRUE; goto done;
    }
    if(sscanf(period+1,"T%hu[%hu]",&table,&word)!=2) {
	errlogPrintf("record %s INP %s is illegal\n",precord->name,period+1);
	precord->pact = TRUE; goto done;
    }
    *period = 0;
    dcmStatus = (*pabDcm->connect)(&precord->dpvt,parm,table,word,1);
    if(dcmStatus!=abDcmOK) {
	errlogPrintf("record %s abDcm.connect error %s\n",
	    precord->name,pabDcm->abDcmStatusMessage[dcmStatus]);
	precord->pact = TRUE; goto done;
    }
done:
    if(parmSize>80) free((void *)parm);
    return(0);
}
static long ai_init_record_i2f(struct aiRecord *pai)
{
    return(ai_init_record(pai, 0));
}    
static long ai_init_record_16bit(struct aiRecord *pai)
{
    return(ai_init_record(pai, 65535));
}    
static long ai_init_record_13bit(struct aiRecord *pai)
{
    return(ai_init_record(pai, 8191));
}    
static long ai_init_record_12bit(struct aiRecord *pai)
{
    return(ai_init_record(pai, 4095));
}    

static long ai_get_ioint_info(int cmd,struct aiRecord *precord,
    IOSCANPVT *ppvt)
{
    if(!pabDcm) return(0);    
    if(!precord->dpvt) return(0);
    (*pabDcm->get_ioint_info)(precord->dpvt,cmd,ppvt);
    return(0);
}

static long ai_read(struct aiRecord *precord, unsigned short mask)
{
    unsigned short      svalue;
    abDcmStatus		dcmStatus;

    if(!pabDcm) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    dcmStatus = (*pabDcm->get_ushort)(precord->dpvt,&svalue);
    if(dcmStatus!=abDcmOK) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    precord->rval = (long)(svalue & mask);
    return(0);
}

static long ai_read_i2f(struct aiRecord *precord)
{
    short	        svalue;
    abDcmStatus		dcmStatus;

    if(!pabDcm) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    dcmStatus = (*pabDcm->get_ushort)(precord->dpvt,(unsigned short *)&svalue);
    if(dcmStatus!=abDcmOK) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    precord->rval = (long)svalue;
    return(0);
}

static long ai_read_16bit(struct aiRecord *precord)
{
    unsigned short      svalue;
    abDcmStatus		dcmStatus;

    if(!pabDcm) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    dcmStatus = (*pabDcm->get_ushort)(precord->dpvt,&svalue);
    if(dcmStatus!=abDcmOK) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    precord->rval = ((long)svalue)^0x8000;
    return(0);
}

static long ai_read_13bit(struct aiRecord *precord)
{
    unsigned short	svalue;
    abDcmStatus		dcmStatus;

    if(!pabDcm) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    dcmStatus = (*pabDcm->get_ushort)(precord->dpvt,&svalue);
    if(dcmStatus!=abDcmOK) {
	recGblSetSevr(precord,READ_ALARM,INVALID_ALARM);
	return(0);
    }
    precord->rval = (long)((svalue & 0x1FFF)^0x1000);
    return(0);
}

static long ai_read_12bit(struct aiRecord *precord)
{
    return(ai_read(precord, 0x0FFF));
}

static long ai_linconv_16bit(struct aiRecord *precord, int after)
{

    if(!after) return(0);
    /* set linear conversion slope*/
    precord->eslo = (precord->eguf -precord->egul)/65535.0;
    return(0);
}

static long ai_linconv_13bit(struct aiRecord *precord, int after)
{

    if(!after) return(0);
    /* set linear conversion slope*/
    precord->eslo = (precord->eguf -precord->egul)/8191.0;
    return(0);
}

static long ai_linconv_12bit(struct aiRecord *precord, int after)
{

    if(!after) return(0);
    /* set linear conversion slope*/
    precord->eslo = (precord->eguf -precord->egul)/4095.0;
    return(0);
}

@------------------------------------------------------------------
--					IACK CONTROL								--
------------------------------------------------------------------
--
--	File:           iack_ctl.vhd
--	Created By:     J. Dusatko
--	Created:        July 29, 2003
--
--	Stanford Linear Accelerator Center
--	Copyright 2003
--
--
--		Created on: 7/29/2003 6:12:46 PM
--		Last change: JED 7/30/2003 3:12:12 PM
--
--
--Description:
--	This module implements the IACK cycle Data size selection feature.
--  It modification permits the proper handling of D16 IACK cycles.
--
--	This module is part of a design modification to the U7 EPF8820
--	FPGA on the Kinetic Systems V152 VXI CPU. This VHDL code will be
--  integrated with the FPGA design in the slave.gdf file using the
--	symbol generated by the altera SW.
--
--	CHANGE HISTORY:
--
--		<7-29-2003 JED>: original version
--
--
--
--
--
--
--
--
-------------------------------------------------------------------



-------------------------------------------------------------------

-- Standard library configuration --
Library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.STD_LOGIC_UNSIGNED.all;



--Define I/O Signals
entity iack_ctl is

	port (

		-- Inputs
		reset_l:		in std_logic; --power-on reset from U7

		as_n:		in std_logic; --VXIbus address strobe

		iack_n:		in std_logic; --VXIbus interrupt acknowledge

		rd_int:		in std_logic; --FPGA internal read strobe / from slave>a16_ack state machine

		wr_int:		in std_logic; --FPGA internal write strobe / from slave>a16_ack state machine


		id:			in std_logic_vector(15 downto 0); --internal VXI databus

		a:			in std_logic_vector(15 downto 1);  --internal VXI addr bus


		--outputs
		d16_isel:		out std_logic; --select ctrl to DSn* mux in GAL16V8

		iak_ctrl:		out std_logic_vector(15 downto 0); --output of IACK_CTRL register for readback

		rd_iackctrl:		out std_logic	 --read strobe to rd_mux block

		);

end iack_ctl;



architecture behavioral of iack_ctl is

------------------------------------------------------------------------
--Define Constants
	CONSTANT	iac_reg_val: std_logic_vector(7 downto 0) := x"36"; --A16 offset 0x36


------------------------------------------------------------------------
--define Nodes (SIGNAL statements)

	SIGNAL	iack_ctrl:		std_logic_vector(7 downto 0); --IACK data mode control register

	--SIGNAL	iack_ctrl:		std_logic_vector(15 downto 8); --unused upper byte

	SIGNAL	wr_ictlreg:		std_logic; --decoded write strobe to the IACK_CTRL reg

	SIGNAL	adr:			std_logic_vector(5 downto 0); --right-justified address bus for ease of design

	SIGNAL	irq_lvl:		std_logic_vector(2 downto 0); --right-justified address bus for ease of design

------------------------------------------------------------------------



----------------------------------------------------------------------
--Equations Section

begin

	-------------------------------
	--re-define the address bus for easier use
	adr(5 downto 1) <= a(5 downto 1);
	adr(0)	<= '0';	--placeholder for a0

	--lower 3 bits of adress bus indicate IRQ level during an IACK
	irq_lvl(2 downto 0) <= a(3 downto 1);

	-------------------------------
	--IACK_CTRL register
	--
	-- BIT[0]: Enable
	-- BITS[7:1]: correspond to the IACK level you
	-- would like to respond to as D16
	--
	iac_reg: process (wr_ictlreg, reset_l) begin
		IF (reset_l = '0') THEN
			iack_ctrl <= x"00";
		ELSIF rising_edge(wr_ictlreg) THEN
			iack_ctrl <= id(7 downto 0);
		END IF;
	end process iac_reg;


	--register write strobe logic
	wr_ictlreg			<= '1' WHEN (wr_int = '1') AND (adr = iac_reg_val) ELSE
							'0';

	--register read strobe logic
	rd_iackctrl			<= '1' WHEN (rd_int = '1') AND (adr = iac_reg_val) ELSE
							'0';


	--form the readback value
	--gets sent to the rd_mux.tdf block
	iak_ctrl(15 downto 8)		<= x"00";	--upper byte is unused, set to 0x00
	iak_ctrl(7 downto 0)		<= iack_ctrl(7 downto 0); 

	-------------------------------


	-------------------------------
	--Main Logic section
	--this logic generates the control signal to the DS1* src select mux
	--When the IACK_CTRL register bit corresponding to IACK level is high
	--then the DS1* mux control signal, d16_sel, goes high

	iack_mode: PROCESS (as_n, iack_n, irq_lvl, iack_ctrl) BEGIN
	IF ( as_n = '0' AND iack_n = '0' AND iack_ctrl(0) = '1') THEN
		IF (irq_lvl = x"7" AND iack_ctrl(7) = '1') THEN
			d16_isel <= '1';
		ELSIF (irq_lvl = x"6" AND iack_ctrl(6) = '1') THEN
			d16_isel <= '1';
		ELSIF (irq_lvl = x"5" AND iack_ctrl(5) = '1') THEN
			d16_isel <= '1';
		ELSIF (irq_lvl = x"4" AND iack_ctrl(4) = '1') THEN
			d16_isel <= '1';
		ELSIF (irq_lvl = x"3" AND iack_ctrl(3) = '1') THEN
			d16_isel <= '1';
		ELSIF (irq_lvl = x"2" AND iack_ctrl(2) = '1') THEN
			d16_isel <= '1';
		ELSIF (irq_lvl = x"1" AND iack_ctrl(1) = '1') THEN
			d16_isel <= '1';
		END IF;
	ELSE
			d16_isel <= '0';
	END IF;
	END PROCESS iack_mode;

 ------------------------------------------------------------------------


end behavioral;

@



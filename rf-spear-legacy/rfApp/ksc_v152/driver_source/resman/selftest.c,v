/***************************************************************************
  rmshell.c

  System Self-Test & Diagnostics Management portion of Resource Manager
  (second of six parts) per sections C.4.1 & C.4.1.2, Rules C.4.4, C.4.6
  and C.4.7 of VXIbus System Specification VXI-1, Rev. 1.4; 4/21/92
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>

#include "resman.h"


/*
 * Entry point
 */

int rmSelfTest( time_t sfDelay )
{
   config_t *thisLA;
   UINT16 data, allPassed;
   int la, modID, found, i;
   int status;


/* WAIT UNTIL ALL SELF-TESTS HAVE COMPLETED
 * (all devices have set their Passed bits to 1 
 *  OR >= 5 seconds have elapsed since de-assertion of SYSRESET*)
 * NOTE:  this includes any time used by the Identify Devices step 
 */
   do
   {
      allPassed = 4L;
      for( la = 0; la < NVXIADDR; la++ )
      {
       if( laPresent[la] != LA_NOT_SEEN )
       {
        /* 
         * READ STATUS REGISTER FOR THIS L.A. 
         */
	 status = VXIinReg (la, 0x04, &data);
         allPassed &= data;
       }
      } /* endfor la */
   }
   while( !allPassed && (time((time_t *)NULL) < sfDelay) ); /* 2/14/96 */

/* FORCE ALL FAILED DEVICES INTO THE "SOFT RESET" STATE (Reset bit = 1)
 * WITH SYSFAIL* ASSERTION INHIBITED (Sysfail Inhibit = 1).
 * --> See Rule C.4.4, which mandates setting device dependent bits to 1
 *     unless ResMan knows about the device.  This ResMan doesn't know
 *     about ANY device-dependent Control register bit assignments.
 */
   for( la = 0; la < NVXIADDR; la++ )
   {
      if( laPresent[la] != LA_NOT_SEEN )
      {
        /*
         *  READ STATUS REGISTER FOR CURRENT L.A. 
         */

	status = VXIinReg (la, 0x04, &data);

	if( (data & 4L) == 0L )
	{
	  WARN "Device at LA %3d in slot %2d did not pass self-test.\n"
	    "    It is now in Soft Reset state.\n", la, laPresent[la]);

	  status = VXIoutReg (la, 0x04, 0x7FFF);

	  thisLA = findLAConfig( la, HEAD );
	  thisLA->reset = thisLA->syfInhb = 1;
	  thisLA->passed = 0;
	  thisLA->ready = data >> 3;
	}  /* endif not passed */
      }  /* endif present */
    } /* endfor la */

   return( 0 );
}
@



/***************************************************************************
  modnam.c

  Manipulate model names and ID codes
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>
#include <assert.h>

#include <vxWorks.h>
#include <limits.h>

#include "resman.h"


/* Add an entry to the circular linked list of model names. */
void createModelEntry(mfrName_t **tail,
	char *strManufr, char *strModel, unsigned short modelCode)
{
        mfrName_t *this;
	this = malloc(sizeof(mfrName_t));
	assert(this);
	strcpy(this->manufr, strManufr);
	strcpy(this->model, strModel);

	this->code_mf = modelCode;
        if (*tail == NULL) {
                this->next = this;
        } else {
                this->next = (*tail)->next;
                (*tail)->next = this;
        }
        *tail = this;
}


/* Read model names and IDs from a file. */
void getModelNames(char *path, mfrName_t **tail)
{
   FILE *fpModel;
   char fn[PATH_MAX];
   char strManufr[16], strModel[16];
   unsigned short modelCode;
   int x;

   strcpy( fn, path );
   strcat( fn, "model.tbl" );
   if( (fpModel = fopen( fn, "r" )) == NULL )
   {
      printf( "Could not open %s\n",fn);
      perror( fn );
      return;
   }

   while( !feof(fpModel) )
   {
      if (fscanf(fpModel, "%[^,], %[^,], %hx\n",
         strModel, strManufr, &modelCode) == 3)
      {
         TrimSp(strModel);
         TrimSp(strManufr);
         createModelEntry(tail, strManufr, strModel, modelCode);

      }  /* endif 3 fields */
   }  /* endwhile !feof */

   fclose( fpModel );
   return;
}

int codeToName( mfrName_t      *list,
                char           *strManuf,
                unsigned short modelCode,
                char           *pn )
{
   mfrName_t *this = list->next;
/*/printf("codeToName:modelCode %x\n",modelCode);*/
   do
   {
      /* NEED TO CHECK MANUFACTURER NAME *AND* MODEL CODE */
      if( (modelCode == this->code_mf) &&
          !strcmp(strManuf, this->manufr) )
      {
         strcpy( pn, this->model );
/*/printf("codeToName:TN_FOUND pn %s\n",pn);*/
	 return( TN_FOUND );
      }
      this = this->next;
   } while (this != list->next);
   sprintf( pn, "MODEL_%X", modelCode );
/*/printf("codeToName:TN_DEFAULT pn %s\n",pn);*/
   return( TN_DEFAULT );
}

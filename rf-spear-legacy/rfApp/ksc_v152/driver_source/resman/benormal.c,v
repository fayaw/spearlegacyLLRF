/***************************************************************************
  benormal.c

  Initiates Normal Operation of Message-Based Devices (last of six parts
  of Resource Manager) per section C.4.1.6 (including Rule C.4.14) of
  VXIbus System Specification VXI-1, Rev. 1.4; 4/21/92
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>

#include "resman.h"


/*
 * Entry point
 */

int rmNormalOp( void )

{
  config_t *thisLA;

  UINT16 cmd, data;
  int status, chkResp;
  int i;

  /* 
   * For all top-level commanders in order of increasing 
   * logical addressses 
   */

  for( i = VXI_RESMAN_LA + 1; i < NVXIADDR; i++ ) {
    thisLA = findLAConfig( i, HEAD );
    if( thisLA == NULL ) {
      continue;
    }

    /*
     * Send "begin normal operation" command with "top level" bit 
     * set for any commander with resman as *its* commander
     */

    if( (thisLA->devClass == DEVCL_MESSAGE) && thisLA->passed ) {
      /* 
       * And if it's served by v160 resman at la 0 
       */

      if( TRUE| thisLA->cmdrLA == 0 ) {
	/* 
	 * Set top-level bit for commanders 
	 */
	cmd = ((thisLA->protocol & VXICMDRMASK) == 0)? 0xFDFF : 0xFCFF;
	cmd = 0xFCFF; /** ALWAYS? **/

	/*
	 * Set chk-resp for all but VXI Rev 1.2 devices
	 */
	chkResp = !MBR_REV_12(thisLA->rdProtocol);

	/*
	 * Send command
	 */
	status = WScmd (thisLA->logAdr, cmd, chkResp, &data);

	if (status != WS_RET_IODONE) {
	  fprintf(stderr,
                  "\n* Error while writing BNO command to LA %3d "
		  "[%04X,%04X]\n",
		  thisLA->logAdr, cmd, status );
	}
	else if (chkResp  &&  data != 0xFFFE) {
	  fprintf(stderr,
		  "\n* Error: LA %3d response to BNO:  Status %d",
		  thisLA->logAdr, data >> 12);
	  fprintf( stderr,
		  "  State %d  LA %3d\n",
		  (data >> 8) & 0x000F, data & 0x00FF );
	}
      }
    }
  }

  return( 0 );
}
@



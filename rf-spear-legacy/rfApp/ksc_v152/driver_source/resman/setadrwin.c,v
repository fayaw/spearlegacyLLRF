/***************************************************************************
  setadrwin.c

  Set one of the Address window registers of a MXI extender so the
  address range indicated with 'base' & 'size' are routed in the
  'direction' indicated.
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>

#include "resman.h"



#define  MXI_ADR_MAXSIZE  0x0100
#define  MXI_ADR_MIDPT   (MXI_ADR_MAXSIZE / 2)

int setAddressWindow( unsigned short extndrLA,
		     unsigned short adrSpace,
		     unsigned short direction,
		     unsigned short base,
		     unsigned short size,
		     unsigned short sizeCode)

{

#if 0
   int status;

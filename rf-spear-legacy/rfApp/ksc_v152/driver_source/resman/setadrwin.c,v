   unsigned short data = 0;
   unsigned short winSize = size;
   unsigned short winBase = base;
   unsigned short leftover;
   unsigned short aXX = 0;

   switch( adrSpace )
   {
      case VXI_ADDR_EXT_A24:
         regBase += MXI_A24_WIN;
         aXX = 24;
         break;

      case VXI_ADDR_EXT_A32:
         regBase += MXI_A32_WIN;
         aXX = 32;
         break;

      case VXI_ADDR_EXT_NONE:
      default:
         regBase += MXI_A16_WIN;
         aXX = 16;
         break;
   }   /* endswitch adrSpace */

   /* DOES THIS RANGE CROSS THE MIDPOINT?  IF SO, FORCE IT
    * TO BE BIGGER THAN HALF SO "FLIPPING" LOGIC, NOT
    * NORMAL SIZE-BASED LOGIC, WILL TAKE OVER.
    * This ensures that child buses get big enough windows.
    */
   if( (base < MXI_ADR_MIDPT) && ((base + size) >= MXI_ADR_MIDPT) )
   {
      winSize = MXI_ADR_MAXSIZE - base;
   }

   if( winSize == MXI_ADR_MAXSIZE )
   {
      i = 0;
      winBase = 0;
   }
   else if( winSize > MXI_ADR_MIDPT )
   {
      /* TOGGLE DIRECTION BIT */
      direction ^= MXI_DIRN_MSK;

      /* FIND APPROPRIATE SIZE & CONVERT TO LA WIN REG VALUE */
/* pick the larger of two unused portions, not the sum of them!
 * select the base depending on where we found the bigger piece:
 *  base is the lower end (close to 0); 255 - (base + size) is the upper end
 * If the two are equal, this implementation puts the flipped window high,
 *  assuming LA 0 is in root mainframe & needs to stay there.
 */
      if( base > (MXI_ADR_MAXSIZE - (base + size)) )
      {
         leftover = base;
         winBase  = 0;
      }
      else
      {
         leftover = (MXI_ADR_MAXSIZE - (base + size));
         winBase  = 0xFF;
      }

      for( i = 1;  i < 8; i++ )
      {
            if( (leftover & 0x80) == 0x80 )
               break;
            else
               leftover <<= 1;
      }
      /* FIND NEAREST APPROPRIATE LA BASE */
      /* (8 - i) + (i - 1) = 7 */
      leftover >>= 7;  /* undo the loop's effect on leftover AND clear low bits */
      leftover <<= (8 - i);
      winBase >>= (8 - i);
      winBase <<= (8 - i);
   }

   /* WRITE VALUE TO LA WINDOW REGISTER */
   data = MXI_WINDOW_ENABLE + direction
          + ((i & 7) << 8) + (winBase &= 0x00FF);


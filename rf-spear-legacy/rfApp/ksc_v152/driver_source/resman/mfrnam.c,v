/***************************************************************************
  mfrnam.c

  Manipulate manufacturer ID codes
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>
#include <assert.h>

#include <vxWorks.h>
#include <limits.h>

#include "resman.h"


/* Add an entry to the circular linked list of manufacturers. */
void createMfrEntry(mfrName_t **tail, char *mfrName, unsigned short mfrID)
{
	mfrName_t *this = malloc(sizeof(mfrName_t));

	assert(this);
	strcpy(this->manufr, mfrName);
	this->id_la = mfrID;
	if (*tail == NULL) {
		this->next = this;
	} else {
		this->next = (*tail)->next;
		(*tail)->next = this;
	}
	*tail = this;
}


/* Read manufacturer names and IDs from a file. */
void getMfrNames(char *path, mfrName_t **tail)
{
   FILE *fpMfrName;
   char fn[PATH_MAX];
   char strName[16];
   unsigned short mfrID;

   strcpy( fn, path );
   strcat( fn, "mfnameid.tbl" );
   if( (fpMfrName = fopen( fn, "r" )) == NULL )
   {
#ifdef WARN_VERBOSE
      WARN "Could not open ");
      perror( fn );
#endif
      return;
   }
   while( !feof(fpMfrName) )
   {
      if(fscanf(fpMfrName, "%[^,], %hx\n", strName, &mfrID) == 2)
      {
         TrimSp(strName);
         createMfrEntry(tail, strName, mfrID);
      }  /* endif 2 fields */
   }  /* endwhile !feof */

   fclose( fpMfrName );
   return;
}


int idToName( mfrName_t *list, unsigned short mfrID, char *pn )
{
   mfrName_t *this = list->next;
/*printf("idToName:mfrID %x\n",mfrID);*/
   do
   {
      if( mfrID == this->id_la )
      {
         strcpy( pn, this->manufr );
/*printf("idToName:TN_FOUND pn %s\n",pn);*/
	 return( TN_FOUND );
      }
      this = this->next;
   } while (this != list->next);
   sprintf( pn, "MFR_%X", mfrID );
/*printf("idToName:TN_DEFAULT pn %s\n",pn);*/
   return( TN_DEFAULT );
}


void freeNameList( mfrName_t *list )
{
   mfrName_t *next, *this = list;

   if (this == NULL)
      return;
   do
   {
      next = this->next;
      free( this );
      this = next;
   } while (this != list);
}

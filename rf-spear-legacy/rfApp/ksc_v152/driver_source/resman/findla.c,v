/***************************************************************************
  bldconfg.c

  Assign the next available Logical Address to a Dynamic Configuration
  device.  Address-blocked devices (multiple devices in one slot) are
  handled per section F.3.1.2, Rule F.2.7 of VXIbus System Specification
  VXI-1, Rev. 1.4; 4/21/92
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>

#include "resman.h"


/*
* Entry Point
*/

UINT16 rmFindFreeLAs (UINT16 from,
		      UINT16 to,
		      UINT16 howMany)

{
   int la, incr, n;

   /* SANITY CHECK ON first 3 ARGS */
   if( from >= NVXIADDR )  from = NVXIADDR - 1;
   if( to >= NVXIADDR )  to = NVXIADDR - 1;

   if( howMany >= NVXIADDR ) {
     howMany = NVXIADDR - 2;
   }
   else if( (howMany == 0) || (howMany == (NVXIADDR - 1)) ) {
     /* per VXI spec, 0, 1, and 255 all mean just 1 */
     howMany = 1;
   }

   /* FIGURE THE INCREMENT & REAL STARTING LA FROM # DEVICES:
    * See Rule F.2.7 - round "howMany" up to nearest power of 2
    * then allocate the block at an integer multiple of that
    * same power of 2.  Ex.:  5 devices means increment of 8
    * and allocation at either 8, 16, 24, ... and so on.
    * 13 devices would mean increment of 16 & alloc. at 16, 32, 48, ...
    */

   for( incr = 1; incr <= NVXIADDR; incr <<= 1 ) {
     if( incr >= howMany ) break;
   }

   /* round up to next multiple of incr
    * these 2 lines should be the same as:
    * "from = ((from + (incr - 1)) % incr) * incr;"
    */

   from += (incr - 1);
   from &= ~(incr - 1);

   /* FIND THE FIRST AVAILABLE [BLOCK OF] LA['S]
    */

   for( la = from; la <= to; la += incr ) {
     /* check to see that we don't run past "to" ... */
     for( n = 0; (n < howMany) && ((la + n) <= to); n++ ) {
       if( laPresent[la + n] <= 12 ) break;
     }

     /* If we got what we wanted, that's great! */
     if( n == howMany ) return( la );
   }

   /* DID NOT FIND A BLOCK BIG ENOUGH
    */

   return( NVXIADDR );
}
@



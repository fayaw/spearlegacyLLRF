int assignNonVxiMem( nonVxi_t *nonvxi,
			  config_t *root,
			  unsigned short adrSpace)
{
	nonVxi_t *nonVxiLA;
	config_t *thisLA;
	long i;
	long getMemSize;

	for( nonVxiLA = nonvxi; nonVxiLA != NULL; nonVxiLA = nonVxiLA->next )
	{
#ifdef KSC_DEBUG1
  printf("Assigning memory for LA %d \n",nonVxiLA->pseudoLA);
#endif
		for( thisLA = root; thisLA != NULL; thisLA = thisLA->next )
		{
			 if(nonVxiLA->A16Base == (VXI_LA2PA(thisLA->logAdr)))
			 {
				printf("Error:  A16 Base address conflict \n");
				printf("Non-vxi device LA:%x and VXI LA:%x share same A16 space\n",nonVxiLA->pseudoLA, thisLA->logAdr);
                                nonVxiLA->sysBool = FALSE;
				return(OVERLAP);
			 }
		}
		if(nonVxiLA->sysBool)
		{
	       		if(adrSpace == VXI_ADDR_EXT_A24 && nonVxiLA->A24Size!=0)
                        {
#ifdef KSC_DEBUG1
  printf("Trying to assign nonvxi, A24Base is 0x%x, A24Size is 0x%x\n",
           nonVxiLA->A24Base, nonVxiLA->A24Size);
#endif
                           /* Round the requested size up to a power of 2. */
                           getMemSize = nonVxiLA->A24Size >> 8;
                           if ((nonVxiLA->A24Size & 0xff) != 0)
                              getMemSize++;
                           for (i = 0x8000; i != 0; i >>= 1) {
                              if ((getMemSize & i) != 0) {
                                 if ((getMemSize & ~i) != 0)
                                    getMemSize = i << 1;
                                 break;
                              }
                           }
                           if (getMemSize != (nonVxiLA->A24Size >> 8))
                              WARN "Increasing the A24 space "
                                 "assigned for non-VXI device \"%s\" \n"
                                 "at address 0x%06x, to 0x%04x00 bytes.\n",
                                 nonVxiLA->device, nonVxiLA->A24Base,
                                 (short) getMemSize);

                           /* Ensure the base address is a multiple of size. */
                           nonVxiLA->A24Size = getMemSize << 8;
                           if (nonVxiLA->A24Base % nonVxiLA->A24Size != 0) {
                              WARN "Unable to assign A24 space "
                                 "for non-VXI device \"%s\":\n"
                                 "address 0x%06x is not evenly divisible "
                                 "by size 0x%06x.\n",
                                 nonVxiLA->device,
                                 nonVxiLA->A24Base, nonVxiLA->A24Size);
                              nonVxiLA->sysBool = FALSE;

                           /* Allocate the A24 space. */
                           } else if (getMemBlock(
                              getMemSize, nonVxiLA->A24Base >> 8) == FALSE) {
                              WARN "Unable to assign A24 space "
                                 "for non-VXI device \"%s\"\n"
                                 "at address 0x%06x.\n",
                                 nonVxiLA->device, nonVxiLA->A24Base);
                              nonVxiLA->sysBool = FALSE;
                           }
                        }
	        	else if (adrSpace == VXI_ADDR_EXT_A32 && nonVxiLA->A32Size!=0)
                        {
#ifdef KSC_DEBUG1
  printf("Trying to assign nonvxi, A32Base is 0x%x, A32Size is 0x%x\n", 
           nonVxiLA->A32Base, nonVxiLA->A32Size);
#endif
                           /* Round the requested size up to a power of 2. */
                           getMemSize = nonVxiLA->A32Size >> 16;
                           if ((nonVxiLA->A32Size & 0xffff) != 0)
                              getMemSize++;
                           for (i = 0x8000; i != 0; i >>= 1) {
                              if ((getMemSize & i) != 0) {
                                 if ((getMemSize & ~i) != 0)
                                    getMemSize = i << 1;
                                 break;
                              }
                           }
                           if (getMemSize != (nonVxiLA->A32Size >> 16))
                              WARN "Increasing the A32 space "
                                 "assigned for non-VXI device \"%s\" \n"
                                 "at address 0x%08x, to 0x%04x0000 bytes.\n",
                                 nonVxiLA->device, nonVxiLA->A32Base,
                                 (short) getMemSize);

                           /* Ensure the base address is a multiple of size. */
                           nonVxiLA->A32Size = getMemSize << 16;
                           if (nonVxiLA->A32Base % nonVxiLA->A32Size != 0) {
                              WARN "Unable to assign A32 space "
                                 "for non-VXI device \"%s\":\n"
                                 "address 0x%08x is not evenly divisible "
                                 "by size 0x%08x.\n",
                                 nonVxiLA->device,
                                 nonVxiLA->A32Base, nonVxiLA->A32Size);
                              nonVxiLA->sysBool = FALSE;

                           /* Allocate the A32 space. */
                           } else if (getMemBlock(
                              getMemSize, nonVxiLA->A32Base >> 16) == FALSE) {
                              WARN "Unable to assign A32 space "
                                 "for non-VXI device \"%s\"\n"
                                 "at address 0x%08x.\n",
                                 nonVxiLA->device, nonVxiLA->A32Base);
                              nonVxiLA->sysBool = FALSE;
                           }
                        }
		}
        }
	return( SUCCESS );
}

#endif

typedef struct map {
  unsigned short logAdr;
  unsigned short memRqmt;
} map_t;


/*==========================================================================
  memRqmtCompare
==========================================================================*/

int memRqmtCompare( const map_t *a, const map_t *b )
{
   if( (b)->memRqmt == (a)->memRqmt ) return 0;
   else if( (b)->memRqmt < (a)->memRqmt ) return -1;
   else return 1;
}

#if 0 /* This function has been replaced in allocMem.c */
/*==========================================================================
  findMemBlock 

  Returns TRUE if it found a suitable block;
          FALSE if nothing big enough is free.

  Args:   root - pointer to linked list of free blocks (IN)
          memRqmt - how much memory is needed (IN)
          where - pointer to the base address of the block (OUT)
==========================================================================*/

unsigned short findMemBlock( block_t        *root, 
                             unsigned short  memRqmt, 
                             unsigned short *where )
{
   unsigned short found = FALSE;

   while( !found && (root != NULL) )
   {
      if( root->size >= memRqmt )
      {
         found  = TRUE;
         *where = root->base;
         root->base += memRqmt;  /* update size of this block */
         root->size -= memRqmt;  /* update size of this block */
      }
      else
      {
         root = root->next;
      }
   }
   return( found );
}
#endif


/*==========================================================================
  findLAConfig
==========================================================================*/

config_t *findLAConfig( unsigned short logAdr, 
                        config_t *root )
{
   config_t *thisLA;

   for( thisLA = root; thisLA != NULL; thisLA = thisLA->next )
   {
      if( thisLA->logAdr == logAdr )
      {
         return( thisLA );
      }
   }
   return( thisLA );
}


/*==========================================================================
  assignMemory
==========================================================================*/

int assignMemory( unsigned short adrSpace,
                  unsigned short mainframe,
                  unsigned short base )
{
   block_t  rootAXX;
   config_t *thisLA;
   map_t    *memNeeds = NULL;
   unsigned int aXXCount, aXXNeeded;
   unsigned int i, j;
   unsigned short vxiBase;
   unsigned short blkBase;
   unsigned short status;

/* OPTIONAL:  READ MEMORY REQUIREMENTS OF NON-VXI DEVICES FROM FILE */

/* CALCULATE A24 AND A32 OFFSETS SUCH THAT NO TWO DEVICE'S ADDRESS SPACES
 * OVERLAP (START WITH LARGEST BLOCKS AND WORK DOWN TO SMALLEST ONES)
 * A24 space should be   0x40_0000 ..   0xDF_FFFF
 * A32 space should be 0x4000_0000 .. 0xDFFF_FFFF
 */
   rootAXX.base = base;
   rootAXX.size = (0xA000 + 0x4000) - base;  /* CHECK THIS!!! */
   rootAXX.next = (block_t *)NULL;

/* DETERMINE WHICH DEVICES IMPLEMENT A24 OR A32 REGISTERS BY READING THE
 * ADDRESS SPACE FIELD OF EACH DEVICE'S ID REGISTER (actually, from list)
 * Here we count 'em so we know how much to malloc up later.
 * Also, we take some statistics so we know how much A24 & A32 will be used.
 */
   aXXCount = aXXNeeded = 0;
   for( thisLA = HEAD; thisLA != NULL; thisLA = thisLA->next )
   {
      if( (thisLA->adrSpace == adrSpace)
          &&
          (thisLA->mainframe == mainframe)
        )
      {
         aXXCount++;
         aXXNeeded += (1 << (15 - thisLA->memRqmt));
      }
   }

/* MALLOC UP ENOUGH FOR ALL THE DEVICES WITH MEMORY
 * BUT ONLY DO IT if there's at least 1 module with A24/A32 memory (15mar)
 */
 if( aXXCount )
 {
   assert(memNeeds = (map_t *)calloc( aXXCount, sizeof( map_t ) ));

/* DETERMINE THE NUMBER OF A24 REGISTERS IMPLEMENTED BY EACH DEVICE
 * BY READING THE REQUIRED MEMORY FIELD OF THE DEVICE'S DEVICE TYPE REGISTER
 */
   i = 0;
   for( thisLA = HEAD; thisLA != NULL; thisLA = thisLA->next )
   {
      if( (thisLA->adrSpace == adrSpace)
          &&
          (thisLA->mainframe == mainframe)
        )
      {
         memNeeds[i].logAdr  = thisLA->logAdr;
         memNeeds[i].memRqmt = (1 << (15 - thisLA->memRqmt));
         /*memNeeds[i].memRqmt = 0x800000L >> thisLA->memRqmt;*/
         i++;
      }
   }  /* endfor all devices */

/* CALCULATE A24 OFFSETS SUCH THAT NO TWO DEVICE'S ADDRESS SPACES
 * OVERLAP (START WITH LARGEST BLOCKS AND WORK DOWN TO SMALLEST ONES)
 */
   qsort( memNeeds, i, sizeof( map_t ), (int(*)()) memRqmtCompare );
   for( j = 0; j < i; j++ )
   {
      BreakLargeBlocks(memNeeds[j].memRqmt << 1); /*Break all larger blocks*/
      status = findMemBlock( /* &rootAXX, */ /* no longer used */
                             memNeeds[j].memRqmt,
                             &blkBase );
      if( status == FALSE )
         WARN "Not enough VXI memory left for device @@ LA %3d (requires 0x%X)."
            "\n", memNeeds[j].logAdr, memNeeds[j].memRqmt);
      else
      {
         thisLA = findLAConfig( memNeeds[j].logAdr, HEAD );
         thisLA->offset = blkBase;
      }
   }   /* endfor j */

/* endif >= 1 device with memory */
 }

/* RELEASE ALLOCATED MEMORY & RETURN "ok" CODE (added 'if' 13jun95) */
   if( memNeeds ) free( memNeeds );
   return( 0 );
}

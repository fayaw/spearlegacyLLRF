/***************************************************************************
  assignMem.c

  Auxiliary (old) routines for MXI Resource Manager's Configure system
  A24/A32 address maps function (third of six parts) per section
  C.4.1.3, Rule C.4.8 of VXIbus System Specification VXI-1, Rev. 1.4;

  MXI functionality per section F.2 of Mainframe Extender Specification
  VXI-6, Rev. 1.0; 2/7/91
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>
#include <assert.h>

#include "resman.h"


#ifndef max
#define max(a,b) ((a > b)? (a) : (b))
#endif


/***************************************************************************
  activeMem.c

  Auxiliary routine to activate A24/A32 memory in VXI device's
  Control/Status register.  Part of MXI Resource Manager's Configure
  system A24/A32 address maps function (third of six parts) per section
  C.4.1.3, Rule C.4.8 of VXIbus System Specification VXI-1, Rev. 1.4;
  4/21/92
***************************************************************************/

#include <stdio.h>
#include <stdlib.h>

#include "resman.h"


int rmActivateMemory( void )
{
   config_t *thisLA;
   int status;

/* FOR ALL "ON-LINE" (PASSED) DEVICES WITH A24 OR A32 MEMORY */
   for( thisLA = HEAD; thisLA != NULL; thisLA = thisLA->next )
   {
      if ((thisLA->passed == 1)  &&
          ((thisLA->adrSpace == VXI_ADDR_EXT_A24)  ||
	   (thisLA->adrSpace == VXI_ADDR_EXT_A32)))
      {
/*       ASSIGN THE A24 or A32 BASE ADDRESSES BY WRITING THE OFFSETS TO
 *       EACH DEVICE'S OFFSET REGISTER
 */
	status = VXIoutReg (thisLA->logAdr, 0x06, thisLA->offset);

	if( status != 0 ) 
		WARN "Offset may not be set properly for LA %3d.\n",
			thisLA->logAdr);

/*       ENABLE EACH DEVICE'S A24 OR A32 REGISTERS BY WRITING A ONE TO THE
 *       A24/A32 ENABLE BIT OF EACH DEVICE'S CONTROL REGISTER
 */
	status = VXIoutReg (thisLA->logAdr, 0x04, 0xFFFC);

	if( status != 0 ) 
		WARN "A24/A32 may not be enabled properly for LA %3d.\n",
			thisLA->logAdr);

/*    ENDIF PASSED *AND* A24/A32 USED */
      }
/* ENDFOR ALL DEVICES */
   }

/* RETURN "ok" CODE */
   return( 0 );
}
@



/***************************************************************************
  lclBusFxn/lclBusIO.c
 
  This module provides lo-level register IO.
***************************************************************************/
 
#include <vxWorks.h>
#include <vxLib.h>
#include <vme.h>
 
#include <kscvxi.h>
#include <busacc.h>
 
#include <bus.h>

/*==========================================================================
  VXIinLR
==========================================================================*/

INT16 VXIinLR (UINT16 reg, UINT16 width, void* value)
{
   if (reg > 0x3f)
      return -3;   /* Invalid reg */

   if (width > 3 || width == 0)
      return -4;   /* Invalid width */

   if (width == 3)
      return -9;   /* width not supported */

   return VXIin(1, 0xc000 + reg, width, value);
}

/*==========================================================================
  VXIoutLR
==========================================================================*/

INT16 VXIoutLR (UINT16 reg, UINT16 width, UINT32 value)
{
   if (reg > 0x3f)
      return -3;   /* Invalid reg */

   if (width > 3 || width == 0)
      return -4;   /* Invalid width */

   if (width == 3)
      return -9;   /* width not supported */

   return VXIout(1, 0xc000 + reg, width, value);
}

/*==========================================================================
  SetMODID
==========================================================================*/

NIVXI_STATUS NIVXI_FN SetMODID(UINT16 enable, UINT16 modid)
{
   return VXIoutReg(0, 0x28, (enable ? M_ENABLE : 0) | (modid & 0x1fff));
}

UINT16 smb;

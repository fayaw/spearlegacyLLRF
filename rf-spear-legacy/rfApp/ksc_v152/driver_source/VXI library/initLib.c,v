/***************************************************************************
  coreFxn/initLib.c

  This module provides hi-level register IO.
***************************************************************************/

#include "vxWorks.h"
#include "vxLib.h"
#include <string.h>

#include "kscvxi.h"

#include "libvar.h"
#include "bus.h"


/*==========================================================================
  Global Variables
==========================================================================*/

static int refCnt = 0;
LibVar vxiLibVar;


/*==========================================================================
  InitVXIlibrary
==========================================================================*/

INT16 InitVXIlibrary (void)
{
  if (refCnt == 0) {
/*/printf("calling vxiBusInit \n");*/

    /** initialize bus interface **/
    vxiBusInit ();
/*/printf("calling bzero \n");*/

    /** initialize library vars **/
    bzero ((char*)&vxiLibVar, sizeof(vxiLibVar));
/*/printf("calling  vxiIntrInit \n");*/

    /** initialize interrupt mechanisms **/
    vxiIntrInit ();

    /** set default values **/
    vxiCmdrWsTimo = 2500;

    /** set refcnt forever **/
    refCnt = 1;

    /** Return ok for first time of running  **/
    return NIVXI_OK;
  }

  return 1;
}


/*==========================================================================
  CloseVXIlibrary
==========================================================================*/

INT16 CloseVXIlibrary (void)
{
  return NIVXI_OK;
}


/*==========================================================================
  
  The KSCorp V151 interface module will generate interrupts for the single
  board computer on three conditions:

  1)  VXI interrupt sourced by another card.
  2)  Signal written to our SIGNAL register.
  3)  Selected trigger line rising edge.

  Cases (2) and (3) generate an interupt at the level programmed into
  (0x2C) and the V151 logical address (usually zero).

  Case (1) generates an interrupt at the level and vector dictated by
  the interrupting card; note that the vector is, by VXI spec, the card's
  logical address.

  Since the single board computer will always interrupt the cpu at the
  vector passed on the VME bus (it CANNOT autovector vme interrupts), 
  the logical addresses between 1 and 63 (reserved by motorola for cpu use)
  shall not be able to interrupt us.  Furthermore, the following table
  includes vectors used by the single board computer for local devices,
  which are also excluded from use.

==========================================================================*/
#if 0	
// Does not apply to the V151
#define NO_RES_VEC 17	

static int ReservedVector[] = {
  0x40, 0x41, 0x42, 0x43, 		/*  64, 65, 66, 67, */
  0x44, 0x45, 0x46, 0x47,		/*  68, 69, 70, 71, */
  0x90, 0x91, 0x92, 0x93, 		/* 144,145,146,147, */
  0x94, 0x95, 0x96, 0x97,		/* 148,149,150,151, */
  0
};
#endif 

static int TrigLineId[] = {
  0, 1, 2, 3, 4, 5, 6, 7,	/** TTL **/
  8, 9,				/** ECL **/
  40,				/** FP 1 **/
  41				/** FP 2 **/
};

/* Globals */
UINT16 LEVEL;	
UINT32 STATID;	

/*==========================================================================
  vxiBaseIsr
==========================================================================*/
/* This interrupt handler is connected to the VME_INT_VEC vector, so that it
is invoked when a VME interrupt occurs. It is also connected to vectors 15 
through 255 so that no interrupt is uninitialized.
For the VME_INT_VEC vector, when this ISR is invoked for a VME interrupt,
it will index into the array of function pointers, vxiIntHandler[], and invoke
the proper handler. If no handler has been setup, the DefaultVXIintHandler() 
will be invoked. 
==========================================================================*/

void vxiBaseIsr (void)	
{
  INT16 controller = -1;
  UINT32 statusId;
  UINT16 level;		
  UINT32 status;
  int i;

#ifdef DEBUG_INTR
  logMsg("In BaseIsr\n",0,0,0,0,0,0);
#endif

  statusId = GET_MY_REG(0x38);

    /* Read interrupt status from chip. */    
    status = vxiUnivRegRd( VXI_UNIV_LINT_STAT );
    LEVEL = (status & 0xff) >> 1;


#ifdef DEBUG_INTR
   logMsg("stat id is 0x%x, LEVEL is 0x%x\n", statusId,LEVEL,0,0,0,0);
#endif

    if ( vxiTrigEnbMask != 0 && (LEVEL & 0x1) && (statusId & 0x100) ) 
    {
      /*--------------------------------------------------------------------
	trigger interrupt...
      --------------------------------------------------------------------*/
      UINT16 trig = GET_MY_REG(0x2E);
      int k;

      PUT_MY_REG (0x30,trig);			/** clear flags **/
      PUT_MY_REG (0x2E,vxiTrigEnbMask);		/** reset intr enb **/

#ifdef DEBUG_INTR
      logMsg("went to trig, trig is %d\n",trig,0,0,0,0,0);
#endif
      for (k=0; k < 12; k++) 
      {
	if (trig & (1 << k)) 
        {
	  if (vxiTrigAction[k] & 0x8000) 
          {
	    /*--------------------------------------------------------------
	      map trigger...pulse mapped line
	    --------------------------------------------------------------*/

#ifdef DEBUG_INTR
            logMsg("Writing 0x%x to SourceTrigger Register\n", 
                       0x8000 | (1 << (vxiTrigAction[k] & 0x1F)),0,0,0,0,0);
#endif

	    PUT_MY_REG (0x32, 0x8000 | (1 << (vxiTrigAction[k] & 0x1F)));
	  }
	  else if (vxiTrigAction[k]) 
          {
	    /*--------------------------------------------------------------
	      sense trigger...notify handler
	    --------------------------------------------------------------*/

#ifdef DEBUG_INTR
            logMsg("Sensed trig, k is %d\n",k,0,0,0,0,0);
#endif

	    vxiTrigHandler[k] (0, TrigLineId[k], 0x0001);
	  }
	}
      } /* end of for(k) */

      LEVEL ^= 0x1;	/*Do not also handle this as a regular interrupt*/
      return;
    } /* end of if(statusID & 0x100) */   /*end of trigger handling*/

    if ( vxiMonEnbMask !=0 && (LEVEL & 0x1) == 0x1 && (statusId & 0x200) )
    {
      /*--------------------------------------------------------------------
	location monitor interrupt
      --------------------------------------------------------------------*/
      UINT16 mon = GET_MY_REG(0x3A);

      if (mon & 0x10)  /* Signal occurred */
      {
        UINT16 signal;
        UINT16 type;
        int la;

        PUT_MY_REG(0x3A, mon | vxiMonEnbMask);	/** clear/reset intr enb **/
        LEVEL ^= 0x1;	/*Do not also handle this as a regular interrupt*/
	signal = GET_MY_REG(0x3C);

	type = (signal >> 8) & 0x7F;
	la = signal & 0xFF;

#ifdef DEBUG_INTR
        logMsg("went to loc mon, signal is 0x%x\n", signal,0,0,0,0,0);
#endif

	if (signal & (1 << 15)) /* Event signal */
        {
          if (type == 0x7f)  /* No cause given event */
          {
             if (vxiSigRoute[la] & 0x100)
		vxiSigHandler[la] (signal);
          }
          else if (type == 0x7d) /* Request true event */
          {
             if (vxiSigRoute[la] & 0x200)
		vxiSigHandler[la] (signal);
          }
          else if (type == 0x7c) /* Request false event */
          {
             if (vxiSigRoute[la] & 0x400)
		vxiSigHandler[la] (signal);
          }
          else if ((type & 0x40) == 0) /* User defined event */
          {
             if (vxiSigRoute[la] & 0x4000)
		vxiSigHandler[la] (signal);
          }
          else if (type >= 0x65 && type <= 0x75) /* Shared memory events */
          {
             if (vxiSigRoute[la] & 0x1000)
		vxiSigHandler[la] (signal);
          }
          else                 /* VXI reserved events */
             if (vxiSigRoute[la] & 0x2000)
		vxiSigHandler[la] (signal);
        } /* END of if Event signal */
        else  /* Response signal */
        {
	   if ( vxiSigRoute[la] & (type ^ 0x09) & 0x3f )
	     vxiSigHandler[la] (signal);
        }
      } /* END if Signal occurred */

      return;
    } /* end of if(statusId & 0x200) */		/*end of location monitor handling*/

    /*----------------------------------------------------------------------
      all others...
    ----------------------------------------------------------------------*/
#ifdef DEBUG_INTR
    logMsg("vxiBaseIsr:LEVEL is 0x%x\n",LEVEL,0,0,0,0,0);
#endif
    if(LEVEL != 0 /* && interrupts are enabled */)
    {      
	/*/ Start with highest priority*/
	for (i = 0; i < 7; i++)
	{
	    level = 6-i;

	    if ( LEVEL & (1 << (level)) )
	    {
#ifdef DEBUG_INTR
                logMsg("level is %d\n", level+1,0,0,0,0,0);
#endif
		LEVEL ^= (1<<level);	/*Clear interrupt flag*/

		/* Get contents of status ID register */
		switch(level+1)
		{
		case 1:
                   STATID = vxiUnivRegRd( VXI_UNIV_V1_STATID );
		   break;
		case 2:
                   STATID = vxiUnivRegRd( VXI_UNIV_V2_STATID );
		   break;
		case 3:
                   STATID = vxiUnivRegRd( VXI_UNIV_V3_STATID );
		   break;
		case 4:
                   STATID = vxiUnivRegRd( VXI_UNIV_V4_STATID );
		   break;
		case 5:
                   STATID = vxiUnivRegRd( VXI_UNIV_V5_STATID );
		   break;
		case 6:
                   STATID = vxiUnivRegRd( VXI_UNIV_V6_STATID );
		   break;
		case 7:
                   STATID = vxiUnivRegRd( VXI_UNIV_V7_STATID );
		   break;
		default:
                   STATID = vxiUnivRegRd( VXI_UNIV_V7_STATID );
		   break;
		}
#ifdef DEBUG_INTR
logMsg("STATID = 0x%x\n",STATID,0,0,0,0,0);
#endif
		vxiIntHandler[level] (controller,level+1,STATID);
/*/		break;*/
	    }
	}
    } /*END of if LEVEL*/

    /* Clear Register */
    vxiUnivRegWr( VXI_UNIV_LINT_STAT, status );
}



/*==========================================================================
  kscIntHandler
============================================================================
This handler was created to be invoked whenever a VME interrupt occurs. It 
will be called just prior to sysUniverseIntHandler(). This handler read the 
LINT_STAT register of the universe chip to determine the level and status
id of the interrupt. This has to be done first because sysUniverseIntHandler
resets that register.
===========================================================================*/
void kscIntHandler()
{
    UINT32		status;
    int			i;

#ifdef DEBUG_INTR
    logMsg("In kscIntHandler\n",0,0,0,0,0,0);
#endif

    /* Read interrupt status from chip. */    
    status = vxiUnivRegRd( VXI_UNIV_LINT_STAT );

#ifdef DEBUG_INTR
    logMsg("lintStat is 0x%x\n",status,0,0,0,0,0);
#endif

    /* Check if VME interrupt. */
#ifdef FORCE                          /* powercore 603/4 */
    if ((status & LINT_EN_VME_MASK) != 0)
#elif defined DY4                     /* dy4 svme178 */
    if ((status & 0x000000fe) != 0)
#elif defined MV2400
    if ((status & 0x000000fe) != 0)     /*mv2400 */
#else
#error - Board type not defined.  Must define either FORCE or DY4 or MV2400 to compile.
#endif

    {
	/* Handle each VME Bus interrupt */
	LEVEL = (status & 0xff) >> 1;

	for (i = 0; i < 7; i++)
	{
	    if (((status >> (7 - i)) & 0x01) == 0x01)
	    {
		/* Save level for use in vxiBaseIsr. */

#ifdef DEBUG_INTR
                logMsg("LEVEL is 0x%x\n",LEVEL,0,0,0,0,0);
#endif

	    }
	} /* end of for */
    } /* end if VME interrupt*/

  return;
}

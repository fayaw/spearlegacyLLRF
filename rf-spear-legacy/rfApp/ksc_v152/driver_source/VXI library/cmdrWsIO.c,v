      return (WS_ERRORFLAG | WS_RET_TIMO_REC);
    }

    VXIinReg (la,VXI_MB_DATA_LOW,&data);
    VXIinReg (la,VXI_MB_DATA_HIGH,&dataHi);

    *response = ((UINT32) dataHi << 16) | ((UINT32) data);
  }

  return (WS_RET_IODONE);
}


/*==========================================================================
  WSclr
==========================================================================*/

INT16 WSclr (INT16 la)
{
  return WScmd (la, WS_CLEAR, FALSE, 0);
}


/*==========================================================================
  WStrg
==========================================================================*/

INT16 WStrg (INT16 la)
{
  return WScmd (la, WS_TRIGGER, FALSE, 0);
}


/*==========================================================================
  WSrd
==========================================================================*/

INT16 WSrd (INT16 la, UINT8* buf, UINT32 cnt, UINT16 mode, UINT32* retcnt)
{
#ifdef KSC_DEBUG
 printf("\nIn WSrd.\n");
#endif
  return wsRead (la,cnt,mode,retcnt,(FUNCPTR) wrBuf,buf);
}


/*==========================================================================
  WSrdf
==========================================================================*/

INT16 WSrdf (INT16 la, INT8* filnam, UINT32 cnt, UINT16 mode, UINT32* retcnt)
{
  FILE* fp;
  int rv;

  if (fp = fopen (filnam,"wb"),  !fp)
    return (WS_ERRORFLAG | WSb_RET_FopenError);

  rv = wsRead (la,cnt,mode,retcnt,(FUNCPTR) wrFile,fp);
  fclose (fp);

  return (rv);
}


/*==========================================================================
  WSsetTmo


  ARGUMENTS

  INT32 timo;			timeout in milliseconds
  INT32* actualTimo;		realizable timeout in milliseconds


  RETURN VALUE

  INT16	 			status code


  DESCRIPTION



  DIAGNOSTICS


==========================================================================*/

INT16 WSsetTmo (INT32 timo, INT32* actualTimo)
{
  INT32 sysClkPeriod = 1000.0 / sysClkRateGet();

  vxiCmdrWsTimo = (timo + sysClkPeriod -1) / sysClkPeriod;
  *actualTimo = vxiCmdrWsTimo * sysClkPeriod;

  return (NIVXI_OK);
}


/*==========================================================================
  WSgetTmo
==========================================================================*/

INT16 WSgetTmo (INT32* actualTimo)
{
  INT32 sysClkPeriod = 1000.0 / sysClkRateGet();

  *actualTimo = vxiCmdrWsTimo * sysClkPeriod;
  return (NIVXI_OK);
}



  VXIoutReg (la,VXI_MB_DATA_HIGH, cmd >> 16);
  VXIoutReg (la,VXI_MB_DATA_LOW, cmd & 0xFFFF);


  if (respflag) {
    /** wait to read value **/

    while (ticks = tickGet() - tick0,  ticks <= vxiCmdrWsTimo) {
      if (status = VXIinReg (la,VXI_MB_RESPONSE,&data),  status != 0)

/***************************************************************************
  sigFxn/sigCtrl.c

  This module provides VXI signal control.
***************************************************************************/

#include <vxWorks.h>

#include <kscvxi.h>

#include <libvar.h>
#include <bus.h>


/*==========================================================================
  DisableSignalInt
==========================================================================*/

INT16 DisableSignalInt (void)
{
  UINT16 int_ctrl_reg;

  vxiMonEnbMask &= ~0x0001;
  PUT_MY_REG (0x3A, vxiMonEnbMask);

  int_ctrl_reg = ( vxiTrigEnbMask != 0 ? 0x0000 : 0x100 ) |
                 ( vxiMonEnbMask  != 0 ? 0x0000 : 0x200 ) |
                 ( 0x30 ); /* Enable onto VMEbus, irq 1 */
  PUT_MY_REG (0x2c, int_ctrl_reg);
  if ( vxiTrigEnbMask == 0 && vxiMonEnbMask == 0 )
     DisableVXIint(-1, 1);

  return 0;
}


/*==========================================================================
  EnableSignalInt
==========================================================================*/

INT16 EnableSignalInt (void)
{
  UINT16 int_ctrl_reg;
  UINT16 reg;

  vxiMonEnbMask |= 0x0001;
  PUT_MY_REG (0x3A, vxiMonEnbMask);

  /*/debug*/
  int_ctrl_reg = ( vxiTrigEnbMask != 0 ? 0x0000 : 0x100 ) |
                 ( vxiMonEnbMask  != 0 ? 0x0000 : 0x200 ) |
                 ( 0x30 ); /* Enable onto VMEbus, irq 1 */
  PUT_MY_REG (0x2c, int_ctrl_reg);
  EnableVXIint(-1, 1);

  reg = GET_MY_REG(0x3c); /*/ Clear pending signals.*/
  return 0;
}


/*==========================================================================
  GetSignalHandler
==========================================================================*/

NIVXI_HSIGNAL* GetSignalHandler (INT16 la)
{
     if (la < 0 || la > 255)
        return (NIVXI_HSIGNAL*) 0; /*/Invalid LA*/

  return (NIVXI_HSIGNAL*) vxiSigHandler[la];
}


/*==========================================================================
  RouteSignal
==========================================================================*/

INT16 RouteSignal (INT16 la, UINT32 mask)
{
     if (la < -1 || la > 255)
        return -1; /*/Invalid LA*/

     if (la == -1)  /*/ Special meaning - all logical addresses.*/
        for (la = 0; la <= 255; la++)
           vxiSigRoute[la] = mask;
     else
        vxiSigRoute[la] = mask;

  return 0;
}


/*==========================================================================
  SetSignalHandler
==========================================================================*/

INT16 SetSignalHandler (INT16 la, NIVXI_HSIGNAL* func)
{
     if (la < -1 || la > 255)
        return -1; /*/Invalid LA*/

     if ( func == (NIVXI_HSIGNAL*) 0 )
        func = DefaultSignalHandler;

     if (la == -1)  /*/ Special meaning - all logical addresses.*/
        for (la = 0; la <= 255; la++)
           vxiSigHandler[la] = (VOIDFUNCPTR) func;
     else
        vxiSigHandler[la] = (VOIDFUNCPTR) func;

  return 0;
}

/*==========================================================================
  DefaultSignalHandler
==========================================================================*/

void DefaultSignalHandler (UINT16 signal)
{
#ifdef DEBUG_INTR
  logMsg ("VXI SIGNAL: signal %04X\n", signal);
#endif

   /* debug - if unrecognized command signal, we should call WS abort() */

}

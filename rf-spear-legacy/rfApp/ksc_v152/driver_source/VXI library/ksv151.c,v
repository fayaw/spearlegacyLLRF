  This module provides KSV151 VXI access routines.
***************************************************************************/

#include <vxWorks.h>
#include <kscvxi.h>

#include <bus.h>
#include <buscntl.h>


/*==========================================================================
			     V151 REGISTERS
==========================================================================*/

#define  V151_SUFFIX_HI		0x20
#define  V151_SUFFIX_LO		0x22
#define  V151_SERNUM_HI		0x24
#define  V151_SERNUM_LO		0x26
#define  V151_MODID		0x28
#define  V151_INT_STAT		0x2A
#define  V151_INT_CTRL		0x2C
#define  V151_TRIG_INT		0x2E
#define  V151_TRIG_CLR		0x30
#define  V151_TRIG_SRC		0x32
#define  V151_TRIG_TMR		0x34
#define  V151_INT_ACKD		0x38
#define  V151_MISC_CTRL		0x3C
#define  V151_READ_SIG		0x3C


/*==========================================================================
			    MEMBER ROUTINES
==========================================================================*/

/*==========================================================================
  chkModId
==========================================================================*/

static
unsigned chkModId (int la)
{
  UINT16 value;

  if (VXIoutReg (la, V151_MODID, 0x0000))  return (-1);
  if (VXIinReg (la, V151_MODID, &value))  return (-1);

/*vxMemProbe(0xfbffc028,0,2,&value);*/

  return (value & 0x1FFF);
}


/*==========================================================================
  clrModId
==========================================================================*/

static
int clrModId (int la)
{
  if (VXIoutReg (la, V151_MODID, 0x0000))  return (-1);
  return 0;
}


/*==========================================================================
  setModId
==========================================================================*/

static
int setModId (int la, unsigned val)
{
  if (VXIoutReg (la, V151_MODID, 0x2000 | (val & 0x1FFF)))  return (-1);
  return 0;
}


/*==========================================================================
			       BUS OBJECT
==========================================================================*/

BusCntl KSV151_BUS = {
  chkModId,
  clrModId,
  setModId,
};


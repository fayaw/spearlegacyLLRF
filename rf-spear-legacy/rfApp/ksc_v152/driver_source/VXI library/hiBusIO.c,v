/***************************************************************************
  hiBusFxn/hiBusIO.c

  This module provides hi-level register IO.
***************************************************************************/

#include <vxWorks.h>
#include "vxLib.h"

#include <kscvxi.h>
#include <bus.h>


/*==========================================================================
  VXIin
==========================================================================*/

INT16 VXIin (UINT16 accessparms, UINT32 address, UINT16 width, void *value)
{
  UINT32 paddr;

  if (width != 1  &&  width != 2  &&  width != 4) {
    return INVALID_ACCESS_WIDTH;
  }
  
  switch (accessparms & 0x3) {
  case A16_SPACE:
    paddr = (UINT32) VXIBUS_A16 + address;
    break;
  case A24_SPACE:
    paddr = (UINT32) VXIBUS_A24 + address;
    break;
  case A32_SPACE:
    paddr = (UINT32) VXIBUS_A32 + address;
/*	paddr = paddr + 0x08000000;*/
/*printf("VXIin:paddr = 0x%x\n",paddr);*/
    break;
  default:
    return INVALID_ACCESS_PARM;
  }

  if (vxMemProbe ((char *) paddr, READ, width, value) != OK) {
    return INVALID_WINDOW;
  }

  return (NIVXI_OK);
}


/*==========================================================================
  VXIout
==========================================================================*/

INT16 VXIout (UINT16 accessparms, UINT32 address, UINT16 width, UINT32 value)
{
  UINT32 paddr;

  switch (accessparms & 0x3) {
  case A16_SPACE:
    paddr = (UINT32) VXIBUS_A16 + address;
    break;
  case A24_SPACE:
    paddr = (UINT32) VXIBUS_A24 + address;
    break;
  case A32_SPACE:
    paddr = (UINT32) VXIBUS_A32 + address;
    break;
  default:
    return INVALID_ACCESS_PARM;
  }
  
  switch (width) {
  case 1:
    { UINT8 val = (UINT8) value;

      if (vxMemProbe ((char*) paddr, WRITE, width, (char*) &val) != OK) {
	return INVALID_WINDOW;
      }
      break;
    }
  case 2:
    { UINT16 val = (UINT16) value;

      if (vxMemProbe ((char*) paddr, WRITE, width, (char*) &val) != OK) {
	return INVALID_WINDOW;
      }
      break;
    }
  case 4:
/*paddr = paddr + 0x08000000;*/
/*printf("VXIout:paddr = 0x%x\n",paddr); */
    if (vxMemProbe ((char*) paddr, WRITE, width, (char*) &value) != OK) {
      return INVALID_WINDOW;
    }
    break;

  default:
    return INVALID_ACCESS_WIDTH;
  }

  return (NIVXI_OK);
}


/*==========================================================================
  VXImove
==========================================================================*/

INT16 VXImove (UINT16 srcparms, UINT32 srcaddr,
	       UINT16 dstparms, UINT32 dstaddr,
	       UINT32 length, UINT16 width)
{
  UINT32 srcp, dstp;

  switch (srcparms & 0x3) {
  case A16_SPACE:
    srcp = (UINT32) VXIBUS_A16 + srcaddr;
    break;
  case A24_SPACE:
    srcp = (UINT32) VXIBUS_A24 + srcaddr;
    break;
  case A32_SPACE:
    srcp = (UINT32) VXIBUS_A32 + srcaddr;
    break;
  default:
    srcp = srcaddr;
  }
  
  switch (dstparms & 0x3) {
  case A16_SPACE:
    dstp = (UINT32) VXIBUS_A16 + dstaddr;
    break;
  case A24_SPACE:
    dstp = (UINT32) VXIBUS_A24 + dstaddr;
    break;
  case A32_SPACE:
    dstp = (UINT32) VXIBUS_A32 + dstaddr;
    break;
  default:
    dstp = dstaddr;
  }
  
  switch (width) {
  case 1:
    { UINT8* src = (UINT8*) srcp;
      UINT8* dst = (UINT8*) dstp;

      while (length--)  *dst++ = *src++;
      break;
    }
  case 2:
    { UINT16* src = (UINT16*) srcp;
      UINT16* dst = (UINT16*) dstp;

      while (length--)  *dst++ = *src++;
      break;
    }
  case 4:
    { UINT32* src = (UINT32*) srcp;
      UINT32* dst = (UINT32*) dstp;

      while (length--)  *dst++ = *src++;
      break;
    }

  default:
    return INVALID_ACCESS_WIDTH;
  }

  return (NIVXI_OK);
}
  

/*==========================================================================
  VXIinReg
==========================================================================*/

INT16 VXIinReg (INT16 la, UINT16 reg, UINT16 *value)
{
  uint32 offset = 0xc000 + (la << 6) + reg;
  return (VXIin (A16_SPACE, offset, WORD_WIDTH, value));
}


/*==========================================================================
  VXIoutReg
==========================================================================*/

INT16 VXIoutReg (INT16 la, UINT16 reg, UINT16 value)
{
  uint32 offset = 0xc000 + (la << 6) + reg;
  return (VXIout (A16_SPACE, offset, WORD_WIDTH, value));
}


#ifdef SHELL_FXN

/*==========================================================================
  shell utility
==========================================================================*/

int regIn (int la, unsigned reg)
{
  UINT16 value;
  int rv;

  if (rv = VXIinReg (la,reg,&value),  rv == 0) {
    printf ("[%04X], ", value);
  }

  return rv;
}

int regOut (int la, unsigned reg, unsigned value)
{
  return VXIoutReg (la,reg,value);
}


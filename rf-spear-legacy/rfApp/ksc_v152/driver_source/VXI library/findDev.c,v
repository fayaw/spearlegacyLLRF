  This module provides findDevLA routine.
***************************************************************************/

#include <vxWorks.h>
#include <string.h>

#include <kscvxi.h>
#include <devinfo.h>

#include <libvar.h>


/*==========================================================================
  FindDevLA
==========================================================================*/

INT16 FindDevLA (INT8* namepat,
		 INT16 manid,
		 INT16 modelcode,
		 INT16 devclass,
		 INT16 slot,
		 INT16 mainframe,
		 INT16 cmdrla,
		 INT16* la)

{
  UserLAEntry* entry;
  UINT16 length;
entry =  vxiDevHead;
/*/printf("DevHead la is %d\n",entry->la);*/

  for (entry = vxiDevHead;  entry;  entry = entry->next) 
  {
    if(*namepat)
    {
	/* Determine length of shortest string. */
	if (strlen(namepat) < strlen(entry->DevName) )
	   length = strlen(namepat);
	else
	   length = strlen(entry->DevName);
    }
     /*if (*namepat  &&  strcmp (entry->DevName, namepat) != 0)*/  /* NO */
/*/printf("entry->DevName is %s.\nnamepat is %s.\n", entry->DevName, namepat);
//printf("result of string compare is %d.\n",strncmp (entry->DevName, namepat, length) );*/
    if (*namepat  && (strncmp (entry->DevName, namepat, length) != 0) )
      continue;

    if (manid >= 0  &&  entry->ManId != manid)
      continue;

    if (modelcode >= 0  &&  entry->ModelCode != modelcode)
      continue;

    if (devclass >= 0  &&  entry->DevClass != devclass)
      continue;

    if (slot >= 0  &&  entry->Slot != slot)
      continue;

    if (mainframe >= 0  &&  entry->Mainframe != mainframe)
      continue;

    if (cmdrla >= 0  &&  entry->Cmdr != cmdrla)
      continue;

    *la = entry->la;
    return 0;
  }

  return -1;
}

		 

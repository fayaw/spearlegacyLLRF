1.4
log
@Replace *.template files with *.substitutions files and build full
databases using make.  The build scripts are no longer needed.
@
text
@#==============================================================
#
# Abs:  Database template for RFP DAC Outputs
#
# Name:  rf_dac.substitutions
#
# Desc:  EPICS database template file for RFP DAC
#        outputs
#
# Side:  None
#
# Facility: SLAC/PEPII Low-Level RF 
#
# Auth: dd-mmm-yyyy, Stephanie Allison (SAA)
# Rev:  dd-mmm-yyyy, First Lastname  (USERNAME)
#==============================================================
#
# Mod:
#       01-Apr-2003, K. Luchini, M. Browne (LUCHINI,MJB)
#         Added Ripple Loop Coefficients and Internal Reference
#         for in rf_rfp_twodacs.db. This is necessary for the
#         new rfp module.
#       06-Feb-2002, K. Luchini (LUCHINI):
#         Added standard header and obtained
#         db files from the top level db directory
#         instead of epicsApp/Db
#
#==============================================================
#
#
file rf_rfp_fourdacs.db
{
#	        
#	   STN      TYPE , Field     
  pattern { S     , TYPE ,F }
	  {$(RRRS),CAV1  ,C1}
	  {$(RRRS),CAV2  ,C2}
	  {$(RRRS),CAV3  ,C3}
	  {$(RRRS),CAV4  ,C4}
	  {$(RRRS),DIRECT,DL}
	  {$(RRRS),COMB  ,CL}
}
file rf_rfp_twodacs.db
{
#	        
#	   STN     TYPE IField,QField
  pattern { S     ,TYPE,  IF    ,QF   }
	  {$(RRRS),TUNE,  TMIS  ,TMQS }
          {$(RRRS),RLCOEF,RLII  ,RLIQ }
          {$(RRRS),IREF  ,IREI  ,IREQ }
}
@



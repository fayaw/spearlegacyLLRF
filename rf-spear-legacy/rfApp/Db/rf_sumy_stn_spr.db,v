1.4
log
@Remove ripple loop gain tracking from feedback summary status as SPEAR
can run OK without it.
@
text
@# Macros:
#   S = Station (HR81, etc)
# 
record(calc,"$(S):STN:SUMY:MODU") {
	field(DESC,"Station Status Sum")
	field(FLNK,"$(S):STNPLC:SUMY:MODU.VAL")
	field(CALC,"0")
	field(INPA,"$(S):KLYS:SUMY:MODU.SEVR NPP MS")
	field(INPB,"$(S):HVPSDCM:SUMY:MODU.SEVR NPP MS")
	field(INPC,"$(S):CIRC:SUMY:MODU.SEVR NPP MS")
	field(INPE,"$(S):CAV:SUMY:MODU.SEVR NPP MS")
	field(INPF,"$(S):STNDCM:SUMY:MODU.SEVR NPP MS")
	field(INPG,"$(S):STN:CLK:MODU.SEVR NPP MS")
	field(INPJ,"$(S):STN:RFP:MODU.SEVR NPP MS")
	field(INPK,"$(S):STN:AIM:MODU.SEVR NPP MS")
}
record(calc,"$(S):FBCK:SUMY:SEVR") {
	field(DESC,"Feedback Loop Severity Sum")
	field(SCAN,"1 second")
	field(CALC,"0")
	field(INPA,"$(S):STNDAC:LOOP:STATUS.SEVR NPP MS")
	field(INPB,"$(S):HVPS:LOOP:STATUS.SEVR NPP MS")
	field(INPE,"$(S):STNDIRECT:LOOP:CTRL.SEVR NPP MS")
	field(INPF,"$(S):STNDIRECT:LEADCOMP:CTRL.SEVR NPP MS")
	field(INPG,"$(S):STNDIRECT:INTCOMP:CTRL.SEVR NPP MS")
	field(INPH,"$(S):STNDIRECT:LOOP:TRACK.SEVR NPP MS")
#	field(INPI,"$(S):STNRIPPLE:LOOP:TRACK.SEVR NPP MS")
	field(INPJ,"$(S):STN:RFP:RIPPLELOOP.SEVR NPP MS")
}
record(calc,"$(S):STNMPS:SUMY:LTCH") {
	field(DESC,"Station MPS Status Sum")
	field(FLNK,"$(S):STNTEMP:SUMY:LTCH.PROC")
	field(CALC,"0")
	field(INPB,"$(S):STN:FORCED:LTCH.SEVR NPP MS")
	field(INPC,"$(S):STN:VXI:LTCH.SEVR NPP MS")
	field(INPE,"$(S):STN:NCV:PLC.SEVR NPP MS")
	field(INPF,"$(S):STNREF:POWER:LTCH.SEVR NPP MS")
	field(INPG,"$(S):STNCRATEPS:TEMP:LTCH.SEVR NPP MS")
	field(INPH,"$(S):STN:RF476MHZREF:LTCH.SEVR NPP MS")
	field(INPI,"$(S):STN:MPS:LTCH.SEVR NPP MS")
}
@



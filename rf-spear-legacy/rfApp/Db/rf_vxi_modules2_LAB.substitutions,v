1.2
log
@Replace *.template files with *.substitutions files and build full
databases using make.  The build scripts are no longer needed.
@
text
@#==============================================================
#
# Abs:   Database template for RF VXI Modules
#
# Name:  rf_vxi_modules2_LAB.substitutions
#
# Desc:  EPICS database template file for RF PLC
#        temperatures pv's
#
# Side:  None
#
# Facility: SLAC/PEPII Low-Level RF
#
# Auth: dd-mmm-yyyy, Stephanie Allison (SAA)
# Rev:  dd-mmm-yyyy, First Lastname    (USERNAME)
#==============================================================
#
# Mod:
#       19-Feb-2003, K. Luchini (LUCHINI):
#         Added macros for rfp.db RAM files
#       06-Feb-2002, K. Luchini (LUCHINI):
#         Added standard header and obtained
#         db files from the top level db directory
#         instead of db. Added substitutions tobe used
#         in the build script
#
#==============================================================
#
# RF Clock and RF Distribution Module
#
file clk.db
{
     {R=$(RRRS), S=5}
}
#
# RF Gap Voltage Feed Forward Module
#
file gvf.db
{ 
     {R=$(RRRS), S=3}
}
#
# RF RF-Processing Module
#
file rfp.db
{
#           STN       Slot  DAC I File               DAC Q File               Cavity I File    Cavity Q File   Signal I File  Signal Q File
  pattern { R       , S   , TI                      ,TQ                      , CI            , CQ            , SI           , SQ            }
          { $(RRRS) , 4   , "/tbl/NOISE_I_BL_SMALL" ,"/tbl/NOISE_Q_BL_SMALL" ,"/dat/CAVITY_I","/dat/CAVITY_Q","/dat/TOTAL_I","/dat/TOTAL_Q" }
}
#
# RF Comb Filter Module
#
file cfm.db
{
     {R=$(RRRS), M=1, S=10}
     {R=$(RRRS), M=2, S=11}
}
#
# RF I/Q & Amplitude Detector Module
#
file iqa.db
{
     {R=$(RRRS), M=1, S=8,   RCE=1, TBL="/tbl/iqadf_23KHz.rpt"}
}
#
# RF Arc Detector/Fast Interlock Module
#
file aim.db
{
    {R=$(RRRS),S=12}
}




@



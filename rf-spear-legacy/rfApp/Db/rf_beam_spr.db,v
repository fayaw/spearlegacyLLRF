1.11
log
@Commit changes made in production in 2018 to CVS
@
text
@grecord(ai,"$(R):STN:BEAM:CURR") {
	field(DESC,"SPEAR Beam Current")
	field(DTYP,"Soft Channel")
	field(FLNK,"$(R):STN:BEAM:STATINP.VAL  PP NMS")
	field(INP,"SPEAR:BeamCurrAvg1S.VAL CPP MS")
	field(PREC,"1")
	field(EGU,"mA")
	field(HOPR,"500")
	field(MDEL,"0.1")
}
grecord(ao,"$(R):RF:CUTOFF") {
	field(DESC,"SPEAR Beam Curr Limit")
	field(PINI,"YES")
	field(DTYP,"Soft Channel")
	field(FLNK,"$(R):STN:BEAM:STATINP.VAL  PP NMS")
	field(EGU,"mA")
	field(DRVH,"550")
	field(HOPR,"100")
	field(MDEL,"-1")
}
grecord(bi,"$(R):STN:BEAM:STAT") {
	field(DESC,"SPEAR Beam Avail")
	field(DTYP,"Soft Channel")
	field(INP,"$(R):STN:BEAM:STATINP.VAL  NPP MS")
	field(ZSV,"MAJOR")
	field(ZNAM,"OFF")
	field(ONAM,"ON")
}
grecord(calc,"$(R):STN:BEAM:STATINP") {
	field(DESC,"SPEAR Beam Curr Compare")
	field(FLNK,"$(R):STN:BEAM:STAT.VAL  PP NMS")
	field(CALC,"A<C?0:1")
	field(INPA,"$(R):STN:BEAM:CURR.VAL  NPP")
	field(INPB,"$(R):STN:BEAM:CURR.SEVR  NPP NMS")
	field(INPC,"$(R):RF:CUTOFF.VAL  NPP NMS")
}
# Magic T post alarm limits need to be set based on outdoor ambient temp.
# Normal diff between post and ambient is 42deg.  On cold days, just set
# alarm limits to 75 (yellow) and 80 (red). 
grecord(calcout,"$(R):HVPSOIL:TEMPHIHI") {
	field(DESC,"HIHI Alarm Limit")
	field(FLNK,"$(R):HVPSOIL:TEMPHIGH")
	field(CALC,"A>50?D:((A+B+C)<D?D:(A+B+C))")
#	field(INPA,"spr:TG09R2C4/AM1 CPP")
#	field(INPA,"09G-TC:R2C04Temp CPP")
	field(INPA,"116-TC:R1C04Temp CPP")
	field(B,"42")
	field(C,"15")
# scondam: 18-Oct-2018: Changed limit per SPEAR3 elog entry 	961133	
#	field(D,"80")
	field(D,"90")
	field(OUT,"$(R):HVPSOIL:TEMP.HIHI")
}
grecord(calcout,"$(R):HVPSOIL:TEMPHIGH") {
	field(DESC,"HIGH Alarm Limit")
	field(CALC,"A>50?D:((A+B+C)<D?D:(A+B+C))")
	field(INPA,"$(R):HVPSOIL:TEMPHIHI.A")
	field(INPB,"$(R):HVPSOIL:TEMPHIHI.B")
	field(C,"10")
# scondam: 18-Oct-2018: Changed limit per SPEAR3 elog entry 	961133		
#	field(D,"75")
	field(D,"85")
	field(OUT,"$(R):HVPSOIL:TEMP.HIGH PP")
}

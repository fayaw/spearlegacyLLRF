1.3
log
@Replace *.template files with *.substitutions files and build full
databases using make.  The build scripts are no longer needed.
@
text
@#==============================================================
#
# Abs:   Database template for RF LAB VXI Modules
#
# Name:  rf_vxi_modules_LAB.substitutions (LAB ioc's only)
#
# Desc:  EPICS database template to load databases 
#        for acquire and process IQ Data and processing
#        the RFP module.
#
# Side:  None
#
# Facility: SLAC/PEPII Low-Level RF
#
# Auth: 26-Aug-2002, Kristi Luchini  (LUCHINI)
# Rev:  dd-mmm-yyyy, First Lastname  (USERNAME)
#==============================================================
#
# Mod:
#       11-Jul-2003, K. Luchini      (LUCHINI):
#          Replace rfp_dacs.db with rf_rfp_twodacs.db
#          and rf_rfp_fourdacs.db
#
#==============================================================
#
# For acquiring IQA Data
file iqGet.db
{
    {R=$(RRRS),M=1,F=TRM}
    {R=$(RRRS),M=2,F=TRM}
}

# For processing the RFP Module
#file rfp_dacs.db
#{
#    {R=$(RRRS)}
#}

file rf_rfp_fourdacs.db
{
#
#          STN      TYPE , Field
  pattern { S     , TYPE ,F }
          {$(RRRS),CAV1  ,C1}
          {$(RRRS),CAV2  ,C2}
          {$(RRRS),CAV3  ,C3}
          {$(RRRS),CAV4  ,C4}
          {$(RRRS),DIRECT,DL}
          {$(RRRS),COMB  ,CL}
}

file rf_rfp_twodacs.db
{
#
#          STN     TYPE IField,QField
  pattern { S     ,TYPE,  IF    ,QF   }
          {$(RRRS),TUNE,  TMIS  ,TMQS }
          {$(RRRS),RLCOEF,RLII  ,RLIQ }
          {$(RRRS),IREF  ,IREI  ,IREQ }
}
@



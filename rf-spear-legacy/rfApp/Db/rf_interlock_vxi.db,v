1.2
log
@Change register that is used for logging the latched vxi backplane,
AB summary, AB heartbeat, and forced faults.  Instead of the interrupt
status register (where the faults are cleared on every read instead of
when the reset button is pushed), we now use the fast interlock status
register.
@
text
@grecord(bi,"$(S):$(C):$(Q):LTCH") {
	field(DESC,"$(C) $(D)")
	field(DTYP,"Soft Channel")
	field(INP,"$(S):STN:AIM:LTCH.B$(BL)  NPP MS")
	field(OSV,"MAJOR")
	field(ZNAM,"OK")
	field(ONAM,"FAULT")
}
grecord(bi,"$(S):$(C):$(Q):FRST") {
	field(DESC,"$(C) $(D)")
	field(DTYP,"Soft Channel")
	field(INP,"$(S):STN:AIM:FRST.B$(BF)  NPP MS")
	field(OSV,"MAJOR")
	field(ZNAM,"OK")
	field(ONAM,"FAULT")
}
@



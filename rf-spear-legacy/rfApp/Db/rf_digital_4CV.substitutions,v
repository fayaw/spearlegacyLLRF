log
@Replace *.template files with *.substitutions files and build full
databases using make.  The build scripts are no longer needed.
@
text
@#==============================================================
#
# Abs:  Database template for 4-cavity station RF VXI Digitial Inputs
#
# Name:  rf_digital_4CV.substitutions
#
# Desc:  EPICS database template file for RF VXI
#        Module Digital Inputs for a 4-cavity station.
#
# Side:  None
#
# Facility: SLAC/PEPII Low-Level RF
#
# Auth: dd-mmm-yyyy, Stephanie Allison (SAA)
# Rev:  dd-mmm-yyyy, First Lastname  (USERNAME)
#==============================================================
#
# Mod:
#       06-Feb-2002, K. Luchini (LUCHINI):
#         Added standard header and obtained
#         db files from the top level db directory
#         instead of epicsApp/Db
#
#==============================================================
#
file rf_interlock.db
{
#	                                                                     LTCH FRST DIG
#	   STN     COMP      Quantity    Group    Next    Description           WORD WORD BIT   
  pattern { S     , C      ,   Q       , G      , N  ,      D                  , WL , WF , B }
	  {$(RRRS),STNHCW2 ,:FLOW      ,FLOW    ,FANO,"Flow Return"            , 15 , 30 , 7 }

	  {$(RRRS),CAV3    ,WATR:FLOW  ,""      ,SUMY,"Raft Water Flow"        , 18 , 33 , 0 }
	  {$(RRRS),CAV3    ,:VACMSTAT  ,""      ,VACM,"Vacuum Status"          , 18 , 33 , 1 }
	  {$(RRRS),CAV3    ,:VACMTIMED ,""      ,VACM,"Timed Vacuum Status"    , 18 , 33 , 2 }
	  {$(RRRS),CAV3    ,:VACMSPARE1,""      ,VACM,"Spare Vacuum Status"    , 18 , 33 , 3 }
	  {$(RRRS),CAV3    ,:VACMSPARE2,""      ,VACM,"Spare Vacuum Status"    , 18 , 33 , 4 }
	  {$(RRRS),CAV3IONP,:CURRSTAT  ,""      ,CURR,"Current Status"         , 18 , 33 , 5 }

	  {$(RRRS),CAV4    ,WATR:FLOW  ,""      ,SUMY,"Raft Water Flow"        , 18 , 33 , 8 }
	  {$(RRRS),CAV4    ,:VACMSTAT  ,""      ,VACM,"Vacuum Status"          , 18 , 33 , 9 }
	  {$(RRRS),CAV4    ,:VACMTIMED ,""      ,VACM,"Timed Vacuum Status"    , 18 , 33 , 10}
	  {$(RRRS),CAV4    ,:VACMSPARE1,""      ,VACM,"Spare Vacuum Status"    , 18 , 33 , 11}
	  {$(RRRS),CAV4    ,:VACMSPARE2,""      ,VACM,"Spare Vacuum Status"    , 18 , 33 , 12}
	  {$(RRRS),CAV4IONP,:CURRSTAT  ,""      ,CURR,"Current Status"         , 18 , 33 , 13}

}
file rf_sumy_plc.db
{
#	                                                                          DIG  DIG
#	   STN     COMP      Quantity    Group    Next                               WORD BIT   
  pattern { S     , C      ,   Q       , G      , N  ,                                W  , B }
	  {$(RRRS),CAV3    ,""         ,""      ,LTCH,                                36 , 2 }

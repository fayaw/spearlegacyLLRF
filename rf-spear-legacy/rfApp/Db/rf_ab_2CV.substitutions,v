1.2
log
@Replace *.template files with *.substitutions files and build full
databases using make.  The build scripts are no longer needed.
@
text
@#==============================================================
#
# Abs:   Database template for Allen-Bradley Adapter/DCM Data
#
# Name:  rf_ab_2CV.substitutions
#
# Rem:   EPICS database tempate file for VME Allen-Bradley
#        Scanner Adapter and DCM data
#
# Side:  None
#
# Facility: SLAC/Low-Level RF
#
# Auth:  02-Feb-2001,  Stephanie Allison   (SAA)
#==============================================================
# Mod:
#        26-Aug-2002, K. Luchini (LUCHINI):
#          moved allen-bradley databases from 
#          rf_stn_2CV.template to this file.
#
#==============================================================
#
file ab_adapter.db
{
#	        
#	   STN     Component Adapter      Forward Link    Scan Mechanism
  pattern { S     ,    C   ,    A  ,              F     , SC          }
	  {$(RRRS), HVPSDCM,    1  ,      HVPSDCM:A1C0  , ".5 second" }
	  {$(RRRS), CAVTUNR,    2  ,      CAV1TUNR:A2C0 , ".5 second" }
	  {$(RRRS),  STNDCM,    3  ,      STNDCM:A3C0   , ".5 second" }
}
file ab_adapter_card.db
{
#    
#	   STN     Component Adapter Card   Forward Link
  pattern { S     ,    C   ,    A  ,  CD,         F      }
	  {$(RRRS), HVPSDCM,    1  ,  0 , HVPSDCM:A1C2   }
	  {$(RRRS), HVPSDCM,    1  ,  2 , HVPSDCM:A1C4   }
	  {$(RRRS), HVPSDCM,    1  ,  4 , HVPSDCM:A1C6   }
	  {$(RRRS), HVPSDCM,    1  ,  6 , HVPSDCM:A1C8   }
	  {$(RRRS), HVPSDCM,    1  ,  8 , HVPSDCM:A1C10  }
	  {$(RRRS), HVPSDCM,    1  , 10 , HVPSDCM:A1C12  }
	  {$(RRRS), HVPSDCM,    1  , 12 , HVPSDCM:A1C14  }
	  {$(RRRS), HVPSDCM,    1  , 14 , HVPSDCM:SUMY   }

	  {$(RRRS), CAV1TUNR,   2  ,  0 , CAV2TUNR:A2C2  }
	  {$(RRRS), CAV2TUNR,   2  ,  2 , CAVTUNR:SUMY   }

	  {$(RRRS), STNDCM,     3  ,  0 , STN:DCM        }
}
file ab_dcm_table.db
{
#	        
#	   STN     TABLE     
  pattern { S     , T   }
	  {$(RRRS), 0   }
	  {$(RRRS), 1   }
	  {$(RRRS), 2   }
	  {$(RRRS), 3   }
	  {$(RRRS), 4   }
	  {$(RRRS), 5   }
	  {$(RRRS), 6   }
	  {$(RRRS), 7   }
}
@



1.5
log
@Replace *.template files with *.substitutions files and build full
databases using make.  The build scripts are no longer needed.
@
text
@#==============================================================
#
# Abs:  Database template for 4-cavity station RF Station PV's 
#
# Name:  rf_stn_4CV.substitutions
#
# Desc:  EPICS database template file for general
#        4-cavity station PV's (some arc interlocks)
#
# Side:  None
#
# Facility: SLAC/PEPII Low-Level RF
#
# Auth: dd-mmm-yyyy, Stephanie Allison (SAA)
# Rev:  dd-mmm-yyyy, First Lastname    (USERNAME)
#==============================================================
#
# Mod:       
#       26-Aug-2002, K. Luchini (LUCHINI):
#         Moved allen-bradley db to rf_ab_HER.template
#       06-Feb-2002, K. Luchini (LUCHINI):
#         Added standard header and obtained
#         db files from the top level db directory
#         instead of epicsApp/Db
#
#==============================================================
#
file rf_sumy_4CV.db
{
  {S=$(RRRS)}
}
file rf_sumy_wg.db
{
#	           Wave  Water Supply Water Flow
#	   STN     Guide   Temp       Circuit     
  pattern { S     , C  ,    W       ,   F       }
	  {$(RRRS),WG02,   STN      ,  HCW2     }
	  {$(RRRS),WG03,   WG02     ,  HCW2     }
}
file rf_stn_cav.db
{
  {S=$(RRRS),C3=CAV3,C4=CAV4,NC=4}
}
file rf_cav.db
{
#	               Step Mtr Ana Inp
#	   STN     CAV  Card     Card   
  pattern { S     , C  , M    ,   AI  }
	  {$(RRRS),CAV3, 4    ,  R1G1 }
	  {$(RRRS),CAV4, 6    ,  R1G1 }
}
file rf_sumy_cav.db
{
#	                   Step Mtr Ana Inp TC Inp TC Inp TC Inp
#	   STN     CAV  IQA Card     Card   Card 1 Card 2 Card 3
  pattern { S     , C  , I , M    ,   AI  ,  T1  ,  T2  ,  T3  }
	  {$(RRRS),CAV3, 3 , 4    ,  R1G1 , R2G0 , R2G1 , R2G2 }
	  {$(RRRS),CAV4, 3 , 6    ,  R1G1 , R2G3 , R2G4 , R2G5 }
}
file rf_stn.db
{
  {S=$(RRRS),RINGID=$(ID),RING=$(RNG),REGIOC=$(REG),4S=NO_ALARM,2S=MAJOR,IQA3=IQA3}
}
file rf_sumy_stn.db
{
#	           Cav  Cav   WG   WG  HCW  SM Card  SM Card 
#	   STN      3    4    2    3    2   for Cav3 for Cav4      
  pattern { S     , C3 , C4 , W2 , W3 , H2 ,   M3  ,  M4     }
	  {$(RRRS),CAV3,CAV4,WG02,WG03,HCW2,   4   ,  6      }
}
file rf_interlock_arc.db
{
#	   STN     COMP Quantity Description   BIT   Next
  pattern { S     , C  ,   Q    ,   D          , B ,  N  }
	  {$(RRRS),CAV1,"_2:ARC","Arc 2"       , 2 ,:ARC }
	  {$(RRRS),CAV1,"_1:ARC","Arc 1"       , 3 ,:ARC }
	  {$(RRRS),CAV2,":ARC"  ,"Arc"         , 4 ,:SUMY}
	  {$(RRRS),CAV3,":ARC"  ,"Arc"         , 5 ,:SUMY}
	  {$(RRRS),CAV4,":ARC"  ,"Arc"         , 6 ,:SUMY}
}
file rf_sumy_arc_4CV.db
{
  {S=$(RRRS)}
}
@



#include <1610.h>
#include <dspDef.h>
#include <pioDef.h>
#include <bioDef.h>
#include <intDef.h>
#include <aucDef.h>
#include <gvffMisc.h>


.global adaptive	

.rsect ".ram"

adaptive:
/*
   Description
   -----------
    Function implement adaptive algorithm according to equation:
		OUTn = Forg_coef*OUTp + Adapt_coef*(REF - input)   

	Registers:
	---------

		r3 -  pointer to data out
		r2 -  pointer to data in 
		pt -  pointer to coef.
		a0 - scratch
		ar0 - scratch
		c0 - scratch
		i - scratch


*/
	i = -2
	a0 = auc
	ar0 = a0
	auc = 0x2

					/* Compute first 72 data points */

	c0 = BUF_SIZE_CNT	
adaptive_1:

	y = *r2++ x = *pt++		/* load input data & reference value */
	a0 = x				/* load reference value */
	a0 = a0 - y			/* error signal */
	y = a0 x = *pt++		/* load error and adaption coef.*/
	p = y*x y = *r3 x = *pt++i	/* load prev output and forg. factor */
					/* plus return pointer to ref */
	a0 = p	p = y*x
	a0 = a0 + p

	*r3++ = a0                      /* Save the output      */
	if c0lt goto adaptive_1
					/* Compute second 72 data points */
	c0 = BUF_SIZE_CNT	
adaptive_2:

	y = *r2++ x = *pt++		/* load input data & reference value */
	a0 = x				/* load reference value */
	a0 = a0 - y			/* error signal */
	y = a0 x = *pt++		/* load error and adaption coef.*/
	p = y*x y = *r3 x = *pt++i	/* load prev output and forg. factor */
					/* plus return pointer to ref */
	a0 = p	p = y*x
	a0 = a0 + p

	*r3++ = a0                      /* Save the output      */
	if c0lt goto adaptive_2
	a0 = ar0
	auc = a0
        return
@



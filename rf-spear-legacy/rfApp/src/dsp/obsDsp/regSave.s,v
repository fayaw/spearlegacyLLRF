#include <1610.h>
#include <dspDef.h>
#include <pioDef.h>
#include <bioDef.h>
#include <intDef.h>
#include <aucDef.h>
#include <gvffMisc.h>


.global SaveReg
.global RestReg

.rsect ".ram"

SaveReg:
/*
   Description
   -----------
   Saves the control registers of the DSP to designated memory location
   supplied in r3 register.


   Registers used
   --------------
	      inc - Interrupt control
	      auc - Arithmetic unit control
	    mwait - wait states for the ERAM
	     pioc - PIO control
	     sbit - BIO status
	     cbit - BIO control
*/

        *r3++ = y  
        *r3++ = yl  
        *r3++ = p  
        *r3++ = pl 
        *r3++ = a0 
        *r3++ = a0l 
        *r3++ = a1
        *r3++ = a1l     
        *r3++ = i
	*r3++ = c0
        *r3++ = r0     
        *r3++ = r1
	*r3++ = r2
        *r3++ = pioc     
        *r3++ = inc
	*r3++ = auc
        *r3++ = sbit     
        *r3++ = cbit
	*r3 = inc
	r2 = STORE_R3
	*r2 = r3

        return

RestReg:
/*
   Description
   -----------
   Restore the control registers of the DSP from designated memory location
   supplied in r3 register.


   Registers used
   --------------
	      inc - Interrupt control
	      auc - Arithmetic unit control
	    mwait - wait states for the ERAM
	     pioc - PIO control
	     sbit - BIO status
	     cbit - BIO control
*/

	r2 = STORE_R3
	r3 = *r2
        y = *r3--  
        yl = *r3--  
        p = *r3--  
        pl = *r3-- 
        a0 = *r3-- 
        a0l = *r3-- 
        a1 = *r3--
        a1l = *r3--     
        i = *r3--
	c0 = *r3--
        r0 = *r3--     
        r1 = *r3--
	r2 = *r3--
        pioc = *r3--     
        inc = *r3--
	auc = *r3--
        sbit = *r3--     
        cbit = *r3--
	inc = *r3--

        return
STORE_R3: int
@



#include <1610.h>
#include <dspDef.h>
#include <pioDef.h>
#include <bioDef.h>
#include <intDef.h>
#include <aucDef.h>
#include <gvffMisc.h>


.global IQ2A
.global IQ2P
.extern _sqrt2
.extern _atan	
.extern atan_loc	

.rsect ".ram"

IQ2A:
/*
   Description
   -----------
    Function convert I and Q record to amplitude record   

	Registers:
	---------

		r0 -  pointer to data out amplitude
		r1 -  pointer to data in Q
		r2 -  scratch
		r3 -  pointer to data in I
		a0 - scratch
		a1 - scratch
		ar0 - scratch
		ar1 - scratch
		c0 - scratch

*/

	a0 = auc
	ar0 = a0			/* Save auc register */
	auc = 0x2                       /* a0=p*4     */
	a0 = pr				/* location of storage of return addr */
	ar1 = a0			/* done in order save pr register     */
					/* required if subroutin call another */
					/* subrutin 			      */
	

					/* Compute first 72 data points */

	c0 = BUF_SIZE_CNT	
IQ2A_1:
	a0 = a0 - a0
	y = *r1
	x = *r1++
	p = y*x
	a0 = p
	y = *r3
	x = *r3++
	p = y*x
	a0 = a0+p
	a0l = 0x0			/* to clear low part of register */ 
	call _sqrt2                     /* Call the subroutine to calculate */
	                            	/* the square root.                 */
	auc = 0x2                       /* a0=p*4     */
	*r0++ = a0                      /* Save the output to out.      */
	if c0lt goto IQ2A_1
					/* Compute second 72 data points */
	c0 = BUF_SIZE_CNT	
IQ2A_2:
	a0 = a0 - a0
	y = *r1
	x = *r1++
	p = y*x
	a0 = p
	y = *r3
	x = *r3++
	p = y*x
	a0 = a0+p
	a0l = 0x0			/* to clear low part of register */ 
	call _sqrt2                     /* Call the subroutine to calculate */
	                            	/* the square root.                 */
	auc = 0x2                      	/* a0=p*4     */
	*r0++ = a0                      /* Save the output to out.      */
	if c0lt goto IQ2A_2
	a0 = ar0
	auc = a0			/* Restore auc register */
	a0 = ar1			/* location of storage of return addr */
	pr = a0			/* done in order restore pr register  */
	return
IQ2A_pr:	int

IQ2P:
/*
   Description
   -----------
    Function convert I and Q record to phase record   

	Registers:
	---------

		r2 -  pointer to data out phase
		r1 -  pointer to data in Q
		r0 -  scratch
		r3 -  pointer to data in I
		a0 - scratch
		a1 - scratch
		ar0 - scratch
		ar1 - scratch
		c0 - scratch

*/

	a0 = auc
	ar0 = a0			/* Save auc register 		*/
	auc = 0x0 			/* Clear low half of accum.     */
	a0 = pr				/* location of storage of return addr */
	ar1 = a0			/* done in order save pr register     */
					/* required if subroutin call another */
					/* subrutin 			      */                  
	r0 = atan_loc
	*r0--
	*r0++ = r2 
					/* Compute first 72 data points */
	c0 = BUF_SIZE_CNT	
IQ2P_1:
	a0 = *r1++
	a1 = *r3++
	call _atan                      /* Calculate atan(Y/X).         */

	*r0--
	r2 = *r0 
	*r2++ = a0                      /* Save the output to out.      */
	*r0++ =r2
	if c0lt goto IQ2P_1
					/* Compute second 72 data points */
	c0 = BUF_SIZE_CNT	
IQ2P_2:
	a0 = *r1++
	a1 = *r3++
	call _atan                      /* Calculate atan(Y/X).         */

	*r0--
	r2 = *r0 
	*r2++ = a0                      /* Save the output to out.      */
	*r0++ =r2
	if c0lt goto IQ2P_2
	a0 = ar0
	auc = a0				/* Restore auc register */
	a0 = ar1			/* location of storage of return addr */
	pr = a0				/* done in order restore pr register  */
	return
IQ2P_pr:	int
@



#include <1610.h>

#include "dspDef.h"
#include "comDef.h"
#include "intDef.h"
#include "sttDef.h"
#include "gvffMisc.h"


.global ldCirBuf
.global cmCirBuf
.global cmCirBufa
.global PrelBuf
.extern OUT_BUF_OFFSET

.rsect ".ram"

ldCirBuf:
/*
   Description
   -----------
   Copy circular buffer from one memory location to other.

   Registers used
   --------------
		r1 - location of circular buffer offset 
		r2 - start location of source memory 
		r3 - start location of circular buffer
		rb - start location of destination memory 
		re - end location of destination memory
		a0 - scratch register
		y  - scratch register
		
*/
	y	= *r1		/* load offset			*/
	a0	= rb		/* load begining of the buffer 	*/
	a0	= a0 + y
	r3	= a0
	do BUF_HLF_SIZE {	/* Repead loop BUF_SIZE times */
	a0	= *r2++		/* Temprory store data in the register */
	*r3++	= a0		/* Store it to distination memory */
	a0	= *r2++		/* Temprory store data in the register */
	*r3++	= a0		/* Store it to distination memory */
	}
        return


cmCirBuf:
/*
   Description
   -----------
   Routine to compare circular buffers at 2 specified locations. It will return
   zero on success and one on error. It will return also locations of the first
   mismatch.

   Registers used
   --------------
		r2 - Pointer to the first memorry
		r3 - Pointer to the second memory
		a1 - scratch
		c0 - scratch

		Return
		a0 - 0 if OK
		     1 if error
		r2 - location  of error in the first memory
		r2 - location  of error in the second memory
*/


	a0 	= a0 - a0		/* to clear a0 */
	a1 	= a1 - a1		/* to clear a1 */
	c0 	= BUF_SIZE_CNT		/* preload cntr buf. with  1-BUF_SIZE */
cmCirBuf_1:
	a0	= *r2++			/* Temporary store data in register*/
	a1	= *r3++			/* Temporary store data in register*/
	a0 - a1
	if ne goto cmCirBuf_2		/* If not equal goto label */
	a0	= *r2++			/* Temporary store data in register */
	a1	= *r3++			/* Temporary store data in register */
	a0 - a1
	if ne goto cmCirBuf_2		/* If not equal goto label */
	if c0lt goto cmCirBuf_1		/* loop */
	a0	= a0 - a0		/* All locations same, return 0*/
	goto cmCirBuf_3	
		/* ready to return */
cmCirBuf_2:
	a0 = 0x1			/* to set a0 */
	*r2--				/* to preserve location of errors */
	*r3--				/* to preserve location of errors */

cmCirBuf_3: 
	return


cmCirBufa:
/*
   Description
   -----------
   Routine to compare circular buffers at 2 specified locations. It will return
   the number of differences in memories.

   Registers used
   --------------
		r2 - Pointer to the first memorry
		r3 - Pointer to the second memory
		a1 - scratch
		p - scratch
		c0 -scratch

		Return
		a0 - number of differences
*/


	a0	= a0 - a0		/* to clear counter */
	a1	= a1 - a1		/* to clear a1 */
	p	= a0			/* to clear p */
	c0	= BUF_SIZE_CNT		/* preload cntr buf. with  1-BUF_SIZE */
cmCirBufa_1:
	p	= *r2++			/* Temporary store data in register */
	a1	= *r3++			/* Temporary store data in register */
	a1 - p
	if ne a0 = a0 + 0x1		/* If not equal incr counter */
	p	= *r2++			/* Temporary store data in register */
	a1	= *r3++			/* Temporary store data in register */
	a1 - p
	if ne a0 = a0 + 0x1		/* If not equal incr counter */
	if c0lt goto cmCirBufa_1	/* loop */
	return


PrelBuf:
/*
   Description
   -----------
	Preload initial reference to internal buffer

   Registers used
   --------------
		r0 - Pointer to initial reference
		r1 - Pointer to the external memory buffer
		r2 - Pointer to initial reference
		r3 - Pointer to the internal memory buffer
		a0 - scratch
		a1 - scratch

*/

	a0	= *r2
	a1	= *r0
	do BUF_HLF_SIZE {		/* Repead loop BUF_SIZE times */
	*r3++	= a0			/* Store it into distination memory */
	*r3++	= a0			/* Store it into distination memory */
	*r1++	= a1			/* Store it into distination memory */
	*r1++	= a1			/* Store it into distination memory */
	}
        return
@



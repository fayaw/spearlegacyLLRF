#ifndef GVFFMISC_H
#define GVFFMISC_H

/* Interrupt service routine vector area and context 'stack' area: */
#define VEC_A_RESET     0x0000
#define DSP_A_ISRSTACK	DSP_A_YBASE
#define DSP_K_STACKLEN	0x20

#define BUF_SIZE	144		/* buffer size is 144 samples */
#define BUF_SIZE_M1	(BUF_SIZE - 1)
#define BUF_HLF_SIZE	72		/*  1/2 buffer size, used for DO loop */
#define BUF_SIZE_CNT	0xb9		/* 1 - BUF_HLF_SIZE */

#define I_BUF_OUT_L	0x2000		/* Starting location of low I buffer */
#define I_BUF_OUT_H	0x2100		/* Starting location of high I buffer */
#define Q_BUF_OUT_L	0x2200		/* Starting location of low Q buffer */
#define Q_BUF_OUT_H	0x2300		/* Starting location of high Q buffer */

/* Interrupt 0 delay: When input FIFOs start to fill due to turn trigger, */
/* interrupt 0 occurs after the input FIFOs have acquired the following   */
/* number of words.  The DSP is expected to read out either FIFO at a     */
/* lower rate than the sampling (filling) rate.                           */

#define DSP_K_INT0_DEL	0x000a		/* delay value with int hrdw enabled */
#define DSP_K_STT0_DEL	0x800a		/* delay value with int hrdw disabled */

#define DSP_K_SIGNBIT	0x8000

/* right shift factor applied to I & Q Error signals to provide guard bit(s) */

#define DSP_K_PRESHIFT	0x0001

/* Number of parameters expected in a LD_REF message */

#define DSP_K_NLDREF	8

/* Scale factor used for normalizing the 'find_dc' calculation */
/* When AUC register is set for no shift of P, this value equals 0.00694275 */

#define DSP_K_P00694	0x01c7

/* The following constant is used to allign the loading of the I and Q */
/* circular buffers to account for hardware delays. Its value MUST BE in */
/* range [0:143] (decimal) */

#define DSP_K_BUFOFFS	133

/* Number of turns of IQ Error data to collect and average over: max is 3 */

/* #define DSP_K_NTURNS	3 */
#define DSP_K_NTURNS	1

#endif

#ifndef GVFDSPDEF_H
#define GVFDSPDEF_H

/* Include general definitions */
#include "../genDsp/dspDef.h"

#define DSP_K_MEMWAIT  0x3333           /* Number of wait states for ERAM   */
					/* 0x3333 - 3 wait states for ERAMs */

/* Gap Voltage Feedforward DSP external memory definitions - DSEL IO portion */
#define DSP_A_DSEL0    0x7f00
#define DSP_A_DSEL1    0x7f01
#define DSP_A_DSEL2    0x7f02
#define DSP_A_DSEL3    0x7f03
#define SndDspMsg      DSP_A_DSEL0      /* Address of dsel0, addressing this */
                                        /* loc. will trigger VXI interrupt */
#define ChkDspState    DSP_A_DSEL1      /* Bits at this location corresp. to */
                                        /* the different operating states */

#define DSEL1_V_RUN    0                /* Correspond to normal run bit	*/
#define DSEL1_V_TF     1                /* TF bit		    	*/
#define DSEL1_V_TEST   2                /* Test bit 			*/
#define DSEL1_V_MSG    3                /* Message bit 			*/

/* DSEL1 external register masks */
#define DSEL1_M_RUN   (1 << DSEL1_V_RUN)
#define DSEL1_M_TF    (1 << DSEL1_V_TF)
#define DSEL1_M_TEST  (1 << DSEL1_V_TEST)
#define DSEL1_M_MSG   (1 << DSEL1_V_MSG)
#define DSEL1_M_CMD   (DSEL1_M_RUN | DSEL1_M_TF | DSEL1_M_TEST)
#define DSEL1_M_LOAD  0

#endif

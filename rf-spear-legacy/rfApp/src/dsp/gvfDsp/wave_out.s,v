/* Modified by W. Ross, May 30, 1997, to conform to Revision 1 Gap Module */
/* The main change is the exchange of IOBit2 and IOBit3 functions, IOBit3 now */
/* drives an external LED (and additionally resets the IQ FIFOs which don't */
/* effect this test.  IOBit2 is now an input for an external test switch */

#include <1610.h>

#include "dspDef.h"
#include "timDef.h"
#include "intDef.h"
#include "bioDef.h"

.rsect ".ram"
.= VEC_A_RESET
main:
	auc = 0
	mwait = 0x3333
        inc    = 0                      /* Disable interrupts */
	sbit = DSP_K_BIODIR			/* Set sbit configuration */
        cbit   = 0                      /* Reset all BIO outputs */
        cbit   = BIO_OFF(BIO_V_FIFOENA) /* Used here as output bit driving */
					/*   external led through IOBit conn */
	pl = 0

	cbit	= BIO_ON(BIO_V_BUFSEL)	/* Select high buffers as output
	nop				/* wait for control bit re-sync */
	nop
	nop
	nop
	nop
	nop

        r0 = 0x2000			/* Put wave form in I-lo circular buf */
	r1 = out_wave4
	do 72 {
           a0 = *r1++
	   *r0++ =a0
           a0 = *r1++
	   *r0++ =a0
         }

        r0 = 0x2200			/* Put wave form in Q-lo circular buf */
	r1 = out_wave4
	do 72 {
           a0 = *r1++
	   *r0++ =a0
           a0 = *r1++
	   *r0++ =a0
         }

	cbit	= BIO_OFF(BIO_V_BUFSEL)	/* Select low buffers as output
	nop				/* wait for control bit re-sync */
	nop
	nop
	nop
	nop
	nop

        r0 = 0x2100			/* Put wave form in I-hi circular buf */
	r1 = out_wave6
	do 72 {
           a0 = *r1++
	   *r0++ =a0
           a0 = *r1++
	   *r0++ =a0
         }

        r0 = 0x2300			/* Put wave form in Q-hi circular buf */
	r1 = out_wave6
	do 72 {
           a0 = *r1++
	   *r0++ =a0
           a0 = *r1++
	   *r0++ =a0
         }

	cbit = BIO_ON(BIO_V_DSPRUN)	/* turn on DSP_RUN led, enable DAC */
	cbit = BIO_ON(BIO_V_FIFOENA)	/* turn on IOBit Connector LED	   */
test:
        cbit = BIO_TESTT(BIO_V_GENERAL)	/* test iobit2 and select between upper
					  and lower buffer for both channels */
   	if allt goto l_buf
	goto test
l_buf:
	cbit = BIO_ON(BIO_V_BUFSEL)
	goto test1
test1:
        cbit   = BIO_TESTF(BIO_V_GENERAL)
   	if allt goto l_buf1
	goto test1
l_buf1:
	cbit = BIO_OFF(BIO_V_BUFSEL)
	goto test
end: goto end


        inc    = 0                      /* Disable interrupts */
	sbit = 0x8c00			/* Set sbit configuration */
        cbit   = 0                      /* Reset all BIO outputs */
	pl = 0
	r1 = 0x1fff			/* use last RAM location for storage */
        r0 = 0x8000			/* First location of the ERAMHI */
	a0 = a0 - a0			/* clear a0 */
	call pat2vximem			/* function call which write pattern */
				        /*to the memory. Pattern stored in a0 */
        r0 = 0x8000
	a0 = a0 - a0		
	p = 0
	call patFvximem			/* function call which read pattern */
					/* from memory			     */
	r0 = 0x8000
	a0 = a0 - a0
	a0 = 0xffff
	call pat2vximem
        r0 = 0x8000
	a0 = a0 - a0
	p = 0xffff
	call patFvximem
        r0 = 0x8000
	a0 = a0 - a0
	call cnt2vximem			/* function which write incrementing */
					/* to memory			     */
        r0 = 0x8000
	a0 = a0 - a0
	call cntFvximem			/* function which read incrementing */
					/* from memory			     */
        r0 = 0x2000			/* First location of the ERAMLO */	
	a0 = a0 - a0
	call pat2lut			/* Write pattern to LUT memory    */
        r0 = 0x2000
	a0 = a0 - a0
	p = 0
	call patFlut			/* Read pattern from LUT memory    */
	r0 = 0x2000
	a0 = a0 - a0

	call cnt2lut			/* Write incr. count to LUT memory    */
        r0 = 0x2000
	a0 = a0 - a0
	call cntFlut			/* Read incr. count from LUT memory   */

	r0 = 0x8000
	*r1++

dump:	a0 = *r1++			/* Dump number of error in each test */

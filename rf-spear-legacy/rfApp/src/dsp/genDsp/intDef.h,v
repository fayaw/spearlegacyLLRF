#ifndef INTDEF_H
#define INTDEF_H

/* Interrupt vectors in X Memory Space */
#define VEC_A_RESET      0x0000         /* Reset vector */
#define VEC_A_DSP16      0x0001         /* DSP16/DSP16A interrupts */
#define VEC_A_ICALL      0x0002         /* Software interrupt, from icall inst*/
#define VEC_A_HDSTRAP    0x0003         /* TRAP from HDS */
#define VEC_A_INT0       0x0001         /* External interrupt 0 */
#define VEC_A_INT1       0x0004         /* External interrupt 1 */
#define VEC_A_INT2       0x0008         /* External interrupt 2 */
#define VEC_A_INT3       0x000c         /* External interrupt 3 */
#define VEC_A_TIME       0x0010         /* Timer vector */
#define VEC_A_IBF2       0x0014         /* Input Buffer Full vector */
#define VEC_A_OBE2       0x0018         /* Output Buffer Empty vector */
#define VEC_A_EMUXBOTH   0x001c         /* Ext data bus mux ctl both high */
#define VEC_A_RSVD1      0x0020         /* Reserved vector */
#define VEC_A_RSVD2      0x0024         /* Reserved vector */
#define VEC_A_RSVD3      0x0028         /* Reserved vector */
#define VEC_A_IBF        0x002c         /* Input Buffer Full,      enb by inc */
#define VEC_A_OBE        0x0030         /* Output Buffer Empty,    enb by inc */
#define VEC_A_PIDS       0x0034         /* Parallel Input Data Strobe, "  inc */
#define VEC_A_PODS       0x0038         /* Parallel Output Data Strobe, " inc */
#define VEC_A_JINT       0x0042         /* JTAG in */
#define VEC_A_USRTRAP    0x0046         /* TRAP from user */

/* Bits in Interrupt Control and Interrupt Status Registers */
#define INT_V_IBF             0         /* Input  Buffer Full,     enb by inc */
#define INT_V_OBE             1         /* Output Buffer Empty,    enb by inc */
#define INT_V_PODS            2         /* Parallel Output Data Strobe, " inc */
#define INT_V_PIDS            3         /* Parallel Input  Data Strobe, " inc */
#define INT_V_INTS            4         /* External interrupts */
#define INT_V_INT0            4         /* External interrupt 0 */
#define INT_V_INT12           5         /* External interrupt 1 and 2 */
#define INT_V_INT123          5         /* External interrupt 1, 2, and 3 */
#define INT_V_INT1            5         /* External interrupt 1 */
#define INT_V_INT2            6         /* External interrupt 2 */
#define INT_V_INT3            7         /* External interrupt 3 */
#define INT_V_TIME            8         /* Timer */
#define INT_V_IBF2            9         /* Input  Buffer Full */
#define INT_V_OBE2           10         /* Output Buffer Empty */
#define INT_V_EMUXBOTH       11         /* Ext data bus mux ctl both high */
#define INT_V_RSVD1          12         /* Reserved */
#define INT_V_RSVD2          13         /* Reserved */
#define INT_V_RSVD3          14         /* Reserved */
#define INT_V_JINT           15         /* JTAG in */

/* Masks for bits in Interrupt Control and Interrupt Status Registers */
#define INT_M_IBF            (0x0001 << INT_V_IBF     )
#define INT_M_OBE            (0x0001 << INT_V_OBE     )
#define INT_M_PODS           (0x0001 << INT_V_PODS    )
#define INT_M_PIDS           (0x0001 << INT_V_PIDS    )
#define INT_M_INTS           (0x000f << INT_V_INTS    )
#define INT_M_INT0           (0x0001 << INT_V_INT0    )
#define INT_M_INT12          (0x0003 << INT_V_INT12   )
#define INT_M_INT123         (0x0007 << INT_V_INT123  )
#define INT_M_INT1           (0x0001 << INT_V_INT1    )
#define INT_M_INT2           (0x0001 << INT_V_INT2    )
#define INT_M_INT3           (0x0001 << INT_V_INT3    )
#define INT_M_TIME           (0x0001 << INT_V_TIME    )
#define INT_M_IBF2           (0x0001 << INT_V_IBF2    )
#define INT_M_OBE2           (0x0001 << INT_V_OBE2    )
#define INT_M_EMUXBOTH       (0x0001 << INT_V_EMUXBOTH)
#define INT_M_RSVD1          (0x0001 << INT_V_RSVD1   )
#define INT_M_RSVD2          (0x0001 << INT_V_RSVD2   )
#define INT_M_RSVD3          (0x0001 << INT_V_RSVD3   )
#define INT_M_JINT           (0x0001 << INT_V_JINT    )

#define INT_CLR(mask)        (~(mask))
#define INT_SET(mask)         (mask)

#endif

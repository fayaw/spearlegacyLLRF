#ifndef BIODEF_H
#define BIODEF_H

/* sbit and cbit register definitions for setting up BIO */
#define SBT_V_VALUE           0         /* sbit value field */
#define SBT_V_DIR             8         /* sbit direction field */
#define CBT_V_DATAPAT         0         /* cbit data/pattern */
#define CBT_V_MODEMASK        8         /* cbit mode/mask */

#define SBT_M_VALUE          (0x00ff << SBT_V_VALUE   )
#define SBT_M_DIR            (0x00ff << SBT_V_DIR     )
#define CBT_M_DATAPAT        (0x00ff << CBT_V_DATAPAT )
#define CBT_M_MODEMASK       (0x00ff << CBT_V_MODEMASK)

#define BIO_K_CLEAR           0         /* Clear */
#define BIO_K_SET             1         /* Set */
#define BIO_K_OFF             0         /* Off */
#define BIO_K_ON              1         /* On */
#define BIO_K_FALSE           0         /* Off */
#define BIO_K_TRUE            1         /* On */
#define BIO_K_DISABLE         0         /* Disable */
#define BIO_K_ENABLE          1         /* Enable */
#define BIO_K_DATA            0         /* Put DATA on output */
#define BIO_K_DONTCARE        0         /* Don't care */
#define BIO_K_TOGGLE          1         /* Toggle output */
#define BIO_K_INPUT           0         /* Input */
#define BIO_K_OUTPUT          1         /* Output */

#define BIO_INPUT(bit)         ((BIO_K_INPUT   << (bit)) << SBT_V_DIR)
#define BIO_OUTPUT(bit)        ((BIO_K_OUTPUT  << (bit)) << SBT_V_DIR)

#define BIO_DATA(bit, value)  ((~((~(DSP_K_BIODIR)) | \
                               ((1       << (bit))  << CBT_V_MODEMASK))) | \
                               (((value) << (bit))  << CBT_V_DATAPAT))
#define BIO_DATA2(bit1, bit2, value)  ((~((~(DSP_K_BIODIR))              | \
			       ((1	 << (bit1)) << CBT_V_MODEMASK)   | \
                               ((1       << (bit2)) << CBT_V_MODEMASK))) | \
                               (((value) << (bit1)) << CBT_V_DATAPAT)    | \
                               (((value) << (bit2)) << CBT_V_DATAPAT))
#define BIO_TOGGLE(bit)       ((DSP_K_BIODIR) | \
                               ((1       << (bit))  << CBT_V_DATAPAT ))
#define BIO_TESTF(bit)        ((DSP_K_BIODIR) | \
                               ((1       << (bit))  << CBT_V_MODEMASK) | \
                               ((FALSE   << (bit))  << CBT_V_DATAPAT))
#define BIO_TESTT(bit)        ((DSP_K_BIODIR) | \
                               ((1       << (bit))  << CBT_V_MODEMASK) | \
                               ((TRUE    << (bit))  << CBT_V_DATAPAT))
#define BIO_TESTT2(bit1,bit2)  ((DSP_K_BIODIR) | \
                               ((1       << (bit1))  << CBT_V_MODEMASK) | \
                               ((TRUE    << (bit1))  << CBT_V_DATAPAT)  | \
                               ((1       << (bit2))  << CBT_V_MODEMASK) | \
                               ((TRUE    << (bit2))  << CBT_V_DATAPAT))
#define BIO_CLEAR(bit)          (BIO_DATA ((bit), BIO_K_FALSE))
#define BIO_SET(bit)            (BIO_DATA ((bit), BIO_K_TRUE))
#define BIO_OFF(bit)            (BIO_DATA ((bit), BIO_K_OFF))
#define BIO_ON(bit)             (BIO_DATA ((bit), BIO_K_ON))
#define BIO_FALSE(bit)          (BIO_DATA ((bit), BIO_K_FALSE))
#define BIO_TRUE(bit)           (BIO_DATA ((bit), BIO_K_TRUE))
#define BIO_DISABLE(bit)        (BIO_DATA ((bit), BIO_K_DISABLE))
#define BIO_ENABLE(bit)         (BIO_DATA ((bit), BIO_K_ENABLE))
#define BIO_DONTCARE(bit)       (BIO_DATA ((bit), BIO_K_X))
#define BIO_SET2(bit1, bit2)	(BIO_DATA2 ((bit1), (bit2), BIO_K_SET))
#define BIO_OFF2(bit1, bit2)	(BIO_DATA2 ((bit1), (bit2), BIO_K_OFF))

#endif

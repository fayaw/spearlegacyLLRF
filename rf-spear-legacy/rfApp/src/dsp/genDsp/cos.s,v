@/************************ The routine _cos follows **********************

Name:           _cos
		[cos.s - cos.o]

Synopsis:       Implementation of the cosine function of an argument X
		between -PI/2 and PI/2.

Performance and Memory Requirements:

	Instruction cycles:     40 with BMU device [Call & return included].
				40 with non BMU device [Call & return incl.].

	Code:                   17 words of ROM with BMU device.
				17 words of ROM with non BMU device.

	Coefficients:           6 words of RAM.
	Local variables:        0
	Static variables:       0
	Registers used: x, y, p, a0, a1, r0, auc
			auc is initialized to 0x0 [no scaling of p register]
	Accuracy:       Result is accurate to sixteen bits of precision for
			inputs in the segment [-PI/2, PI/2].

Description:

	Algorithm: cos(X) = c0+X^2(c2+X^2(c4+X^2(c6+X^2(c8+X^2(c10)))))
		   where cn corresponds to coefficients of the Taylor
		   series expansion of the cosine function.

	BEGIN _cos
	    Set auc = 0.
	    Angle X is passed via a1h register in Q14 format.
	    Compute nested polinomial series representation of cos(X).
	    Return result in a0h in Q14 format.
	END _cos.

Inputs:         The argument is passed in a1h in Q14 format.

Outputs:        The cosine of the argument is returned in a0h in Q14 format.

Routines Called:        None.

This _cos routine was written by Homayoon Sam (March 1994) to run on
DSP1616. I evaluated and verified the routine efficiency on DSP1610,
included a performance summary, and added comments to the existing code
for clarification.

This routine shows 60% improvement in instruction cycles and 80%
improvement in memory requirements when BMU device is used and compared
to the performance on DSP16A.
Work by Aristos Nkansa-Kissi (Summer 1994).
*************************************************************************/
/*                                                                      */
#include <1610.h>             /* Include the DSP16xx device             */
			      /* header file.                           */
.global _cos                  /* Declare routine as global. This allows */
			      /* _cos to be called from any routine.    */
.rsect ".ram"                 /* Assemble in .ram.                      */

_cos:
	auc = 0x0             /* No scaling of p register.              */
	x = a1                /* Load input number into x, in q14.      */
	y = a1                /* Load input number into y, in q14.      */
	p = x*y               /* Calcualte x^2 in q12.                  */
	a0 = p                /* Load x^2 into a0, retain q12 format.   */
	x = a0                /* Load x^2 into x reg.                   */
	auc = 0x02            /* Load p<<2 into a0.                     */
	r0 = CosCoeff         /* Pointer to cosine coefficients.        */
	y = *r0++             /* Load the last coefficient into y.      */

do 5 {
	p = x*y  a0 = *r0++   /* p gets x^2 * c[n], a0 gets c[n-1]      */
	a0 = a0+p             /* a0 gets c[n-1] + x^2 * a[n]            */
	y = a0                /* this is two cycles                     */
     }

	/* at the end of the cash loop, a0h has cos(x) in q14 format    */

	return

.rsect ".ram"                   /* Assemble in .ram                     */

CosCoeff:                    /* all numbers in q14 format by default    */
	int -0.000282187     /* c10<<10                                 */
	int 0.00634921       /* c8<<8                                   */
	int -0.0888889       /* c6<<6                                   */
	int 0.666667         /* c4<<4                                   */
	int -2.00000         /* c2<<2                                   */
	int 1.0              /* c0                                      */

/*      sca_coeff(6)=8.55112e-06
	sca_coeff(7)=-1.28106e-05                                    */

/************************************************************************/

@



#include <1610.h>

#include "dspDef.h"
#include "comDef.h"
#include "intDef.h"
#include "sttDef.h"


.extern SOS
.global InitVecTbl


.rsect ".ram"

UnInitInt:
/*
   Description
   -----------
   Interrupt Service Routine that runs when an uninitialized interrupt
   is triggered.  This ISR causes a bugcheck when it is called.  This
   is meant to trap spurious interrupts.  Uninitialized vectors power
   up containing zero, which is an opcode for branch to location zero,
   in other words, reboot.  At least, I think.

   Registers used
   --------------
	       r3 - General
	       a0 - Scratch
*/
	r3     = Status                 /* Place to store status */
	a0     = STT_UNINIINT           /* Error message */
	*r3++  = a0                     /* Store it */
	r3     = SttArg                 /* Place to store status arguments */
	*r3++  = pr                     /* Address we vectored through */
	*r3    = pi                     /* Address at which exception occured */
	call     SOS                    /* Never returns */



InitVecTbl:
/*
   Description
   -----------
   Routine to initialize unused interrupt vectors.  Unused vectors are
   loaded with the UnInitInt ISR above.

   Registers used
   --------------
	       r0 - Pointer into the vector table
               r1 - Pointer to the instruction template
	       a0 - Instruction template
	       a1 - scratch
*/
	r0     = DSP_A_VECTBL           /* Address of vector table */
	r1     = Inst                   /* Store instruction template in acc */
	a0     = *r1
	a0l    = 0                      /* Clear lower half */
	*r0    = a1                     /* Overwrite Reset vector */
	p      = 0
	pl     = 0
	do DSP_K_VECCNT {               /* Max number of vects to init */
	  a1    = *r0                   /* Vect already initted? */
	  a1 - p
	  if eq a1 = a0                 /* No, load new instruction */
	  *r0++ = a1                    /* Store instruction, next vector */
	}
	return

/* Define the template instruction */
Inst:   call     UnInitInt              /* Template instruction */
@



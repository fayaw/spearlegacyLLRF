#ifndef RFPBIODEF_H
#define RFPBIODEF_H

/* Include BIO definitions */
#include "../genDsp/bioDef.h"

/* Define BIO control register fields */
#define BIO_V_MSG2DSP         0       /* Message to DSP*/
#define BIO_V_RIPLOOP         1       /* Open/Close Ripple Loop */
#define BIO_V_RIPCLK          2       /* Ripple clock from backplane */
#define BIO_V_BCKPLNTRG       3       /* Backplane Trigger */
#define BIO_V_GEN1            4       /* General usage */
#define BIO_V_GEN2            5       /* General usage */
#define BIO_V_MSG2CPU         6       /* Message to CPU */
#define BIO_V_DSPRUN          7       /* DSP running */

/* Make BIO masks */
#define BIO_M_MSG2DSP        (1 << BIO_V_MSG2DSP)
#define BIO_M_RIPLOOP        (1 << BIO_V_RIPLOOP)
#define BIO_M_RIPCLK         (1 << BIO_V_RIPCLK)
#define BIO_M_BCKPLNTRG      (1 << BIO_V_BCKPLNTRG)
#define BIO_M_GEN1           (1 << BIO_V_GEN1)
#define BIO_M_GEN2           (1 << BIO_V_GEN2)
#define BIO_M_MSG2CPU        (1 << BIO_V_MSG2CPU)
#define BIO_M_DSPRUN         (1 << BIO_V_DSPRUN)

/* BIO bit directions.  Constant for the board */
#define DSP_K_BIODIR         (BIO_INPUT    (BIO_V_MSG2DSP  ) | \
                              BIO_INPUT    (BIO_V_RIPLOOP  ) | \
                              BIO_INPUT    (BIO_V_RIPCLK   ) | \
                              BIO_INPUT    (BIO_V_BCKPLNTRG) | \
                              BIO_OUTPUT   (BIO_V_GEN1     ) | \
                              BIO_OUTPUT   (BIO_V_GEN2     ) | \
                              BIO_OUTPUT   (BIO_V_MSG2CPU  ) | \
                              BIO_OUTPUT   (BIO_V_DSPRUN   ))

#define DSP_K_BIOINIT       ((0x0000         << CBT_V_MODEMASK ) | \
                             (BIO_K_DONTCARE << BIO_V_MSG2DSP  ) | \
                             (BIO_K_DONTCARE << BIO_V_RIPLOOP  ) | \
                             (BIO_K_DONTCARE << BIO_V_RIPCLK   ) | \
                             (BIO_K_DONTCARE << BIO_V_BCKPLNTRG) | \
                             (BIO_K_CLEAR    << BIO_V_GEN1     ) | \
                             (BIO_K_CLEAR    << BIO_V_GEN2     ) | \
                             (BIO_K_CLEAR    << BIO_V_MSG2CPU  ) | \
                             (BIO_K_CLEAR    << BIO_V_DSPRUN   ))

#endif

#include <1610.h>

#include "dspDef.h"
#include "aucDef.h"
#include "intDef.h"
#include "bioDef.h"
#include "pioDef.h"
#include "sttDef.h"
#include "timDef.h"

.rsect ".eram"

#ifdef GVF
/* Fake the DAC ports on the GVF module */
        .= DSP_A_ERAM
Dac:    4*int  0.0
#endif

        .= (DSP_A_ERAM + 4)
Mem:    4*int  0.0                      /* Location to save data to */



.rsect ".ram"

/* Interrupt and exception vectors */
        .= VEC_A_RESET
start:  goto main                       /* Jump to main routine */

.= DSP_A_CODELOW

/* Main program */
main:
        call     InitReg                /* Initialize registers   */

        mwait = 0xffff                  /* Slow it down to see LED flash */

/* Ramp the DACs */

RunTest:
        cbit  = BIO_TOGGLE (BIO_V_GEN1) /* Toggle LED */
        p     = 0x0fff                  /* Maximum test value */
        a0    = 0                       /* Clear a0 */
        a0l   = 0

        auc   = 0xc                     /* Don't saturate acc regs at 07fff */

Loop:
        r0    = Mem                     /* External memory address */
#ifdef GVF
        r1    = Dac                     /* "DAC" address */
#else
# ifdef RFP
        r1    = DSP_A_DACS              /* DAC address */
# endif
#endif
        a1    = a0 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

        a1    = a0 ^ p                  /* Invert test value */
        a1    = a1 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

        a1    = a0 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

        a1    = a0 ^ p                  /* Invert test value */
        a1    = a1 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

#ifdef RFP
        r0    = DSP_A_UPDDACS           /* Update the DACs */
        *r0   = a0                      /* Value doesn't matter */
#endif

        a0    = a0h + 1                 /* Increment */
        a0 - p \ if gt goto RunTest2    /* Stage 2 if exceeded maximum */
        goto Loop


RunTest2:
        a0    = 0                       /* Clear a0 */
        a0l   = 0

Loop2:
        r0    = Mem                     /* External memory address */
#ifdef GVF
        r1    = Dac                     /* "DAC" address */
#else
# ifdef RFP
        r1    = DSP_A_DACS              /* DAC address */
# endif
#endif
        a1    = a0 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

        a1    = a0 ^ p                  /* Invert test value */
        a1    = a1 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

        a1    = a0 << 4                 /* Shift to MSB */
        *r0++ = a1                      /* Save in external memory */
        *r1++ = a1                      /* Load 1st DAC register */

#ifdef RFP
        r0    = DSP_A_UPDDACS           /* Update the DACs */
        *r0   = a0                      /* Value doesn't matter */
#endif

        a0    = a0h + 1                 /* Increment */
        a0 - p \ if gt goto RunTest     /* Start again if exceeded maximum */
        goto Loop2


/* Routine register init */
InitReg:
        inc  = DSP_K_INTINIT            /* Disable interrupts */
        auc  = DSP_K_AUCINIT            /* Set up Arithmetic Unit */
        mwait= DSP_K_MEMWAIT            /* Number of wait states for ERAM */
        pioc = DSP_K_PIOINIT            /* Set up PIO */
        sbit = DSP_K_BIODIR             /* Set up BIO bit directions */
        cbit = DSP_K_BIOINIT            /* Set up BIO outputs */

        timer0 = NULL                   /* Timer count-down register */
        timerc = DSP_K_TIMINIT          /* Timer is off */

        y      = 0
        yl     = 0                      /* Don't trip on upper bits */
        p      = 0
        pl     = 0                      /* Don't trip on upper bits */
        a0     = 0
        a0l    = 0                      /* Don't trip on upper bits */
        a1     = 0
        a1l    = 0                      /* Don't trip on upper bits */

        return
@



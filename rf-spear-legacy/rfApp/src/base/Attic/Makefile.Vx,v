SRCS.c += ../mapAdx.c
SRCS.c += ../memTest.c
SRCS.c += ../mtlMsgs.c
SRCS.c += ../tstMem.c
SRCS.c += ../vbb.c
SRCS.c += ../vbbMsgs.c

# vxi files
SRCS.c += ../vxiBaseIsr.c

LIBOBJS += bootFix.o
LIBOBJS += bus.o 
LIBOBJS += busMsgs.o  

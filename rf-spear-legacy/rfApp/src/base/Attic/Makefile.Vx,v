LIBOBJS += dlt.o
LIBOBJS += dtlMsgs.o 
LIBOBJS += dwnMsgs.o 
LIBOBJS += initModule.o 
LIBOBJS += lip.o 
LIBOBJS += lipMsgs.o
LIBOBJS += lstLib.o
LIBOBJS += mvxLib.o 
LIBOBJS += memTest.o
LIBOBJS += mtlMsgs.o
LIBOBJS += sgl.o 
LIBOBJS += sglMsgs.o 
LIBOBJS += sysMsgs.o
LIBOBJS += stateShow.o
LIBOBJS += ethShow.o


# System Diagnostics 
# Note: These routines do not need EPICS
# and therefore diagLib can be loaded
# before iocCore

PROD += time
PROD += dld dlt mapAdx memTest tstMem vbb
PROD += dtlMsgs.o mtlMsgs.o
ifeq ($(T_A),niCpu030)
# VXI_OBJECTS  += $(VX_TARGET_DIR)/nivxi/nivxi.o 
# VXI_OBJECTS  += $(VX_TARGET_DIR)/nivxi/resman.o
# PROD         += niLib
 PROD         += vxiBaseIsr.o
 PROD         += $(VX_TARGET_DIR)/nivxi/nivxi.o
 PROD         += $(VX_TARGET_DIR)/nivxi/resman.o
 PROD         += $(VX_TARGET_DIR)/nivxi/vxitedit.o
 PROD         += $(VX_TARGET_DIR)/nivxi/victext.o
endif
ifeq ($(T_A),mv2400)
# VXI_OBJECTS  += $(VX_TARGET_DIR)/V152/Resman.o
# VXI_OBJECTS  += $(VX_TARGET_DIR)/V152/VXI_Library.o
# PROD        += niLib
 PROD         += vxiBaseIsr.o
 PROD         += $(VX_TARGET_DIR)/V152/nivxi.o
 PROD         += $(VX_TARGET_DIR)/V152/resman.o
endif

LIBNAME = diagLib

include $(TOP)/config/RULES.Vx
#----------------------------------------
#  ADD RULES AFTER THIS LINE
#
time:	time.o
	$(LD) -o time time.o

dld: 	dld.o dwnMsgs.o lstLib.o sgl.o sglMsgs.o
	$(LD) -o dld dld.o dwnMsgs.o lstLib.o sgl.o sglMsgs.o

dlt: 	dlt.o dwnMsgs.o lip.o lipMsgs.o
	$(LD) -o dlt dlt.o dwnMsgs.o lip.o lipMsgs.o lstLib.o \
		 bus.o busMsgs.o mvxLib.o sgl.o sglMsgs.o
mapAdx: mapAdx.o
	$(LD) -o mapAdx mapAdx.o

memTest:  memTest.o mtlMsgs.o
	  $(LD) -o memTest memTest.o mtlMsgs.o

tstMem:	tstMem.o memTest.o mtlMsgs.o
	$(LD) -o tstMem tstMem.o memTest.o mtlMsgs.o 


vbb:	vbb.o vbbMsgs.o
	$(LD) -o vbb vbb.o vbbMsgs.o

# VXI library of routines 
niLib: $(VXI_OBJECTS)
	$(LD) -o niLib $?


@



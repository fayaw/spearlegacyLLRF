VX_TARGET_DIR = $(VX_CONFIG_DIR_YES)/$(T_A)
USR_INCLUDES += -I $(VX_CONFIG_DIR_YES)/all
USR_INCLUDES += -I $(VX_TARGET_DIR)

ifeq ($(T_A),niCpu030) 
  USR_INCLUDES += -I $(VX_TARGET_DIR)/nivxi/include
endif
ifeq ($(T_A),mv2400)
  USR_INCLUDES += -I $(VX_TARGET_DIR)/V152/Include
endif

#for compiling sys routines
USR_CPPFLAGS += -DVXWORKS -DTARGET=$(T_A)

**  Facility:  SGL - Signaling library
**
**  Abstract:
**      Set up macros for signaling messages
**
**  Author:
**	R. Claus, SLAC/PEP-II Longitudinal Feedback Project
**
**  Revision History:
**      July 20, 1993 - Created
**
** --
*/

#ifndef SGLLIB_H
#define SGLLIB_H

#ifdef VXWORKS
#  include "stdioLib.h"
#else
#  include <stdio.h>
#endif

typedef unsigned long  Status;

extern void *SGLhndl;

#define Call(fn) \
{ register Status _s_;  if ((_s_ = fn) != SUCCESS)  return (_s_); }

#define Function(function) static const char FN[] = function

#define SGL_K_MAXFNLEN  20              /* Maximum function name length */

#define SGL_Error     SGL_Status
#define SGL_ErrorFn   SGL_StatusFn

void   *SGL_Init     (FILE *, Status (*)(), void *);
void   *SGL_SysInit  (FILE *, Status (*)(), void *);
Status  SGL_Free     (void *);
Status  SGL_Output   (const char *, ...);
Status  SGL_Status   (Status, ...);
Status  SGL_StatusFn (Status, ...);
Status  SGL_Error    (Status, ...);
Status  SGL_ErrorFn  (Status, ...);
Status  SGL_Report   (FILE *, FILE *, const char *, ...);

#endif

#include <vxWorks.h>
#include <stdioLib.h>

#include "sglLib.h"
#include "busLib.h"
#include "mtlLib.h"
#include "memTest.h"
#include "genLib.h"


const char
Tst_MemFld[] = "Memory test %s failed at adx %08x",
Tst_MemTst[] = "Memory test: %s";

#define TST_MEMFLD      (Status) &Tst_MemFld
#define TST_MEMTST      (Status) &Tst_MemTst


Status TstMem (unsigned long  address,
               unsigned int   count,
               unsigned int   loop)
/*
   Description
   -----------
   Diagnostic suite for the SLAC PEP-II RF Modules.
   This function requires a resource manager to have run to assign A24
   address space to the module

   NB - Currently you must supply the address and number of words you
        want to test.  Some day we may get around to reducing this to
        just having to supply the Logical Address.  This function would
        then have to figure out where the module's A24 space is and its
        length.

   NB - At the moment this function doesn't work because MemTest
        increments the tested address.  The PEP-II RF modules have
        memories that are accessed through a single address through
        write and increment/read and decrement type hardware.

   Parameter
   ---------
     address - A24 address to start testing at
       count - Number of words to test
        loop - Number of times to loop over each test.  Zero implies once.

   Returns
   -------
   SUCCESS or some failure status.
*/
{
  /* Sanity checks */
  if (loop == 0) loop = 1;

  /* Memory tests */
  SGL_Status (TST_MEMTST, "Constant");
  if (MemTest (SPC_K_A24, address, count, SIZ_K_SHORT,
               MTL_K_CONSTANT,   0xdeadbeef, loop, TRUE))
    return (SGL_Error (TST_MEMFLD, "Constant",   address));

  SGL_Status (TST_MEMTST, "Bit");
  if (MemTest (SPC_K_A24, address, count, SIZ_K_SHORT,
               MTL_K_BIT,        0x00000001, loop, TRUE))
    return (SGL_Error (TST_MEMFLD, "Bit",        address));

  SGL_Status (TST_MEMTST, "Increment");
  if (MemTest (SPC_K_A24, address, count, SIZ_K_SHORT,
               MTL_K_INCREMENT,  0x12488241, loop, TRUE))
    return (SGL_Error (TST_MEMFLD, "Increment",  address));

  SGL_Status (TST_MEMTST, "Complement");
  if (MemTest (SPC_K_A24, address, count, SIZ_K_SHORT,
               MTL_K_COMPLEMENT, 0xa5a55a5a, loop, TRUE))
    return (SGL_Error (TST_MEMFLD, "Complement", address));

  return (SUCCESS);
}
@



#define VRB(wrd,min,fn,arg,gbl,lcl,sub) \
{TYP_K_VERB,     wrd, sizeof (wrd), min,  fn,  arg,  gbl, lcl, sub}
#define SBJ(wrd,min,fn,arg,lcl,sub)     \
{TYP_K_SUBJECT,  wrd, sizeof (wrd), min,  fn,  arg,  NIL, lcl, sub}
#define MOD(wrd,min,fn,arg,sub)         \
{TYP_K_MODIFIER, wrd, sizeof (wrd), min,  fn,  arg,  NIL, NIL, sub}

static void DoMods (DltContext  *context,
                    LIST        *list)
{
  if (list)
  {
    LipWrdNode *mod = LIP_First (list);
    while (mod) mod = (*mod->word->fn) (mod->word->arg, context, mod, NIL);
  }
}



static Status Range (DltContext     *context,
                     LipWrdNode    **subj,
                     unsigned long  *addr,
                     unsigned int   *cnt)
{
  LipWrdNode *sbj = *subj;

  /* Return context values if an error occurs */
  *subj  = NIL;
  *addr  = context->address;
  *cnt   = context->count;

  /* Decode the range */
  if (sbj)
  {
    ItemDsc item = {TYP_K_UNINITIALIZED, NULL};

    sbj = (*sbj->word->fn) (sbj->word->arg, context, sbj, &item);
    switch (item.type)
    {
    case TYP_K_NUMBER:
      *cnt  = 1;
      *addr = item.value;
      break;

    case TYP_K_ABSRNGE:
      if (sbj)
      {
        unsigned long a = item.value;
        sbj = (*sbj->word->fn) (sbj->word->arg, context, sbj, &item);
        if (item.type == TYP_K_NUMBER)
          *cnt = 1 + (item.value - a) / context->copy.size;
        else
        {
          if (item.type != TYP_K_UNKNOWN)  SGL_Error (DWN_BADTYP);
          return (FAILURE);
        }
        *addr = a;
      }
      break;

    case TYP_K_CNTDRNGE:
      if (sbj)
      {
        unsigned long a = item.value;
        sbj = (*sbj->word->fn) (sbj->word->arg, context, sbj, &item);
        if (item.type == TYP_K_NUMBER)
          *cnt = item.value;
        else if (item.type == TYP_K_UNKNOWN)
          return (FAILURE);
        else
          return (SGL_Error (DWN_BADTYP), FAILURE);
        *addr = a;
      }
      break;

    default:
      SGL_Error (DWN_BADTYP);

    case TYP_K_UNKNOWN:
      return (FAILURE);

    case TYP_K_UNINITIALIZED:
      break;
    }
  }

  *subj = sbj;

  return (SUCCESS);
}

typedef struct _SglHndl
{
  union
  {
    LIST            list;
    NODE            node;
  }                 sgl;
  int               tid;
  FILE             *log;
  Status          (*rtn) ();
  void             *arg;
  char              buffer[160];
  struct _SglHndl  *self;
} SglHndl;


static SglHndl *GetHandle (void);
static void     InitHandle (SglHndl *, FILE *, Status (*)(), void *);
static char    *BuildFmt  (char *, int, int, const char *, char *);
#ifdef VXWORKS

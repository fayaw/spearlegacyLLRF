static SglHndl  SglHandle;



void *SGL_Init (FILE    *log,
                Status (*rtn) (),
                void    *arg)
/*
   Description
   -----------
   Initialize the Signalling facility.  This routine can be run by a task in
   order to set up its own, private callback routine and buffer.  This is
   useful if there are multiple signalling tasks running.  If there is only
   one signalling task or there is no concern about signalled messages stomping
   on one another, then this routine need not be called.  Usually, this routine
   is not called from tShell, for example.
   This routine may be called multiple times to change the logging file or
   the call-back.

   Parameter
   ---------
         log - An open file stream to be added to the logging facility,
               NIL to leave existing entry unchanged.
         rtn - A call-back routine to run when the SGL routines are called,
               NIL to leave existing entry unchanged.
         arg - An argument for this routine.

   Call-back is as follows:
     (*rtn) (arg, prm0, prm1, prm2, prm3, prm4, prm5);
   Return values are ignored.

   Returns
   -------
   A SGL handle pointer
*/
{
  Status      SGL_Error (Status, void *,void *,void *,void *,void *,void *);

  SglHndl        *hndl = NIL;


  /* Initialize the signal handle if it hasn't been done yet */
  if (SglHandle.sgl.list.count == NULL)  lstInit (&SglHandle.sgl.list);

  /* If this task already has a signal handle, use it */
  if ((hndl = GetHandle ()) == &SglHandle)
  {
    /* Get a cleared SGL handle for this task */
    if ((hndl = (SglHndl *) calloc (1, sizeof (*hndl))) == NIL)
    {
      SGL_Error (SGL_NOHNDLMEM, NIL, NIL, NIL, NIL, NIL, NIL);
      return (NIL);
    }
  }

  /* Initialize the handle */
  InitHandle (hndl, log, rtn, arg);

  /* Add the task's handle to the list */
  lstAdd (&SglHandle.sgl.list, &hndl->sgl.node);

  return (hndl);
}



void *SGL_SysInit (FILE    *log,
                   Status (*rtn) (),
                   void    *arg)
/*
   Description
   -----------
   Initialize the Signalling facility system-wide defaults.  Like SGL_Init,
   this routine need not be called by a task that will signal messages.  It
   should be called by a task that is part of a group of tasks in which all
   tasks should use the same call-back routine.
   This routine may be called multiple times to change the logging file or
   the call-back.

   Parameter
   ---------
         log - An open file stream to be added to the logging facility,
               NIL to leave existing entry unchanged.
         rtn - A call-back routine to run when the SGL routines are called,
               NIL to leave existing entry unchanged.
         arg - An argument for this routine.

   Call-back is as follows:
     (*rtn) (arg, prm0, prm1, prm2, prm3, prm4, prm5);
   Return values are ignored.

   Returns
   -------
   A SGL handle pointer
*/
{
  InitHandle (&SglHandle, log, rtn, arg);

  return (&SglHandle);
}



static void InitHandle (SglHndl *hndl,
                        FILE    *log,
                        Status (*rtn) (),
                        void    *arg)
{
  Status SGL_Error (Status, void *, void *, void *, void *, void *, void *);

#ifdef VXWORKS
  /* Store the task's ID */
  hndl->tid = taskIdSelf ();

  /* Add a log file to the logging list, if there is one */
  if (log)
  {
    if (logFdAdd (fileno (log)) != OK)
    {
      SGL_Error (SGL_FILADDFLD, NIL, NIL, NIL, NIL, NIL, NIL);
      hndl->log = NIL;
    }
    else
    {
      /* Remove the previous logging stream, if there was one */
      if (hndl->log)  logFdDelete (fileno (hndl->log));

      hndl->log = log;
    }
  }
#else
  hndl->tid = NULL;
  hndl->log = NIL;
#endif

  /* Store the call-back routine particulars if one was supplied */
  if (rtn != NIL)
  {
    hndl->rtn = rtn;
    hndl->arg = arg;
  }

  /* Save a pointer the handle to try and detect corruption */
  hndl->self = hndl;
}



Status SGL_Free (void *handle)
/*
   Description
   -----------
   Free the resources used by a signal handle.  The routine should be called
   when a task is about to terminate.

   Parameters
   ----------
       handle - A SGL handle pointer from SGL_Init

   Returns
   -------
   Status
*/
{
  Status SGL_Error (Status, void *, void *, void *, void *, void *, void *);

  SglHndl *hndl = (SglHndl *) handle;


  /* Just return if no handle is supplied */
  if (hndl == NIL)  return (SUCCESS);

  /* Make sure the handle has not been corrupted */
  if (hndl->self == hndl)
  {
#ifdef VXWORKS
    /* Take the logging stream out of the log list */
    if (hndl->log) logFdDelete (fileno (hndl->log));
#endif

    /* Return if the system default handle is supplied */
    if (hndl == &SglHandle)  return (SUCCESS);

    /* Remove the entry from the list of handles */
    lstDelete (&SglHandle.sgl.list, &hndl->sgl.node);

    /* Free the memory allocated to the handle */
    free (hndl);
  }
  else
    return (SGL_Error (SGL_CRPTHNDL, hndl, NIL, NIL, NIL, NIL, NIL));

  return (SUCCESS);
}



Status SGL_Output (char       *msg,
                   void       *arg0,
                   void       *arg1,
                   void       *arg2,
                   void       *arg3,
                   void       *arg4,
                   void       *arg5)
/*
   Description
   -----------
   Function to output a message to the error log.  The message takes the
   form of a printf format string and can have up to six arguments.

   Parameter
   ---------
         msg - A pointer to a printf format string.
      arg0-5 - A set of up to six arguments satisfying the format string.

   Returns
   -------
   A pointer to the message that was reported.
*/
{
#ifdef VXWORKS
  return (LogMsg (GetHandle (), msg, msg, &arg0));
#else
  return (LogMsg (GetHandle (), msg, msg,  arg0, arg1, arg2, arg3, arg4, arg5));
#endif
}



Status SGL_Status (Status      status,
                   void       *arg0,
                   void       *arg1,
                   void       *arg2,
                   void       *arg3,
                   void       *arg4,
                   void       *arg5)
/*
   Description
   -----------
   Function to output a status message to the error log.  The message takes
   the form of a printf format string and can have up to six arguments.  The
   function name used in the message is found from the nearest global entry
   point before the return PC address.

   Parameter
   ---------
         msg - A pointer to a printf format string.
      arg0-5 - A set of up to six arguments satisfying the format string.

   Returns
   -------
   A pointer to the message that was reported.
*/
{
  SglHndl        *hndl = GetHandle ();
  char           *fmt;


  /* Build the format string to log */
  fmt = BuildFmt (hndl->buffer, sizeof (hndl->buffer),
                  *(&status - 1), NIL, (char *) status);

  /* Log the message */
#ifdef VXWORKS
  return (LogMsg (hndl, fmt, (char *) status, &arg0));
#else
  return (LogMsg (hndl, fmt, (char *) status,  arg0, arg1, arg2,
                                               arg3, arg4, arg5));
#endif
}



Status SGL_StatusFn (Status      status,
                     const char *fn,
                     void       *arg0,
                     void       *arg1,
                     void       *arg2,
                     void       *arg3,
                     void       *arg4,
                     void       *arg5)
/*
   Description
   -----------
   Function to signal a status message to the error log.  The message takes
   the form of a printf format string and can have up to six arguments.  The
   function name to use in the message is to be supplied as an argument.

   Parameter
   ---------
      status - A pointer to a printf format string.
          fn - The function name to use in the message
      arg0-5 - A set of up to six arguments satisfying the format string.

   Returns
   -------
   A status value.
*/
{
  SglHndl        *hndl = GetHandle ();
  char           *fmt;


  /* Build the format string to log */
  fmt = BuildFmt (hndl->buffer, sizeof(hndl->buffer), NULL, fn, (char *)status);

  /* Log the message */
#ifdef VXWORKS
  return (LogMsg (hndl, fmt, (char *) status, &arg0));
#else
  return (LogMsg (hndl, fmt, (char *) status, arg0, arg1, arg2,
                                              arg3, arg4, arg5));
#endif
}




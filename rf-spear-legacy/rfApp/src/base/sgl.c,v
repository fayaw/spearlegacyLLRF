Status SGL_Report (FILE       *out,
                   FILE       *log,
                   char       *msg,
                   void       *arg0,
                   void       *arg1,
                   void       *arg2,
                   void       *arg3,
                   void       *arg4,
                   void       *arg5)
/*
   Description
   -----------
   Function to report a signal by outputing a message.  The message can
   optionally go to an output stream and or a logging stream.  The message
   takes the form of a printf format string and can have up to six arguments.

   Parameter
   ---------
         out - A pointer to the output  stream or NIL if none.
         log - A pointer to the logging stream or NIL if none.
         msg - A pointer to a printf format string.
      arg0-6 - A set of up to six arguments satisfying the format string.

   Returns
   -------
   A status value (actually the address of the message reported).
*/
{
  SglHndl *hndl   = GetHandle ();
  Status   status = (Status) msg;


  if (msg)
  {
    /* Output the message on the out descriptor */
    if (out)
    {
      fprintf (out, msg, arg0, arg1, arg2, arg3, arg4, arg5);
      fflush  (out);
    }

    /* Output the message on the log descriptor */
    if (log)
    {
      fprintf (log, msg, arg0, arg1, arg2, arg3, arg4, arg5);
      fflush  (log);
    }
  }

  /* Call the call-back routine, if there is one */
  if (hndl)
  {
    if (hndl->rtn)
      status = (*hndl->rtn) (hndl->arg, msg,
                             arg0, arg1, arg2, arg3, arg4, arg5);
  }

  return (status);
}



static SglHndl *GetHandle (void)
{
#ifdef VXWORKS
  int      tid  = taskIdSelf ();
#else
  int      tid  = NULL;
#endif
  SglHndl *hndl;


  /* If the list is empty, return the default handle */
  if (SglHandle.sgl.list.count == NULL)  return (&SglHandle);

  /* Search for the handle with the task ID in it of the calling task */
  hndl = (SglHndl *) lstFirst (&SglHandle.sgl.list);
  while (hndl->tid != tid)
  {
    /* If handle was not found in the list, so return the default one */
    if ((hndl = (SglHndl *) lstNext (&hndl->sgl.node)) == NIL)
      return (&SglHandle);
  }

  return (hndl);
}



static char *BuildFmt (char       *buffer,
                       int         bufSize,
                       int         pc,
                       const char *fn,
                       char       *fmt)
{
  time_t          ts;
  int             l;


  /* Get the time and format it */
  time (&ts);
  l = strftime (buffer, bufSize, "%a %c ", localtime (&ts));

#ifdef VXWORKS
  /* Find the nearest global function name preceding the return PC */
  if (fn == NIL)
  {
    int       symValue;
    SYM_TYPE  symType;
    symFindByValueAndType (sysSymTbl, pc, &buffer[l], &symValue, &symType,
                           N_TEXT | N_EXT, N_TEXT | N_EXT);
    l = strlen (buffer);

    fn = "";
  }
#endif

  /* Build the format string */
  sprintf (&buffer[l], "%s:\n  %s\n", fn, fmt);

  return (buffer);
}



#ifdef VXWORKS
static Status LogMsg (SglHndl *hndl,
                      char    *fmt,
                      char    *msg,
                      void    *args[6])
{
  Status status = (Status) msg;


  /* Log the message */
  logMsg (fmt, (int) args[0], (int) args[1], (int) args[2],
               (int) args[3], (int) args[4], (int) args[5]);
#if 0
  printf (fmt, (int) args[0], (int) args[1], (int) args[2],
               (int) args[3], (int) args[4], (int) args[5]);
#endif

  /* Don't do the rest of this stuff if we're running at interrupt level */
  if (intContext ()) return (status);

  /* Flush the log file(s), if there is one */
  if (hndl->log)      fflush (hndl->log);
  if (SglHandle.log)  fflush (SglHandle.log);

  /* Call the task specific or system wide call-back routine, if there is one */
  if (hndl->rtn)
    status = (*hndl->rtn) (hndl->arg, msg, args[0], args[1], args[2],
                                           args[3], args[4], args[5]);
  else if (SglHandle.rtn)
    status = (*SglHandle.rtn) (SglHandle.arg, msg, args[0], args[1], args[2],
                                                   args[3], args[4], args[5]);

  return (status);
}
#else
static Status LogMsg (SglHndl *hndl,
                      char    *fmt,
                      char    *msg,
                      void    *args0,
                      void    *args1,
                      void    *args2,
                      void    *args3,
                      void    *args4,
                      void    *args5)
{
  Status status = (Status) msg;


  /* Log the message */
  logMsg (fmt, (int) args0, (int) args1, (int) args2,
               (int) args3, (int) args4, (int) args5);

  /* Flush the log file(s), if there is one */
  if (hndl->log)      fflush (hndl->log);
  if (SglHandle.log)  fflush (SglHandle.log);

  /* Call the task specific or system wide call-back routine, if there is one */
  if (hndl->rtn)
    status = (*hndl->rtn) (hndl->arg, msg, args0, args1, args2,
                                           args3, args4, args5);
  else if (SglHandle.rtn)
    status = (*SglHandle.rtn) (SglHandle.arg, msg, args0, args1, args2,
                                                   args3, args4, args5);

  return (status);
}
#endif

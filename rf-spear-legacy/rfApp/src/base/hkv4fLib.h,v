/* Definitions missing from WRS's vsbchip2.h */

/* VSBCHIP2_LIVB register definitions */
#define LIVB_LWP                 0x00      /* Lcl Wrt Post Err Int Vector     */
#define LIVB_VWP                 0x01      /* VSB Wrt Post Err Int Vector     */
#define LIVB_VSB                 0x02      /* VSB Interrupt Vector            */
#define LIVB_ATT                 0x04      /* EVSB Attention Int Vector       */
#define LIVB_VIA                 0x05      /* VSB Int Ack Complete Int Vect   */

/* VSBCHIP2_LISR register definitions */
#define LISR_LWPIF              (1 << 30)  /* Lcl Wrt Post Err Int Flag    30 */
#define LISR_VWPIF              (1 << 29)  /* VSB Wrt Post Err Int Flag    29 */
#define LISR_VSBIF              (1 << 28)  /* VSB Interrupt Flag           28 */
#define LISR_ATTIF              (1 << 26)  /* EVSB Attention Int Flag      26 */
#define LISR_VIAIF              (1 << 25)  /* VSB Int Ack Complete Int Flg 25 */

/* VSBCHIP2_LIER register definitions */
#define LIER_GIE                (1 << 15)  /* Global Interrupt Enable      15 */
#define LIER_LWPIE              (1 << 14)  /* Lcl Wrt Post Err Int Enable  14 */
#define LIER_VWPIE              (1 << 13)  /* VSB Wrt Post Err Int Enable  13 */
#define LIER_VSBIE              (1 << 12)  /* VSB Interrupt Enable         12 */
#define LIER_ATTIE              (1 << 10)  /* EVSB Attention Int Enable    10 */
#define LIER_VIAIE              (1 <<  9)  /* VSB Int Ack Complete Int Enb  9 */

/* VSBCHIP2_LILR register definitions */
#define LILR_LWP_LEVEL1       (~(1 << 24)) /* Lcl Bus Write Post Lvl 1  26-24 */
#define LILR_LWP_LEVEL2       (~(2 << 24)) /* Lcl Bus Write Post Lvl 2  26-24 */
#define LILR_LWP_LEVEL3       (~(3 << 24)) /* Lcl Bus Write Post Lvl 3  26-24 */
#define LILR_LWP_LEVEL4       (~(4 << 24)) /* Lcl Bus Write Post Lvl 4  26-24 */
#define LILR_LWP_LEVEL5       (~(5 << 24)) /* Lcl Bus Write Post Lvl 5  26-24 */
#define LILR_LWP_LEVEL6       (~(6 << 24)) /* Lcl Bus Write Post Lvl 6  26-24 */
#define LILR_LWP_LEVEL7       (~(7 << 24)) /* Lcl Bus Write Post Lvl 7  26-24 */

#define LILR_VWP_LEVEL1       (~(1 << 20)) /* VSB Write Post Err Lvl 1  22-20 */
#define LILR_VWP_LEVEL2       (~(2 << 20)) /* VSB Write Post Err Lvl 2  22-20 */
#define LILR_VWP_LEVEL3       (~(3 << 20)) /* VSB Write Post Err Lvl 3  22-20 */
#define LILR_VWP_LEVEL4       (~(4 << 20)) /* VSB Write Post Err Lvl 4  22-20 */
#define LILR_VWP_LEVEL5       (~(5 << 20)) /* VSB Write Post Err Lvl 5  22-20 */
#define LILR_VWP_LEVEL6       (~(6 << 20)) /* VSB Write Post Err Lvl 6  22-20 */
#define LILR_VWP_LEVEL7       (~(7 << 20)) /* VSB Write Post Err Lvl 7  22-20 */

#define LILR_VSB_LEVEL1       (~(1 << 16)) /* VSB Interrupt Lvl 1       18-16 */
#define LILR_VSB_LEVEL2       (~(2 << 16)) /* VSB Interrupt Lvl 2       18-16 */
#define LILR_VSB_LEVEL3       (~(3 << 16)) /* VSB Interrupt Lvl 3       18-16 */
#define LILR_VSB_LEVEL4       (~(4 << 16)) /* VSB Interrupt Lvl 4       18-16 */
#define LILR_VSB_LEVEL5       (~(5 << 16)) /* VSB Interrupt Lvl 5       18-16 */
#define LILR_VSB_LEVEL6       (~(6 << 16)) /* VSB Interrupt Lvl 6       18-16 */
#define LILR_VSB_LEVEL7       (~(7 << 16)) /* VSB Interrupt Lvl 7       18-16 */

#define LILR_ATT_LEVEL1       (~(1 <<  8)) /* EVSB Attention Inter Lvl 1 10-8 */
#define LILR_ATT_LEVEL2       (~(2 <<  8)) /* EVSB Attention Inter Lvl 2 10-8 */
#define LILR_ATT_LEVEL3       (~(3 <<  8)) /* EVSB Attention Inter Lvl 3 10-8 */
#define LILR_ATT_LEVEL4       (~(4 <<  8)) /* EVSB Attention Inter Lvl 4 10-8 */
#define LILR_ATT_LEVEL5       (~(5 <<  8)) /* EVSB Attention Inter Lvl 5 10-8 */
#define LILR_ATT_LEVEL6       (~(6 <<  8)) /* EVSB Attention Inter Lvl 6 10-8 */
#define LILR_ATT_LEVEL7       (~(7 <<  8)) /* EVSB Attention Inter Lvl 7 10-8 */

#define LILR_VIA_LEVEL1       (~(1 <<  4)) /* VSB Int Ack Complete Lvl 1  6-4 */
#define LILR_VIA_LEVEL2       (~(2 <<  4)) /* VSB Int Ack Complete Lvl 2  6-4 */

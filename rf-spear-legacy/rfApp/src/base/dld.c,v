typedef struct _DldHndl
{
  FILE           *in;
  int             swap;
#ifdef DUMP
  int             dump;
#endif
  int             verify;
  int             lderam;
  FILHDR          fileHdr;
  SCNHDR          scnHdr;
  unsigned int    offset;
  unsigned long   relAddr;
} DldHndl;

  static Status  DldFileHdr    (DldHndl *);
  static Status  DldSections   (DldHndl *);
  static Status  DldSection (DldHndl *, SCNHDR *, unsigned int, unsigned int);
  static Status  DldLoad    (unsigned short *, unsigned short *, unsigned int);
  static Status  DldVerify  (unsigned short *, unsigned short *, unsigned int);
  static void    ByteSwap   (void *, int);
  static void    WordSwap   (void *, int);
#ifdef DUMP
  static void    DumpFilHdr (FILHDR *);
  static void    DumpScnHdr (SCNHDR *);
  static void    DumpRaw    (unsigned short *, unsigned short *, unsigned int);
#endif



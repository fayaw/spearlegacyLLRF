*/

#ifndef GENLIB_H
#define GENLIB_H

#ifdef VXWORKS
#  include <vxWorks.h>
#  include <stdioLib.h>
#  include <fioLib.h>
#else
#  include <stdio.h>
#  include <stdlib.h>
#  include <malloc.h>
#endif

#define NIL   (void *)(0)
#ifndef NULL
 #define NULL           0
#endif
#define TRUE           1
#define FALSE          0
#define SUCCESS        0
#define FAILURE        1

#define Min(a,b)       ((a) < (b) ? (a) : (b))
#define Max(a,b)       ((a) > (b) ? (a) : (b))
#define lsizeof(var)   (sizeof (var) >> 2)

#ifdef DBG
#define myMalloc(size,FN) \
   ({void *__p = malloc((size));\
    printf ("%s: malloc: size %ld, %p\n", (FN), (size), __p);\
    __p;  })
#define myFree(__p,FN) \
      ({printf ("%s: free: %p\n",(FN), (__p)); \
        free((__p)); })
#else
#  define myMalloc(size,FN) malloc(size)
#  define myFree(size,FN)   free(size)
#endif

#endif /* GENLIB_H */
@

#ifndef LIPLIB_H
#define LIPLIB_H

#ifdef VXWORKS
#  include "lstLib.h"
#else
#  include "lstLib-unix.h"
#endif

typedef struct _LipWrdDsc
{
  int                   type;
  char                 *string;
  int                   size;
  int                   minLen;
  void               *(*fn) ();
  unsigned long         arg;            /* This is a cheat! Cast if pointer! */
  struct _LipWrdDsc    *gblDict;
  struct _LipWrdDsc    *lclDict;
  struct _LipWrdDsc    *sbjDict;
} LipWrdDsc;

typedef struct _LipWrdNode
{
  NODE                  links;
  LipWrdDsc            *word;
  LIST                 *list;
  LIST                 *gblLst;
  LIST                 *lclLst;
} LipWrdNode;

typedef struct _LipWord
{
  int                   length;
  unsigned int          type;
  char                 *text;
} LipWord;

#define    LIP_First(list) (void *) lstFirst ((LIST *) (list))
#define    LIP_Next(node)  (void *) lstNext  ((NODE *) (node))

LIST      *LIP_CompileLine ();
char      *LIP_FindWord    ();
LipWrdDsc *LIP_LkupWord    ();
void       LIP_Free        ();

#endif

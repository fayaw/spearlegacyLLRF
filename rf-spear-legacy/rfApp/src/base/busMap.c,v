#include "modTypes.h"

#if TARGET == FRC40 || TARGET == MV166
#  include "dspLib.h"
#elif TARGET == NICPU030
#  include "dsLib.h"
#  include "hbLib.h"
#endif
#include "genLib.h"



Status BUS_Map (void)
/*
   Description
   -----------
   This routine displays information about the modules it finds in the crate
   it is executed in.

   Parameter
   ---------

   Returns
   -------
   SUCCESS
*/
{
#if TARGET == FRC40 || TARGET == MV166
  static const char  *item[] =
  {"Slot\t\t",   "Serial #\t", "Version #\t", "Revision #\t",
   "CSRs\t\t",   "VME port\t",
   "ERAM 0\t\t", "ERAM 1\t\t", "ERAM 2\t\t",  "ERAM 3\t\t",
   "comBlk 0\t", "comBlk 1\t", "comBlk 2\t",  "comBlk 3\t"};

  Status         status;
  DspBoard      *board;
  unsigned long  csr6;
  unsigned long  brdData[DSP_K_SLOTCOUNT][14];
  unsigned long *bd;
  unsigned long *data;
  unsigned long *comBlk;
  char          *fmt;
  unsigned int   i;
  unsigned int   j;


  memset ((void *) brdData, NULL, sizeof (brdData));

  /* Find the DSP boards in the system */
  if ((status = DSP_FindEm (&board)) != SUCCESS)
    return (status);

  bd = &brdData[0][0];
  while (board->slot)
  {
    /* Find the communications blocks on the board */
    if ((status = DSP_FindComBlk (board, -1, board->comBlk)) != SUCCESS)
      return (status);

    /* Get CSR 6 and the data and communicaiont block pointers */
    csr6   = (unsigned long)   board->csrs[6];
    data   = (unsigned long *) board->data;
    comBlk = (unsigned long *) board->comBlk;

    /* Store the data */
    *bd++ = board->slot;
    *bd++ = (csr6 & DSP_M_SERIALNO) >> DSP_V_SERIALNO;
    *bd++ = (csr6 & DSP_M_VERSION)  >> DSP_V_VERSION;
    *bd++ = (csr6 & DSP_M_REVISION) >> DSP_V_REVISION;
    *bd++ = (unsigned long) board->csrs;
    *bd++ = (unsigned long) board->port;
    *bd++ = *data++;
    *bd++ = *data++;
    *bd++ = *data++;
    *bd++ = *data++;
    *bd++ = *comBlk++;
    *bd++ = *comBlk++;
    *bd++ = *comBlk++;
    *bd++ = *comBlk++;

    board++;
  }

  /* Print out the results */
  for (i = 0; i < sizeof (*brdData) / sizeof (**brdData); i++)
  {
    fmt = i < 4 ? "%s %8u" : "%s %08x";
    printf (fmt, item[i], brdData[0][i]);
    j = 1;
    while ((j < DSP_K_SLOTCOUNT) && (brdData[j][0]))
    {
      printf (fmt, " ", brdData[j][i]);
      j++;
    }
    printf ("\n");
  }

#elif TARGET == NICPU030

  static const char  *item[] =
  {"Module\t\t", "Revision #\t", "CSRs\t\t", "Lookup Table\t"};

  Status         status;
  DsBoard       *board;
  unsigned long  brdData[2][14];
  unsigned long *bd;
  unsigned long *data;
  char          *fmt;
  unsigned int   i;
  unsigned int   j;


  memset ((void *) brdData, NULL, sizeof (brdData));

  /* Find the DS boards in the system */
  if ((status = DS_FindIt (&board)) == SUCCESS)
  {
    bd = &brdData[0][0];

    *bd++ = (unsigned long) "Down Sampler";
    *bd++ = ((unsigned long) board->csrs[0] & DS_M_REVISION) >> DS_V_REVISION;
    *bd++ = (unsigned long) board->csrs;
    *bd++ = (unsigned long) board->data;
  }

  /* Find the HB boards in the system */
  if ((status = HB_FindIt (&board)) == SUCCESS)
  {
    bd = &brdData[0][0];

    *bd++ = (unsigned long) "Hold Buffer";
    *bd++ = ((unsigned long) board->csrs[0] & HB_M_REVISION) >> HB_V_REVISION;
    *bd++ = (unsigned long) board->csrs;
    *bd++ = (unsigned long) board->data;
  }

  /* Print out the results */
  for (i = 0; i < sizeof (*brdData) / sizeof (**brdData); i++)
  {
    fmt = i == 1 ? "%s %s" : "%s %08x";
    printf (fmt, item[i], brdData[0][i]);
    j = 1;
    while ((j < 2) && (brdData[j][0]))
    {
      printf (fmt, " ", brdData[j][i]);
      j++;
    }
    printf ("\n");
  }

#endif

  return (SUCCESS);
}
@



#include <stdlib.h>
#include "lstLib-unix.h"
#include "sglLib.h"    
#include "genLib.h"        



void lstInit (LIST *list)
/*
   Description
   -----------
   Initialize a list descriptor to an empty list.

   Parameter
   ---------
        list - A pointer to a list descriptor to be initialized

   Returns
   -------
   Nothing.
*/
{
  list->node.next     = NULL;
  list->node.previous = NULL;
  list->count         = 0;
}



void lstAdd (register LIST *list,
             register NODE *node)
/*
   Description
   -----------
   Add a node to the end of a list.

   Parameter
   ---------
        list - A pointer to a list descriptor to be added to
        node - A pointer to a node to be added

   Returns
   -------
   Nothing.
*/
{
  register NODE *lstn = &list->node;

  node->next     = NULL;
  node->previous = lstn->previous;

  if (lstn->previous)  {  lstn->previous->next = node;  }
  else                 {  lstn->next           = node;  }

  lstn->previous = node;
  list->count++;
}



void lstDelete (register LIST *list,
                register NODE *node)
/*
   Description
   -----------
   Delete a specified node from a list

   Parameter
   ---------
        list - A pointer to a list descriptor
        node - A pointer to a node to be deleted

   Returns
   -------
   Nothing.
*/
{
  register NODE *lstn = &list->node;

  while (lstn)
  {
    if (lstn == node)
    {
      if (lstn->previous)  {  lstn->previous->next = lstn->next;      }
      else                 {  list->node.next      = lstn->next;      }
      if (lstn->next)      {  lstn->next->previous = lstn->previous;  }
      else                 {  list->node.previous  = lstn->previous;  }
      list->count--;
      break;
    }
    lstn = lstn->next;
  }
}



int lstCount (register LIST *list)
/*
   Description
   -----------
   Report the number of nodes in a list.

   Parameter
   ---------
        list - A pointer to a list descriptor

   Returns
   -------
   Nothing.
*/
{
  return (list->count);
}



NODE *lstFirst (register LIST *list)
/*
   Description
   -----------
   Find the first node in a list.

   Parameter
   ---------
        list - A pointer to a list descriptor

   Returns
   -------
   Nothing.
*/
{
  return (list->node.next);
}



NODE *lstLast (register LIST *list)
/*
   Description
   -----------
   Get the last node in a list.

   Parameter
   ---------
        list - A pointer to a list descriptor

   Returns
   -------
   Nothing.
*/
{
  return (list->node.previous);
}



NODE *lstGet (register LIST *list)
/*
   Description
   -----------
   Delete and return the first node from a list.

   Parameter
   ---------
        list - A pointer to a list descriptor

   Returns
   -------
   Nothing.
*/
{
  register NODE *node = list->node.next;

  if (node)
  {
    list->node.next = node->next;
    if (list->node.next)  {  list->node.next->previous = NULL;  }
    else                  {  list->node.previous       = NULL;  }
    list->count--;
  }

  return (node);
}



NODE *lstNext (register NODE *node)
/*
   Description
   -----------
   Find the next node in a list.

   Parameter
   ---------
        node - A pointer to a node whose succesor is to be found

   Returns
   -------
   Nothing.
*/
{
  return (node->next);
}



void lstFree (register LIST *list)
/*
   Description
   -----------
   Free up a list.  This routine also frees up memory used for nodes.

   Parameter
   ---------
        list - A pointer to a list for which to free all nodes

   Returns
   -------
   Nothing.
*/
{
#ifdef DGB
   Function ("lstFree");
#endif
  register NODE *node = list->node.previous;
  register NODE *prev;

  /* Free nodes */
  while (node)
  {
    prev = node->previous;
    myFree (node,FN);
    node = prev;
  }

  /* Reset list header */
  list->node.next     = NULL;
  list->node.previous = NULL;
  list->count         = 0;
}

/********************************************************************************/

static long InitRecord (P2RfCf2Record  *rec,
                        int             pass)
/*
   Description
   -----------
   Verify that device support exists and use it to initialize the record.

   Parameters
   ----------
          rec - A pointer to the record
         pass - An invocation flag

   Returns
   -------
   status
*/
{
  Function ("InitRecord");

  P2RfCf2Dset  *dSet;
  long          status;


  /* If this is the first invocation, just return success */
  if (pass == 0)  return (OK);

  /* Verify existance of the device support block */
  if (!(dSet = (P2RfCf2Dset *) (rec->dset)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_dev_noDSET, (void *) rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "%s: init_record", rec->name));
    return (S_dev_noDSET);
  }

  /* Verify that the device support block has the proper routines in it */
  if ((dSet->number < 5) || (dSet->initRecord == NULL) || (dSet->action == NULL))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_dev_missingSup, (void *) rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "%s: init_record", rec->name));
    return (S_dev_missingSup);
  }

  /* Call device support to initialize record */
  if ((status = (*dSet->initRecord) (rec)))  return (status);

  /* If initialization has been successful, mark the record defined */
  rec->udf = FALSE;

  return (OK);
}

/********************************************************************************/

static long Process (P2RfCf2Record   *rec)
/*
   Description
   -----------
   Process the record.

   Parameters
   ----------
          rec - A pointer to the record structure

   Returns
   -------
   status
*/
{
  Function ("Process");

  P2RfCf2Dset    *dSet = (P2RfCf2Dset *) (rec->dset);
  long            status;
  unsigned char   pAct = rec->pact;


  if ((dSet == NULL) || (dSet->action == NULL))
  {
    char  buf[P2RF_K_BUFSIZE];

    /* Leave pact TRUE so that dbProcess doesn't keep calling */
    rec->pact = TRUE;
    recGblRecordError (S_dev_missingSup, (void *) rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "%s: action", rec->name));
    return (S_dev_missingSup);
  }

  /* Take action */
  status = (*dSet->action) (rec);

  /* If device support set pact it's beginning of async processing, so return */
  if (!pAct && rec->pact)  return (0);
  rec->pact = TRUE;

  recGblGetTimeStamp (rec);

  /* Check for alarms */
  Alarm (rec);

  /* Check event list */
  Monitor (rec);

  /* Process forward scan link record */
  recGblFwdLink (rec);

  rec->pact = FALSE;
  return (status);
}


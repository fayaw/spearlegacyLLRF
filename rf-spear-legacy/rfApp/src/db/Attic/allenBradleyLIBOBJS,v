@Link against individual allenBradley modules instead of library.
This makes it easier to debug one.
@
text
@#Special subroutines for subroutine records
LIBOBJS += $(EPICS_SITE_BIN)/subSysAb.o

#Allen Bradley Basic Support
LIBOBJS += $(EPICS_SITE_BIN)/devABBINARY.o
LIBOBJS += $(EPICS_SITE_BIN)/devABStatus.o
LIBOBJS += $(EPICS_SITE_BIN)/drvAb.o

#Allen Bradley 1746HSTP Stepper Motor Controller
LIBOBJS += $(EPICS_BASE_BIN)/steppermotorRecord.o
LIBOBJS += $(EPICS_SITE_BIN)/devSmAB1746HSTP1.o

#Allen Bradley 1771 DCM
LIBOBJS += $(EPICS_SITE_BIN)/abDcmLib

#General Purpose Device Interfaces
LIBOBJS += $(EPICS_SITE_BIN)/devIai1.o
LIBOBJS += $(EPICS_SITE_BIN)/devIao1.o

#Allen Bradley 1771IX(E and HR) - also needs devIai1
LIBOBJS += $(EPICS_SITE_BIN)/ab1771IXRecord.o

#Allen Bradley 1771IFE - also needs devIai1
LIBOBJS += $(EPICS_SITE_BIN)/ab1771IFERecord.o

#Allen Bradley 1771N Series - also needs devIai1 and devIao1
LIBOBJS += $(EPICS_SITE_BIN)/ab1771NRecord.o

#Allen Bradley 1791 Block I/O
LIBOBJS += $(EPICS_SITE_BIN)/ab1791Record.o

#Allen Bradley SLC DCM
LIBOBJS += $(EPICS_SITE_BIN)/devABSLCDCM.o









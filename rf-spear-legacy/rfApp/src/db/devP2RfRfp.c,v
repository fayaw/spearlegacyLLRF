static long DspFindComBlk (void                *drvPvt,
                           volatile DspComBlk **comBlk)
/*
   Description
   -----------
   Routine to find the location of the Communications Block in the DSP's
   external RAM.  The pointer is returned as an absolute pointer.

   Parameters
   ----------
       drvPvt - A pointer to the driver-private block
       comBlk - A location in which to return the Communications Block pointer

   Returns
   -------
   OK or ERROR if if the Block ID and/or version numbers have bad values
*/
{
  Function ("DspFindComBlk");


  /* Get the pointer to the communications block */
  if (P2RF_DspFindComBlk (drvPvt, (volatile void **) comBlk) == OK)
  {
    /* Check the comBlk ID and version numbers */
    if ((*comBlk)->blkId != DSP_K_COMBLKID)
    {
      P2RF_Printf (__FILE__, FN,
                   "DSP has different comBlk ID %u than the expected %u",
                   (*comBlk)->blkId, DSP_K_COMBLKID);
      return (ERROR);
    }
    if ((*comBlk)->vers  != DSP_K_COMVERS)
    {
      P2RF_Printf (__FILE__, FN,
                   "DSP has different comBlk version %u than the expected %u",
                   (*comBlk)->vers, DSP_K_COMVERS);
      return (ERROR);
    }
  }

  return (OK);
}



static void DspMsgCallback (RfpDspMsgBlk *blk)
/*
   Description
   -----------
   This function handles messages from the on-board DSP.  It is invoked
   by the callback facility when a DSP message interrupt is received.

   Parameters
   ----------
          blk - A pointer to the DSP message handling block

   Returns
   -------
   nothing
*/
{
  Function ("DspMsgCallback");

  P2RfRfpRecord        *rec;
  volatile DspComBlk   *comBlk = blk->comBlk;

  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;

  /* If the comBlk pointer is not yet initialized, initialize it */
  if (comBlk == NULL)
  {
    if (DspFindComBlk (blk->drvPvt, &comBlk) != OK)
    {
      P2RF_Printf (__FILE__, FN, "Could not find a valid communications block");
      return;
    }

    blk->comBlk = comBlk;
  }

  /* Decide what to do, given the message */
  switch (comBlk->dspMsg)
  {
    case CMD_K_READY:
    {
      RfpBoard             *brd    = rec->dpvt;
      void                 *drvPvt = brd->drvPvt;
      volatile DspComBlk   *comBlk = brd->dspMsgBlk.comBlk;

        if (comBlk->status == STT_OKAY)
        {
          blk->status = OK;
  	  /*
	  ** Load all of the DSP data. Since the DSP can only do one at a time,
          ** tarry a tad between sends. Since it runs ~23KHz it doesn't have to
	  ** be much.
	  */
          ActLdas(brd, drvPvt, rec);
          taskDelay (4);
          ActLdpg(brd, drvPvt, rec);
          taskDelay (4);
          ActLddo(brd, drvPvt, rec);
          taskDelay (4);
          ActLdphc(brd, drvPvt, rec);
          taskDelay (4);
          ActLdahc(brd, drvPvt, rec);
        }
        else
        {
          strncpy (rec->val, "DSP did not come up with OKAY status",
                  sizeof (rec->val));
          P2RF_Printf (__FILE__, FN, "DSP did not comup with OKAY status");
          blk->status = ERROR;
        }
    }
    break;

    case CMD_K_SVDATA:
    {
      RfpDspMsgPrm  *prm = blk->prm;
      int            startIdx = prm->index;
      int            endIdx   = EXT2IDX ((long) comBlk);
      int            begIdx   = comBlk->dspArg - RFP_A_ERAM;
      long           status;

      if ((status = P2RF_SaveDspMemory (blk->drvPvt,
                                        startIdx, begIdx, endIdx, rec->ddsf,
                                        rec->val, sizeof (rec->val))) == OK)
      {
        rec->sdst = NO_ALARM;

        /* Load the response */
        comBlk->cpuMsg = CMD_K_SVDATA; /* Done saving */

        /* Tell DSP to read our response.  OK if rctl changes underneath us */
        P2RF_WriteVme (blk->drvPvt, RFP_I_RFCTRL, rec->rctl | RFP_M_MSGTODSP);
        P2RF_WriteVme (blk->drvPvt, RFP_I_RFCTRL, rec->rctl);
      }
      else
      {
        rec->sdst = WRITE_ALARM;
        db_post_events (rec, &rec->sdst, DBE_VALUE | DBE_LOG);
      }
    }
    break;

    case CMD_K_ERROR:
      strncpy (rec->val, "DSP crashed", sizeof (rec->val));
      P2RF_Printf (__FILE__, FN, "DSP crashed with error status %h04x",
                   comBlk->status);
      blk->status = ERROR;
      break;
  }
}




static long InitRecord (P2RfRfpRecord  *rec)
/*
   Description
   -----------
   Initialize the record.  Many fields of the record are filled with data from
   the hardware.  Depending on the start-up type (cold or warm) some record
   fields will either set up the hardware or get their values from a restore
   file.  Interrupts from the board are enabled at the end of the
   initialization.

   Parameters
   ----------
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("InitRecord");

  struct vxiio   *vxiIo = NULL;
  RfpBoard       *brd;
  long            status;
  void           *drvPvt;
  char           *msg   = "RFP module initialization failed";
  int             startType;
  unsigned short  reg;


  /* rec.out must be of type VXI_IO */
  if (rec->out.type != VXI_IO)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_db_badField, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "Illegal OUT field"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return(S_db_badField);
  }

  /* Allocate the device private block */
  if ((brd = calloc (1, sizeof (*brd))) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "No memory for RFP board descriptor"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Register the module to get a driver handle */
  vxiIo = &rec->out.value.vxiio;
  if ( (status = P2RF_RegisterModule (vxiIo->flag, vxiIo->frame, vxiIo->slot,
                                    vxiIo->la,
                                    RFP_K_MODEL, RFP_K_NAME, RFP_K_DRAWING,
                                    RfpIsr, brd, RfpShutdown, brd,
                                    &drvPvt)) )
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "P2RF_RegisterModule"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (status);
  }

  /* Set up the device private block and save a pointer to it in the record */
  brd->drvPvt = drvPvt;
  brd->rec    = rec;
  rec->dpvt   = brd;

  /* Initialize the callback facility for the reset function*/
  brd->resetBlk.drvPvt = drvPvt;
  callbackSetCallback ((void*)ResetCallback, &brd->resetBlk.callback);
  callbackSetPriority (priorityHigh,         &brd->resetBlk.callback);
  callbackSetUser     (rec,                  &brd->resetBlk.callback);

  /* Initialize the callback facility for loading the DSP */
  brd->dspBlk.drvPvt = drvPvt;
  callbackSetCallback ((void*)LdDspCallback, &brd->dspBlk.callback);
  callbackSetPriority (priorityLow,          &brd->dspBlk.callback);
  callbackSetUser     (rec,                  &brd->dspBlk.callback);

  /* Load the static part of the DSP parameter block */
  {
    RfpDspPrm  *prm = &brd->dspPrm;

    prm->index = RFP_I_DSPMEM;
  }

  /* Initialize the callback facility for handleing DSP messages */
  brd->dspMsgBlk.drvPvt = drvPvt;
  brd->dspMsgBlk.comBlk = NULL;
  brd->dspMsgBlk.status = ERROR;  /* Mark as error 'till READY msg recv`d */
  callbackSetCallback ((void*)DspMsgCallback, &brd->dspMsgBlk.callback);
  callbackSetPriority (priorityHigh,          &brd->dspMsgBlk.callback);
  callbackSetUser     (rec,                   &brd->dspMsgBlk.callback);

  /* Load the static part of the DSP message parameter block */
  {
    RfpDspMsgPrm  *prm = &brd->dspMsgPrm;

    prm->index  = RFP_I_DSPMEM;

    brd->dspMsgBlk.prm = prm;
  }

  /* Initialize the callback facility for the get-RAM function */
  brd->getRamBlk.drvPvt = drvPvt;
  callbackSetCallback ((void*)GetRamCallback, &brd->getRamBlk.callback);
  callbackSetPriority (priorityLow,           &brd->getRamBlk.callback);
  callbackSetUser     (rec,                   &brd->getRamBlk.callback);

  /* Load the static part of the signal I RAM parameter block */
  {
    RfpMemPrm  *prm = &brd->sigIPrm;

    prm->id    = RFP_K_SIGIRAMID;
    prm->index = RFP_I_SIGIRAM;
  }

  /* Load the static part of the signal Q RAM parameter block */
  {
    RfpMemPrm  *prm = &brd->sigQPrm;

    prm->id    = RFP_K_SIGQRAMID;
    prm->index = RFP_I_SIGQRAM;
  }

  /* Load the static part of the cavity I RAM parameter block */
  {
    RfpMemPrm  *prm = &brd->cavIPrm;

    prm->id    = RFP_K_CAVIRAMID;
    prm->index = RFP_I_CAVIRAM;
  }

  /* Load the static part of the cavity Q RAM parameter block */
  {
    RfpMemPrm  *prm = &brd->cavQPrm;

    prm->id    = RFP_K_CAVQRAMID;
    prm->index = RFP_I_CAVQRAM;
  }

  /* Initialize the callback facility for the load-RAM function */
  brd->ldRamBlk.drvPvt = drvPvt;
  callbackSetCallback ((void*)LdRamCallback, &brd->ldRamBlk.callback);
  callbackSetPriority (priorityLow,          &brd->ldRamBlk.callback);
  callbackSetUser     (rec,                  &brd->ldRamBlk.callback);

  /* Load the static part of the DAC I RAM parameter block */
  {
    RfpMemPrm  *prm = &brd->dacIPrm;

    prm->id    = RFP_K_DACIRAMID;
    prm->index = RFP_I_DACIRAM;
  }

  /* Load the static part of the DAC Q RAM parameter block */
  {
    RfpMemPrm  *prm = &brd->dacQPrm;

    prm->id    = RFP_K_DACQRAMID;
    prm->index = RFP_I_DACQRAM;
  }

  /* Figure out the restart type -- To be determined */
  startType = P2RF_K_COLDSTART;

  /* Initialize the module and the database fields depending on startup type */
  if ( (status = InitFields (brd, P2RF_K_COLDSTART)) )
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Enable module interrupts and update the database copy */
  P2RF_ModIntEnable (drvPvt);
  P2RF_ReadVme (brd->drvPvt, RFP_I_INTCTRL, &reg);
  if (reg != rec->ictl ) {
    rec->ictl = reg;
    db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
  }
  return (OK);
}



static long InitFields (RfpBoard *brd,
                        int       initType)
/*
   Description
   -----------
   Function to initialize the fields in the database record and/or the module,
   depending on the initialization type.

   Parameters
   ----------
          brd - A pointer to the device private block
     initType - Type of initialization.

   Returns
   -------
   Status
*/
{
  /*  Function ("InitFields");*/

  P2RfRfpRecord  *rec    = brd->rec;
  void           *drvPvt = brd->drvPvt;
  unsigned short      sernHi;
  unsigned short      sernLo;
  long                status;

  /* Reset the module, if it's a cold startup.  This takes a while... */
  if (initType == P2RF_K_COLDSTART)  P2RF_ResetModule (drvPvt);

  /* Load the record fields with device data */
  P2RF_ReadVme (drvPvt, RFP_I_MANID,     &rec->mid );
  P2RF_ReadVme (drvPvt, RFP_I_MODELNO,   &rec->mtyp);
  P2RF_ReadVme (drvPvt, RFP_I_STATUS,    &rec->mstt);
  P2RF_ReadVme (drvPvt, RFP_I_OFFSET,    &rec->a24o);
  P2RF_ReadVme (drvPvt, RFP_I_ATTRIBUTE, &rec->vatt);
  P2RF_ReadVme (drvPvt, RFP_I_SERIALHI,  &sernHi   );
  P2RF_ReadVme (drvPvt, RFP_I_SERIALLO,  &sernLo   );
  rec->sern = (sernHi << 16) | sernLo;
  P2RF_ReadVme (drvPvt, RFP_I_VERSION,   &rec->vern);
  P2RF_ReadVme (drvPvt, RFP_I_SUBCLASS,  &rec->vscl);

  /* Resman wrote 0xfffc to module control register; take down software int */
  rec->mctl = rec->mstt & (RFP_M_SFTRST | RFP_M_SYSFAILINH | RFP_M_A24A32);
  
  /* Get hardware and firmware version (lower nibble) from the version register */
  rec->verh = P2RF_HWVER( rec->vern );
  rec->verf = P2RF_FWVER( rec->vern );

  /* Write some registers if we're doing a grounds-up initialization */
  if (initType == P2RF_K_COLDSTART)    status = ColdInit (brd, rec);
  else                                 status = WarmInit (brd, rec);


  /* Update the database copy of the RFP Status and control registers */
  P2RF_ReadVme (drvPvt, RFP_I_STATUS, &rec->mstt);
  db_post_events (rec, &rec->rstt, DBE_VALUE | DBE_LOG);
  P2RF_ReadVme  (drvPvt, RFP_I_CONTROL,  &rec->mctl);

  /* Update the database copy of the RFP Status and control registers */
  P2RF_ReadVme (drvPvt, RFP_I_RFSTAT, &rec->rstt);
  db_post_events (rec, &rec->rstt, DBE_VALUE | DBE_LOG);
  P2RF_ReadVme (drvPvt, RFP_I_RFCTRL, &rec->rctl);

  /* Update the readback for the feedback signal mux */
  rec->sfmx = FBSIGMUX_READ(rec);
  db_post_events (rec, &rec->sfmx, DBE_VALUE | DBE_LOG);

  /* Update the current state of the DACs Output */
  rec->sdac = (rec->mctl & (RFP_V_DACINJPT-1)) | (rec->rctl & RFP_V_DACSON);
  db_post_events (rec, &rec->sdac, DBE_VALUE | DBE_LOG);
  /*
  |  Reading the Interrupt Status Register clears the outstanding Software
  |  Interrupt Status bit, but does not clear the pending interrupt.  Thus
  |  reading the register here would confuse the ISR when interrupts are
  |  enabled and the pending software interrupt is taken: the ISR would
  |  not be able to find the source of the interrupt.
  */

  return (status);
}



static long ColdInit (RfpBoard      *brd,
                      P2RfRfpRecord *rec)
/*
   Description
   -----------
   Initialization function to run when starting up from scratch.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("ColdInit");

  register void  *drvPvt = brd->drvPvt;
  unsigned short  reg;
  long            status;

  /* Don't allow database access to the interrupt level */
  reg = (P2RF_K_INTLEVEL << RFP_V_INTLEVEL) & RFP_M_INTLEVEL;

  /* Initialize the Interrupt Control Register from the database */
  reg = ~(reg | ((rec->imsk << RFP_V_INTSELECT) & RFP_M_INTSELECT));
  P2RF_WriteVme (drvPvt, RFP_I_INTCTRL,reg );
  if ( rec->oimk != rec->imsk ) {
    rec->oimk = rec->imsk;
  }
  if ( rec->ictl != reg ) {
    rec->ictl = reg;
    db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
  }

  /* Verify that the Interrupt Control Register data latched */
  P2RF_ReadVme (drvPvt, RFP_I_INTCTRL, &reg);
  if ( rec->ictl != reg ) {
    epicsPrintf ("%s - Interrupt Control register readback error: wrt %04x, rd %04x, xor %04x\n",
                     FN, reg, rec->ictl, reg ^ rec->ictl);
    strncpy (rec->val, "Interrupt Control register readback error",
             sizeof (rec->val));
  }

  /* Get module into LOAD state via a RESET, pulse the serial link error and rf falut reset bits */
  reg = (RFP_K_RESET << RFP_V_MODE) | RFP_M_SERLNKRST | RFP_M_RFFLTRST;
  P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, reg);
  P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, RFP_K_LOAD << RFP_V_MODE);

  /* Load and start DSP executable */
  {
    RfpDspPrm    *prm = &brd->dspPrm;

    /* Reset the DSP */
    P2RF_ReadVme  (drvPvt, RFP_I_RFCTRL, &reg);
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, reg & ~RFP_M_NOTDSPRST);

    /* Load the DSP */
    if ((status = P2RF_LoadDsp (drvPvt, prm->index, rec->dspe, TRUE,
                                rec->val, sizeof (rec->val))) == OK)
    {
      rec->dstt = NO_ALARM;
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (ERROR, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s, file = %s, status = %08x",
                                       "P2RF_LoadDsp", rec->dspe, status));
      rec->dstt = UDF_ALARM;
    }
  }

  /* Clear any alarm status on the data save file */
  rec->sdst = NO_ALARM;

  /* Initialize all octal DACs to their DB values */
  {
    unsigned short  idx;
    unsigned short  last=RFP_I_CLCQQ;
    short          *dac = &rec->c1ii;
    
    if ( rec->verh >= RFP_K_VER2VERN ) last=RFP_I_MDRV;
    for (idx = RFP_I_CCC1II; idx <= last; dac++, idx++)
    {
      P2RF_WriteVme (drvPvt, idx, ((*dac) + RFP_K_OCTDACOS) << RFP_V_OCTDAC);
    }
  }

  /* Load the DAC I and Q memories */
  {
    RfpMemPrm    *prm = &brd->dacIPrm;

    prm->count             = RFP_K_DACRAMCNT;
    brd->ldRamBlk.abortFlg = FALSE;

    /* Load the table */
    if ((status = P2RF_LoadTblFile (drvPvt, prm->id, prm->index,
                                    rec->dirf, prm->count,
                                    &brd->ldRamBlk.abortFlg,
                                    rec->val, sizeof (rec->val))) == OK)
    {
      rec->dist = NO_ALARM;
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed, file = %s",
                                       "P2RF_LoadTblFile", rec->dirf));
      rec->dist = UDF_ALARM;
    }
  }

  {
    RfpMemPrm    *prm = &brd->dacQPrm;

    prm->count             = RFP_K_DACRAMCNT;
    brd->ldRamBlk.abortFlg = FALSE;

    /* Load the table */
    if ((status = P2RF_LoadTblFile (drvPvt, prm->id, prm->index,
                                    rec->dqrf, prm->count,
                                    &brd->ldRamBlk.abortFlg,
                                    rec->val, sizeof (rec->val))) == OK)
    {
      rec->dqst = NO_ALARM;
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed, file = %s",
                                       "P2RF_LoadTblFile", rec->dqrf));
      rec->dqst = UDF_ALARM;
    }
  }

  /* Initialize the RF Processing module's control register  */
  reg  = (rec->dle  << RFP_V_DIRLPENB)  & RFP_M_DIRLPENB;
  reg |= (rec->cle  << RFP_V_CMBLPENB)  & RFP_M_CMBLPENB;
  reg |= (rec->rle  << RFP_V_RIPLPENB)  & RFP_M_RIPLPENB;
  reg |= (rec->csmx << RFP_V_CAVSELMUX) & RFP_M_CAVSELMUX;  
  FeedbackSigMux( rec, &reg, &rec->mctl ); /* Set feedback signal mux   */

 /* Get the operating mode */
  switch (rec->mode)
  {
    case rfpReset:
    case rfpLoad:
      reg |= rec->mode << RFP_V_MODE;
      break;

    case rfpRun:
      reg |= rec->mode << RFP_V_MODE;
      if (rec->dacs)  reg |= RFP_M_DACSOUT   << RFP_V_MODE;
      if (rec->ssct)  reg |= RFP_M_SGLSHTCNT << RFP_V_MODE;
      break;

    default:
      reg |= RFP_K_LOAD << RFP_V_MODE;
      break;
  }

  /* Potentially set Dacs */
  if (rec->dinj)  rec->mctl |= RFP_M_DACINJPT;

  /* Boot the DSP */
  if (rec->dstt == NO_ALARM)  reg |= RFP_M_NOTDSPRST;

  /* Update the module and the database */
  rec->rctl = reg;
  P2RF_WriteVme (drvPvt, RFP_I_RFCTRL,rec->rctl);

  /* Update bits A2 of the feedback mux setting
   * which is found in the Control Register. 
   * Bits A0 and A1 are found in the RF Control Register 
   * on version 1 only.
   */ 
  P2RF_WriteVme (drvPvt, RFP_I_CONTROL, rec->mctl);

  return (OK);
}



static long WarmInit (RfpBoard       *brd,
                      P2RfRfpRecord  *rec)
/*
   Description
   -----------
   Initialization routine to run when the module is still running
   satisfactorily.  This function will (when it is written) bring
   the EPICS database in synch with the module.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  {
    unsigned char mode[] = {0, 1, 2, 2, 0, 1, 2, 2};
    unsigned char dacs[] = {0, 0, 0, 0, 0, 0, 1, 1};
    unsigned char ssct[] = {0, 0, 0, 1, 0, 0, 0, 1};
    unsigned int  state  = (rec->rctl & RFP_M_MODE) >> RFP_V_MODE;

    rec->mode = mode[state];
    rec->dacs = dacs[state];
    rec->ssct = ssct[state];
    rec->dinj = (rec->mctl & RFP_M_DACINJPT) >> RFP_V_DACINJPT;
  }

  return (OK);
}



static long Action (P2RfRfpRecord    *rec)
/*
   Description
   -----------
   This is the action routine for the RFP.  It handles the several states
   that the module can be in.  The module's state can be changed by modifying
   the .MODE field of the record.

   Additionally, an asynchronous module reset mechanism implemented.  This
   feature toggles the software reset line on the VXI interface chip.  Since it
   takes a while (on the order of a second) for the reset to complete, the
   module must not be touched during its assertion.  To implement this, the
   record is processed asynchronously.  When the reset completes, the database
   fields are updated with the current state of the module

   Parameters
   ----------
          rec - A pointer to the record structure

   Returns
   -------
   0 or 2 for successful returns, else a status */
{
  Function ("Action");


  RfpBoard       *brd    = NULL;
  void           *drvPvt;
  unsigned short  mctl;
  unsigned short  rctl;
  RfpState        state  = rfpInvalid;
  unsigned short  reg;
  unsigned short  rstt;
  unsigned short  sdac;
  unsigned short  mstt;

  /* If initialization failed let the system know */
  if ((brd = rec->dpvt) == NULL)  return (ERROR);
  drvPvt = brd->drvPvt;

  /* If processing was invoked by an interrupt, handle it */
  if (brd->intPrc)
  {
    /* Update client value of interrupt status field */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }

    /* Don't loose invocation count on multiple interrupts */
    brd->intPrc--;

    /* Update the database copy of the RF Module status register */
    P2RF_ReadVme (drvPvt, RFP_I_RFSTAT,  &rec->rstt);
    db_post_events (rec, &rec->rstt, DBE_VALUE | DBE_LOG);

    return (0);
  }

  /* Initialize the message buffer if we're not doing completion processing */
  if (!rec->pact)  strncpy (rec->val, "Success", sizeof (rec->val));

  /* If requested, do a "software reset" on the module */
  if (rec->mrst) {
     return (SpawnReset (rec, &brd->resetBlk));
  }

  /* If operator disabled interrupts update interrupt status DB field */
  P2RF_ReadVme (brd->drvPvt, RFP_I_INTCTRL, &reg);
  if ((reg & RFP_M_INTSELECT) == RFP_M_INTSELECT)
  {
    P2RF_ReadVme (brd->drvPvt, RFP_I_INTSTAT, &rec->istt);
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
  }
  if ( reg != rec->ictl ) {
     rec->ictl = reg;
     db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
  }


  /* Let the operator acknowledge that the interrupts have been seen */
  if (rec->iack)
  {
    rec->istt &= ~rec->iack;            /* Take only requested bits down */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
    rec->iack = 0;
    db_post_events (rec, &rec->iack, DBE_VALUE | DBE_LOG);
  }

  /* Update the interrupt control register if there was a change request */
  if (rec->imsk != rec->oimk)
  {
    rec->oimk = rec->imsk;
    rec->ictl = (rec->ictl & ~RFP_M_INTSELECT) |
      ((~rec->imsk << RFP_V_INTSELECT) & RFP_M_INTSELECT);
    printf("IMSK Change: New=0x%4.4x (%hd) Old=0x%4.4x (%hd) ICTL 0x%4.4x\n",
             rec->imsk,rec->imsk,rec->oimk,rec->oimk,reg);
    P2RF_WriteVme (drvPvt, RFP_I_INTCTRL, rec->ictl);
    db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);

   /* Verify that the Interrupt Control Register data latched */
    P2RF_ReadVme (drvPvt, RFP_I_INTCTRL, &reg);
    if ( rec->ictl != reg ) {
      epicsPrintf ("%s - Interrupt Control register readback error: wrt %04x, rd %04x, xor %04x\n",
                     FN, reg, rec->ictl, reg ^ rec->ictl);
      strncpy (rec->val, "Interrupt Control register readback error",
                sizeof (rec->val));
    }
  }

  /* Get the current state of the module */
  P2RF_ReadVme (drvPvt, RFP_I_RFCTRL,  &rctl);
  P2RF_ReadVme (drvPvt, RFP_I_CONTROL, &mctl);
  mctl &= (RFP_M_SYSFAILINH | RFP_M_SFTINT | RFP_M_A24A32);

  /* Potentially modify the RF Control Register */
  rctl &= ~(RFP_M_MODE      | RFP_M_RFENB    | RFP_M_OPMODE   |
            RFP_M_DIRLPENB  | RFP_M_CMBLPENB | RFP_M_RIPLPENB |
            RFP_M_CAVSELMUX | RFP_M_FBSIGMUX);

  /* Check if the RF Control register needs updating */
  {
    RfpState      mode[] = {rfpReset, rfpLoad, rfpRun, rfpRun,
                            rfpReset, rfpLoad, rfpRun, rfpRun};
    unsigned int  iState = (rctl & RFP_M_MODE) >> RFP_V_MODE;

    /* Potentially modify the RF Control Register */
    rctl &= ~(RFP_M_MODE      | RFP_M_RFENB    | RFP_M_OPMODE   |
              RFP_M_DIRLPENB  | RFP_M_CMBLPENB | RFP_M_RIPLPENB |
              RFP_M_CAVSELMUX | RFP_M_FBSIGMUX);

    /* Potentially select a new operating mode */
    switch (rec->mode)
    {
      case rfpReset:
      case rfpLoad:
        iState = rec->mode;
        break;

      case rfpRun:
        iState = rec->mode;
        if (rec->dacs)  iState |= RFP_M_DACSOUT;
        if (rec->ssct)  iState |= RFP_M_SGLSHTCNT;
        break;

      default:
        state = rfpInvalid;
        break;
    }
    rctl      |= iState << RFP_V_MODE;
    state      = mode[iState];
 
    /* Potentiall set Dacs Ouptput type */
    if (rec->dinj) mctl |= RFP_M_DACINJPT;

    /* Potentially set the anlog ripple loop */
    if (rec->rlon) mctl |= RFP_M_RLON;

    /* Potentially select feedback signal mux */
    FeedbackSigMux( rec,&rctl,&mctl );

    /* Potentially enable RF the ripple loop, integral and lead compensation */
    if (rec->rfoo)
    {
      rctl                |= RFP_M_RFENB;
      if (rec->rle)  rctl |= RFP_M_RIPLPENB;
    }
    if (rec->ice)    mctl |= RFP_M_INTCOMP;

    if (!rec->lce)   mctl |= RFP_M_LEADCOMP;

    /* Select the operating mode */
    if (rec->tnop)   rctl |= RFP_M_OPMODE;

    /* Enable the direct and comb loop */
    if (rec->dle)    rctl |= RFP_M_DIRLPENB;
    if (rec->cle)    rctl |= RFP_M_CMBLPENB;

    /* Select a different cavity and/or feedback signal */
    rctl |= (rec->csmx << RFP_V_CAVSELMUX) & RFP_M_CAVSELMUX;
    rctl |= (rec->fsmx << RFP_V_FBSIGMUX)  & RFP_M_FBSIGMUX;

    /* Update the module and the database versions of RF Control register*/
    if (rctl != rec->rctl)
    {
      P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rctl);
      P2RF_ReadVme  (drvPvt, RFP_I_RFCTRL, &rec->rctl);
      db_post_events (rec, &rec->rctl, DBE_VALUE | DBE_LOG);

      /* Make sure that the register changed to what we set it to */
      if (rctl != rec->rctl)
      {
        epicsPrintf ("%s - RF Control register readback error: wrt %04x, rd %04x, xor %04x\n",
                     FN, rctl, rec->rctl, rctl ^ rec->rctl);
        strncpy (rec->val, "RF Control register readback error",
                 sizeof (rec->val));
      }
    }

    /* Update the module and the database versions of Module Control register*/
    if (mctl != rec->mctl)
    {
      rec->mctl = mctl;
      P2RF_WriteVme (drvPvt, RFP_I_CONTROL, rec->mctl);
      db_post_events (rec, &rec->mctl, DBE_VALUE | DBE_LOG);

      /* Update the database version of the Module Status Register */
      P2RF_ReadVme (drvPvt, RFP_I_STATUS, &rec->mstt);
      db_post_events (rec, &rec->mstt, DBE_VALUE | DBE_LOG);
    }

    /* Update the database Dacs status field */
    sdac = (rec->mctl & (RFP_V_DACINJPT-1)) | (rec->rctl & RFP_V_DACSON);
    if (sdac != rec->sdac)
    {
       rec->sdac = sdac;
       db_post_events (rec, &rec->sdac, DBE_VALUE | DBE_LOG);
    }  

  }

  /* Reset Serial Link, Memory Collision and RF Faults */
  if (rec->rffr)
  {
    rec->rffr = 0;

    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL,
                   rec->rctl | RFP_M_SERLNKRST | RFP_M_RFFLTRST);
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl);
  }

  /* Update the database copy of the RF Module status register */
  P2RF_ReadVme (drvPvt, RFP_I_RFSTAT,  &rstt);
  if ( rstt != rec->rstt ) 
  {
    rec->rstt = rstt;
    db_post_events (rec, &rec->rstt, DBE_VALUE | DBE_LOG);
  }

  /* Update the database copy of the Status register */
  P2RF_ReadVme (drvPvt, RFP_I_STATUS, &mstt );
  mstt &= RFP_M_STATUS;
  if ( mstt != rec->mstt ) 
  {
    rec->mstt = mstt;
    db_post_events (rec, &rec->mstt, DBE_VALUE | DBE_LOG);
  }

  /* Read the current state of the feedback signal mux
   * and then update the dtabase copy 
   */
  if ( FBSIGMUX_READ(rec) != rec->sfmx ) 
  {
    rec->sfmx = FBSIGMUX_READ(rec);
    db_post_events (rec, &rec->sfmx, DBE_VALUE | DBE_LOG);
  }

  /* Process the request to stop state machine data taking in continuous mode */
  if (rec->scdt)
  {
    P2RF_WriteVme (drvPvt, RFP_I_SMSTOPDT, NULL);
    rec->scdt = 0;
  }

  /* Load and start DSP executable */
  if (rec->ldsp)  return (SpawnLdDsp (rec, &rec->ldsp, &brd->dspBlk,
                                      &brd->dspPrm, rec->dspe, &rec->dstt));

  /* Load all octal DACs, if requested */
  if (rec->lod)
  {
    unsigned short        idx;
    unsigned short        last=RFP_I_CLCQQ;
    short                *dac    = &rec->c1ii;
    short                 val;
    short                 chk;

    if ( rec->verh >= RFP_K_VER2VERN ) last = RFP_I_MDRV;
    for (idx = RFP_I_CCC1II; idx <= last; dac++, idx++)
    {
      val = ((*dac) + RFP_K_OCTDACOS) << RFP_V_OCTDAC;

      octal_dac=1;
      P2RF_WriteVme (drvPvt, idx,  val);
      P2RF_ReadVme  (drvPvt, idx, (unsigned short *) &chk);
      octal_dac=0;
      if (val != chk)
      {
        epicsPrintf ("%s, Octal DAC readback error: idx %hd, wrt %hd, rd %hd, xor %hd\n",
                     FN, idx, val, chk, val ^ chk);
        strncpy (rec->val, "Octal DAC readback error", sizeof (rec->val));
      }
    }
    rec->lod = 0;
    db_post_events (rec, &rec->lod, DBE_VALUE | DBE_LOG);	/* for rf_calib.st */
  }

  /*
  ** Check for requests to load various DSP Ripple loop data. All data must 
  ** be loaded after the DSP is initialized, hence we make them separate
  ** routines which can also be called when the CMD_K_READY message comes
  ** back from the DSP after it's been booted.
  */

  if (rec->ldas)          /* Load DSP amplitude setpoint */
  {
    ActLdas(brd, drvPvt, rec);
    rec->ldas = 0;
  }

  if (rec->ldpg)          /* Load DSP Phase gain */
  {
    ActLdpg(brd, drvPvt, rec);
    rec->ldpg = 0;
  }

  if (rec->dlod)          /* Load DSP DAC offsets */
  {
    ActLddo(brd, drvPvt, rec);
    rec->dlod = 0;
    db_post_events (rec, &rec->dlod, DBE_VALUE | DBE_LOG);	/* for rf_calib.st */
  }

  if (rec->ldpc)          /* Load DSP Phase Harmonic coefficients */
  {
    ActLdphc(brd, drvPvt, rec);
    rec->ldpc = 0;
  }

  if (rec->ldac)          /* Load DSP Amplitude Harmonic coefficients */
  {
    ActLdahc(brd, drvPvt, rec);
    rec->ldac = 0;
  }

  if (rec->gerp)          /* Get Ripple run-time parameters */
  {
    ActGerp(brd, drvPvt, rec);
    rec->gerp = 0;
  }

  /* Don't attempt to get or load RAMs if wrong module state */
  if (state != rfpLoad)
  {
    char *msg = NULL;

    if ((rec->gsir) || (rec->gsqr))
    {
      msg = "Get Signal RAM: Module not in LOAD mode";
      if (rec->gsir)
      {
        rec->gsir = 0;
        rec->sist = WRITE_ALARM;
        db_post_events (rec, &rec->sist, DBE_VALUE | DBE_LOG);
      }
      if (rec->gsqr)
      {
        rec->gsqr = 0;
        rec->sqst = WRITE_ALARM;
        db_post_events (rec, &rec->sqst, DBE_VALUE | DBE_LOG);
      }
    }
    if ((rec->gcir) || (rec->gcqr))
    {
      msg = "Get Cavity RAM: Module not in LOAD mode";
      if (rec->gcir)
      {
        rec->gcir = 0;
        rec->cist = WRITE_ALARM;
        db_post_events (rec, &rec->cist, DBE_VALUE | DBE_LOG);
      }
      if (rec->gcqr)
      {
        rec->gcqr = 0;
        rec->cqst = WRITE_ALARM;
        db_post_events (rec, &rec->cqst, DBE_VALUE | DBE_LOG);
      }
    }
    if ((rec->ldir) || (rec->ldqr))
    {
      msg = "Load DAC RAM: Module not in LOAD mode";
      if (rec->ldir)
      {
        rec->ldir = 0;
        rec->dist = WRITE_ALARM;
        db_post_events (rec, &rec->dist, DBE_VALUE | DBE_LOG);
      }
      if (rec->ldqr)
      {
        rec->ldqr = 0;
        rec->dqst = WRITE_ALARM;
        db_post_events (rec, &rec->dqst, DBE_VALUE | DBE_LOG);
      }
    }

    if (msg)  strncpy (rec->val, msg, sizeof (rec->val));
    return (0);
  }

  /* Process requests to read out the module's signal I or Q RAM */
  if (rec->gsir)  return (SpawnGetRam (rec, &rec->gsir, &brd->getRamBlk,
                                       &brd->sigIPrm, rec->rmsz, rec->sirf,
                                       &rec->sist));
  if (rec->gsqr)  return (SpawnGetRam (rec, &rec->gsqr, &brd->getRamBlk,
                                       &brd->sigQPrm, rec->rmsz, rec->sqrf,
                                       &rec->sqst));

  /* Process requests to read out the module's cavity I or Q RAM */
  if (rec->gcir)  return (SpawnGetRam (rec, &rec->gcir, &brd->getRamBlk,
                                       &brd->cavIPrm, rec->rmsz, rec->cirf,
                                       &rec->cist));
  if (rec->gcqr)  return (SpawnGetRam (rec, &rec->gcqr, &brd->getRamBlk,
                                       &brd->cavQPrm, rec->rmsz, rec->cqrf,
                                       &rec->cqst));

  /* Process requests to load the module's DAC I or Q RAM */
  if (rec->ldir)  return (SpawnLdRam  (rec, &rec->ldir, &brd->ldRamBlk,
                                       &brd->dacIPrm, rec->dirf,
                                       &rec->dist));
  if (rec->ldqr)  return (SpawnLdRam  (rec, &rec->ldqr, &brd->ldRamBlk,
                                       &brd->dacQPrm, rec->dqrf,
                                       &rec->dqst));

  return (0);
}


/**
 ** Action routines to load various DSP memories. Called on demand from
 ** a display and on startup after the DSP has been booted and is ready
 ** to rock 'n roll.
 */

/*
** Common routine to insure DSP is alive and well.
*/
static int CheckDspOK(long status)
{
  int retval = TRUE;  /* Assume all will be well */

  if (status != OK)
  {
     epicsPrintf ("Rfp module DSP error. Can't load parameter(s).\n");
     retval = FALSE;
  }
  return retval;
}
/*
** Load Amplitude setpoint
*/
static void  ActLdas         (RfpBoard *brd, void *drvPvt, 
                              P2RfRfpRecord  *rec)
{
  volatile DspComBlk   *comBlk = brd->dspMsgBlk.comBlk;

  /*
  ** The DSP expects the setpoint in Q13 format. Q13 format is a fixed point
  ** 16 bit number with 13 bits after the decimal. We limit check through
  ** an analog output and so assume it's in range 
  */

  short  amsp = (short) (rec->amsp * (float) (1 << 13)); /* Q13 */

  if (CheckDspOK(brd->dspMsgBlk.status))
  {
    comBlk->cpuMsg = CMD_K_AMSP;
    comBlk->cpuArg = amsp;       /* The arg is the value */

    /* Tell DSP to read our message */
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl | RFP_M_MSGTODSP);
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl);
  }
  return;
}
/*
** Load Phase Gain
*/
static void  ActLdpg         (RfpBoard *brd, void *drvPvt,
                              P2RfRfpRecord  *rec)
{
  volatile DspComBlk   *comBlk = brd->dspMsgBlk.comBlk;
  short  phsg = (short) (rec->phsg * (float) (1 << 14)); /* Q14 */

  if (CheckDspOK(brd->dspMsgBlk.status))
  {
    comBlk->cpuMsg = CMD_K_PHSG;
    comBlk->cpuArg = phsg;         /* The arg is the value */

    /* Tell DSP to read our message */
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl | RFP_M_MSGTODSP);
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl);
  }
  return;
}
/*
** Load DSP Klystron Modulator DAC offsets 
*/
static void  ActLddo       (RfpBoard *brd, void *drvPvt,
                            P2RfRfpRecord  *rec)
{
  volatile DspComBlk   *comBlk = brd->dspMsgBlk.comBlk;

  if (CheckDspOK(brd->dspMsgBlk.status))
  {
    P2RF_WriteVme (drvPvt, RFP_I_DSPMEM + 0, rec->kmii << 4);
    P2RF_WriteVme (drvPvt, RFP_I_DSPMEM + 1, rec->kmiq << 4);
    P2RF_WriteVme (drvPvt, RFP_I_DSPMEM + 2, rec->kmqi << 4);
    P2RF_WriteVme (drvPvt, RFP_I_DSPMEM + 3, rec->kmqq << 4);

    comBlk->cpuMsg = CMD_K_DACO;
    comBlk->cpuArg = DSP_A_ERAM;

    /* Tell DSP to read our message */
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl | RFP_M_MSGTODSP);
    P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl);
  }
  return;
}
/*
** Load Phase Harmonic Coefficients.
*/
static void  ActLdphc         (RfpBoard *brd, void *drvPvt, 
                              P2RfRfpRecord  *rec)
{
  Function ("ActLdphc");        /* Our name for error msg */
  volatile DspComBlk   *comBlk = brd->dspMsgBlk.comBlk;
  long     status;              /* Read file status */
  char     loaderr[40];         /* Error msg from ReadConstsFile */
  short    consts[NUMHARMS*4];  /* Number of harmonics currently supported */

  rec->pcst = UDF_ALARM;
  db_post_events (rec, &rec->pcst, DBE_VALUE | DBE_LOG);

  if (CheckDspOK(brd->dspMsgBlk.status))
  {
    if ((status = P2RF_ReadConstsFile (drvPvt, RFP_K_PHARMID,  rec->pcdf,
                                     NUMHARMS*4, consts,
                                     loaderr, sizeof (loaderr), 1)) == OK)
    {
      P2RF_LoadConsts (drvPvt, consts, NUMHARMS*4, RFP_I_DSPMEM);

      comBlk->cpuMsg = CMD_K_PHARM;
      comBlk->cpuArg = DSP_A_ERAM;
      comBlk->comLen = NUMHARMS;
      /* Tell DSP to read our message */
      P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl | RFP_M_MSGTODSP);
      P2RF_WriteVme (drvPvt, RFP_I_RFCTRL, rec->rctl);
      rec->pcst = NO_ALARM;
      db_post_events (rec, &rec->pcst, DBE_VALUE | DBE_LOG);
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
          P2RF_Sprintf (buf, __FILE__, FN,
          "%s failed - id = %s, msg is: %s file = %s",
                                       "P2RF_ReadConstsFile",
                                       RFP_K_PHARMID, loaderr, rec->pcdf));
      rec->pcst =  UDF_ALARM;
    }
  }
  return;
}

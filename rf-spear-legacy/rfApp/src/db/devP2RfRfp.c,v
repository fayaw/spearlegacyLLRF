   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the record block
          prm - A pointer to the record parameter block
       blkCnt - Number of blocks of record buffer to record
         file - The file to record the record buffer in
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnGetRam");

  char  buf[P2RF_K_BUFSIZE];


  if (!rec->pact)
  {
    sprintf (buf, "Get %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val,  DBE_VALUE | DBE_LOG);
    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before get-history completes */
    rec->pact = TRUE;

    /* Save block count and file name in parameter block and reset abort flag */
    prm->count    = blkCnt < RFP_K_RAMBLKCNT ? blkCnt : RFP_K_RAMBLKCNT;
    prm->file     = file;
    blk->abortFlg = FALSE;

    /* Point the RAM block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - file = %s",
                                       "P2RF_RecordMemory", prm->file));
      *stat = READ_ALARM;
    }
    else
    {
      sprintf (buf, "Get %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));

      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}



static void GetRamCallback (RfpRamBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to read one of the module's RAMs.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the get-history block

   Returns
   -------
   nothing
*/
{
  /* Function ("GetRamCallback"); */

  P2RfRfpRecord    *rec;
  struct rset      *rSet;
  RfpMemPrm        *prm = blk->prm;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Preload the state machine address counter */
  P2RF_WriteVme (blk->drvPvt, RFP_I_SMPRELD, NULL);

  /* Read the history memory and record it */
  blk->status = P2RF_RecordMemory (blk->drvPvt, prm->id, prm->index,
                                   prm->count, prm->file, &blk->abortFlg,
                                   rec->val, sizeof (rec->val));

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}



static long SpawnLdRam (P2RfRfpRecord  *rec,
                        unsigned char  *request,
                        RfpRamBlk      *blk,
                        RfpMemPrm      *prm,
                        char           *file,
                        unsigned short *stat)
/*
   Description
   -----------
   This function initiates and completes the loading of the RAM blocks
   on the module.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the reset block
          prm - A pointer to the RAM parameter block
         file - The file that contains the coefficients to load
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnLdRam");

  char  buf[P2RF_K_BUFSIZE];


  if (!rec->pact)
  {
    sprintf (buf, "Load %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val,  DBE_VALUE | DBE_LOG);
    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before load-table completes */
    rec->pact = TRUE;

    /* Save block count and file name in parameter block and reset abort flag */
    prm->count    = RFP_K_DACRAMCNT;
    prm->file     = file;
    blk->abortFlg = FALSE;

    /* Point the RAM block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_LoadTblFile", prm->id, prm->file));
      *stat = WRITE_ALARM;
    }
    else
    {
      sprintf (buf, "Load %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));

      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}



static void LdRamCallback (RfpRamBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to load one of the module's RAMs.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the load-RAM block

   Returns
   -------
   nothing
*/
{
  /* Function ("LdRamCallback"); */

  P2RfRfpRecord    *rec;
  struct rset      *rSet;
  RfpMemPrm        *prm = blk->prm;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Load the RAM */
  blk->status = P2RF_LoadTblFile (blk->drvPvt, prm->id, prm->index,
                                  prm->file, prm->count, &blk->abortFlg,
                                  rec->val, sizeof (rec->val));

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}


static void FeedbackSigMux (P2RfRfpRecord *rec, unsigned short *rctl, unsigned short *mctl)
/*
   Description
   -----------
   This function sets the feedback signal mux based on the database field FSMX. The feedback
   signal mux bits A0-A1 are located in two registers, bit A0-A1 in the RF Control Register and the 
   bits A2 in the Control Register. It is important to note that the mux settings for 
   the RFP hw version 2 or later allow mux settings values 0-7 while eariler version of this module only
   provide for mux settings 0-3. So this function check to set that these limits have been
   followed. If an invalid setting is attempted, the old feedback signal mux setting found in
   the database field OFMX is restore to the FSMX field.

   Valid Mux Settings are:
       0 - Total
       1 - Comb Out
       2 - Noise 1
       3 - Drive
       4 - Ripple Monitor   ( ver 2 or later)
       5 - Error Sum        ( ver 2 or later)
       6 - Noise 2          ( ver 2 or later)
       7 - Spare            ( ver 2 or later)

   Parameters
   ----------
          rec - A pointer to the record
         rctl - The RF Control Register 
         mctl - The Control Register

   Returns
   -------
   None
*/
{
  /* Function ("FeedbackSigMux"); */

  if ( (rec->fsmx > menuFsmx_Drive) && (rec->verh < RFP_K_VER2VERN) ) 
  {
     rec->fsmx = rec->ofmx;
  }

  /* Save old feedback signal mux */
  rec->ofmx = rec->fsmx;
  if ( rec->fsmx > menuFsmx_Drive )
  {
    *mctl |= RFP_M_FBSIGMUX2;
  }
  else 
  {
     *mctl &= ~RFP_M_FBSIGMUX2;
  }
 
  *rctl |= (rec->fsmx << RFP_V_FBSIGMUX);
}



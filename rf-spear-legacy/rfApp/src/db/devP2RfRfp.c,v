/*
** Get Runtime ripple parameters.
*/
static void  ActGerp         (RfpBoard *brd, void *drvPvt,
                              P2RfRfpRecord  *rec)
{
  unsigned short  riparam;

  if (CheckDspOK(brd->dspMsgBlk.status))
  {
    /*
    ** Read various ripple loop parameters from eram, convert them, put 'em
    ** in the record and post the events.
    */
    P2RF_ReadVme  (drvPvt, RIP_A_IREF,  &riparam);
    rec->iref = ((float) (short) riparam)/6550.; /* Convert +/- 5 volts */
    db_post_events (rec, &rec->iref, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_QREF,  &riparam);
    rec->qref = ((float) (short) riparam)/6550.; /* Convert +/- 5 volts */
    db_post_events (rec, &rec->qref, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_PREF,  &riparam);
    rec->pref = (float) (short) riparam / (float) (1 << 12);
    db_post_events (rec, &rec->pref, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_IKLS,  &riparam);
    rec->ikls = (float) (short) riparam;
    db_post_events (rec, &rec->ikls, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_QKLS,  &riparam);
    rec->qkls = (float) (short) riparam;
    db_post_events (rec, &rec->qkls, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_PKLS,  &riparam);
    rec->pkls = (float) (short) riparam / (float) (1 << 12);
    db_post_events (rec, &rec->pkls, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_PERR,  &riparam);
    rec->perr = (float) (short) riparam / (float) (1 << 12);
    db_post_events (rec, &rec->perr, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_PERP,  &riparam);
    rec->perp = (float) (short) riparam / (float) (1 << 13);
    db_post_events (rec, &rec->perp, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_AERR,  &riparam);
    rec->aerr = (float) (short) riparam;
    db_post_events (rec, &rec->aerr, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_POUT,  &riparam);
    rec->pout = (float) (short) riparam / (float) (1 << 13);
    db_post_events (rec, &rec->pout, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_POUP,  &riparam);
    rec->poup = (float) (short) riparam / (float) (1 << 13);
    db_post_events (rec, &rec->poup, DBE_VALUE | DBE_LOG);

    P2RF_ReadVme  (drvPvt, RIP_A_AOUT,  &riparam);
    rec->aout = (float) (short) riparam / (float) (1 << 10);
    db_post_events (rec, &rec->aout, DBE_VALUE | DBE_LOG);
  
    /* Read new ADC's for ver 3 or later. These registers
     * mirror the data read by the DSP Parallel I/O in A24 space.
     */
    if ( rec->verh >= RFP_K_VER2VERN ){
      /* Read quad ADC-ADC0 (I Error) */
      P2RF_ReadVme  (drvPvt, RFP_I_ADCIERR,  &riparam);
      rec->ierr = (float) (short) riparam /6550.; /* Convert +/- 5 volts */
      db_post_events (rec, &rec->ierr, DBE_VALUE | DBE_LOG);  

      /* Read quad ADC-ADC1 (Q Error) */
      P2RF_ReadVme  (drvPvt, RFP_I_ADCQERR,  &riparam);
      rec->qerr = (float) (short) riparam /6550.; /* Convert +/- 5 volts */
      db_post_events (rec, &rec->qerr, DBE_VALUE | DBE_LOG); 

      /* Read quad ADC-ADC2 (I Klystron) */
      P2RF_ReadVme  (drvPvt, RFP_I_ADCIKLY,  &riparam);
      rec->ikly = (float) (short) riparam /6550.; /* Convert +/- 5 volts */
      db_post_events (rec, &rec->ikly, DBE_VALUE | DBE_LOG); 

      /* Read quad ADC-ADC3 (Q Klystron) */
      P2RF_ReadVme  (drvPvt, RFP_I_ADCQKLY,  &riparam);
      rec->qkly = (float) (short) riparam /6550.; /* Convert +/- 5 volts */
      db_post_events (rec, &rec->qkly, DBE_VALUE | DBE_LOG); 
    }
  }
  return;
}



static long SpawnReset (P2RfRfpRecord  *rec,
                        RfpRstBlk      *blk)
/*
   Description
   -----------
   This function initiates and completes the module reset.

   Parameters
   ----------
          rec - A pointer to the record
          blk - A pointer to the reset block

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnReset");
  unsigned short reg;

  if (!rec->pact)
  {
    /* Let operator know what's happening */
    strncpy (rec->val,  "Software Reset: active", sizeof (rec->val));
    strncpy (rec->oval, "Software Reset: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);

    /* Don't allow reprocessing of record before reset completes */
    rec->pact = TRUE;

    /* Disable module interrupts during software reset */
    P2RF_ModIntDisable (blk->drvPvt);
    P2RF_ReadVme (blk->drvPvt, RFP_I_INTCTRL, &reg);
    if (reg != rec->ictl ) {
      rec->ictl = reg;
      db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
    }
    printf("After P2RF_ModIntEnable: ICTL 0x%4.4x\n",rec->ictl);

    /* Do the deed */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
      strncpy (rec->val, "Attempt to initialize module failed", sizeof (rec->val));
      recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
    }
    else
    {
      /* Re-enable module interrupts */
      P2RF_ModIntEnable (blk->drvPvt);
      P2RF_ReadVme (blk->drvPvt, RFP_I_INTCTRL, &reg);
      if (reg != rec->ictl ) {
        rec->ictl = reg;
        db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
      }
      printf("After P2RF_ModIntEnable: ICTL 0x%4.4x\n",rec->ictl);

      strncpy (rec->val, "Software reset: done", sizeof (rec->val));
    }

    /* Reset the reset request so we don't redo it on the next process pass */
    rec->mrst = 0;
  }

  return (0);
}



static void ResetCallback (RfpRstBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a module software reset it requested.  It invokes completion processing
   of the associated record.

   Parameters
   ----------
          blk - A pointer to the reset block

   Returns
   -------
   nothing
*/
{
  /* Function ("ResetCallback"); */

  struct dbCommon  *rec;
  struct rset      *rSet;


  /* Just return if record pointer isn't initialized */
  if ((rec = callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Reset and update the record and the module */
  blk->status = InitFields ((RfpBoard *) rec->dpvt, P2RF_K_COLDSTART);

  /* Complete processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     (rec);
}



static long SpawnLdDsp (P2RfRfpRecord  *rec,
                        unsigned char  *request,
                        RfpDspBlk      *blk,
                        RfpDspPrm      *prm,
                        char           *file,
                        unsigned short *stat)
/*
   Description
   -----------
   This function initiates and completes the loading of the DSP on the module.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the DSP block
          prm - A pointer to the DSP parameter block
         file - The file that contains the DSP executable to load
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnLdDsp");


  if (!rec->pact)
  {
    /* Let operator know what's happening */
    strncpy (rec->val,  "Load DSP: active", sizeof (rec->val));
    strncpy (rec->oval, "Load DSP: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);
    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before DSP-load completes */
    rec->pact = TRUE;

    /* Save the file name in the parameter block */
    prm->file = file;

    /* Point the DSP block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (ERROR, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - file = %s, status = %08x",
                                       "P2RF_LoadDsp",
                                       prm->file, blk->status));
      *stat = WRITE_ALARM;
    }
    else
    {
      strncpy (rec->val, "Load DSP: done", sizeof (rec->val));

      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}



static void LdDspCallback (RfpDspBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to load and start the module's DSP.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the DSP block

   Returns
   -------
   nothing
*/
{
  /* Function ("LdDspCallback"); */

  P2RfRfpRecord    *rec;
  struct rset      *rSet;
  unsigned short    reg;
  RfpDspPrm        *prm = blk->prm;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Reset the DSP */
  P2RF_ReadVme  (blk->drvPvt, RFP_I_RFCTRL, &reg);
  P2RF_WriteVme (blk->drvPvt, RFP_I_RFCTRL, reg & ~RFP_M_NOTDSPRST);

  /* Load the DSP */
  if ((blk->status = P2RF_LoadDsp (blk->drvPvt, prm->index, prm->file, TRUE,
                                   rec->val, sizeof (rec->val))) == OK)
  {
    /* Boot the DSP */
    P2RF_WriteVme (blk->drvPvt, RFP_I_RFCTRL, reg | RFP_M_NOTDSPRST);
  }

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}




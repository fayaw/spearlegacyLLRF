static long Action (P2RfAimRecord    *rec)
/*
   Description
   -----------
   This is the action routine for the AIM.  An asynchronous module reset
   mechanism is implemented.  This feature toggles the software reset line on
   the VXI interface chip.  Since it takes a while (on the order of a second)
   for the reset to complete, the module must not be touched during its
   assertion.  To implement this, the record is processed asynchronously.  When
   the reset completes, the database fields are updated with the current state
   of the module

   Parameters
   ----------
          rec - A pointer to the record structure

   Returns
   -------
   0 or 2 for successful returns, else a status */
{
  Function ("Action");

  AimBoard       *brd    = NULL;
  void           *drvPvt;
  unsigned short  fctl;
  unsigned short  reg;

  /* If initialization failed let the system know */
  if ((brd = rec->dpvt) == NULL)  return (ERROR);
  drvPvt = brd->drvPvt;

  /* If processing was invoked by an interrupt, handle it */
  if (brd->intPrc)
  {
    /* Read the First Fault register */
    if (rec->istt & (AIM_M_ARCDETD | AIM_M_VXIBPFLT |
                     AIM_M_ABFLT   | AIM_M_FRCDFLTINT))
    {
      P2RF_ReadVme (drvPvt, AIM_I_FIRSTFLT, &brd->firstFault);
      rec->qflt = brd->firstFault;		/* save original */

      brd->firstFault ^= AIM_M_ARCFLT;		/* Get all bits high TRUE */

      /* Report enabled channels only */
      brd->firstFault &= rec->afes | (AIM_M_VXIFLT   | AIM_M_ABHBFLT |
                                      AIM_M_ABSUMFLT | AIM_M_FRCD_FLT);
    }

#if 0 /* remove, per Mike Browne... "useless function" [lazmo 2004-03-29] */
    /* Read the Invalid Operation Address register */
    if (rec->istt & AIM_M_INVOP) {
      P2RF_ReadVme (drvPvt, AIM_I_INVOPADX, &brd->invOpAdx);
      brd->invOpAdx = (brd->invOpAdx << 1) & AIM_M_INVOPADX;
    }
#endif

    /* Update client value of interrupt status field */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DB_POST_PARMS);
      rec->oist = rec->istt;

      db_post_events (rec, &rec->qflt, DB_POST_PARMS);	/* post original */
      ICURAP (brd->firstFault, fflt);
      ICURAP (brd->invOpAdx, ioax);
    }

    /* Update the database copy of the fast interlock status register */
    P2RF_ReadVme (drvPvt, AIM_I_FISTAT,  &rec->fstt);
    db_post_events (rec, &rec->fstt, DB_POST_PARMS);

    /* Read the Arc Current Status and look at enabled channels only */
    P2RF_ReadVme (drvPvt, AIM_I_ARCCURSTT, &reg);

    ICURAP (reg, qcst);			/* save/post original */

    reg ^= AIM_M_ARCCURSTT_FLT;		/* Convert to low FAULTED */
    reg &= rec->afes;

    ICURAP (reg, acst);

    /* Read the Arc Latched Status and look at enabled channels only */
    P2RF_ReadVme (drvPvt, AIM_I_ARCLTDSTT, &reg);

    ICURAP (reg, qlst);			/* save/post original */

    reg &= rec->afes;                   /* Register is low FAULTED */
    ICURAP (reg, alst);

    /* Don't lose invocation count on multiple interrupts */
    brd->intPrc--;

    return (0);
  }

  /* Initialize the message buffer if we're not doing completion processing */
  if (!rec->pact)    strncpy (rec->val, "Success", sizeof (rec->val));

  /* If requested, do a "software reset" on the module */
  if (rec->mrst)  return (SpawnReset (rec, &brd->resetBlk));

  /* If operator disabled interrupts update interrupt status DB field */
  P2RF_ReadVme (drvPvt, AIM_I_INTCTRL, &reg);
  if ((reg & AIM_M_INTSELECT) == AIM_M_INTSELECT)
  {
    P2RF_ReadVme (drvPvt, AIM_I_INTSTAT, &rec->istt);
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DB_POST_PARMS);
      rec->oist = rec->istt;

      /* Read the First Fault register */
      if (rec->istt & (AIM_M_ARCDETD | AIM_M_VXIBPFLT |
                       AIM_M_ABFLT   | AIM_M_FRCDFLTINT))
      {
        P2RF_ReadVme (drvPvt, AIM_I_FIRSTFLT, &brd->firstFault);

	ICURAP (brd->firstFault, qflt);	/* save/post original */

        brd->firstFault ^= AIM_M_ARCFLT; /* Bit is high when faulted */

        /* Report enabled channels only */
        brd->firstFault &= rec->afes | (AIM_M_VXIFLT   | AIM_M_ABHBFLT |
                                        AIM_M_ABSUMFLT | AIM_M_FRCD_FLT);

	ICURAP (brd->firstFault, fflt);
      }

#if 0 /* remove, per Mike Browne... "useless function" [lazmo 2004-03-29] */
      /* If there was an invalid operation, update Invalid Operation Address */
      if (rec->istt & AIM_M_INVOP) {
	P2RF_ReadVme (drvPvt, AIM_I_INVOPADX, &brd->invOpAdx);
	brd->invOpAdx = (brd->invOpAdx << 1) & AIM_M_INVOPADX;
	ICURAP (brd->invOpAdx, ioax);
      }
#endif

    }
  }

  /* Let the operator acknowledge that the interrupts have been seen */
  if (rec->iack)
  {
    rec->istt &= ~rec->iack;            /* Take only requested bits down */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DB_POST_PARMS);
      rec->oist = rec->istt;
    }
    rec->iack = 0;
    db_post_events (rec, &rec->iack, DB_POST_PARMS);
  }

  /* Update the interrupt control register if there was a change request */
  if (rec->imsk != rec->oimk)
  {
    rec->oimk = rec->imsk;
    rec->ictl = (rec->ictl & ~AIM_M_INTSELECT) |
              ((~rec->imsk << AIM_V_INTSELECT) & AIM_M_INTSELECT);
    P2RF_WriteVme (drvPvt, AIM_I_INTCTRL, rec->ictl);
    db_post_events (rec, &rec->ictl, DB_POST_PARMS);
  }

  /* Get the current state of the module */
  P2RF_ReadVme (drvPvt, AIM_I_FICTRL, &fctl);

  /* Potentially modify some bits in the Fast Interlock Control register */
  fctl &= ~(AIM_M_SOLENOID | AIM_M_HVPS     | AIM_M_FILAMENT | AIM_M_FILTMOOVRD |
            AIM_M_FRCDFLT  | AIM_M_FLTRESET | AIM_M_FRCBMABT | AIM_M_RSTBMABT );

  if (AIM_IS12CH) {				/* 12ch: hist buf bits */
    fctl &= ~( AIM_M_ADCMUX | AIM_M_ADCCTL );
  }

  /* Potentially turn solenoid on or off */
  fctl  |= ((rec->soo  ? 1 : 0) << AIM_V_SOLENOID)   & AIM_M_SOLENOID;

  /* Potentially request HVPS to turn on */
  fctl  |= ((rec->hvps ? 1 : 0) << AIM_V_HVPS)       & AIM_M_HVPS;
  rec->hvps = 0;

  /* Potentially turn the klystron filament on or off */
  fctl  |= ((rec->foo  ? 1 : 0) << AIM_V_FILAMENT)   & AIM_M_FILAMENT;

  /* Potentially request filament timeout override */
  fctl  |= ((rec->ftor ? 1 : 0) << AIM_V_FILTMOOVRD) & AIM_M_FILTMOOVRD;
  rec->ftor = 0;

  /* Potentially force a fault */
  fctl  |= ((rec->ff   ? 1 : 0) << AIM_V_FRCDFLT)    & AIM_M_FRCDFLT;

  /* Potentially reset faults */
  if (rec->rstf)
  {
    rec->rstf = 0;

    fctl  |= AIM_M_FLTRESET;

    /* Acknowledge the fault interrupt(s) */
    rec->istt &= ~(AIM_M_ARCDETD    | AIM_M_VXIBPFLT | AIM_M_ABFLT |
                   AIM_M_FRCDFLTINT | AIM_M_TEMPVOLT);

    rec->oist &= ~(AIM_M_ARCDETD    | AIM_M_VXIBPFLT | AIM_M_ABFLT |
                   AIM_M_FRCDFLTINT | AIM_M_TEMPVOLT);

    db_post_events (rec, &rec->istt, DB_POST_PARMS);
  }

  /* Potentially force a beam abort */
  fctl  |= ((rec->fba  ? 1 : 0) << AIM_V_FRCBMABT)   & AIM_M_FRCBMABT;

  /* Potentially reset beam abort */
  fctl  |= ((rec->rba  ? 1 : 0) << AIM_V_RSTBMABT)   & AIM_M_RSTBMABT;
  rec->rba = 0;

  /* 12-channel AIM: Set history buffer control bits */
  if (AIM_IS12CH) {
    fctl |= (rec->hmux ? AIM_M_ADCMUX : 0);
    fctl |= (rec->hctl ? AIM_M_ADCCTL : 0);
  }

  /* Update module and database versions of Fast Interlock Control register */
  if (fctl != rec->fctl)
  {
    /* strobed bits */
    unsigned short fiCtl = fctl & ~(AIM_M_HVPS     | AIM_M_FILTMOOVRD |
                                    AIM_M_FLTRESET | AIM_M_RSTBMABT);

    P2RF_WriteVme (drvPvt, AIM_I_FICTRL, fctl);

    /* Resensitize some bits to low-high transitions by taking them down */
    if (fiCtl != fctl)    P2RF_WriteVme (drvPvt, AIM_I_FICTRL, fiCtl);

    P2RF_ReadVme  (drvPvt, AIM_I_FICTRL, &rec->fctl);
    db_post_events (rec, &rec->fctl, DB_POST_PARMS);

    /* Make sure that the register changed to what we set it to */
    if (fiCtl != rec->fctl)
    {
      epicsPrintf ("%s - Fast Interlock Control register readback error: wrt 0x%04X, rd 0x%04X, xor 0x%04X\n",
                   FN, fiCtl, rec->fctl, fiCtl ^ rec->fctl);
      strncpy (rec->val, "Fast Interlock Control register readback error",
               sizeof (rec->val));
    }
  }

  /* process trip test requests, and update trip levels */
  {
    unsigned char  *tt   = &rec->tt1;	/* trip test buttons */

    unsigned short *tl   = &rec->tl1;	/* trip level values */
    unsigned short *tlp  = &rec->tlp1;	/* trip level previous values */
    unsigned short *tlr  = &rec->tlr1;	/* trip level readback values */
    unsigned short *tlam = &rec->tlam;	/* trip level readback alarm mask */
    unsigned short *tlas = &rec->tlas;	/* trip level readback alarm mask (sticky) */

    unsigned short  lvl, rbk, ambit;
    int             chan;

    for (chan = 0;
	 chan < AIM_K_CHANCNT;
	 chan++, tt++, tl++, tlp++, tlr++) {

      ambit = (1 << chan);				/* alarm bit, for masks */

      /* Trip Test - value written is immaterial */
      if (*tt) {					/* button pushed? */
        P2RF_WriteVme (drvPvt, chan + AIM_I_TRIPTEST1, 0);
        *tt = 0;					/* resensitize button */
      }

      /* enforce limits on trip level */
      if (*tl < MINTRIPLVL) {*tl = MINTRIPLVL; db_post_events (rec, tl, DB_POST_PARMS);}
      if (*tl > MAXTRIPLVL) {*tl = MAXTRIPLVL; db_post_events (rec, tl, DB_POST_PARMS);}

      /* update trip level if different from previous */
      lvl = (*tl << AIM_V_TRIPLVL) & AIM_M_TRIPLVL;	/* desired trip level, from GUI */
      if (*tl != *tlp) {
	*tlp = *tl;						/* update "previous" */
	db_post_events (rec, tlp, DB_POST_PARMS);		/* update DB */
        P2RF_WriteVme (drvPvt, chan + AIM_I_TRIPLVL1, lvl);	/* write reg */
      }

      /* verify current trip level (this is done every time) */
      P2RF_ReadVme  (drvPvt, chan + AIM_I_TRIPLVL1, &reg);
      reg &= AIM_M_TRIPLVL;				/* isolate level */

      rbk = reg >> AIM_V_TRIPLVL;
      if (rbk != *tlr) {				/* if not same as previous readback... */
	*tlr = rbk;					/* update readback DB field */
	db_post_events (rec, tlr, DB_POST_PARMS);
      }

      /* if readback is different from desired, set alarm and post error if first time */
      if (reg != lvl) {
	if ((*tlam & ambit) == 0) {			/* first time bad? */
	  *tlam |= ambit;				/* ... set bit in alarm mask */
	  *tlas |= ambit;				/* ... also in sticky mask */
	  db_post_events (rec, tlam, DB_POST_PARMS);
	  db_post_events (rec, tlas, DB_POST_PARMS);

	  /* channels are numbered 0+ in h/w, 1+ in s/w & displays :(( */
	  epicsPrintf(
	     "%s - Arc Trip Level register readback error: chan %d, wrt 0x%04X, rd 0x%04X, xor 0x%04X\n",
	     FN, chan+1, lvl, reg, reg ^ lvl);

if (DBG1x2) printf(" >>> Trip Level rbck err: wrt 0x%04X, rd 0x%04X, xor 0x%04X\n", lvl, reg, reg^lvl);

	  strncpy(rec->val,
		  "Arc Trip Level register readback error",
		  sizeof(rec->val));

#if 0 /*don't... but if you want to, here's where to do it */
	  P2RF_WriteVme (drvPvt, chan + AIM_I_TRIPLVL1, lvl);	/* write good value again */
#endif
	}
      }
      else {			/* readback is OK; reset alarm if it was set */
	if (*tlam & ambit) {
	  *tlam &= (-1 ^ ambit);			/* reset bit in mask */
	  db_post_events (rec, tlam, DB_POST_PARMS);
				/* .TLAS is sticky -> never reset by s/w */
	}
      } /* end if (readback different) */

    } /* end for (all channels) */
  } /* end local block */

  /* Update the database copy of the fast interlock status register */
  P2RF_ReadVme (drvPvt, AIM_I_FISTAT,  &rec->fstt);
  db_post_events (rec, &rec->fstt, DB_POST_PARMS);

  /* Read the Arc Channel Fault Enable Status */
  P2RF_ReadVme (drvPvt, AIM_I_FLTENBSTT, &reg);

  ICURAP (reg, qfes);			/* save/post original */

  reg &= AIM_M_FLTENBSTT;
  ICURAP (reg, afes);

  /* Refresh the First Fault database copy */
  P2RF_ReadVme (drvPvt, AIM_I_FIRSTFLT, &brd->firstFault);

  ICURAP (brd->firstFault, qflt);	/* save/post original */

  brd->firstFault ^= AIM_M_ARCFLT;      /* Convert so set bit means fault */

  /* Report enabled channels only */
  brd->firstFault &= rec->afes | (AIM_M_VXIFLT   | AIM_M_ABHBFLT |
                                  AIM_M_ABSUMFLT | AIM_M_FRCD_FLT);

  ICURAP (brd->firstFault, fflt);

  /* Read the Arc Current Status and look at enabled channels only */
  P2RF_ReadVme (drvPvt, AIM_I_ARCCURSTT, &reg);

  ICURAP (reg, qcst);			/* save/post original */

  reg ^= AIM_M_ARCCURSTT_FLT;		/* Convert to low FAULTED */
  reg &= rec->afes;

  ICURAP (reg, acst);

  /* Read the Arc Latched Status and look at enabled channels only */
  P2RF_ReadVme (drvPvt, AIM_I_ARCLTDSTT, &reg);

  ICURAP (reg, qlst);			/* save/post original */

  reg &= rec->afes;                     /* Register is low FAULTED */
  ICURAP (reg, alst);

  if (AIM_IS7CH) {

    /* Process request to load DAS 0 instructions */
    if (rec->ld0f)  return (SpawnLdDas (rec, &rec->ld0f, &brd->dasBlk[0],
					&brd->dasPrm[0], rec->d0if, &rec->d0as));

    /* Process request to load DAS 1 instructions */
    if (rec->ld1f)  return (SpawnLdDas (rec, &rec->ld1f, &brd->dasBlk[1],
					&brd->dasPrm[1], rec->d1if, &rec->d1as));
    /*
    ** Read registers for Aim diagnostic display.
    */
    if (rec->rrd0)
      {
	rec->rrd0 = 0;
	if (rec->rid0 > 13)
	  {
	    rec->rid0 = 0;
	    db_post_events (rec, &rec->rid0, DBE_VALUE);
	  }
	P2RF_ReadVme (drvPvt, brd->dasPrm[0].index + rec->rid0, &rec->rdd0);
	db_post_events (rec, &rec->rdd0, DBE_VALUE);
      }

    if (rec->rrd1)
      {
	rec->rrd1 = 0;
	if (rec->rid1 > 13)
	  {
	    rec->rid1 = 0;
	    db_post_events (rec, &rec->rid1, DBE_VALUE);
	  }
	P2RF_ReadVme (drvPvt, brd->dasPrm[1].index + rec->rid1, &rec->rdd1);
	db_post_events (rec, &rec->rdd1, DBE_VALUE);
      }
  } /* end AIM_IS7CH */

  /*
  ** Read all temps & voltages etc. from TVREG of both DAS chips. The 
  ** subregister of each increments on read from 0-7
  ** (...corresponding code for 12-channel AIM follows...)
  */
  if (AIM_IS7CH && rec->rdas)
  {
    /*----------------------------------------------------------------
     * 7-channel AIM crate temp/voltage readout
     *----------------------------------------------------------------
     */

    /* Le local variables */

    /*
    ** Set up pointers to raw and converted value for each DAS chip.
    */
    unsigned short tempreg;

    unsigned short *das0s_p = &rec->rs00;
    unsigned short *das1s_p = &rec->rs10;

    float          *das0f_p = &rec->rf00;
    float          *das1f_p = &rec->rf10;

    int   dsr;          /* Looper for DAS sub-register within TVREG */

    /*
    ** Scale factors for crate voltage conversions.
    */ 
    static float vscale[NUMTVREG] = 
              { 21.5, -20.5, 11., -10., 4.01, 4.01, -3.01, -1.};

    /* Le Code */

    rec->rdas = 0;	/* reset selection */

    /*
    ** For each DAS chip, read register TVREG until we hit the 7th channel. 
    ** Then read the raw values and convert them. We could do this 
    ** more cleverly but why bother?
    */
    dsr =NUMTVREG;  /* Prevent infinite loop */ 
    do
    {
       P2RF_ReadVme (drvPvt, brd->dasPrm[0].index + TVREG, &tempreg);
    } while ( ((tempreg & REGANDMASK) !=(7 << REGBITPOS)) && dsr-- >= 0);
    dsr =NUMTVREG;  /* Prevent infinite loop */ 
    do
    {
       P2RF_ReadVme (drvPvt, brd->dasPrm[1].index + TVREG, &tempreg);
    } while ( ((tempreg & REGANDMASK) != (7 << REGBITPOS)) && dsr-- >= 0);

/* offset from 7 -> 13, for crate temp */
#define MAP7TO13 (13 - 7)

    /*
    ** Now read the rest of each into the raw value array.
    */

/*if (DBG1x1) printf("\nCrate stats (DAS0/DAS1):\n");*/

    for (dsr=0; dsr <NUMTVREG; dsr++)
    {
       P2RF_ReadVme (drvPvt, brd->dasPrm[0].index + TVREG, das0s_p);
       P2RF_ReadVme (drvPvt, brd->dasPrm[1].index + TVREG, das1s_p);

/*if (DBG1x1) printf(" %2d:0x%04X/0x%04X%s",dsr,*das0s_p,*das1s_p,((dsr&3)==3)?"\n":"");*/

       das0s_p++;
       das1s_p++;
    }

    /*
    ** Convert to E.U. and save as float.
    */ 
    das0s_p = &rec->rs00;
    das1s_p = &rec->rs10;

    for (dsr = 0; dsr < NUMTVREG; dsr++)
    {
      /* 
      ** DAS0.  Arc detector peaks 0-6. Subregister 7 is the crate temp.
      */
      *das0f_p = (float)(*das0s_p & VALANDMASK) * 5.0 / MAX12BIT; 

      if (dsr == 7) {		/* crate temp; cvt & move to RS/RF0D */
	*(das0f_p+MAP7TO13) = 200.0 / 4.5 * (*das0f_p * 3.0 - 0.25) - 50.0; /* Temp Deg C */
	*(das0s_p+MAP7TO13) = *das0s_p;
	*das0f_p = 0.0;
	*das0s_p = 0;
      }

      /* 
      ** DAS 1. All voltages with varying scale factors.
      */
      *das1f_p = (float)(*das1s_p & VALANDMASK) * 2.5 / MAX12BIT * vscale[dsr];

      /*
      ** Post changes
      */  
      db_post_events (rec, das0s_p + ((dsr==7) ? MAP7TO13 : 0), DB_POST_PARMS);
      db_post_events (rec, das1s_p                            , DB_POST_PARMS);

      db_post_events (rec, das0f_p + ((dsr==7) ? MAP7TO13 : 0), DB_POST_PARMS);
      db_post_events (rec, das1f_p                            , DB_POST_PARMS);

      /* increment pointers */
      das0s_p++;
      das1s_p++;
      das0f_p++;
      das1f_p++;
    }
  }

  if (AIM_IS12CH && rec->rdas) {	/* use RDAS also */

    /*----------------------------------------------------------------
     * 12-channel AIM crate temp/voltage & arc voltage readout
     *----------------------------------------------------------------
     */

      /* 12-channel AIM module scale factors
       *       +24V = reg * (+7.324e-3)
       *       -24V = reg * (-7.324e-3)
       *       +12V = reg * (+3.662e-3)
       *       -12V = reg * (-3.662e-3)
       *        +5V = reg * (+1.526e-3)
       *        -2V = reg * (-0.610e-3)
       *      -5.2V = reg * (-1.587e-3)
       * Temp deg-C = reg * ( 3.662e-3)
       *       (all are 12-bits, no sign)
       */

    /* DB fields Rx00-Rx07 extended to Rx00-Rx0D
     */

    unsigned short *pRS00 = &rec->rs00;		/* raw values */
    unsigned short *pRS10 = &rec->rs10;

    float          *pRF00 = &rec->rf00;		/* EU values */
    float          *pRF10 = &rec->rf10;

    unsigned short reg;
    int i, j;

    /* h/w index => DB offset map */
    static int chan2db[8] = {
      0, 1, 2, 3, 4,
      7, 6,			/* -2V, -5.2V (swapped in 12-ch AIM) */
      5				/* crate temperature */
    };

    /* crate temp & V raw => EU scaling...
     * this array is indexed by DB offset, i.e., output of chan2db[]
     */
    static double crate_raw2eu[8] = {
       7.324e-3, -7.324e-3,		/* +/- 24 */
       3.662e-3, -3.662e-3,		/* +/- 12 */
       1.526e-3,			/* +5     */
       5.426e-2,			/* temperature; requires further calc */
      -1.587e-3,			/* -5.2   */
      -0.610e-3				/* -2     */
    };
    
    rec->rdas = 0;	/* reset selection */

    /********************************
     * 12-channel Crate Temp & Voltages
     ********************************
     */

    for (i = 0; i < 8; i++) {		/* start out zero, to catch missing readouts */
      pRS10[i] = 0;
      pRF10[i] = 0.0;
    }

/* make two passes through, to up the odds of getting them all... h/w problem?
 * ... (sometimes doesn't read all values) ...
 */

/*if (DBG1x1) printf("\nCrate stats:\n");*/

    for (i = 0; i < 8*2; i++) {
      P2RF_ReadVme (drvPvt, AIM_I_CRTVOL, &reg);
      j = (reg & AIM_M_CRTCHAN) >> AIM_V_CRTCHAN;	/* extract index & cvt to DB */

/*if (DBG1x1) printf(" %2d:0x%04X%s",j,reg,((i&7)==7)?"\n":"");*/

      if (j <= 7) {					/* ignore if bogus */
	j  = chan2db[j];
	pRS10[j] = reg;								/* raw */
	pRF10[j] = ((reg & AIM_M_CRTVOL) >> AIM_V_CRTVOL) * crate_raw2eu[j];	/* EU */
      }
    }

    /* fix temperature; original calc was: tempC = ((reg * 0.001221) - 1.375) * 44.44
     *                         reduced to: tempC =  (reg * 0.05426 ) - 61.11
     */
    pRF10[5] -= 61.11;

    /* move crate temp from RS/RF15 to where it belongs (RS/RF0D), & post it
     */
    pRS00[13] = pRS10[5];
    pRF00[13] = pRF10[5];
    db_post_events (rec, &pRS00[13], DB_POST_PARMS);
    db_post_events (rec, &pRF00[13], DB_POST_PARMS);

    /* copy +5V value to 2nd (non-existent in 12-chan AIM) +5V loc
     */
    pRS10[5] = pRS10[4];
    pRF10[5] = pRF10[4];

    /* post all crate voltages
     */
    for (j = 0; j < 8; j++) {
      db_post_events (rec, &pRS10[j], DB_POST_PARMS);
      db_post_events (rec, &pRF10[j], DB_POST_PARMS);
    }

    /********************************
     * 12-ch Arc Voltages
     ********************************
     */

    for (i = 0; i < 12; i++) {		/* start out zero, to catch missing readouts */
      pRS00[i] = 0;
      pRF00[i] = 0.0;
    }

    /* sync to channel 0... should not be strictly necessary, but hey
     */
    i = 16;
    do {
      P2RF_ReadVme (drvPvt, AIM_I_ARCVOL, &reg);
      j = (reg & AIM_M_ARCCHAN) >> AIM_V_ARCCHAN;	/* extract chan # */
    } while ( (j != 0) && (i-- >= 0) );

    /* make two passes, to up the odds of getting them all... h/w problem?
     * ... (sometimes doesn't read all values) ...
     */

    for (i = 0; i < 16*2; i++) {	/* 0-11 are Arc Vs, 12-15 are HVPS (ignored for now) */
      if (i > 0) {					/* already got first one */
	P2RF_ReadVme (drvPvt, AIM_I_ARCVOL, &reg);
	j = (reg & AIM_M_ARCCHAN) >> AIM_V_ARCCHAN;	/* extract chan # */
      }
      if (j < AIM_K_CHANCNT) {				/* trap bogus channel #s */
	pRS00[j] = reg;					/* raw */

	/* arc V is signed quantity... map to real volts (per D.Brown)
	 */
	reg  = (reg & AIM_M_ARCVOL) >> AIM_V_ARCVOL;
	if (reg & (1 << (AIM_M_ARCVOL_BITS - 1))) reg |= ((-1) << AIM_M_ARCVOL_BITS);  /* propagate sign */
	reg += (1 << (AIM_M_ARCVOL_BITS - 1));		/* map [-Z,(Z-1)] to [0,(2*Z)-1] */

	pRF00[j]  = (float)reg / ((1 << AIM_M_ARCVOL_BITS) - 1);	/* -> [0,1]         */
	pRF00[j] *= (AIM_M_ARCVOL_MAXV - AIM_M_ARCVOL_MINV);		/* -> [0,(max-min)] */
	pRF00[j] +=  AIM_M_ARCVOL_MINV;					/* -> [min,max]     */
      }
    }

    /* now post them
     */
    for (j = 0; j < AIM_K_CHANCNT; j++) {
      db_post_events (rec, &pRS00[j], DB_POST_PARMS);
      db_post_events (rec, &pRF00[j], DB_POST_PARMS);
    }
  }

  /*----------------------------------------------------------------
   * Calibrate arc detector trip levels
   *----------------------------------------------------------------
   */
  if (rec->calt) {
    int             iarc;		/* arc channel looper  */
    int             i, j;		/* read peak loopers */
    short           sreg;		/* to read/store peaks */
    unsigned short *tl;			/* trip levels */

    /* Channel peak values */
    short peakread[] = {
      0,0,0,0,0,0,0,0,		/* ch 1-8  */
      0,0,0,0,0,		/* ch 9-12 */
      0,0,0			/* hedge for bogus channel nums (0xF mask) */
    };

    rec->calt = 0;	/* reset */

    if ((rec->fstt & AIM_M_HVPSON) == 0) {

      /* 12-channel AIM doesn't need the following alignment loop since there's
       * no temperature value to skip over... it doesn't matter which channel we
       * start on; each of them should be read the same number of times regardless
       */
      if (AIM_IS7CH) {
	/* For the DAS0 registers, read register TVREG until we hit the 7th 
	 * channel. The next read will start at 0 so we can read all 8 registers
	 * using just the first 7 which have the peak outputs. 
	 */
	i = NUMTVREG;  /* Prevent infinite loop */ 
	do {
	  P2RF_ReadVme (drvPvt,
			brd->dasPrm[0].index + TVREG, 
			(unsigned short *)&sreg);
	} while ( ((sreg & REGANDMASK) != (7 << REGBITPOS)) && i-- >= 0);
      }

      /* Now get the signed max of 50 reads of the detector peaks.
       */
      for (i = 0; i < PEAKREADS; i++) {

	if (AIM_IS7CH) {
	  /* 7-channel: we must read all registers even though the last is the temp
	   * since they cycle in order
	   */
	  for (j = 0; j < NUMTVREG; j++) {
	    P2RF_ReadVme (drvPvt,
			  brd->dasPrm[0].index + TVREG, 
			  (unsigned short *) &sreg);
	    sreg <<= 3; sreg >>= 3;			/* sign extend */
	    if (sreg > peakread[j]) peakread[j] = sreg;
	  }
	}

	if (AIM_IS12CH) {
	  /* 12-channel: arc voltages come out of repeated reads of a single
	   * register and include channel number; crate temp is in a different reg
	   */
	  P2RF_ReadVme (drvPvt, AIM_I_ARCVOL, (unsigned short *)&sreg);

	  j    = ((unsigned short)sreg & AIM_M_ARCCHAN) >> AIM_V_ARCCHAN;	/* get chan # */
	  sreg = ((unsigned short)sreg & AIM_M_ARCVOL)  >> AIM_V_ARCVOL ;

	  if (sreg > peakread[j]) peakread[j] = sreg;
	}
      }

      /* Scale the peaks for each arc detector which exists on this station.
       * We have 8 bits of trip level and 12 for noise so divide calculated
       * result by 16 so it's properly scaled.
       */

      tl = &rec->tl1;
      for (iarc = 0; iarc < AIM_K_CHANCNT; iarc++) {
	*tl = 255;				/* init to "channel not valid this station" */
        if ((rec->afes & chan2bit[iarc]) != 0) {
          sreg = rec->casf * (float)peakread[iarc]; 
	  if (sreg < MINTRIPLVL) sreg = MINTRIPLVL;
	  if (sreg > MAXTRIPLVL) sreg = MAXTRIPLVL;
          *tl = (unsigned short)sreg;
        }
        db_post_events (rec, tl++, DB_POST_PARMS);
      }
    }
    else {
       epicsPrintf("Can\'t calibrate arc trip levels while HVPS is permitted.\n");
    }
  } /* end if (AIM_IS7CH && rec->calt) */


  /*
  ** Test Arc Trip Levels.
  */
  if (rec->tstl)
  {
    /* Le local variables */
    int iarc;                 /* arc channel looper  */
    unsigned short reg;       /* Register */
    unsigned short *ttl_p = &rec->ttl1; /* Tested trip levels */
    unsigned short *tl_p  = &rec->tl1;  /* To save trip levels */
    unsigned short lvl;       /* masked trip level to reg */
    unsigned short savetl;    /* Saved previous trip level */

    /*
    ** Binary search vars
    */
    unsigned short top, bot, fence;

    /*
    ** Le Code
    */

    rec->tstl=0;

    /*
    ** Clear any arc faults by toggling the arc fault reset bit.
    */
    P2RF_ReadVme  (drvPvt, AIM_I_FICTRL, &reg); /* Get ctrl reg */

    reg &= ~(AIM_M_FLTRESET);  /* Clear arc fault reset */
    P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);

    reg |= AIM_M_FLTRESET;  /* Set arc fault reset */
    P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);

    reg &= ~(AIM_M_FLTRESET);  /* Clear arc fault reset again */
    P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);

    P2RF_ModIntDisable (drvPvt);  /* Disable interrupts */

    for (iarc=0; iarc < AIM_K_CHANCNT; iarc++, ttl_p++)
    {
      if ( (rec->afes & chan2bit[iarc]) != 0) /* If channel enabled */
      {
        savetl = *tl_p++;  /* Save existing trip level */
	/*
	** Do a binary search to find the trip level twixt 0 - 255 
	*/
        top = 255; bot = 0; fence = (top-bot)/2;
        do
	{
          lvl = (fence << AIM_V_TRIPLVL) & AIM_M_TRIPLVL;
          P2RF_WriteVme (drvPvt, iarc + AIM_I_TRIPLVL1, lvl); /* Set level */
          /* Read level back to ensure it's latched */
          P2RF_ReadVme  (drvPvt, iarc + AIM_I_TRIPLVL1, &reg); 

          P2RF_WriteVme (drvPvt, iarc + AIM_I_TRIPTEST1, 0);  /* Fire test */

          P2RF_ReadVme (drvPvt, AIM_I_ARCLTDSTT, &reg); /* Get results */

	  if ( (reg & chan2bit[iarc]) == 0) {
            bot = fence;    /* Up the ante */
            fence = (top-bot)/2 + bot;
            P2RF_ReadVme (drvPvt, AIM_I_FICTRL, &reg);
            reg  |= AIM_M_FLTRESET;  /* Reset Arc fault */  
            P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);
            reg  &= ~AIM_M_FLTRESET; /* Clear reset so OK next time */
            P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);
          }
          else {    /* No trip */
            top = fence;    /* Decrease the ante */
            fence = (top-bot)/2 + bot;
          }
        } while ((top - bot) > 1);  /* Bracket trip */

        *ttl_p = fence;             /* Store tested level */
        P2RF_WriteVme (drvPvt, iarc + AIM_I_TRIPLVL1, savetl);/* Saved level */

        /* Read level back to insure it's latched */
        P2RF_ReadVme  (drvPvt, iarc + AIM_I_TRIPLVL1, &reg);

	/*
	** Clear any remaining arc faults
	*/

        P2RF_ReadVme (drvPvt, AIM_I_FICTRL, &reg);

        reg  |= AIM_M_FLTRESET;  /* Reset Arc fault */  
        P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);

        reg  &= ~AIM_M_FLTRESET; /* Clear reset so OK next time */
        P2RF_WriteVme (drvPvt, AIM_I_FICTRL, reg);

        db_post_events (rec, ttl_p, DB_POST_PARMS);

      }   /* If channel enabled */
    }     /* For all channels */

    rec->rstf = 1;  /* Force fault reset */
    db_post_events (rec, &rec->rstf, DB_POST_PARMS);
    P2RF_ModIntEnable (drvPvt);  /* Re-enable interrupts */
  }
  
  if (AIM_IS12CH) {
    /* Process request to read out history buffer */
    if (rec->hget) {
      return SpawnGetRam (rec,
			  &rec->hget,
			  &brd->getRamBlk,
			  &brd->hisPrm,
			  rec->hbsz,
			  rec->hbfn,
			  &rec->hbst);
    }
  } /* end AIM_IS12CH */

  return (0);
}


static long SpawnReset (P2RfAimRecord  *rec,
                        AimRstBlk      *blk)
/*
   Description
   -----------
   This function initiates and completes the module reset.

   Parameters
   ----------
          rec - A pointer to the record
          blk - A pointer to the reset block

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnReset");

  if (!rec->pact)
  {
    /* Let operator know what's happening */
    strncpy (rec->val,  "Software Reset: active", sizeof (rec->val));
    strncpy (rec->oval, "Software Reset: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DB_POST_PARMS);

    /* Don't allow reprocessing of record before reset completes */
    rec->pact = TRUE;

    /* Disable module interrupts during software reset */
    P2RF_ModIntDisable (blk->drvPvt);

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
      strncpy (rec->val, "Attempt to initialize module failed", sizeof (rec->val));
      recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
    }
    else
    {
      /* Re-enable module interrupts */
      P2RF_ModIntEnable (blk->drvPvt);

      strncpy (rec->val, "Software reset: done", sizeof (rec->val));
    }

    /* Reset the reset request so we don't redo it on the next process pass */
    rec->mrst = 0;
  }

  return (0);
}


static void ResetCallback (AimRstBlk  *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a module software reset it requested.  It invokes completion processing
   of the associated record.

   Parameters
   ----------
          blk - A pointer to the reset block

   Returns
   -------
   nothing
*/
{
  /* Function ("ResetCallback"); */

  struct dbCommon  *rec;
  struct rset      *rSet;

  /* Just return if record pointer isn't initialized */
  if ((rec = callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Lock the record to prevent processing during reinitialization */
  dbScanLock       (rec);

  /* Reset and update the record and the module */
  blk->status = InitFields ((AimBoard *) rec->dpvt, P2RF_K_COLDSTART);

  /* Complete processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     (rec);
}


/* 7-channel ONLY */

static long SpawnLdDas (P2RfAimRecord  *rec,
                        unsigned char  *request,
                        AimDasBlk      *blk,
                        AimDasPrm      *prm,
                        char           *file,
                        unsigned short *stat)
/*
   Description
   -----------
   This function initiates and completes the loading of the DAS chips
   on the module.  For 7-channel ONLY.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the DAS block
          prm - A pointer to the DAS parameter block
         file - The file that contains the DAS instructions to load
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnLdDas");

  char  buf[P2RF_K_BUFSIZE];

  if (!rec->pact)
  {
    sprintf (buf, "Load %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val, DB_POST_PARMS);
    *stat = NO_ALARM;
    db_post_events (rec, stat, DB_POST_PARMS);

    /* Don't allow record reprocessing record before coef load completes */
    rec->pact = TRUE;

    /* Save the file name in the parameter block */
    prm->file = file;

    /* Point the coefficient block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_LoadRegFile",
                                       prm->id, prm->file));
      *stat = UDF_ALARM;
      db_post_events (rec, stat, DB_POST_PARMS);
    }
    else
    {
      sprintf (buf, "Load %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));
    }

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}


/* 7-channel ONLY */

static void LdDasCallback (AimDasBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to load one of the module's Data Acquisition
   System chips with instructions.  It invokes completion processing of
   the associated record.

   Parameters
   ----------
          blk - A pointer to the DAS loading block

   Returns
   -------
   nothing
*/
{
  /* Function ("LdDasCallback"); */

  P2RfAimRecord    *rec;
  struct rset      *rSet;
  AimDasPrm        *prm = blk->prm;

  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Read the data file and load the DAS chip */
  blk->status = P2RF_LoadRegFile (blk->drvPvt, prm->id, prm->file,
                                  prm->index, FALSE,
                                  rec->val, sizeof (rec->val));

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}


/* 12-channel ONLY ... derived from devP2RfRfp.c */

static long SpawnGetRam (P2RfAimRecord  *rec,
                         unsigned char  *request,
                         AimRamBlk      *blk,
                         AimMemPrm      *prm,
                         unsigned int    blkCnt,
                         char           *file,
                         unsigned short *stat)
/*
   Description
   -----------
   This function initiates and completes the retrieval of the module RAMs.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the record block
          prm - A pointer to the record parameter block
       blkCnt - Number of blocks of record buffer to record
         file - The file to record the record buffer in
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnGetRam");

  char  buf[P2RF_K_BUFSIZE];

  if (!rec->pact)
  {
    sprintf (buf, "Get %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val,  DB_POST_PARMS);

    *stat = UDF_ALARM;
    db_post_events (rec, stat, DB_POST_PARMS);

    /* Don't allow record reprocessing record before get-history completes */
    rec->pact = TRUE;

    /* Save block count and file name in parameter block and reset abort flag */
    prm->count    = (blkCnt < AIM_K_HISBLKCNT) ? blkCnt : AIM_K_HISBLKCNT;
    prm->file     = file;
    blk->abortFlg = FALSE;

    /* Point the RAM block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - file = %s",
                                       "P2RF_RecordMemory", prm->file));
      *stat = READ_ALARM;
    }
    else
    {
      sprintf (buf, "Get %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));

      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DB_POST_PARMS);

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}


/* 12-channel ONLY ... derived from devP2RfRfp.c */

static void GetRamCallback (AimRamBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to read one of the module's RAMs.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the get-history block

   Returns
   -------
   nothing
*/
{
  /* Function ("GetRamCallback"); */

  P2RfAimRecord    *rec;
  struct rset      *rSet;
  AimMemPrm        *prm = blk->prm;

  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock ((struct dbCommon *) rec);

#if 0 /* no such thing in AIM... readout address is reset by fault (or timeout?) */
  /* Preload the state machine address counter */
  P2RF_WriteVme (blk->drvPvt, AIM_I_SMPRELD, NULL);
#endif

  /* Read the history memory and record it */
  blk->status = P2RF_RecordMemory_noPreRead (blk->drvPvt,
					     prm->id,
					     prm->index,
					     prm->count,
					     prm->file,
					     &blk->abortFlg,
					     rec->val,
					     sizeof (rec->val));

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}

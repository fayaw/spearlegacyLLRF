static long InitRecord (P2RfAimRecord  *rec)
/*
   Description
   -----------
   Initialize the record.  Many fields of the record are filled with data from
   the hardware.  Depending on the start-up type (cold or warm) some record
   fields will either set up the hardware or get their values from a restore
   file.  Interrupts from the board are enabled at the end of the
   initialization.

   Parameters
   ----------
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("InitRecord");
  struct vxiio   *vxiIo = NULL;
  AimBoard       *brd;
  long            status;
  void           *drvPvt;
  char           *msg   = "AIM module initialization failed";
  int             startType;

  /* rec.out must be of type VXI_IO */
  if (rec->out.type != VXI_IO)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_db_badField, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "Illegal OUT field"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return(S_db_badField);
  }

  /* Allocate the device private block */
  if ((brd = calloc (1, sizeof (*brd))) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "No memory for AIM board descriptor"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Register the module to get a driver handle */
  vxiIo = &rec->out.value.vxiio;
  if ( (status = P2RF_RegisterModule (vxiIo->flag, vxiIo->frame, vxiIo->slot,
                                    vxiIo->la,
                                    AIM_K_MODEL, AIM_K_NAME, AIM_K_DRAWING,
                                    AimIsr, brd, AimShutdown, brd,
                                    &drvPvt)) )
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "P2RF_RegisterModule"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (status);
  }

  /* Set up the device private block and save a pointer to it in the record */
  brd->drvPvt = drvPvt;
  brd->rec    = rec;
  rec->dpvt   = brd;

  /* Initialize the callback facility for the reset function */
  callbackSetCallback ((void*)ResetCallback, &brd->resetBlk.callback);
  callbackSetPriority (priorityHigh,         &brd->resetBlk.callback);
  callbackSetUser     (rec,                  &brd->resetBlk.callback);
  brd->resetBlk.drvPvt = drvPvt;

  /* sneak in an early VME read of the board version number here... copied from
   * initFields() below; we need it here so AIM_IS<n>CH macros will work!
   */

  P2RF_ReadVme (drvPvt, AIM_I_VERSION, &rec->vern);
  rec->verh = P2RF_HWVER(rec->vern);
  rec->verf = P2RF_FWVER(rec->vern);

  /*----------------------------------------------------------------
   * support for 7-channel DAS readout
   *----------------------------------------------------------------
   */
  if (AIM_IS7CH) {
    /* Initialize the callback facility for loading DAS chip 1 */
    callbackSetCallback ((void*)LdDasCallback, &brd->dasBlk[0].callback);
    callbackSetPriority (priorityLow,          &brd->dasBlk[0].callback);
    callbackSetUser     (rec,                  &brd->dasBlk[0].callback);
    brd->dasBlk[0].drvPvt = drvPvt;

    /* Load the static part of the DAS parameter block */
    {
      AimDasPrm *prm = &brd->dasPrm[0];
      prm->id        = AIM_K_DASID;
      prm->index     = AIM_I_DAS1;
    }

    /* Initialize the callback facility for loading DAS chip 2 */
    callbackSetCallback ((void*)LdDasCallback, &brd->dasBlk[1].callback);
    callbackSetPriority (priorityLow,          &brd->dasBlk[1].callback);
    callbackSetUser     (rec,                  &brd->dasBlk[1].callback);
    brd->dasBlk[1].drvPvt = drvPvt;

    /* Load the static part of the DAS parameter block */
    {
      AimDasPrm *prm = &brd->dasPrm[1];
      prm->id        = AIM_K_DASID;
      prm->index     = AIM_I_DAS2;
    }
  } /* end if (AIM_IS7CH) */

  /*----------------------------------------------------------------
   * support for 12-channel AIM history-buffer readout 
   *----------------------------------------------------------------
   */
  if (AIM_IS12CH) {
    /* Initialize the callback facility for the History-Buffer read function */
    brd->getRamBlk.drvPvt = drvPvt;
    callbackSetCallback ((void*)GetRamCallback, &brd->getRamBlk.callback);
    callbackSetPriority (priorityLow,           &brd->getRamBlk.callback);
    callbackSetUser     (rec,                   &brd->getRamBlk.callback);

    /* Load the static part of the history-buffer parameter block */
    {
      AimMemPrm *prm = &brd->hisPrm;
      prm->id    = AIM_K_HISBUFID;
      prm->index = AIM_I_HISBUF;
    }
  } /* end if (AIM_IS12CH) */

  /* Figure out the restart type -- To be determined */
  startType = P2RF_K_COLDSTART;

  /* Initialize the module and the database fields depending on startup type */
  if ( (status = InitFields (brd, startType)) )
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Enable module interrupts and update the database copy */
  P2RF_ModIntEnable (drvPvt);
  P2RF_ReadVme (drvPvt, AIM_I_INTCTRL, &rec->ictl);

  return (OK);
}


static long InitFields (AimBoard *brd,
                        int       initType)
/*
   Description
   -----------
   Function to initialize the fields in the database record and/or the module,
   depending on the initialization type.

   Parameters
   ----------
          brd - A pointer to the device private block
     initType - Type of initialization.

   Returns
   -------
   Status
*/
{
  /* Function ("InitFields"); */

  P2RfAimRecord  *rec    = brd->rec;
  void           *drvPvt = brd->drvPvt;
  long            status;
  unsigned short  sernHi;
  unsigned short  sernLo;

  /* Reset the module, if it's a cold startup.  This takes a while... */
  if (initType == P2RF_K_COLDSTART)  P2RF_ResetModule (drvPvt);

  /* Load the record fields with device data */
  P2RF_ReadVme (drvPvt, AIM_I_MANID,     &rec->mid );
  P2RF_ReadVme (drvPvt, AIM_I_MODELNO,   &rec->mtyp);
  P2RF_ReadVme (drvPvt, AIM_I_STATUS,    &rec->mstt);
  P2RF_ReadVme (drvPvt, AIM_I_OFFSET,    &rec->a24o);
  P2RF_ReadVme (drvPvt, AIM_I_ATTRIBUTE, &rec->vatt);

  P2RF_ReadVme (drvPvt, AIM_I_SERIALHI,  &sernHi   );
  P2RF_ReadVme (drvPvt, AIM_I_SERIALLO,  &sernLo   );
  rec->sern = (sernHi << 16) | sernLo;

  P2RF_ReadVme (drvPvt, AIM_I_VERSION,   &rec->vern);
  P2RF_ReadVme (drvPvt, AIM_I_SUBCLASS,  &rec->vscl);

  rec->verh = P2RF_HWVER(rec->vern);
  rec->verf = P2RF_FWVER(rec->vern);

  rec->nchn = AIM_K_CHANCNT;

  /* Write some registers if we're doing a grounds-up initialization */
  if (initType == P2RF_K_COLDSTART)    status = ColdInit (brd, rec);
  else                                 status = WarmInit (brd, rec);

  /* Resman wrote 0xfffc to module control register; take down software int */
  rec->mctl = rec->mstt & (AIM_M_SFTRST | AIM_M_SYSFAILINH | AIM_M_A24A32);
  P2RF_WriteVme (drvPvt, AIM_I_CONTROL,  rec->mctl);
  P2RF_ReadVme  (drvPvt, AIM_I_STATUS,  &rec->mstt);

  /*
  |  Reading the Interrupt Status Register clears the outstanding Software
  |  Interrupt Status bit, but does not clear the pending interrupt.  Thus
  |  reading the register here would confuse the ISR when interrupts are
  |  enabled and the pending software interrupt is taken: the ISR would
  |  not be able to find the source of the interrupt.
  */

  /* Update the database copy of the module Status and control registers */
  P2RF_ReadVme (drvPvt, AIM_I_FISTAT, &rec->fstt);
  P2RF_ReadVme (drvPvt, AIM_I_FICTRL, &rec->fctl);

  return (status);
}


static long ColdInit (AimBoard      *brd,
                      P2RfAimRecord *rec)
/*
   Description
   -----------
   Initialization file to run when starting up from scratch.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("ColdInit");

  long            status = OK;
  long         tl_status = OK;		/* trip level status */

  register void  *drvPvt = brd->drvPvt;
  unsigned short  reg;

  /* Don't allow database access to the interrupt level */
  reg = (P2RF_K_INTLEVEL << AIM_V_INTLEVEL) & AIM_M_INTLEVEL;

  /* Initialize the Interrupt Control Register from the database */
  rec->ictl = ~(reg | ((rec->imsk << AIM_V_INTSELECT) & AIM_M_INTSELECT));
  P2RF_WriteVme (drvPvt, AIM_I_INTCTRL, rec->ictl);
  rec->oimk = rec->imsk;

  /* Read the Arc Channel Fault Enable Status */
  P2RF_ReadVme (drvPvt, AIM_I_FLTENBSTT, &reg);
  rec->qfes = reg;			/* save unadulterated contents */
  rec->afes = reg & AIM_M_FLTENBSTT;

  /* Read the Arc Current Status and look at enabled channels only */
  P2RF_ReadVme (drvPvt, AIM_I_ARCCURSTT, &reg);
  rec->qcst = reg;			/* save unadulterated contents */

  reg ^= AIM_M_ARCCURSTT_FLT;		/* Convert to low when FAULTED */
  rec->acst = reg & rec->afes;

  /* Read the Arc Latched Status and look at enabled channels only */
  P2RF_ReadVme (drvPvt, AIM_I_ARCLTDSTT, &reg);
  rec->qlst = reg;			/* save unadulterated contents */
  rec->alst = reg & rec->afes;          /* Bit(s) are low when FAULTED */

  /* Load the default trip levels */
  {
    unsigned short *tl   = &rec->tl1;	/* trip level values */
    unsigned short *tlp  = &rec->tlp1;	/* trip level previous values */
    unsigned short *tlr  = &rec->tlr1;	/* trip level readback values */
    unsigned short *tlam = &rec->tlam;	/* trip level readback alarm mask */
    unsigned short *tlas = &rec->tlas;	/* trip level readback alarm mask (sticky) */

    unsigned short  lvl;
    int             chan;

    *tlam = 0;						/* init readback alarm mask */
    *tlas = 0;

    for (chan = 0; chan < AIM_K_CHANCNT; chan++)
    {
      lvl = ((*tl) << AIM_V_TRIPLVL) & AIM_M_TRIPLVL;	/* trip level */
      *tlp = *tl;					/* "previous" trip level */

      /* for 12-channel AIM, add channel number... these bits aren't writable as such,
       * but we add them here so the readback test will work
       */
      if (AIM_IS12CH) lvl |= (chan << AIM_V_TRIPLVL_CHAN);

      /* Make sure that the register changed to what we set it to */
      P2RF_WriteVme (drvPvt, chan + AIM_I_TRIPLVL1, lvl);
      P2RF_ReadVme  (drvPvt, chan + AIM_I_TRIPLVL1, &reg);

      if (AIM_IS12CH) reg &= AIM_M_TRIPLVL_ALL;		/* fix 12-chan version */

      *tlr =  (reg & AIM_M_TRIPLVL) >> AIM_V_TRIPLVL;	/* init trip level readback (w/o chan#) */

      if (reg != lvl) {					/* init readback alarm */
	*tlam |= (1 << chan);	/* (this could also mean that chan# may have read back wrong) */
	*tlas |= (1 << chan);
      }

      if (reg != lvl)
      {
        char  buf[P2RF_K_BUFSIZE];

        recGblRecordError (
	   -1, rec,
	   P2RF_Sprintf (
		buf, __FILE__, FN,
		"Arc Trip Level register readback error: "
		"idx %hi, wrt %h04x, rd %h04x, xor %h04x\n",
		chan + AIM_I_TRIPLVL1,
		lvl, reg, reg ^ lvl)
	   );

        strncpy (rec->val, "Arc Trip Level register readback error",
                 sizeof (rec->val));

	tl_status = ERROR;
      }
    }
    tl++, tlp++, tlr++;
  }

  /* Read the data file and load the two DAS chips */
  if (AIM_IS7CH)
  {
    AimDasPrm  *prm = &brd->dasPrm[0];

    rec->d0as = NO_ALARM;
    if ((status = P2RF_LoadRegFile (drvPvt, prm->id, rec->d0if,
                                    prm->index, FALSE,
                                    rec->val, sizeof (rec->val))) != OK)
    {
      char  buf[P2RF_K_BUFSIZE];
      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_LoadRegFile",
                                       prm->id, rec->d0if));
      rec->d0as = UDF_ALARM;
    }

    /* Next chip */
    prm++;

    rec->d1as = NO_ALARM;
    if ((status = P2RF_LoadRegFile (drvPvt, prm->id, rec->d1if,
                                    prm->index, FALSE,
                                    rec->val, sizeof (rec->val))) != OK)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_LoadRegFile",
                                       prm->id, rec->d1if));
      rec->d1as = UDF_ALARM;
    }
  } /* end AIM_IS7CH */

  if (tl_status != OK) status = tl_status;

  return (status);
}



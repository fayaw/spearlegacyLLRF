#ifndef P2RFLIB_H
#define P2RFLIB_H

typedef long  Status;

#define Function(function)   static const char FN[] = (function)

#define Printf  if (P2RfDbg) P2RF_Printf
#ifdef DBG
#  define Dbg(cmd)  {cmd;}
#else
#  define Dbg(cmd)  {}
#endif

#define MASK(bit)            (1 << (bit))
#define wSizeOf(var)         (sizeof (var) / sizeof (short))
#define lSizeOf(var)         (sizeof (var) / sizeof (long))

#define BitClear(reg, mask)  ((reg) & ~(mask))
#define BitSet(reg, mask)    ((reg) |  (mask))

#define PI                   (4.0 * atan (1.0))
#define P2RF_V_FIRMWARE      8
#define P2RF_HWVER(reg)      ((reg) &  0xf)
#define P2RF_FWVER(reg)      (((reg) &  0xf00)>>P2RF_V_FIRMWARE)
#define P2RF_K_RFFREQ        476000000  /* 476 MHz */
/* 
** Harmonic number for PEPII and SPEAR3. The four items in this
** array correspond to the clock module configuration id register value.
*/
#define P2RF_K_HARMNO(i)          ((i)==2 ? 372 : 3492)
#define P2RF_K_ONETURN(i)       (P2RF_K_HARMNO(i) / P2RF_K_RFFREQ)
#define P2RF_K_SAMPFACT      72         /* 10 MHz Sampling Factor */
#define P2RF_K_NSPERSAMP(i)     (1e9*4*P2RF_K_SAMPFACT*P2RF_K_RFFREQ/P2RF_K_HARMNO(i))

#define P2RF_K_HERCAVCNT       4        /* Number of cavities in HER */
#define P2RF_K_LERCAVCNT       2        /* Number of cavities in LER */

#define P2RF_K_BUFSIZE       256        /* Message work buffer size */
#define P2RF_K_BLKSIZE      1024        /* Minimum block of history to read */

typedef struct
{
  float           fMin;                 /* Minimum floating point value coefficient is allowed to have */
  short           iMin;                 /* The short integer value that fMin corresponds to */
  float           fMax;                 /* Maximum floating point value coefficient is allowed to have */
  short           iMax;                 /* The short integer value that fMax corresponds to */
  short           iOff;                 /* An offset to be applied to the converted coefficient */
  short         (*cvtRtn)(void *, short); /* A conversion routine to use */
  void           *cvtArg;               /* An argument to pass to the conversion routine */
}  P2RfCvtBlk;

typedef struct
{
  unsigned short lo;
  unsigned short hi;
}  P2RfFc;

typedef struct
{
  int             fcCnt;                /* Coefficient count, 1-257 */
  unsigned short  f;                    /* F_REGISTER */
  P2RfFc          fc[257];              /* Max of 512 taps ==> 257 coefs, max */
  unsigned short  h1;                   /* H_REGISTER1 */
  unsigned short  h2;                   /* H_REGISTER2 */
}  P2RfDdf;

typedef struct _P2RfBufDsc
{
  unsigned int         count;
  short               *buffer;
  struct _P2RfBufDsc  *self;
}  P2RfBufDsc;


/* Forward references */
char   *P2RF_Sprintf        (char *, const char *, const char *, char *, ...);
int     P2RF_Printf         (const char *, const char *, char *, ...);

extern int P2RfDbg;

#endif

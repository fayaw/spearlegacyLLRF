static long Action (P2RfClkRecord    *rec)
/*
   Description
   -----------
   This is the action routine for the CLK.

   Parameters
   ----------
          rec - A pointer to the record structure

   Returns
   -------
   0 or 2 for successful returns, else a status
*/
{
  Function ("Action");

  ClkBoard       *brd    = NULL;
  void           *drvPvt;
  unsigned short  dctl;
  unsigned short  sctl;
  unsigned short  reg;
  unsigned short  btyp=0;


  /* If initialization failed let the system know */
  if ((brd = rec->dpvt) == NULL)  return (ERROR);
  drvPvt = brd->drvPvt;

  /* If processing was invoked by an interrupt, handle it */
  if (brd->intPrc)
  {
    /* Update client value of interrupt status field */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }

    /* Don't loose invocation count on multiple interrupts */
    brd->intPrc--;
    return (0);
  }

  /* Read the interrupt status register 
   * (this is a bad thing to do, only do if imsk==0) 
   */
  if (rec->rist) 
  {
    if (rec->imsk==0)
    {
      Read_IntStatus( brd,rec );
    }
    rec->rist=0;
    return(0);
  }

  /* Initialize the message buffer if we're not doing completion processing */
  if (!rec->pact)    strncpy (rec->val, "Success", sizeof (rec->val));

  /* If requested, do a "software reset" on the module */
  if (rec->mrst)  return (SpawnReset (rec, &brd->resetBlk));

  /* Let the operator acknowledge that the interrupts have been seen */
  if (rec->iack)
  {
    rec->istt &= ~rec->iack;            /* Take only requested bits down */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
    rec->iack = 0;
    db_post_events (rec, &rec->iack, DBE_VALUE | DBE_LOG);
  }

  /* Update the interrupt control register if there was a change request */
  if (rec->imsk != rec->oimk)
  {
    rec->oimk = rec->imsk;
    if (rec->verh == 1)
      rec->ictl = (rec->ictl & ~CLK_M_INTSELECT) |
        ((~rec->imsk << CLK_V_INTSELECT) & CLK_M_INTSELECT);
    else if (rec->verh == 2)
      rec->ictl = (rec->ictl & ~CLK_M_V2INTSELECT) |
        ((~rec->imsk << CLK_V_V2INTSELECT) & CLK_M_V2INTSELECT);
    else
      rec->ictl = (rec->ictl & ~CLK_M_V3INTSELECT) |
        ((~rec->imsk << CLK_V_V3INTSELECT) & CLK_M_V3INTSELECT);
    P2RF_WriteVme (drvPvt, CLK_I_INTCTRL, rec->ictl);
    db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
  }

  /* Get the current state of the trigger control register */
  P2RF_ReadVme (drvPvt, CLK_I_TRGCTRL, &reg);

  /* Potentially modify aux out/in levels, enable, aux out/in, soft trigger */
  reg  = (rec->auxo << CLK_V_AUXOUT) & CLK_M_AUXOUT;
  reg |= (rec->auxi << CLK_V_AUXIN)  & CLK_M_AUXIN;
  if (rec->axoe)  reg |= CLK_M_AUXOUTENB;
  if (rec->axie)  reg |= CLK_M_AUXINENB;
  if (rec->sftt)  reg |= (CLK_K_SOFTTRG << CLK_V_SOFTTRG) & CLK_M_SOFTTRG;

  /* Update the module and the database versions of Trigger Control register */
  if (reg != rec->tctl)
  {
    rec->tctl = reg;
    P2RF_WriteVme (drvPvt, CLK_I_TRGCTRL, rec->tctl);
    db_post_events (rec, &rec->tctl, DBE_VALUE | DBE_LOG);
  }

  /* Get the current state of the clock control register */
  P2RF_ReadVme (drvPvt, CLK_I_CLKCTRL, &dctl);

  /* Look at only those bits that are modifiable. Be version specific */
  if (rec->verh == 1)
  {
    dctl &= ~(CLK_M_FIDDEL | CLK_M_TRNCLKSEL | CLK_M_C39DELSEL);
    dctl |= (rec->tcsl ? 1 : 0) << CLK_V_TRNCLKSEL;
    /* Potentially change the turn clock selection, fiducial delay, Clk39 delay */
    dctl |= (((short) (rec->fdel / CLK_K_FIDDELRES))
             << CLK_V_FIDDEL)    & CLK_M_FIDDEL;
    dctl |= (((short) (rec->c39d / CLK_K_C39DELRES))
             << CLK_V_C39DELSEL) & CLK_M_C39DELSEL;
  }
  else           /* Board Version 2 code */
  {
    dctl &= ~(CLK_M_FIDDEL | CLK_M_V2TCLKDELSEL | CLK_M_C39DELSEL);
    /* Potentially change the turn clock selection, fiducial delay, Clk39 delay */
    dctl |= (((short) (rec->fdel / CLK_K_FIDDELRES))
             << CLK_V_FIDDEL)    & CLK_M_FIDDEL;
    dctl |= (((short) (rec->c39d / CLK_K_C39DELRES))
             << CLK_V_C39DELSEL) & CLK_M_C39DELSEL;
    dctl |= (((short) (rec->tclk / CLK_K_V2TCLKDELRES))
             << CLK_V_V2TCLKDELSEL) & CLK_M_V2TCLKDELSEL;
  }

  /* Update the module and the database versions of Clock Control register */
  if (dctl != rec->dctl)
  {
    rec->dctl = dctl;
    P2RF_WriteVme (drvPvt, CLK_I_CLKCTRL, rec->dctl);
    db_post_events (rec, &rec->dctl, DBE_VALUE | DBE_LOG);
  }

  /* If this is board version 2, update the synch/calibrate register */
  if (rec->verh >= 2)
  {
    /* Get the current state of the synch/calibrate register */
    P2RF_ReadVme (drvPvt, CLK_I_V2SYNCHCAL, &sctl);
    if (rec->verh==2) 
      sctl &= ~(CLK_M_V2SNCHDELSEL | CLK_M_V2SYNON | CLK_M_V2CALON);
    else
      sctl &= ~(CLK_M_V2SNCHDELSEL | CLK_M_V2SYNON);

    /* Potentially change the synch delay, synch on & calibrate on */
    sctl |= (((short) (rec->snch / CLK_K_V2SNCHDELRES))
             << CLK_V_V2SNCHDELSEL)    & CLK_M_V2SNCHDELSEL;
    if ((rec->caln) && (rec->verh==2))  sctl |= CLK_M_V2CALON;
  /* Update the module and the database versions of Synch Control register */
    if (sctl != rec->sctl)
    {
      rec->sctl = sctl;
      P2RF_WriteVme (drvPvt, CLK_I_V2SYNCHCAL, rec->sctl);
      db_post_events (rec, &rec->sctl, DBE_VALUE | DBE_LOG);
    }
  }

  /* 
  ** Read the configuration id constants register. This represents
  ** the dip switch settings (SW12 & SW13) that set ID values used to 
  ** indicate which system clock module is being used in :PEPII-HER,
  ** PEPII-LER or SPEAR3.
  */
  if (rec->verh > 2) 
  {
    P2RF_ReadVme (drvPvt, CLK_I_V3CFGID , &reg );
    btyp = reg & 0x3;
  }
  /* Update the database copy of the harmonic number readback register */
  P2RF_ReadVme (drvPvt, CLK_I_HARMNORB,  &reg);
  if (rec->verh == 1)
    rec->hnrb = 2.0 * (0x10000 - reg);
  else
    rec->hnrb = 2.0 * (0x10000 - reg +1);

  db_post_events (rec, &rec->hnrb, DBE_VALUE | DBE_LOG);
  if (rec->hnrb != P2RF_K_HARMNO(btyp))
  {
    char  buf[P2RF_K_BUFSIZE];
    int   stat = rec->hnrb > P2RF_K_HARMNO(btyp) ? HIHI_ALARM : LOLO_ALARM;

    recGblSetSevr (rec, stat, INVALID_ALARM);
    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "Harmonic Number Readback is not the expected %d: %d", P2RF_K_HARMNO(btyp), rec->hnrb));
  }

  /* Resynchronize the clocks to the external fiducial */
  if (rec->rsyn)
  {
    if (rec->verh == 1)
    {  
      P2RF_WriteVme (drvPvt, CLK_I_RESYNCH, 0);
    }
    else    /* Version 2 synch */
    {
      reg  = (((short) (rec->snch / CLK_K_V2SNCHDELRES))
              << CLK_V_V2SNCHDELSEL)    & CLK_M_V2SNCHDELSEL;
      if ((rec->caln) && (rec->verh==2)) reg |= CLK_M_V2CALON;  /* Or in calibrate bit */
      reg  |= CLK_M_V2SYNON;         /* Synchronize the clocks */
      P2RF_WriteVme (drvPvt, CLK_I_V2SYNCHCAL, reg);
      taskDelay (sysClkRateGet () / 10);  /* Delay a tad and do it twice */
      P2RF_WriteVme (drvPvt, CLK_I_V2SYNCHCAL, reg);
    }
    rec->rsyn = 0;
  }

  if (rec->verh == 1)
  {  
    /* Change the 471.1 MHz PLL constants, if requested */
    if (rec->p4cs != rec->op4c)
    {
      rec->op4c = rec->p4cs;
      rec->pll4 = (rec->p4cs == 0 ? CLK_K_471NORM :
                  (rec->p4cs == 1 ? CLK_K_471LOW  : CLK_K_471HIGH));

      P2RF_WriteVme (drvPvt, CLK_I_471MHZPLL, rec->pll4);
      db_post_events (rec, &rec->pll4, DBE_VALUE | DBE_LOG);
    }
  }
  return (0);
}


static void Read_IntStatus(ClkBoard       *brd,
                           P2RfClkRecord  *rec)
/*
   Description
   -----------
   This function reads the interrupt status register on the VXI module in A16 space.
   Please note that this register should NOT normally be read in this manner, since it is cleared
   on a read. However, interrupts are currently disabled on the clock module (see: IMSK=0)
   so polling this register is a way to report when an interrupt has occured t

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   N/A
*/
{
#if 0
  Function ("Read_IntStatus");
#endif
  unsigned short intStat=0;

  /* Read the interrupt status register */
  P2RF_ReadVme (brd->drvPvt, CLK_I_INTSTAT, &intStat);

#if 0
  Dbg (epicsPrintf ("%s (%s): intStat = %08x\n",__FILE__, FN, intStat));
#endif

  /* Is bit already set in istt field of the db? */
  if (intStat & (intStat ^ rec->istt)) 
  {
    rec->istt |= intStat;
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
  }
  return;
}


static long SpawnReset (P2RfClkRecord  *rec,
                        ClkRstBlk      *blk)
/*
   Description
   -----------
   This function initiates and completes the module reset.

   Parameters
   ----------
          rec - A pointer to the record
          blk - A pointer to the reset block

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnReset");


  if (!rec->pact)
  {
    /* Let operator know what's happening */
    strncpy (rec->val,  "Software Reset: active", sizeof (rec->val));
    strncpy (rec->oval, "Software Reset: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);

    /* Don't allow reprocessing of record before reset completes */
    rec->pact = TRUE;

    /* Disable module interrupts during software reset */
    P2RF_ModIntDisable (blk->drvPvt);

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
      strncpy (rec->val, "Attempt to initialize module failed", sizeof (rec->val));
      recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
    }
    else
    {
      /* Re-enable module interrupts */
      P2RF_ModIntEnable (blk->drvPvt);

      strncpy (rec->val, "Software reset: done", sizeof (rec->val));
    }

    /* Reset the reset request so we don't redo it on the next process pass */
    rec->mrst = 0;
  }

  return (0);
}



static void ResetCallback (ClkRstBlk  *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a module software reset it requested.  It invokes completion processing
   of the associated record.

   Parameters
   ----------
          blk - A pointer to the reset block

   Returns
   -------
   nothing
*/
{
  /* Function ("ResetCallback");*/

  struct dbCommon  *rec;
  struct rset      *rSet;


  /* Just return if record pointer isn't initialized */
  if ((rec = callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Reset and update the record and the module */
  blk->status = InitFields ((ClkBoard *) rec->dpvt, P2RF_K_COLDSTART);

  /* Complete processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     (rec);
}

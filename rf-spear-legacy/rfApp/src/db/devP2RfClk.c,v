#endif

  ClkBoard       *brd = (ClkBoard *) brdArg;
  P2RfClkRecord  *rec = brd->rec;


#if 0
  if (intStat & CLK_M_FIDERR)
    logMsg ("%s: Fiducial counter error\n", (int)FN,0,0,0,0,0);

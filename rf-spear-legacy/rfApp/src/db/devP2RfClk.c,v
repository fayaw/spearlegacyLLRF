    logMsg ("%s: DDF data overwritten (?)\n",(int)FN,0,0,0,0,0);

  if (intStat & CLK_M_PLL2U)
    logMsg ("%s: 471.1 MHz PLL unlocked\n", (int)FN,0,0,0,0,0);
  if (intStat & CLK_M_PLL1U)

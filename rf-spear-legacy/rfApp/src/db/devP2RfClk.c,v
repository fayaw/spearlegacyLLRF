static long InitRecord (P2RfClkRecord  *rec)
/*
   Description
   -----------
   Initialize the record.  Many fields of the record are filled with data from
   the hardware.  Depending on the start-up type (cold or warm) some record
   fields will either set up the hardware or get their values from a restore
   file.  Interrupts from the board are enabled at the end of the
   initialization.

   Parameters
   ----------
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("InitRecord");

  struct vxiio   *vxiIo = NULL;
  ClkBoard       *brd;
  long            status;
  void           *drvPvt;
  char           *msg   = "CLK module initialization failed";
  int             startType;


  /* rec.out must be of type VXI_IO */
  if (rec->out.type != VXI_IO)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_db_badField, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "Illegal OUT field"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return(S_db_badField);
  }

  /* Allocate the device private block */
  if ((brd = calloc (1, sizeof (*brd))) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "No memory for CLK board descriptor"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Register the module to get a driver handle */
  vxiIo = &rec->out.value.vxiio;
  if ((status = P2RF_RegisterModule (vxiIo->flag, vxiIo->frame, vxiIo->slot,
                                    vxiIo->la,
                                    CLK_K_MODEL, CLK_K_NAME, CLK_K_DRAWING,
                                    ClkIsr, brd, ClkShutdown, brd,
				     &drvPvt)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "P2RF_RegisterModule"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (status);
  }

  /* Set up the device private block and save a pointer to it in the record */
  brd->drvPvt = drvPvt;
  brd->rec    = rec;
  rec->dpvt   = brd;

  /* Initialize the callback facility for the reset function*/
  callbackSetCallback ((void*)ResetCallback, &brd->resetBlk.callback);
  callbackSetPriority (priorityHigh,         &brd->resetBlk.callback);
  callbackSetUser     (rec,                  &brd->resetBlk.callback);
  brd->resetBlk.drvPvt = drvPvt;

  /* Figure out the restart type -- To be determined */
  startType = P2RF_K_COLDSTART;

  /* Initialize the module and the database fields depending on startup type */
  if ((status = InitFields (brd, startType)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Enable module interrupts and update the database copy */
  P2RF_ModIntEnable (drvPvt);
  P2RF_ReadVme (drvPvt, CLK_I_INTCTRL, &rec->ictl);

  return (OK);
}



static long InitFields (ClkBoard *brd,
                        int       initType)
/*
   Description
   -----------
   Function to initialize the fields in the database record and/or the module,
   depending on the initialization type.

   Parameters
   ----------
          brd - A pointer to the device private block
     initType - Type of initialization.

   Returns
   -------
   Status
*/
{
  /*  Function ("InitFields");*/

  P2RfClkRecord  *rec    = brd->rec;
  void           *drvPvt = brd->drvPvt;
  long            status;
  unsigned short  sernHi;
  unsigned short  sernLo;


  /* Reset the module, if it's a cold startup.  This takes a while... */
  if (initType == P2RF_K_COLDSTART)  P2RF_ResetModule (drvPvt);

  /* Load the record fields with device data */
  P2RF_ReadVme (drvPvt, CLK_I_MANID,     &rec->mid );
  P2RF_ReadVme (drvPvt, CLK_I_MODELNO,   &rec->mtyp);
  P2RF_ReadVme (drvPvt, CLK_I_STATUS,    &rec->mstt);
  P2RF_ReadVme (drvPvt, CLK_I_ATTRIBUTE, &rec->vatt);
  P2RF_ReadVme (drvPvt, CLK_I_SERIALHI,  &sernHi   );
  P2RF_ReadVme (drvPvt, CLK_I_SERIALLO,  &sernLo   );
  rec->sern = (sernHi << 16) | sernLo;
  P2RF_ReadVme (drvPvt, CLK_I_VERSION,   &rec->vern);
  rec->verh = P2RF_HWVER(rec->vern);  /* save the lower nibble of the hardware version */
  rec->verf = P2RF_FWVER(rec->vern);  /* save the lower nibble of the firmware version */
  P2RF_ReadVme (drvPvt, CLK_I_SUBCLASS,  &rec->vscl);

  /* Write some registers if we're doing a grounds-up initialization */
  if (initType == P2RF_K_COLDSTART)    status = ColdInit (brd, rec);
  else                                 status = WarmInit (brd, rec);

  /* Resman wrote 0xfffc to module control register; take down software int */
  rec->mctl = rec->mstt & (CLK_M_SFTRST | CLK_M_SYSFAILINH);
  P2RF_WriteVme (drvPvt, CLK_I_CONTROL,  rec->mctl);
  P2RF_ReadVme  (drvPvt, CLK_I_STATUS,  &rec->mstt);

  /*
  |  Reading the Interrupt Status Register clears the outstanding Software
  |  Interrupt Status bit, but does not clear the pending interrupt.  Thus
  |  reading the register here would confuse the ISR when interrupts are
  |  enabled and the pending software interrupt is taken: the ISR would
  |  not be able to find the source of the interrupt.
  */

  /* Update the database copy of the Trigger and Clock control registers */
  P2RF_ReadVme (drvPvt, CLK_I_TRGCTRL, &rec->tctl);
  P2RF_ReadVme (drvPvt, CLK_I_CLKCTRL, &rec->dctl);
  /*
  ** Update synch/calibrate register if version 2.
  */
  if (rec->verh  >= 2)
  {
    P2RF_ReadVme (drvPvt, CLK_I_V2SYNCHCAL, &rec->sctl);
  }
  return (status);
}



static long ColdInit (ClkBoard      *brd,
                      P2RfClkRecord *rec)
/*
   Description
   -----------
   Initialization file to run when starting up from scratch.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("ColdInit");

  register void  *drvPvt = brd->drvPvt;
  unsigned short  reg;
  unsigned short  btyp=0;

  /* Don't allow database access to the interrupt level */
  reg = (P2RF_K_INTLEVEL << CLK_V_INTLEVEL) & CLK_M_INTLEVEL;

  /* Initialize the Interrupt Control Register from the database */
  if (rec->verh == 1)  
    rec->ictl = ~(reg | ((rec->imsk << CLK_V_INTSELECT) & CLK_M_INTSELECT));
  else if (rec->verh==2)
    rec->ictl = ~(reg | ((rec->imsk << CLK_V_V2INTSELECT) & CLK_M_V2INTSELECT));
  else
    rec->ictl = ~(reg | ((rec->imsk << CLK_V_V3INTSELECT) & CLK_M_V3INTSELECT));
  P2RF_WriteVme (drvPvt, CLK_I_INTCTRL, rec->ictl);
  rec->oimk = rec->imsk;

  /* Initialize the Trigger Control Register */
  reg  = (rec->auxo << CLK_V_AUXOUT) & CLK_M_AUXOUT;
  reg |= (rec->auxi << CLK_V_AUXIN)  & CLK_M_AUXIN;
  if (rec->axoe)  reg |= CLK_M_AUXOUTENB;
  if (rec->axie)  reg |= CLK_M_AUXINENB;
  if (rec->sftt)  reg |= (CLK_K_SOFTTRG << CLK_V_SOFTTRG) & CLK_M_SOFTTRG;
  P2RF_WriteVme (drvPvt, CLK_I_TRGCTRL, reg);
  rec->tctl = reg;

  /* 
  ** Read the configuration id constants register. This represents
  ** the dip switch settings (SW12 & SW13) that set ID values used to 
  ** indicate which system clock module is being used in :PEPII-HER,
  ** PEPII-LER or SPEAR3.
  */
  if (rec->verh > 2) 
  {
    P2RF_ReadVme (drvPvt, CLK_I_V3CFGID , &reg );
    btyp = reg & 0x3;
  }
  /* Get the harmonic number readback */
  P2RF_ReadVme (drvPvt, CLK_I_HARMNORB, &reg);
  if (rec->verh == 1)
    rec->hnrb = 2.0 * (0x10000 - reg);
  else
    rec->hnrb = 2.0 * (0x10000 - reg +1);

  if (rec->hnrb != P2RF_K_HARMNO(btyp))
  {
    char  buf[P2RF_K_BUFSIZE];
    int   stat = rec->hnrb > P2RF_K_HARMNO(btyp) ? HIHI_ALARM : LOLO_ALARM;

    recGblSetSevr (rec, stat, INVALID_ALARM);
    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
           "Harmonic Number Readback is not the expected %d: %d", P2RF_K_HARMNO(btyp), rec->hnrb));
  }


  /* Initialize the Clock Control Register */
  reg  = (((short) (rec->fdel / CLK_K_FIDDELRES))
          << CLK_V_FIDDEL)    & CLK_M_FIDDEL;
  reg |= (rec->tcsl ? 1 : 0) << CLK_V_TRNCLKSEL;
  reg |= (((short) (rec->c39d / CLK_K_C39DELRES))
          << CLK_V_C39DELSEL) & CLK_M_C39DELSEL;
  if (rec->verh >= 2)            /* If version 2 of the board */
  {  
    reg |= (((short) (rec->tclk / CLK_K_V2TCLKDELRES))
           << CLK_V_V2TCLKDELSEL) & CLK_M_V2TCLKDELSEL;
  }
  P2RF_WriteVme (drvPvt, CLK_I_CLKCTRL, reg);
  rec->dctl = reg;

  /* Initialize the Phase-Locked loop constants if board vers 1 */
  if (rec->verh == 1)
  {  
    rec->pll3 = CLK_K_39CONST;
    rec->pll4 = (rec->p4cs == 0 ? CLK_K_471NORM :
                (rec->p4cs == 1 ? CLK_K_471LOW  : CLK_K_471HIGH));

    P2RF_WriteVme (drvPvt, CLK_I_39MHZPLL,  rec->pll3);
    P2RF_WriteVme (drvPvt, CLK_I_471MHZPLL, rec->pll4);

    /* Always resynchronize to the fiducial at the beginning */
    P2RF_WriteVme (drvPvt, CLK_I_RESYNCH, 0);
  }
  else   /* Must be version 2. Init. synch/calibrate & R/O registers */
  {
    reg  = (((short) (rec->snch / CLK_K_V2SNCHDELRES))
            << CLK_V_V2SNCHDELSEL)    & CLK_M_V2SNCHDELSEL;
    P2RF_WriteVme (drvPvt, CLK_I_V2SYNCHCAL, reg);
    reg  |= CLK_M_V2SYNON;         /* Synchronize the clocks */
    P2RF_WriteVme (drvPvt, CLK_I_V2SYNCHCAL, reg);
    taskDelay (sysClkRateGet () / 10);  /* Delay a tad and do it twice */
    P2RF_WriteVme (drvPvt, CLK_I_V2SYNCHCAL, reg);
    taskDelay (sysClkRateGet () / 10);  /* Let synch settle */
    /*
    ** Get status of all interesting registers including synch/calibrate.
    */
    P2RF_ReadVme (drvPvt, CLK_I_V2SYNCHCAL,  &rec->sctl);
    P2RF_ReadVme (drvPvt, CLK_I_V239MHZPLL1, &rec->p391);
    P2RF_ReadVme (drvPvt, CLK_I_V239MHZPLL2, &rec->p392);
    P2RF_ReadVme (drvPvt, CLK_I_V2471MHZPLL, &rec->p471);
    if ( rec->verh==2 ) 
    {
       P2RF_ReadVme (drvPvt, CLK_I_V2CALIBPLL1, &rec->pcl1);
       P2RF_ReadVme (drvPvt, CLK_I_V2CALIBPLL2, &rec->pcl2);
    }
    if ( rec->verh==3 )
    {
      /* 
      ** Read the dip switch settings (SW8 & SW9) that control
      ** the delay generators for the turn counter output delay. 
      ** the PLL output clock delay and the Fiducial input pulse delay.
      ** Note:  these settings are preset, used to initialize the board at 
      ** power-up, and can be overridden by the values in the Delay Control 
      ** Register at A16 offset 0x24.
      *
      P2RF_ReadVme (drvPvt, CLK_I_V3DLYPRST   , &rec->cdly );
      */
    }
  }

  return (OK);
}




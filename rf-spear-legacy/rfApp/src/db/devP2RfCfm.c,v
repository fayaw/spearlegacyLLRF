static long InitRecord (P2RfCfmRecord  *rec)
/*
   Description
   -----------
   Initialize the record.  Many fields of the record are filled with data from
   the hardware.  Depending on the start-up type (cold or warm) some record
   fields will either set up the hardware or get their values from a restore
   file.  Interrupts from the board are enabled at the end of the
   initialization.

   Parameters
   ----------
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("InitRecord");

  struct vxiio   *vxiIo = NULL;
  CfmBoard       *brd;
  long            status;
  void           *drvPvt;
  char           *msg   = "CFM module initialization failed";
  int             startType;


  /* rec.out must be of type VXI_IO */
  if (rec->out.type != VXI_IO)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (S_db_badField, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "Illegal OUT field"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return(S_db_badField);
  }

  /* Allocate the device private block */
  if ((brd = calloc (1, sizeof (*brd))) == NULL)
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "No memory for CFM board descriptor"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Register the module to get a driver handle */
  vxiIo = &rec->out.value.vxiio;
  if ((status = P2RF_RegisterModule(vxiIo->flag, vxiIo->frame, vxiIo->slot,
                                    vxiIo->la,
                                    CFM_K_MODEL, CFM_K_NAME, CFM_K_DRAWING,
                                    CfmIsr, brd, CfmShutdown, brd,
                                    &drvPvt)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "P2RF_RegisterModule"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (status);
  }

  /* Set up the device private block and save a pointer to it in the record */
  brd->drvPvt = drvPvt;
  brd->rec    = rec;
  rec->dpvt   = brd;

  /* Initialize the callback facility for the reset function*/
  callbackSetCallback ((void*)ResetCallback, &brd->resetBlk.callback);
  callbackSetPriority (priorityHigh,         &brd->resetBlk.callback);
  callbackSetUser     (rec,                  &brd->resetBlk.callback);
  brd->resetBlk.drvPvt = drvPvt;

  /* Initialize the callback facility for loading coefficients */
  callbackSetCallback ((void*)LdCoefCallback, &brd->coefBlk.callback);
  callbackSetPriority (priorityLow,           &brd->coefBlk.callback);
  callbackSetUser     (rec,                   &brd->coefBlk.callback);
  brd->coefBlk.drvPvt = drvPvt;

  /* Load the static part of the coefficient parameter block */
  {
    CfmCoefPrm  *prm = &brd->eq0Prm;

    prm->id            = CFM_K_EQCOEFID;
    prm->coefs         = brd->eqCoefs0;
    prm->count         = CFM_K_EQCOEFCNT;
    prm->index         = CFM_I_EQCOEF0;
    prm->cvtBlk.fMin   = CFM_K_EQCOEFFMIN;
    prm->cvtBlk.fMax   = CFM_K_EQCOEFFMAX;
    prm->cvtBlk.iMin   = (short)CFM_K_EQCOEFIMIN;
    prm->cvtBlk.iMax   = CFM_K_EQCOEFIMAX;
    prm->cvtBlk.iOff   = 0;
#ifdef REVERSE_BITS
    prm->cvtBlk.cvtRtn = ReverseBits;
    prm->cvtBlk.cvtArg = NULL;
#else
    prm->cvtBlk.cvtRtn = NULL;
    prm->cvtBlk.cvtArg = NULL;
#endif
  }

  {
    CfmCoefPrm  *prm = &brd->eq1Prm;

    prm->id            = CFM_K_EQCOEFID;
    prm->coefs         = brd->eqCoefs1;
    prm->count         = CFM_K_EQCOEFCNT;
    prm->index         = CFM_I_EQCOEF1;
    prm->cvtBlk.fMin   = CFM_K_EQCOEFFMIN;
    prm->cvtBlk.fMax   = CFM_K_EQCOEFFMAX;
    prm->cvtBlk.iMin   = (short)CFM_K_EQCOEFIMIN;
    prm->cvtBlk.iMax   = CFM_K_EQCOEFIMAX;
    prm->cvtBlk.iOff   = 0;
#ifdef REVERSE_BITS
    prm->cvtBlk.cvtRtn = ReverseBits;
    prm->cvtBlk.cvtArg = NULL;
#else
    prm->cvtBlk.cvtRtn = NULL;
    prm->cvtBlk.cvtArg = NULL;
#endif
  }

  {
    CfmCoefPrm  *prm = &brd->iirPrm;

    prm->id            = CFM_K_IIRCOEFID;
    prm->coefs         = brd->iirCoefs;
    prm->count         = CFM_K_IIRCOEFCNT;
    prm->index         = CFM_I_IIRCOEF;
    prm->cvtBlk.fMin   = CFM_K_IIRCOEFFMIN;
    prm->cvtBlk.fMax   = CFM_K_IIRCOEFFMAX;
    prm->cvtBlk.iMin   = (short)CFM_K_IIRCOEFIMIN;
    prm->cvtBlk.iMax   = CFM_K_IIRCOEFIMAX;
    prm->cvtBlk.iOff   = 0;
    prm->cvtBlk.cvtRtn = NULL;
    prm->cvtBlk.cvtArg = NULL;
  }

  /* Initialize the callback facility for the get history function */
  brd->histBlk.drvPvt = drvPvt;
  callbackSetCallback ((void*)GetHistCallback, &brd->histBlk.callback);
  callbackSetPriority (priorityLow,            &brd->histBlk.callback);
  callbackSetUser     (rec,                    &brd->histBlk.callback);

  /* Load the static part of the history parameter block */
  {
    CfmMemPrm  *prm = &brd->histPrm;

    prm->id            = CFM_K_HISTID;
    prm->index         = CFM_I_HISTMEM;
  }

  /* Figure out the restart type -- To be determined */
  startType = P2RF_K_COLDSTART;

  /* Initialize the module and the database fields depending on startup type */
  if ((status = InitFields (brd, startType)))
  {
    char  buf[P2RF_K_BUFSIZE];

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Enable module interrupts and update the database copy */
  P2RF_ModIntEnable (drvPvt);
  P2RF_ReadVme (drvPvt, CFM_I_INTCTRL, &rec->ictl);

  return (OK);
}



#ifdef REVERSE_BITS
static short ReverseBits (void   *arg,
                          short   coef)
/*
   Description
   -----------
   Function to swap the bits around to compensate for a wiring error on the
   module.  Bit 0 is moved to bit 15 and vice versa, bit 1 to bit 14 and vice
   versa, etc.

   Parameters
   ----------
          arg - An unused argument
         coef - The coefficient to be converted

   Returns
   -------
   The converted coefficient
*/
{
  return (((coef & 0x0001) << 15) | ((coef & 0x0002) << 13) |
          ((coef & 0x0004) << 11) | ((coef & 0x0008) <<  9) |
          ((coef & 0x0010) <<  7) | ((coef & 0x0020) <<  5) |
          ((coef & 0x0040) <<  3) | ((coef & 0x0080) <<  1) |
          ((coef & 0x0100) >>  1) | ((coef & 0x0200) >>  3) |
          ((coef & 0x0400) >>  5) | ((coef & 0x0800) >>  7) |
          ((coef & 0x1000) >>  9) | ((coef & 0x2000) >> 11) |
          ((coef & 0x4000) >> 13) | ((coef & 0x8000) >> 15));
}
#endif



static long InitFields (CfmBoard *brd,
                        int       initType)
/*
   Description
   -----------
   Function to initialize the fields in the database record and/or the module,
   depending on the initialization type.

   Parameters
   ----------
          brd - A pointer to the device private block
     initType - Type of initialization.

   Returns
   -------
   Status
*/
{
  /*  Function ("InitFields");*/

  P2RfCfmRecord  *rec    = brd->rec;
  void           *drvPvt = brd->drvPvt;
  long            status;
  unsigned short  sernHi;
  unsigned short  sernLo;


  /* Reset the module, if it's a cold startup.  This takes a while... */
  if (initType == P2RF_K_COLDSTART)  P2RF_ResetModule (drvPvt);

  /* Load the record fields with device data */
  P2RF_ReadVme (drvPvt, CFM_I_MANID,     &rec->mid );
  P2RF_ReadVme (drvPvt, CFM_I_MODELNO,   &rec->mtyp);
  P2RF_ReadVme (drvPvt, CFM_I_STATUS,    &rec->mstt);
  P2RF_ReadVme (drvPvt, CFM_I_OFFSET,    &rec->a24o);
  P2RF_ReadVme (drvPvt, CFM_I_ATTRIBUTE, &rec->vatt);
  P2RF_ReadVme (drvPvt, CFM_I_SERIALHI,  &sernHi   );
  P2RF_ReadVme (drvPvt, CFM_I_SERIALLO,  &sernLo   );
  rec->sern = (sernHi << 16) | sernLo;
  P2RF_ReadVme (drvPvt, CFM_I_VERSION,   &rec->vern);
  rec->verh = P2RF_HWVER(rec->vern);  /* lower nibble of hardware version */
  rec->verf = P2RF_FWVER(rec->vern);  /* lower nibble of firmware version */

  /*================================================================
   * from Bill Ross 3/31/2005:
   * The model number is still 0x101.  The way to tell the Comb Version-2
   * from a Comb Version-1 is by looking at the Version Number Register.
   * It will show 0x1121 for the new Version-2 Comb.  (The old Comb reads
   * 0x1111.)
   *================================================================
   */
  if (rec->vern != 0x1111) return ERROR;      /* not a version 1 Comb (CFM) */
  P2RF_ReadVme (drvPvt, CFM_I_SUBCLASS,  &rec->vscl);

  /* Write some registers if we're doing a grounds-up initialization */
  if (initType == P2RF_K_COLDSTART)    status = ColdInit (brd, rec);
  else                                 status = WarmInit (brd, rec);

  /* Resman wrote 0xfffc to module control register; take down software int */
  rec->mctl = rec->mstt & (CFM_M_SFTRST | CFM_M_SYSFAILINH | CFM_M_A24A32);
  P2RF_WriteVme (drvPvt, CFM_I_CONTROL,  rec->mctl);
  P2RF_ReadVme  (drvPvt, CFM_I_STATUS,  &rec->mstt);

  /*
  |  Reading the Interrupt Status Register clears the outstanding Software
  |  Interrupt Status bit, but does not clear the pending interrupt.  Thus
  |  reading the register here would confuse the ISR when interrupts are
  |  enabled and the pending software interrupt is taken: the ISR would
  |  not be able to find the source of the interrupt.
  */

  /* Update the database copy of the Comb Status and Comb control registers */
  P2RF_ReadVme (drvPvt, CFM_I_COMBSTAT, &rec->cstt);
  P2RF_ReadVme (drvPvt, CFM_I_COMBCTRL, &rec->cctl);

  return (status);
}



static long ColdInit (CfmBoard      *brd,
                      P2RfCfmRecord *rec)
/*
   Description
   -----------
   Initialization file to run when starting up from scratch.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  Function ("ColdInit");

  register void  *drvPvt = brd->drvPvt;
  unsigned short  reg;
  long            status;


  /* Don't allow database access to the interrupt level */
  reg = (P2RF_K_INTLEVEL << CFM_V_INTLEVEL) & CFM_M_INTLEVEL;

  /* Initialize the Interrupt Control Register from the database */
  rec->ictl = ~(reg | ((rec->imsk << CFM_V_INTSELECT) & CFM_M_INTSELECT));
  P2RF_WriteVme (drvPvt, CFM_I_INTCTRL, rec->ictl);
  rec->oimk = rec->imsk;

  /* Make sure module is in LOAD state */
  P2RF_WriteVme (drvPvt, CFM_I_COMBCTRL, CFM_K_LOAD << CFM_V_STATE);

  /* Initialize the Equalizer Control Register before loading coefficients */
  P2RF_WriteVme (drvPvt, CFM_I_EQCTRL, CFM_K_EQCTRLVAL);
  rec->ectl   = CFM_K_EQCTRLVAL;

  /* Load Equalizer Coefficient set 0 from a file onto the module */
  {
    CfmCoefPrm  *prm = &brd->eq0Prm;

    if ((status = P2RF_ReadCoefFile (drvPvt, prm->id, rec->e0cf,
                                     prm->count, prm->coefs,
                                     rec->val, sizeof (rec->val))) == OK)
    {
      P2RF_LoadCoefs (drvPvt, prm->coefs, prm->count, prm->index, &prm->cvtBlk);
      rec->e0as = NO_ALARM;
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_ReadCoefFile",
                                       prm->id, rec->e0cf));
      rec->e0as = UDF_ALARM;
    }
  }

  /* Load Equalizer Coefficient set 1 from a file onto the module */
  {
    CfmCoefPrm  *prm = &brd->eq1Prm;

    if ((status = P2RF_ReadCoefFile (drvPvt, prm->id, rec->e1cf,
                                     prm->count, prm->coefs,
                                     rec->val, sizeof (rec->val))) == OK)
    {
      P2RF_LoadCoefs (drvPvt, prm->coefs, prm->count, prm->index, &prm->cvtBlk);
      rec->e1as = NO_ALARM;
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s (%s), file = %s",
                                       "P2RF_ReadCoefFile",
                                       prm->id, rec->e1cf));
      rec->e1as = UDF_ALARM;
    }
  }

  /* Initialize the Comb IIR Control Latches */
  P2RF_WriteVme (drvPvt, CFM_I_DVALIDM, CFM_K_DVALIDM);
  P2RF_WriteVme (drvPvt, CFM_I_DVALIDI, CFM_K_DVALIDI);
  P2RF_WriteVme (drvPvt, CFM_I_EN0M,    CFM_K_EN0M);
  P2RF_WriteVme (drvPvt, CFM_I_EN0I,    CFM_K_EN0I);
  P2RF_WriteVme (drvPvt, CFM_I_EN1M,    CFM_K_EN1M);
  P2RF_WriteVme (drvPvt, CFM_I_EN1I,    CFM_K_EN1I);
  P2RF_WriteVme (drvPvt, CFM_I_EN2M,    CFM_K_EN2M);
  P2RF_WriteVme (drvPvt, CFM_I_EN2I,    CFM_K_EN2I);
  P2RF_WriteVme (drvPvt, CFM_I_EN3M,    CFM_K_EN3M);
  P2RF_WriteVme (drvPvt, CFM_I_EN3I,    CFM_K_EN3I);
  P2RF_WriteVme (drvPvt, CFM_I_RES0M,   CFM_K_RES0M);
  P2RF_WriteVme (drvPvt, CFM_I_RES0I,   CFM_K_RES0I);
  P2RF_WriteVme (drvPvt, CFM_I_RES1M,   CFM_K_RES1M);
  P2RF_WriteVme (drvPvt, CFM_I_RES1I,   CFM_K_RES1I);
  P2RF_WriteVme (drvPvt, CFM_I_RES2M,   CFM_K_RES2M);
  P2RF_WriteVme (drvPvt, CFM_I_RES2I,   CFM_K_RES2I);
  P2RF_WriteVme (drvPvt, CFM_I_RES3M,   CFM_K_RES3M);
  P2RF_WriteVme (drvPvt, CFM_I_RES3I,   CFM_K_RES3I);

  /* Initialize the Comb IIR Mode Latches */
  P2RF_WriteVme (drvPvt, CFM_I_DMUX,    CFM_K_DMUX);
  P2RF_WriteVme (drvPvt, CFM_I_MUX,     CFM_K_MUX );
  P2RF_WriteVme (drvPvt, CFM_I_MISC,    CFM_K_MISC);

  /* Initialize the Comb IIR Coefficient Latches */
  {
    CfmCoefPrm  *prm = &brd->iirPrm;

    if ((status = P2RF_ReadCoefFile (drvPvt, prm->id, rec->imcf,
                                     prm->count, prm->coefs,
                                     rec->val, sizeof (rec->val))) == OK)
    {
      P2RF_LoadCoefs (drvPvt, prm->coefs, prm->count, prm->index, &prm->cvtBlk);
      rec->fstt = NO_ALARM;
    }
    else
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s (%s), file = %s",
                                       "P2RF_ReadCoefFile",
                                       prm->id, rec->imcf));
      rec->fstt = UDF_ALARM;
    }
  }

  /* Delay FIFO Control Registers - Empty & Full offsets */
  {
    short ticks = rec->f0fo / CFM_K_FIFOTICK;

    if (ticks < CFM_K_FIFOMIN)  ticks = CFM_K_FIFOMIN;
    if (ticks > CFM_K_FIFOMAX)  ticks = CFM_K_FIFOMAX;

    /* Double write is black magic necessary to make it work */
    P2RF_WriteVme (drvPvt, CFM_I_FIFO0EMP,  ticks);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO0FULL, CFM_K_FIFOMAX +
                                            CFM_K_FIFOMIN - ticks);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO1EMP,  0);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO1FULL, rec->f1fo);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO2EMP,  0);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO2FULL, rec->f2fo);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO3EMP,  0);
    P2RF_WriteVme (drvPvt, CFM_I_FIFO3FULL, rec->f3fo);

    /* Save current one-turn delay value */
    rec->of0f = rec->f0fo;
  }

  /* Initialize the Comb Control Register */
  reg  = (rec->mtl  << CFM_V_MEMTRGSEL)  & CFM_M_MEMTRGSEL;
  reg |= (rec->itl  << CFM_V_INPTRGSEL)  & CFM_M_INPTRGSEL;
  reg |= (rec->da   << CFM_V_DATAALIGN)  & CFM_M_DATAALIGN;
  reg |= (rec->ebs  << CFM_V_EQCOEFSEL)  & CFM_M_EQCOEFSEL;
  reg |= (rec->css  << CFM_V_CMBCOEFSEL) & CFM_M_CMBCOEFSEL;

  /* Get the operating mode */
  switch (rec->mode)
  {
    case cfmLoad:  reg |= CFM_K_LOAD  << CFM_V_STATE;  break;
    case cfmRun:   reg |= CFM_K_RUN   << CFM_V_STATE;  break;
    case cfmTest:  reg |= CFM_K_SSRUN << CFM_V_STATE;  break;
  }

  /* Enable history buffer recording */
  reg |= CFM_M_MEMTRGRST;

  /* Update the module and the database */
  P2RF_WriteVme (drvPvt, CFM_I_COMBCTRL, reg);
  rec->cctl = reg;

  return (OK);
}




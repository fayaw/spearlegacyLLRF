                      P2RfCfmRecord  *rec)
/*
   Description
   -----------
   Initialization routine to run when the module is still running
   satisfactorily.  This function will (when it is written) bring
   the EPICS database in synch with the module.

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   status
*/
{
  /* Note that we can't access A24 registers whilst Comb is running */

  /* Restore the Equalizer Coefficient fields from reboot parameter file? */

  /* Determine the current mode of the module */
  {
    CfmState      mode[] = {cfmLoad, cfmTest, cfmRun, cfmRun};
    unsigned int  state  = (rec->cctl & CFM_M_STATE) >> CFM_V_STATE;

    rec->mode = state < CFM_K_STATECNT ? mode[state] : cfmInvalid;
  }

  return (OK);
}



static long Action (P2RfCfmRecord    *rec)
/*
   Description
   -----------
   This is the action routine for the CFM.  It handles the several states
   that the module can be in.  The module's state can be changed by modifying
   the .MODE field of the record.  The available states are:

   cfmLoad - Put the Comb Control register in the LOAD state.  In this
             state various module registers are accessable that other-
             wise aren't.  This state is used to read the module's
             history buffer, reload coefficient tables, and change the
             one-turn delay.
   cfmRun  - Start normal operation (comb and equalizer filtering) of
             the module.
   cfmTest - This state is probably not very useful from an EPICS point
             of view.  It single steps data through the module with
             each VME write cycle.  Once the module is put in this state
             the write cycles must be externally introduced (say, with Vbb).

   Additionally, an asynchronous module reset mechanism implemented.  This
   feature toggles the software reset line on the VXI interface chip.  Since it
   takes a while (on the order of a second) for the reset to complete, the
   module must not be touched during its assertion.  To implement this, the
   record is processed asynchronously.  When the reset completes, the database
   fields are updated with the current state of the module

   Parameters
   ----------
          rec - A pointer to the record structure

   Returns
   -------
   0 or 2 for successful returns, else a status */
{
  Function ("Action");

  CfmBoard       *brd    = NULL;
  void           *drvPvt;
  unsigned short  cctl;
  CfmState       state  = cfmInvalid;
  unsigned short  reg;


  /* If initialization failed let the system know */
  if ((brd = rec->dpvt) == NULL)  return (ERROR);
  drvPvt = brd->drvPvt;

  /* If processing was invoked by an interrupt, handle it */
  if (brd->intPrc)
  {
    /* Update client value of interrupt status field */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }

    /* Don't loose invocation count on multiple interrupts */
    brd->intPrc--;

    /* Update the database copy of the Comb status register */
    P2RF_ReadVme (drvPvt, CFM_I_COMBSTAT,  &rec->cstt);
    db_post_events (rec, &rec->cstt, DBE_VALUE | DBE_LOG);

    return (0);
  }

  /* Read the interrupt status register 
   * (this is a bad thing to do, only do if IMSK=0)
   */
  if (rec->rist) 
  {
    if (rec->imsk==0) 
    {
      Read_IntStatus( brd,rec );
    }
    rec->rist=0;
    return(0);
  }

  /* Initialize the message buffer if we're not doing completion processing */
  if (!rec->pact)    strncpy (rec->val, "Success", sizeof (rec->val));

  /* If requested, do a "software reset" on the module */
  if (rec->mrst)  return (SpawnReset (rec, &brd->resetBlk));

  /* If operator disabled interrupts update interrupt status DB field */
  P2RF_ReadVme (brd->drvPvt, CFM_I_INTCTRL, &reg);
  if ((reg & CFM_M_INTSELECT) == CFM_M_INTSELECT)
  {
    P2RF_ReadVme (brd->drvPvt, CFM_I_INTSTAT, &rec->istt);
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
  }

  /* Let the operator acknowledge that the interrupts have been seen */
  if (rec->iack)
  {
    rec->istt &= ~rec->iack;            /* Take only requested bits down */
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
    rec->iack = 0;
    db_post_events (rec, &rec->iack, DBE_VALUE | DBE_LOG);
  }

  /* Update the interrupt control register if there was a change request */
  if (rec->imsk != rec->oimk)
  {
    rec->oimk = rec->imsk;
    rec->ictl = (rec->ictl & ~CFM_M_INTSELECT) |
      ((~rec->imsk << CFM_V_INTSELECT) & CFM_M_INTSELECT);
    P2RF_WriteVme (drvPvt, CFM_I_INTCTRL, rec->ictl);
    db_post_events (rec, &rec->ictl, DBE_VALUE | DBE_LOG);
  }

  /* Get the current state of the module */
  P2RF_ReadVme (drvPvt, CFM_I_COMBCTRL, &cctl);

  /* Check if the Comb Control register needs updating */
  {
    CfmState      mode[] = {cfmLoad, cfmTest, cfmRun, cfmRun};
    unsigned int  iState = (cctl & CFM_M_STATE) >> CFM_V_STATE;

    /* Look at only those bits that are modifiable */
    cctl &= ~(CFM_M_STATE     | CFM_M_CMBCOEFSEL |
              CFM_M_EQCOEFSEL | CFM_M_DATAALIGN);

    /* Potentially select a new operating mode */
    switch (rec->mode)
    {
      case cfmLoad:  iState = CFM_K_LOAD;   break;
      case cfmRun:   iState = CFM_K_RUN;    break;
      case cfmTest:  iState = CFM_K_SSRUN;  break;
      default:
        strncpy (rec->val, "Invalid state requested", sizeof (rec->val));
        return (0);
        break;
    }
    cctl  |= iState << CFM_V_STATE;
    state = mode[iState];

    /* Potentially select a different comb coefficient bank */
    cctl  |= (rec->css << CFM_V_CMBCOEFSEL) & CFM_M_CMBCOEFSEL;

    /* Potentially select a different equalizer coefficient bank */
    cctl  |= (rec->ebs << CFM_V_EQCOEFSEL)  & CFM_M_EQCOEFSEL;

    /* Potentially select a different pre-DAC data alignment */
    cctl  |= (rec->da << CFM_V_DATAALIGN)   & CFM_M_DATAALIGN;

    /* Update the module and the database versions of Comb Control register */
    if (cctl != rec->cctl)
    {
      P2RF_WriteVme (drvPvt, CFM_I_COMBCTRL,  cctl);
      P2RF_ReadVme  (drvPvt, CFM_I_COMBCTRL, &rec->cctl);
      db_post_events (rec, &rec->cctl, DBE_VALUE | DBE_LOG);

      /* Make sure that the register changed to what we set it to */
      if (cctl != rec->cctl)
      {
        epicsPrintf ("%s - Comb Control register readback error: wrt %04x, rd %04x, xor %04x\n",
                     FN, cctl, rec->cctl, cctl ^ rec->cctl);
        strncpy (rec->val, "Comb Control register readback error",
                 sizeof (rec->val));
      }
    }
  }

  /* Update the database copy of the Comb status register */
  P2RF_ReadVme (drvPvt, CFM_I_COMBSTAT,  &rec->cstt);
  db_post_events (rec, &rec->cstt, DBE_VALUE | DBE_LOG);

  /* Get the current digitized module input value and store it in the record */
  if (state != cfmTest)
  {
    P2RF_ReadVme (drvPvt, CFM_I_INPRDOUT, &reg);
    rec->ipro = reg >> 4;
    db_post_events (rec, &rec->ipro, DBE_VALUE | DBE_LOG);
  }

  /* Update the one-turn delay, if requested */
  if (rec->f0fo != rec->of0f)
  {
    if (state != cfmRun)
    {
      short ticks = rec->f0fo / CFM_K_FIFOTICK;

      if (ticks < CFM_K_FIFOMIN)  ticks = CFM_K_FIFOMIN;
      if (ticks > CFM_K_FIFOMAX)  ticks = CFM_K_FIFOMAX;

      P2RF_WriteVme (drvPvt, CFM_I_FIFO0EMP,  ticks);
      P2RF_WriteVme (drvPvt, CFM_I_FIFO0FULL, CFM_K_FIFOMAX +
                                              CFM_K_FIFOMIN - ticks);
      rec->of0f = rec->f0fo;
    }
    else
    {
      /*                 "0123456789112345678921234567893123456789" */
      strncpy (rec->val, "One-turn delay: Module not in LOAD mode", sizeof (rec->val));
      rec->f0fo = rec->of0f;
      db_post_events (rec, &rec->f0fo, DBE_VALUE | DBE_LOG);
      recGblSetSevr (rec, WRITE_ALARM, MINOR_ALARM);
    }
  }

  /* Don't attempt to get history or load coefficients if wrong module state */
  if (state != cfmLoad)
  {
    char *msg = NULL;

    if (rec->ghst)
    {
      msg = "Get History: Module not in LOAD mode";
      rec->ghst = 0;
      rec->hstt = WRITE_ALARM;
      db_post_events (rec, &rec->hstt, DBE_VALUE | DBE_LOG);
    }
    if ((rec->le0c) || (rec->le1c) || (rec->limc))
    {
      msg = "Coef Load: Module not in LOAD mode";
      if (rec->le0c)
      {
        rec->le0c = 0;
        rec->e0as = WRITE_ALARM;
        db_post_events (rec, &rec->e0as, DBE_VALUE | DBE_LOG);
      }
      if (rec->le1c)
      {
        rec->le1c = 0;
        rec->e1as = WRITE_ALARM;
        db_post_events (rec, &rec->e1as, DBE_VALUE | DBE_LOG);
      }
      if (rec->limc)
      {
        rec->limc = 0;
        rec->fstt = WRITE_ALARM;
        db_post_events (rec, &rec->fstt, DBE_VALUE | DBE_LOG);
      }
    }

    if (msg)  strncpy (rec->val, msg, sizeof (rec->val));
    return (0);
  }

  /* Process request to read out the module's history buffer */
  if (rec->ghst)  return (SpawnGetHist (rec, &rec->ghst, &brd->histBlk,
                                        &brd->histPrm, rec->hsiz, rec->hfil,
                                        &rec->hstt));

  /* Process request to load bank 0 equalizer coefficients */
  if (rec->le0c)  return (SpawnLdCoefs (rec, &rec->le0c, &brd->coefBlk,
                                        &brd->eq0Prm, rec->e0cf, &rec->e0as));

  /* Process request to load bank 1 equalizer coefficients */
  if (rec->le1c)  return (SpawnLdCoefs (rec, &rec->le1c, &brd->coefBlk,
                                        &brd->eq1Prm, rec->e1cf, &rec->e1as));

  /* Process request to load comb IIR MAC coefficients */
  if (rec->limc)  return (SpawnLdCoefs (rec, &rec->limc, &brd->coefBlk,
                                        &brd->iirPrm, rec->imcf, &rec->fstt));

  return (0);
}


static void Read_IntStatus(CfmBoard       *brd,
                           P2RfCfmRecord  *rec)
/*
   Description
   -----------
   This function reads the interrupt status register on the VXI module in A16 space.
   Please note that this register should NOT normally be read in this manner, since it is cleared
   on a read. However, interrupts are currently disabled on the Comb module (see: IMSK=0)
   so polling this register is a way to report when an interrupt has occured t

   Parameters
   ----------
          brd - A pointer to the board descriptor
          rec - A pointer to the record

   Returns
   -------
   N/A
*/
{
#if DEBUG
  Function ("Read_IntStatus");
#endif
  unsigned short intStat=0;

  /* Read the interrupt status register */
  P2RF_ReadVme (brd->drvPvt, CFM_I_INTSTAT, &intStat);

#if DEBUG   
  Dbg (epicsPrintf ("%s (%s): intStat = %08x\n",__FILE__, FN, intStat));
#endif

  /* Is bit already set in istt field of the db? */
  if (intStat & (intStat ^ rec->istt)) 
  {
    rec->istt |= intStat;
    if (rec->istt != rec->oist)
    {
      db_post_events (rec, &rec->istt, DBE_VALUE | DBE_LOG);
      rec->oist = rec->istt;
    }
  }
  return;
}


static long SpawnReset (P2RfCfmRecord  *rec,
                        CfmRstBlk      *blk)
/*
   Description
   -----------
   This function initiates and completes the module reset.

   Parameters
   ----------
          rec - A pointer to the record
          blk - A pointer to the reset block

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnReset");


  if (!rec->pact)
  {
    /* Let operator know what's happening */
    strncpy (rec->val,  "Software Reset: active", sizeof (rec->val));
    strncpy (rec->oval, "Software Reset: active", sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);

    /* Don't allow reprocessing of record before reset completes */
    rec->pact = TRUE;

    /* Disable module interrupts during software reset */
    P2RF_ModIntDisable (blk->drvPvt);

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      char  buf[P2RF_K_BUFSIZE];

      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
      strncpy (rec->val, "Attempt to initialize module failed", sizeof (rec->val));
      recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
    }
    else
    {
      /* Re-enable module interrupts */
      P2RF_ModIntEnable (blk->drvPvt);

      strncpy (rec->val, "Software reset: done", sizeof (rec->val));
    }

    /* Reset the reset request so we don't redo it on the next process pass */
    rec->mrst = 0;
  }

  return (0);
}



static void ResetCallback (CfmRstBlk  *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a module software reset it requested.  It invokes completion processing
   of the associated record.

   Parameters
   ----------
          blk - A pointer to the reset block

   Returns
   -------
   nothing
*/
{
  /* Function ("ResetCallback");*/

  struct dbCommon  *rec;
  struct rset      *rSet;


  /* Just return if record pointer isn't initialized */
  if ((rec = callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Reset and update the record and the module */
  blk->status = InitFields ((CfmBoard *) rec->dpvt, P2RF_K_COLDSTART);

  /* Complete processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     (rec);
}



static long SpawnLdCoefs (P2RfCfmRecord  *rec,
                          unsigned char  *request,
                          CfmCoefBlk     *blk,
                          CfmCoefPrm     *prm,
                          char           *file,
                          unsigned short *stat)
/*
   Description
   -----------
   This function initiates and completes the loading of coefficients
   on the module.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the coefficient block
          prm - A pointer to the coefficient parameter block
         file - The file that contains the coefficients to load
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnLdCoefs");

  char  buf[P2RF_K_BUFSIZE];


  if (!rec->pact)
  {
    sprintf (buf, "Load %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);
    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before coef load completes */
    rec->pact = TRUE;

    /* Save the file name in the parameter block */
    prm->file = file;

    /* Point the coefficient block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_ReadCoefFile",
                                       prm->id, prm->file));
      *stat = WRITE_ALARM;
    }
    else
    {
      sprintf (buf, "Load %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));

      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}



static void LdCoefCallback (CfmCoefBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to load equallizer or IIR coefficients.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the load-coefficients block

   Returns
   -------
   nothing
*/
{
  /* Function ("LdCoefCallback"); */

  P2RfCfmRecord    *rec;
  struct rset      *rSet;
  CfmCoefPrm       *prm = blk->prm;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Read and load the coefficients */
  if ((blk->status = P2RF_ReadCoefFile (blk->drvPvt, prm->id, prm->file,
                                        prm->count, prm->coefs,
                                        rec->val, sizeof (rec->val))) == OK)
  {
    P2RF_LoadCoefs (blk->drvPvt, prm->coefs, prm->count,
                    prm->index, &prm->cvtBlk);
  }

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}



static long SpawnGetHist (P2RfCfmRecord  *rec,
                          unsigned char  *request,
                          CfmHistBlk     *blk,
                          CfmMemPrm      *prm,
                          unsigned int    blkCnt,
                          char           *file,
                          unsigned short *stat)
/*
   Description
   -----------
   This function initiates and completes the retrieval of module history.

   Parameters
   ----------
          rec - A pointer to the record
      request - A pointer to the record field that initiated this action
          blk - A pointer to the history block
          prm - A pointer to the history parameter block
       blkCnt - Number of blocks of history to record
         file - The file to record the history in
         stat - A pointer to a record field in which to return status info

   Returns
   -------
   0 for success
*/
{
  Function ("SpawnGetHist");

  char  buf[P2RF_K_BUFSIZE];


  if (!rec->pact)
  {
    sprintf (buf, "Get %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val,  DBE_VALUE | DBE_LOG);
    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before get-history completes */
    rec->pact = TRUE;

    /* Save block count and file name in parameter block and reset abort flag */
    prm->count    = blkCnt < CFM_K_HISTMEMLEN ? blkCnt : CFM_K_HISTMEMLEN;
    prm->file     = file;
    blk->abortFlg = FALSE;

    /* Point the history block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else
  {
    if (blk->status)
    {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN, "%s failed",
                                       "P2RF_RecordMemory"));
      *stat = READ_ALARM;
    }
    else
    {
      sprintf (buf, "Get %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));

      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Reset request so we don't redo it on the next process pass */
    *request = 0;
  }

  return (0);
}



static void GetHistCallback (CfmHistBlk *blk)
/*
   Description
   -----------
   This is the callback routine that is invoked by the callback facility
   when a request is made to read the modules history memory.  It invokes
   completion processing of the associated record.

   Parameters
   ----------
          blk - A pointer to the get-history block

   Returns
   -------
   nothing
*/
{
  /* Function ("GetHistCallback"); */

  P2RfCfmRecord    *rec;
  struct rset      *rSet;
  CfmMemPrm        *prm = blk->prm;


  /* Just return if record pointer isn't initialized */
  if ((callbackGetUser (rec, &blk->callback)) == NULL)  return;
  rSet = rec->rset;

  /* Delay a bit to let db_post_events flush */
  taskDelay (sysClkRateGet () / 10);

  /* Lock the record to prevent processing during critical times */
  dbScanLock       ((struct dbCommon *) rec);

  /* Read the history memory and record it */
  blk->status = P2RF_RecordMemory (blk->drvPvt, prm->id, prm->index,
                                   prm->count, prm->file, &blk->abortFlg,
                                   rec->val, sizeof (rec->val));

  /* Pulse the Memory Trigger Reset bit to re-enable history triggers */
  P2RF_WriteVme (blk->drvPvt, CFM_I_COMBCTRL, rec->cctl | CFM_M_MEMTRGRST);
  P2RF_WriteVme (blk->drvPvt, CFM_I_COMBCTRL, rec->cctl);

  /* Complete the record processing */
  (*rSet->process) (rec);

  /* Unlock the record */
  dbScanUnlock     ((struct dbCommon *) rec);
}

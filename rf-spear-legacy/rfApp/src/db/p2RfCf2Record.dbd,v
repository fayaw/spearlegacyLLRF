recordtype(p2RfCf2) {
#
	include "dbCommon.dbd"
#
	field(VAL,DBF_STRING) {
		prompt("Status message")
		asl(ASL0)
		pp(TRUE)
		size(40)
	}
	field(OVAL,DBF_STRING) {
		prompt("Previous Value")
		special(SPC_NOMOD)
		interest(3)
		size(40)
	}
	field(OUT,DBF_OUTLINK) {
		prompt("Output Specification")
		promptgroup(GUI_OUTPUT)
		special(SPC_NOMOD)
		interest(1)
	}
	field(PREC,DBF_SHORT) {
		prompt("Display Precision")
		promptgroup(GUI_DISPLAY)
		interest(1)
	}
	field(MID,DBF_USHORT) {
		prompt("Manufacturer ID")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MTYP,DBF_USHORT) {
		prompt("Model Type")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MSTT,DBF_USHORT) {
		prompt("Module Status")
		special(SPC_NOMOD)
	}
	field(MCTL,DBF_USHORT) {
		prompt("Module Control")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(MRST,DBF_SHORT) {
		prompt("Module Reset")
		pp(TRUE)
		interest(2)
	}
	field(A24O,DBF_USHORT) {
		prompt("A24 Offset")
		special(SPC_NOMOD)
		interest(3)
	}
	field(VATT,DBF_USHORT) {
		prompt("VXI Attributes")
		special(SPC_NOMOD)
		interest(3)
	}
	field(SERN,DBF_ULONG) {
		prompt("Serial Number")
		special(SPC_NOMOD)
		interest(3)
	}
	field(VERN,DBF_USHORT) {
		prompt("Version Number")
		special(SPC_NOMOD)
		interest(3)
	} 
#
#  Hardware/Firmware versions
#
        field(VERH,DBF_USHORT) {
                prompt("Hardware Version")
                special(SPC_NOMOD)
                interest(3)
        }
        field(VERF,DBF_USHORT) {
                prompt("Firmware Version")
                special(SPC_NOMOD)
                interest(3)
        }
# ------------------------------------------------
 	field(CCTL,DBF_USHORT) {
 		prompt("Comb Control")
 		special(SPC_NOMOD)
 		pp(TRUE)
 	}
 	field(CSTT,DBF_USHORT) {
 		prompt("Comb Status")
 		special(SPC_NOMOD)
 		interest(1)
 	}
# OVFL, derived from CSTT
 	field(OVFL,DBF_USHORT) {
 		prompt("Overflow Status")
 		special(SPC_NOMOD)
 		interest(1)
 	}
 	field(FIFO,DBF_FLOAT) {
 		prompt("FIFO length")
 		promptgroup(GUI_COMMON)
 		pp(TRUE)
 	}
	field(DMON,DBF_USHORT) {
		prompt("data monitor")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(GDEL,DBF_USHORT) {
		prompt("one-turn delay")
		special(SPC_NOMOD)
		pp(TRUE)
	}
 	field(IACK,DBF_USHORT) {
 		prompt("Interrupt Oper Ack")
 		pp(TRUE)
 		interest(2)
 	}
	field(IAOV,DBF_USHORT) {
		prompt("I-ADC Overflow")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(ICOV,DBF_USHORT) {
		prompt("I-Comb Overflow")
		special(SPC_NOMOD)
		pp(TRUE)
	}
 	field(ICTL,DBF_USHORT) {
 		prompt("Interrupt Control")
 		special(SPC_NOMOD)
 		interest(2)
 	}
	field(IEOV,DBF_USHORT) {
		prompt("I-Equalizer Overflow")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(QAOV,DBF_USHORT) {
		prompt("Q-ADC Overflow")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(QCOV,DBF_USHORT) {
		prompt("Q-Comb Overflow")
		special(SPC_NOMOD)
		pp(TRUE)
	}
	field(QEOV,DBF_USHORT) {
		prompt("Q-Equalizer Overflow")
		special(SPC_NOMOD)
		pp(TRUE)
	}
 	field(IMSK,DBF_UCHAR) {
 		prompt("Interrupt Mask")
 		promptgroup(GUI_COMMON)
 		pp(TRUE)
 		base(HEX)
 		interest(1)
 	}
 	field(OIMK,DBF_UCHAR) {
 		prompt("Old Interrupt Mask")
 		interest(3)
 	}
 	field(ISTT,DBF_USHORT) {
 		prompt("Interrupt Status")
 		special(SPC_NOMOD)
 		pp(TRUE)
 		interest(2)
 	}
 	field(OIST,DBF_USHORT) {
 		prompt("Old Interrupt Status")
 		interest(3)
 	}
 	field(JCTL,DBF_USHORT) {
 		prompt("JTAG Control")
 		special(SPC_NOMOD)
 		pp(TRUE)
 		interest(2)
 	}
 	field(JDAT,DBF_USHORT) {
 		prompt("JTAG Data")
 		special(SPC_NOMOD)
 		pp(TRUE)
 		interest(2)
 	}
 	field(MLAD,DBF_USHORT) {
 		prompt("Logical Address")
 		special(SPC_NOMOD)
 		pp(TRUE)
 		interest(2)
 	}
 	field(MODE,DBF_UCHAR) {
 		prompt("Module Mode")
 		promptgroup(GUI_COMMON)
 		asl(ASL0)
 		pp(TRUE)
 	}
 	field(SIOR,DBF_UCHAR) {
 		prompt("Serial I/O Reset")
 		pp(TRUE)
 		interest(2)
 	}
 	field(SPNR,DBF_USHORT) {
 		prompt("serial port not ready err count")
 		special(SPC_NOMOD)
 		pp(TRUE)
 		interest(2)
 	}
 	field(SPRX,DBF_USHORT) {
 		prompt("serial port rx bad sym err count")
 		special(SPC_NOMOD)
 		pp(TRUE)
 		interest(2)
 	}
 	field(SRXR,DBF_UCHAR) {
 		prompt("Serial Rx Reset")
 		pp(TRUE)
 		interest(2)
 	}
 	field(MSTP,DBF_UCHAR) {
 		prompt("Mem Rec Stop")
 		pp(TRUE)
 		interest(2)
 	}
 	field(VSCL,DBF_USHORT) {
 		prompt("VXI Subclass")
 		special(SPC_NOMOD)
 		interest(3)
 	}
 	field(ADEL,DBF_SHORT) {
 		prompt("Archive Deadband")
 		promptgroup(GUI_DISPLAY)
 		interest(1)
 	}
 	field(MDEL,DBF_SHORT) {
 		prompt("Monitor Deadband")
 		promptgroup(GUI_DISPLAY)
 		interest(1)
 	}
 	field(ALST,DBF_SHORT) {
 		prompt("Last IPRO Archived")
 		special(SPC_NOMOD)
 		interest(3)
 	}
 	field(MLST,DBF_SHORT) {
 		prompt("Last IPRO Monitored")
 		special(SPC_NOMOD)
 		interest(3)
 	}
 	field(DBG,DBF_ULONG) {
 		prompt("Debug Flags")
 		promptgroup(GUI_COMMON)
 		initial("0")
 		interest(1)
		pp(TRUE)
 	}
 	field(STIK,DBF_ULONG) {
 		prompt("Sticky Error Flag")
 		promptgroup(GUI_COMMON)
 		initial("0")
 		interest(1)
 	}
#----------------------------------------------------------------
# include some fields from the original comb module to keep other
# seqs & dbs happy... will be ignored
#----------------------------------------------------------------
	field(F0FO,DBF_FLOAT) {
		prompt("FIFO 0 Full Offset")
		promptgroup(GUI_COMMON)
		pp(TRUE)
	}
 	field(OF0F,DBF_FLOAT) {
 		prompt("Old FIFO 0 Offset")
 		special(SPC_NOMOD)
 		interest(3)
 	}
#----------------------------------------------------------------
# Add generated coefficient field definitions
#----------------------------------------------------------------
include "p2RfCf2RecordCoefs.dbd"
}
@



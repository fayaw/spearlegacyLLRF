/*================================================================
 * check for coefficient load/save request (one button)
 *================================================================
 */

static void check_loadsave (P2RfCf2Record  *rec,
			    int             what,	/* 0=load,  1=save */
			    int             fnum,	/* 0=file1, 1=file2 */
			    Cf2CoefPrm     *prm,
			    int             curbank)
{
  Cf2Board  *brd = rec->dpvt;

  char   *filename = fnum ? prm->file2 : prm->file1;
  char   *comment  = fnum ? prm->comm2 : prm->comm1;
  ushort *status   = fnum ? prm->stat2 : prm->stat1;

  uchar  *sbut     = fnum ? prm->sbut2 : prm->sbut1;
  uchar  *lbut     = fnum ? prm->lbut2 : prm->lbut1;
  uchar  *button   = what ? sbut : lbut;

  int     allowed  = (rec->mode != cf2Run) || (prm->bank->num != curbank);

  static char  buf[P2RF_K_BUFSIZE];

  if (*button) {

    if (!allowed) {
      sprintf (buf, "Not allowed");
      strncpy (rec->val,  buf, sizeof (rec->val));
      strncpy (rec->oval, buf, sizeof (rec->oval));
      db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);
      *button = 0;	/* reset button */
      return;
    }


#ifdef DEBUG
printf(">>> (check_loadsave) what(%d) first_name(%s)\n",
       what,
       prm->bank->ploc->name);
#endif

    switch (what) {

    case 0:			/* load */

      SpawnLdCoefs (rec,
		    button,
		    &brd->ldCoefBlk,
		    prm,
		    filename,
		    comment,
		    status);
      break;

    case 1:			/* save */
      SpawnSvCoefs (rec,
		    button,
		    &brd->svCoefBlk,
		    prm,
		    filename,
		    comment,
		    status);
      break;

    }
  }
}


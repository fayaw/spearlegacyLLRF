static long ColdInit (Cf2Board      *brd,
                      P2RfCf2Record *rec)
/*
 *   Description
 *   -----------
 *   Initialization to run when starting up from scratch.
 *
 *   Parameters
 *   ----------
 *          brd - A pointer to the board descriptor
 *          rec - A pointer to the record
 *
 *   Returns
 *   -------
 *   status
 */
{
#if 0
  Function ("ColdInit");
#endif

  register void  *drvPvt = brd->drvPvt;

#if 0
  unsigned short  reg;
  long            status;
#endif

  int             i;

  ushort          mode;

#ifdef DEBUG
printf("(devP2RfCf2.c) ColdInit...\n");
#endif

  /* --- init h/w regs and module rec copies --- */

#if 0
...int ctl init
...put in LOAD state
...bits 0-2/0x20 -> always 0x7
#endif

     /*FIX FIX FIX........... init w/CW??  right phase...*/

  /* setup int ctl
   */
  rec->ictl = 0; 
  recBFSET(ictl,INTLEVEL,P2RF_K_INTLEVEL); 
  rec->ictl ^= -1;				/* invert all bits */
  recBFSET(ictl,IALLMSK,~(rec->imsk));		/* bits are inverted */
  WRITEREG(INTCTRL, rec->ictl);
  rec->oimk = rec->imsk;
  DBPOST(imsk);
  DBPOST(ictl);

  rec->jctl = 0;			/* JTAG Control */
  WRITEREG(JTAGCTL,rec->jctl);
  DBPOST(jctl);

  rec->cctl = 0;			/* Comb Control ... */
  recBFSET(cctl,DIARECENB,1);		/* history buffer record ON */
  recBFSET(cctl,HISRECENB,1);		/* diag buffer record ON */
  recBFSET(cctl,HISRUNSEL,0x7);		/* stop trigger always 1s */
  WRITEREG(COMBCTRL,rec->cctl);
  /* post() below */

  rec->dmon = 0;			/* Data Monitor Select */
  WRITEREG(DATAMONSEL,rec->dmon);
  DBPOST(dmon);

  rec->gdel = 0;			/* One-Turn Delay */
  WRITEREG(ONETURNDELAY,rec->gdel);


  /*----------------------------------------------------------------
   * zero out all h/w coefficients... update_coef()
   * will repopulate the h/w from record fields
   *----------------------------------------------------------------
   */

  mode = rec->mode;			/* save current state... */
  rec->mode = cf2Load;			/* ... and set to LOAD */
  READREG(COMBCTRL, &rec->cctl);
  recBFSET(cctl,STATE,rec->mode);
  WRITEREG(COMBCTRL, rec->cctl);
  DBPOST(cctl);

  for (i = 0; i < 3; i++) {		/* for all filters... */
    cf2_bank_t *pbank = cf2_all_banks[i];	/* get ptr to filter's bank array */

    while (pbank->nloc > 0) {			/* for all banks... */
      cf2_loc_t *ploc = pbank->ploc;			/* ptr to cf2_loc array */
      int        nloc = pbank->nloc;			/* len of cf2_loc array */

      while (nloc--) {					/* for all address blocks... */

	double *pval  = ploc->pval;
	int     index = ploc->index;			/* h/w address */
	int     count = ploc->count;			/* word count */

#ifdef DEBUG
	printf("(devP2RfCf2.c) clearing %s... @@ 0x%08X\n",ploc->name,index<<1);
#endif
	while (count--) {
	  P2RF_WriteVme (drvPvt, index++, 0x0000);	/* zero h/w reg */
	  *pval++ = 0.0;				/* ... and local copy */
	}
	ploc++;						/* next block of addresses */
      }
      pbank++;						/* next bank for this filter */
    }
  }

  /*----------------------------------------------------------------
   * update h/w with local coef values (they were init by save/restore)
   *   ... any different from zero will be loaded
   *----------------------------------------------------------------
   */
  update_coef_all (rec);

  /*----------------------------------------------------------------
   * verify all h/w coef regs... compare desired -v- actual
   *----------------------------------------------------------------
   */
  verify_coef_all (rec);

  /* restore saved module state
   */
  rec->mode = mode;
  recBFSET(cctl,STATE,rec->mode);
  WRITEREG(COMBCTRL, rec->cctl);
  DBPOST(cctl);

  return (rec->stik ? ERROR : OK);	/* obey sticky error */
}


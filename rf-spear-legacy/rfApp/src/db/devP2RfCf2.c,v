static long Action (P2RfCf2Record    *rec)
/*
 *   Description
 *   -----------
 *   This is the action routine for the CF2.  It handles the several states
 *   that the module can be in.  The module's state can be changed by modifying
 *   the .MODE field of the record.  The available states are:
 *
 *   cf2Load - Put the Comb Control register in the LOAD state.  In this
 *             state various module registers are accessable that other-
 *             wise aren't.  This state is used to read the module's
 *             history buffer, reload coefficient tables, and change the
 *             one-turn delay.
 *
 *   cf2Run  - Start normal operation (comb and equalizer filtering) of
 *             the module.
 *
 *   cf2Single - ...
 *
 *   cf2Idle - ...
 *
 *   Additionally, an asynchronous module reset mechanism is implemented.  This
 *   feature toggles the software reset line on the VXI interface chip.  Since it
 *   takes a while (on the order of a second) for the reset to complete, the
 *   module must not be touched during its assertion.  To implement this, the
 *   record is processed asynchronously.  When the reset completes, the database
 *   fields are updated with the current state of the module.
 *
 *   Parameters
 *   ----------
 *          rec - A pointer to the record structure
 *
 *   Returns
 *   -------
 *   0 or 2 for successful returns, else a status
 */
{
#if 0
  Function ("Action");
#endif

  Cf2Board       *brd    = NULL;
  void           *drvPvt;

#if 0
  unsigned short  reg;
  Cf2State        state  = cf2Invalid;
  unsigned short  cctl;
#endif

  int             i;
  int             n;

#if 0
{
 static int foo = 0;
 printf("\n*** Action! %d ***\n\n",foo++);
}
#endif

  /* If initialization failed let the system know */
  if ((brd = rec->dpvt) == NULL) return (ERROR);
  drvPvt = brd->drvPvt;

#if 0 /* interrupts? */
... see devP2RfCfm.c for example
#endif

  /* If requested, do a "software reset" on the module */
  if (rec->mrst) return (SpawnReset (rec, &brd->resetBlk));

  /* initialize the message buffer if we're not doing completion processing
   *   ... only if sticky error isn't set
   */
  if (!rec->stik) {
    if (!rec->pact) strncpy (rec->val, "Success", sizeof (rec->val));
  }

  /*================================================================
   * read some A16 regs to keep db (& displays) up to date
   *================================================================
   */

  READREG(STATUS ,      &rec->mstt); DBPOST(mstt);
  READREG(CONTROL,      &rec->mctl); DBPOST(mctl);

  READREG(INTSTAT,      &rec->istt); DBPOST(istt);
  READREG(INTCTRL,      &rec->ictl); DBPOST(ictl);

  READREG(COMBCTRL,     &rec->cctl); DBPOST(cctl);

  /* done below as part of error counts...
   *   READREG(COMBSTAT,     &rec->cstt); DBPOST(cstt);
   */

  READREG(DATAMONSEL  , &rec->dmon); DBPOST(dmon);
  READREG(ONETURNDELAY, &rec->gdel); DBPOST(gdel);

  READREG(JTAGCTL ,     &rec->jctl); DBPOST(jctl);
  READREG(JTAGDATA,     &rec->jdat); DBPOST(jdat);


  /* update interrupt control reg if requested
   */
  if (rec->imsk != rec->oimk) {
    recBFSET(ictl,IALLMSK,~(rec->imsk));	/* bits are inverted */
    WRITEREG(INTCTRL, rec->ictl);
    rec->oimk = rec->imsk;
    DBPOST(ictl);
  }

  /*================================================================
   * grab latched overflow status bits before they get cleared, for displays
   *================================================================
   */


#if 1 /* use CSTT */
#define CF2_M_ALLOVF \
  ( CF2_M_ICMBOVF | CF2_M_IEQUOVF | CF2_M_IADCOVF \
  | CF2_M_QCMBOVF | CF2_M_QEQUOVF | CF2_M_QADCOVF )
  READREG(COMBSTAT,&rec->cstt);
  rec->ovfl = (rec->cstt & CF2_M_ALLOVF) ? 1 : 0;	/* set OVFL, for module SEVR */
#else /* use ISTT */
#define CF2_M_ALLOVFLMSK \
  ( CF2_M_ICMBOVFLMSK | CF2_M_IEQUOVFLMSK | CF2_M_IADCOVFLMSK \
  | CF2_M_QCMBOVFLMSK | CF2_M_QEQUOVFLMSK | CF2_M_QADCOVFLMSK )
  rec->ovfl = (rec->istt & CF2_M_ALLOVFLMSK) ? 1 : 0;	/* set OVFL, for module SEVR */
#endif
  DBPOST(ovfl);


  /*================================================================
   * error counts
   *================================================================
   */

  /* accumulate error counts from h/w... accumulators are DOUBLEs
   */

  READREG(EC_SERNOTRDY, &rec->spnr);	rec->ecn1 += rec->spnr;
  READREG(EC_SERRXBADY, &rec->sprx);	rec->ecn2 += rec->sprx;

  READREG(EC_ICMBOVFL,  &rec->icov);	rec->ecn3 += rec->icov;
  READREG(EC_IEQUOVFL,  &rec->ieov);	rec->ecn4 += rec->ieov;
  READREG(EC_IADCOVFL,  &rec->iaov);	rec->ecn5 += rec->iaov;

  READREG(EC_QCMBOVFL,  &rec->qcov);	rec->ecn6 += rec->qcov;
  READREG(EC_QEQUOVFL,  &rec->qeov);	rec->ecn7 += rec->qeov;
  READREG(EC_QADCOVFL,  &rec->qaov);	rec->ecn8 += rec->qaov;

  /* reset h/w error counts & overflow status bits
   */
  WRITEREG(COMBSTAT,0x0);
#if 0
  READREG(COMBSTAT,&rec->cstt); ... wipes out overflow bits
#endif

  /* check error count reset button
   */
  if (rec->ecnr) {
    double *p = &rec->ecn1;
    int i;
    for (i = 0; i < 8; i++) *p++ = 0;	/* reset accumulators */
    DBSET(ecnr,0);			/* ... and the button */
  }

  /* update db... error counts will show most recent value
   */

  DBPOST(cstt);

  DBPOST(spnr); DBPOST(ecn1);
  DBPOST(sprx); DBPOST(ecn2);

  DBPOST(icov); DBPOST(ecn3);
  DBPOST(ieov); DBPOST(ecn4);
  DBPOST(iaov); DBPOST(ecn5);

  DBPOST(qcov); DBPOST(ecn6);
  DBPOST(qeov); DBPOST(ecn7);
  DBPOST(qaov); DBPOST(ecn8);



  /*================================================================
   * process GUI selections
   *================================================================
   */

  /*-------------------------------
   * (less-than-)one-turn delay
   *-------------------------------
   */
/* one-turn-delay nSec -> ticks conversion */
#define OTD_NS2TICKS  6.368172		/* ns... == [1 / (476Mhz * (8 / 97))] / 4 */

  {
    /* round to nearest quantum */
    ushort z = (ushort)( ((double)rec->fifo + (OTD_NS2TICKS/2)) / OTD_NS2TICKS );
    recBFSET(gdel,FIFOALL,z);
    DBPOST(fifo);
  }

  /* check db... "one-turn-delay" overrides the bank-select buttons */
  rec->xibs = recBFGET(gdel,INTBNKSEL);
  recBFSET(gdel,INTBNKSEL,rec->xibs);
  DBPOST(xibs);				/* sync display IBS btn */

  /*-------------------------------
   * I/O type -- analog/serial
   *-------------------------------
   */
  recBFSET(mctl,DSIO,(rec->xiot?0:1));	/* sense is inverted */
  DBPOST(xiot);

  /*-------------------------------
   * analog input type
   *-------------------------------
   */
  {
    ushort z = 0;
    switch (rec->xana) {
    case 0: z = 0x3; break;  		/* RFP */
    case 1: z = 0x1; break; 		/* front panel */
    case 2: z = 0x2; break; 		/* loopback */
    }
    recBFSET(mctl,ANATYPE,z);
    DBPOST(xana);
  }

  /*-------------------------------
   * comb filter bank select
   *-------------------------------
   */
  recBFSET(cctl,CMBBNKSEL,rec->xcbs);
  {
    uchar *p = &rec->cbs0;
    rec->cbs0 = rec->cbs1 = 0;
    if (rec->mode == cf2Run) {
      p[rec->xcbs & 0x1] = 1;
    }
  }
  DBPOST(xcbs);
  DBPOST(cbs0);
  DBPOST(cbs1);

  /*-------------------------------
   * equalizer filter bank select
   *-------------------------------
   */
  recBFSET(cctl,EQUBNKSEL,rec->xebs);
  {
    uchar *p = &rec->ebs0;
    rec->ebs0 = rec->ebs1 = 0;
    if (rec->mode == cf2Run) {
      p[rec->xebs & 0x1] = 1;
    }
  }
  DBPOST(xebs);
  DBPOST(ebs0);
  DBPOST(ebs1);

  /*-------------------------------
   * interpolation filter bank select
   *-------------------------------
   */
  recBFSET(gdel,INTBNKSEL,rec->xibs);
  /* DBPOST(xibs); ... feed back to btn ... done above */
  {
    uchar *p = &rec->ibs0;
    rec->ibs0 = rec->ibs1 = rec->ibs2 = rec->ibs3 = 0;
    if (rec->mode == cf2Run) {
      p[rec->xibs & 0x3] = 1;
    }
  }
  DBPOST(xibs);
  DBPOST(ibs0);
  DBPOST(ibs1);
  DBPOST(ibs2);
  DBPOST(ibs3);

  /*-------------------------------
   * pre-DAC data alignment
   *-------------------------------
   */
  recBFSET(cctl,SGP,rec->xdaa);
  DBPOST(xdaa);			/* for CW */


#ifdef DBG
/*** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG ***/
/*** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG ***/

  if (rec->dbg & 0x3) {		/* simulate h/w mem buf turn-off */
    {ushort z = (rec->dbg & 0x1) ? 1 : 0;  if (z) recBFSET(cctl,HISRECENB,0);}
    {ushort z = (rec->dbg & 0x2) ? 1 : 0;  if (z) recBFSET(cctl,DIARECENB,0);}
  }


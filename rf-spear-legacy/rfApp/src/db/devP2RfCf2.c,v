static long SpawnSvCoefs (P2RfCf2Record  *rec,
                          unsigned char  *button,
                          Cf2CoefBlk     *blk,
                          Cf2CoefPrm     *prm,
                          char           *filename,
                          char           *comment,
                          unsigned short *stat)
/*
 *   Description
 *   -----------
 *   This function initiates and completes the loading of coefficients
 *   on the module.
 *
 *   Parameters
 *   ----------
 *          rec - ptr to record
 *       button - ptr to record field that initiated this action
 *          blk - ptr to coefficient block
 *          prm - ptr to coefficient parameter block
 *         file - ptr to name of file to save coefficients in
 *         stat - ptr to a record field in which to return status info
 *
 *   Returns
 *   -------
 *   0 for success
 */
{
  Function ("SpawnSvCoefs");

  static char  buf[P2RF_K_BUFSIZE];

  if (!rec->pact) {
    sprintf (buf, "Save %s: active", prm->id);

    /* Let operator know what's happening */
    strncpy (rec->val,  buf, sizeof (rec->val));
    strncpy (rec->oval, buf, sizeof (rec->oval));
    db_post_events (rec, &rec->val, DBE_VALUE | DBE_LOG);

    *stat = UDF_ALARM;
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Don't allow record reprocessing record before coef load completes */
    rec->pact = TRUE;

    /* Save the file name and comment in the parameter block */
    prm->filename = filename;
    prm->comment  = comment;

    /* Point the coefficient block to the proper parameter block */
    blk->prm = prm;

    /* Invoke the call-back */
    callbackRequest (&blk->callback);
  }
  else {
    if (blk->status) {
      recGblRecordError (blk->status, rec,
                         P2RF_Sprintf (buf, __FILE__, FN,
                                       "%s failed - id = %s, file = %s",
                                       "P2RF_WriteCoefFile",
                                       prm->id, prm->filename));
      *stat = READ_ALARM;
    }
    else {
      sprintf (buf, "Save %s: done", prm->id);
      strncpy (rec->val, buf, sizeof (rec->val));
      *stat = NO_ALARM;
    }
    db_post_events (rec, stat, DBE_VALUE | DBE_LOG);

    /* Reset button so we don't redo it on the next process pass */
    *button = 0;
  }

  return (0);
}


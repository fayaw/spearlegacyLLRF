/*** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG *** DEBUG ***/
#endif


  /*-------------------------------
   * history & diagnostic memory record enables
   *  ... differentiate between gui- and hardware- (ie. fault) caused changes
   *  ... each changes the other, but h/w bit takes precedence
   *  ... ultimate h/w settings are fed back to gui buttons by DB record magic
   *  ... DBPOSTs of buttons come after MSTP processing below
   *-------------------------------
   */

#define BUFBUTT(_CTL_,_FIELD_) \
  {											\
    ushort z = recBFGET(cctl,_CTL_);		/* get h/w bit */			\
    if (z != rec->y##_FIELD_) {			/* if h/w changed from PREVIOUS */	\
      rec->x##_FIELD_ = z;			/* ... change gui button */		\
    }											\
    if (rec->x##_FIELD_ != rec->y##_FIELD_) {	/* then, if gui button changed */	\
      recBFSET(cctl,_CTL_,rec->x##_FIELD_);	/* ... update h/w (possibly unchanged) */ \
    }											\
    rec->y##_FIELD_ = rec->x##_FIELD_;		/* save (new?) current state */		\
  }
/****************************************************************/

  BUFBUTT(HISRECENB,hir);
  BUFBUTT(DIARECENB,dir);

#undef BUFBUTT


  /*-------------------------------
   * history/diag mem record STOP
   * ... provided to assure simultaneity of hist & diag stoppage
   *-------------------------------
   */
  if (rec->mstp) {
    recBFSET(cctl,DIARECENB,0);		/* both off */
    recBFSET(cctl,HISRECENB,0);
    rec->xdir = rec->ydir = 0;		/* DB will update gui buttons if needed... */
    rec->xhir = rec->yhir = 0;
    rec->mstp = 0;
    DBPOST(mstp);
  }

  /* now post the buttons
   */
  DBPOST(xdir);
  DBPOST(xhir);

  /*-------------------------------
   * digital gain: 1 or 4
   *-------------------------------
   */
  recBFSET(cctl,EDIG4,rec->xdga);
  DBPOST(xdga);

  /*-------------------------------
   * digital DC removal
   * ... affects 2 different regs
   *-------------------------------
   */
  {
    ushort z = (rec->xddc > 0) ? 1 : 0;		/* "enable" */
    recBFSET(cctl,EDDCR,z);
    if (z) {				/* if enabled, also update DDCR coef select */
      ushort m = rec->xddc - 1;		/* [1..4] => [0..3] */
      recBFSET(mctl,DDCRCOEF,m);
    }
    DBPOST(xddc);
  }

  /*-------------------------------
   * interpolation filter enable
   *-------------------------------
   */
  recBFSET(gdel,INTFILENB,rec->xifo);
  DBPOST(xifo);

  /*-------------------------------
   * serial loopback enable
   *-------------------------------
   */
  recBFSET(mctl,DSIOLOOP,(rec->xslb?0:1));	/* sense is inverted */
  DBPOST(xslb);

  /*-------------------------------
   * module run state
   *-------------------------------
   */
  recBFSET(cctl,STATE,rec->mode);
  DBPOST(mode);

  /*-------------------------------
   * history buffer source select
   *-------------------------------
   */
  recBFSET(dmon,IQMONSRC,rec->xhbs);
  DBPOST(xhbs);

  /*-------------------------------
   * diag mem 1 source select
   *-------------------------------
   */
  {
    ushort z = rec->xd1s;
    if (z > 3) z += 4;		/* map 4+ -> 8+ */
    recBFSET(dmon,MON1SRC,z);
    DBPOST(xd1s);
  }

  /*-------------------------------
   * diag mem 2 source select
   *-------------------------------
   */
  {
    ushort z = rec->xd2s;
    if (z > 3) z += 4;		/* map 4+ -> 8+ */
    recBFSET(dmon,MON2SRC,z);
    DBPOST(xd2s);
  }

  /*-------------------------------
   * scope sync source select
   *-------------------------------
   */
  recBFSET(dmon,SCOPESYNC,rec->xsys);
  DBPOST(xsys);

  /*-------------------------------
   * SIO/DCM Reset button
   *-------------------------------
   */
  if (rec->sior) {
    recBFSET(mctl,RSIODCM,1);  WRITEREG(CONTROL,rec->mctl);	/* toggle ctl bit */
    recBFSET(mctl,RSIODCM,0);  WRITEREG(CONTROL,rec->mctl);	/* ... */
    DBSET(sior,0);		/* reset gui button */
  }

  /*-------------------------------
   * Serial Rx Reset button
   *-------------------------------
   */
  if (rec->srxr) {
    recBFSET(cctl,RSPR,1);  WRITEREG(COMBCTRL,rec->cctl);	/* toggle ctl bit */
    recBFSET(cctl,RSPR,0);  WRITEREG(COMBCTRL,rec->cctl);	/* ... */
    DBSET(srxr,0);		/* reset gui button */
  }

  /* write final reg values to h/w & db
   */
  WRITEREG(CONTROL,     rec->mctl);	DBPOST(mctl);
  WRITEREG(COMBCTRL,    rec->cctl);	DBPOST(cctl);
  WRITEREG(ONETURNDELAY,rec->gdel);	DBPOST(gdel);
  WRITEREG(DATAMONSEL,  rec->dmon);	DBPOST(dmon);


  /*----------------------------------------------------------------
   * process requests to read out module's history buffer
   * ... only one allowed at a time (parms are shared)
   *----------------------------------------------------------------
   */

  check_gethist  (rec, &rec->ihgt, &rec->ihst, rec->ihsz,        rec->ihfn, CF2_I_IHIST_RW    );
  check_gethist  (rec, &rec->qhgt, &rec->qhst, rec->qhsz,        rec->qhfn, CF2_I_QHIST_RW    );

  check_gethist  (rec, &rec->d1gt, &rec->d1st, rec->d1sz,        rec->d1fn, CF2_I_MON1_DIAG_RW);
  check_gethist  (rec, &rec->d2gt, &rec->d2st, rec->d2sz,        rec->d2fn, CF2_I_MON2_DIAG_RW);

  /* "play" mem files are fixed size */
  check_loadplay (rec, &rec->ipgt, &rec->ipst, CF2_K_PLAYMEMLEN, rec->ipfn, CF2_I_IPLAY_RW    );
  check_loadplay (rec, &rec->qpgt, &rec->qpst, CF2_K_PLAYMEMLEN, rec->qpfn, CF2_I_QPLAY_RW    );


  /*----------------------------------------------------------------
   * check for file load/save requests
   *----------------------------------------------------------------
   */

  for (i = 0; i < 2; i++) {		/* 0=load, 1=save */

    for (n = 0; n < 2; n++) {		/* for (file1,file2) */
      check_loadsave (rec, i, n, &brd->cmb0Prm, rec->xcbs);
      check_loadsave (rec, i, n, &brd->cmb1Prm, rec->xcbs);
      check_loadsave (rec, i, n, &brd->equ0Prm, rec->xebs);
      check_loadsave (rec, i, n, &brd->equ1Prm, rec->xebs);
    }

    check_loadsave (rec, i, 0, &brd->int0Prm, rec->xibs);
    check_loadsave (rec, i, 0, &brd->int1Prm, rec->xibs);
    check_loadsave (rec, i, 0, &brd->int2Prm, rec->xibs);
    check_loadsave (rec, i, 0, &brd->int3Prm, rec->xibs);

    /*... break out if button pushed? multiple concurrent spawns possible? */
  }

  /*----------------------------------------------------------------
   * update h/w with changed coef fields, from GUI/CA/load
   *----------------------------------------------------------------
   */
  update_coef_all (rec);
  verify_coef_all (rec);

  /*----------------------------------------------------------------
   * Action() done!
   *  ... if sticky error set, re-assert it
   *----------------------------------------------------------------
   */
  if (rec->stik) {
    recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
  }

  return (0);
}


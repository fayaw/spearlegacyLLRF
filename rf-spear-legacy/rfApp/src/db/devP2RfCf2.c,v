  int        i;

  if ((fp = fopen(file, "w")) == 0) {
    msg = "file open error (write)";
    P2RF_Printf(__FILE__, FN, "%s: %s, file %s", "Comb2", msg, file);
    goto Error;
  }

  if (fprintf(fp,"%s\n",id) < 0) {		/* write ID string */

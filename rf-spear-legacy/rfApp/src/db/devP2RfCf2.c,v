/*================================================================
 * update changed coefs in ALL banks
 *  ... write changed values out to h/w
 *================================================================
 */

static void update_coef_all(P2RfCf2Record  *rec)
{
  Cf2Board    *brd = rec->dpvt;

  update_coef_bank (rec, &brd->cmb0Prm, rec->xcbs);
  update_coef_bank (rec, &brd->cmb1Prm, rec->xcbs);

  update_coef_bank (rec, &brd->equ0Prm, rec->xebs);
  update_coef_bank (rec, &brd->equ1Prm, rec->xebs);

  update_coef_bank (rec, &brd->int0Prm, rec->xibs);
  update_coef_bank (rec, &brd->int1Prm, rec->xibs);
  update_coef_bank (rec, &brd->int2Prm, rec->xibs);
  update_coef_bank (rec, &brd->int3Prm, rec->xibs);
}


/*================================================================
 * update changed coefs in ONE bank of ONE filter
 *================================================================
 */

static void update_coef_bank (P2RfCf2Record  *rec,
			     Cf2CoefPrm     *prm,
			     int             curbank)
{
  /* this code relies on the record's fields being in coefficient order... 
   */

/*Function ("update_coef_bank");*/

  Cf2Board    *brd    = rec->dpvt;
  void        *drvPvt = brd->drvPvt;

  cf2_bank_t  *pbank  = prm->bank;
  double      *pfield = prm->field;

  cf2_loc_t   *ploc = pbank->ploc;
  int          nloc = pbank->nloc;

  int          k,i;
  ushort       kk;
  double       z;

  /* not allowed if in RUN & active bank... UNLESS forced?  FIX FIX FIX ?
   */
  int          allowed = (rec->mode != cf2Run) || (pbank->num != curbank);

  while (nloc--) {

    double *pval   = ploc->pval;
    ushort *pkk    = ploc->pkk;
    int     index  = ploc->index;
    int     count  = ploc->count;

#if 0
    printf("(update_coef_bank) bank: %s\n",ploc->name);
#endif

    for (i = 0; i < count; i++) {

      if (*pfield != *pval) {		/* changed? */

	if (!allowed) {			/* if not allowed, restore to previous value */
	  *pfield = *pval;
	}
	else {

	  /* limit to [-2,+2]
	   */
	  z = *pfield;
	  z = max(z, -2.000);
	  z = min(z,  2.000);

	  /* map [-2,+2] to +/- 16 bits
	   *
	   * 100..0 = -2.000   = (1 << 15)
	   * 111..1 = -epsilon = (1 << 16) - 1
	   * 000..0 =  0.000   = 0
	   * 011..1 =  1.999   = (1 << 15) - 1
	   */

	  k = (z * (1 << 15) / 2.0) + ((z < 0) ? -0.5 : 0.5);	/* round towards zero */
	  k = max(k, -32768);
	  k = min(k,  32767);
	  kk = (ushort)k;

	  LAZMO_WriteVme (drvPvt, index, kk);

#if 0
	  printf("(update_coef) %s addr 0x%08X: coef %d changed from %f to %f (0x%04X)\n",
		 ploc->name,(index<<1),i,*pval,z,kk);
#endif

	  /* save new "current" values for comparison next time
	   */
	  *pval = *pfield;
	  *pkk = kk;
	}
	/* update DB subscribers */
	db_post_events (rec, pfield, DBE_VALUE | DBE_LOG);
      }

      pfield++;		/* record field double ptr */
      pval++;		/* current val double ptr */
      pkk++;		/* current val ushort ptr */
      index++;		/* reg address */
    }
    ploc++;	/* next block of coefs */
  }
}


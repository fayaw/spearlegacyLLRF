/*================================================================
 * verify coef regs
 *================================================================
 */

static void verify_coef_all(P2RfCf2Record  *rec)
{
  Cf2Board    *brd = rec->dpvt;

  verify_coef_bank (rec, &brd->cmb0Prm, rec->xcbs);
  verify_coef_bank (rec, &brd->cmb1Prm, rec->xcbs);

  verify_coef_bank (rec, &brd->equ0Prm, rec->xebs);
  verify_coef_bank (rec, &brd->equ1Prm, rec->xebs);

  verify_coef_bank (rec, &brd->int0Prm, rec->xibs);
  verify_coef_bank (rec, &brd->int1Prm, rec->xibs);
  verify_coef_bank (rec, &brd->int2Prm, rec->xibs);
  verify_coef_bank (rec, &brd->int3Prm, rec->xibs);
}


/*================================================================
 * verify ONE BANK of coef regs
 *================================================================
 */

static void verify_coef_bank (P2RfCf2Record  *rec,
			      Cf2CoefPrm     *prm,
			      int             curbank)
{
  /* this code relies on the record's fields being in coefficient order... 
   */

/*Function ("verify_coef_bank");*/

  Cf2Board    *brd    = rec->dpvt;
  void        *drvPvt = brd->drvPvt;

  cf2_bank_t  *pbank  = prm->bank;
  double      *pfield = prm->field;

  cf2_loc_t   *ploc = pbank->ploc;
  int          nloc = pbank->nloc;

  int          bank = pbank->num;	/* bank # */

  int          i;
  ushort       kk,kk2;

  int          errcnt = 0;		/* readback error count */

  static char  buf[P2RF_K_BUFSIZE];	/* msg buf */

  while (nloc--) {

    double *pval   = ploc->pval;
    ushort *pkk    = ploc->pkk;
    int     index  = ploc->index;
    int     count  = ploc->count;

#if 0
    printf("(verify_coef_bank) bank: %s\n",ploc->name);
#endif

    for (i = 0; i < count; i++) {

      kk = *pkk;				/* expected value */
      LAZMO_ReadVme (drvPvt, index, &kk2);	/* read coef reg */

      if (kk2 != kk) {		/* check readback */
	if (errcnt++ == 0) {	/* only notify once per bank... */

	  sprintf(buf, "Readback %s %d %04X:%04X/%04x/%04X",	/* addr:write/read/error */
		  ploc->name,bank,index<<1, kk, kk2, (kk ^ kk2));

	  strncpy (rec->val, buf, sizeof (rec->val));
	  recGblSetSevr (rec, UDF_ALARM, INVALID_ALARM);
	  rec->stik = 1;	/* set "sticky error" so next process doesn't clear it */
	  DBPOST(stik);
	}
      }
      pfield++;
      pval++;
      pkk++;
      index++;
    }
    ploc++;	/* next block of coefs */
  }
}


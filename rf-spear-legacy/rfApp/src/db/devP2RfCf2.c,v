/*================================================================================
 * recBFxxx() -- bit-field ops on module record fields
 *     recBFGET, recBFAND return a value
 *     recBFSET, recBFOR  set module record field "R"
 * all values are "baseband", ie. shifted down to bit 0
 *================================================================================
 */

/*--------------------------------------------------------------------------------*/

/* recBFGET: extract bitfield, shifted down to b0
 *	R module record field name
 *	F h/w register field name
 */
#define recBFGET(R,F) \
    (((rec->R) & CF2_M_##F) >> CF2_V_##F) 

/*--------------------------------------------------------------------------------*/

/* recBFAND: test bitfield via AND (use "recBFGET() ==" for comparison)
 *	R module record field name
 *	F h/w register field name
 *	Z value to AND with (unshifted)
 */
#define recBFAND(R,F,Z) \
    (recBFGET(R,F) & (Z))

/*--------------------------------------------------------------------------------*/

/* recBFSET: set bitfield to value
 *	R module record field name
 *	F h/w register field name
 *	Z value to set field to (unshifted)
 */
#define recBFSET(R,F,Z) \
    ( rec->R = ((rec->R) & ~CF2_M_##F) | (((Z) << CF2_V_##F) & CF2_M_##F) )

/*--------------------------------------------------------------------------------*/

/* recBFOR: or bits into bitfield
 *	R module record field name
 *	F h/w register field name
 *	Z value to OR in (unshifted)
 */
#define recBFOR(R,F,Z) \
    ( rec->R |= (((Z) << CF2_V_##F) & CF2_M_##F) )


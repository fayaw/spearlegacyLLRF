/* "LOAD" (file -> coef) callback
 */

static void LoadCoefCallback (Cf2CoefBlk *blk)
{
  /*Function ("LoadCoefCallback");*/

  P2RfCf2Record    *rec;
  struct rset      *rSet;
  Cf2CoefPrm       *prm = blk->prm;

  if ((callbackGetUser (rec, &blk->callback)) == NULL) return;	/* no rec ptr */

  rSet = rec->rset;

  taskDelay (sysClkRateGet() / 10);		/* delay to let db_post_events flush */

  dbScanLock ((struct dbCommon *) rec);		/* lock record */

  blk->status = 
    devCf2_ReadCoefFile (blk->drvPvt,
			 prm,
			 rec->val,
			 sizeof (rec->val));

  (*rSet->process) (rec);			/* complete record processing */

  dbScanUnlock ((struct dbCommon *) rec);	/* unlock record */
}


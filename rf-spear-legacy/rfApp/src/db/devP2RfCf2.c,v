/*--------------------------------------------------------------------------------
 * devCf2_ReadCoefFile(), adapted from drvP2RfVxi.c::P2RF_ReadCoefFile()
 *  ... rewritten to use "cf2_bank_t" struct to figure out where the coefs are
 *  ... reads one value per line; ignores rest of line
 *  ... allows blank lines between values
 *  ... allows comment lines (beginning with "#")
 *  ... reads one "comment" line after last coefficient
 *  ... forces h/w write of every coef by jamming *pval with bogus value
 *--------------------------------------------------------------------------------
 */

static Status devCf2_ReadCoefFile(
	void            *p2Rf,
	Cf2CoefPrm      *prm,
	char            *msgBuf,
	int              msgBufLen
)
{
  Function ("devCf2_ReadCoefFile");
     
  char       *id      = prm->id;	/* ID string (to compare with file) */
  char       *file    = prm->filename;	/* input file name */
  cf2_bank_t *bank    = prm->bank;	/* destination... one filter BANK */
  double     *pfield  = prm->field;	/* starting field */
  char       *comment = prm->comment;	/* file comment rec field (read from file) */

  cf2_loc_t *ploc = bank->ploc;		/* ptr to loc array */
  int        nloc = bank->nloc;		/* bank loc count */

  FILE      *fp;
  char      *msg = "";
  char       buf[132];
  double     z;

#if 1 /* (why not?) */
  if (comment) *comment = '\0';		/* clear it */
#endif

  if ((fp = fopen(file, "r")) == 0) {
    msg = "file open error (read)";
    P2RF_Printf(__FILE__, FN, "%s: %s, file %s", "Comb2", msg, file);
    goto Error;
  }

  /* read ID string */

  buf[0] = '\0';
  if ((fgets(buf,sizeof(buf),fp) == NULL) || (strstr(buf,id) == NULL)) {
    msg = "ID error";
    P2RF_Printf(__FILE__, FN, "%s: %s, file \"%s\"","Comb2", msg, file);
    P2RF_Printf(__FILE__, FN, "expected ID: \"%s\"", id);
    P2RF_Printf(__FILE__, FN, "not found in \"%s\"", buf);
    goto Error;
  }

  while (nloc-- > 0) {

    double *pval  = ploc->pval;
    int     count = ploc->count;
    int     n = 0;

    while (count > 0) {

      if (fgets(buf, 132, fp) == NULL) {
	msg = "unexpected EOF";
	goto Error;
      }

      /* if not empty or comment, get first number on line */
      if ((strlen(buf) > 0) && (buf[0] != '#')) {
	if (sscanf(buf, "%lf", &z) != 1) {
	  msg = "input format error";
	  goto Error;
	}
#ifdef DEBUG
printf("  (devCf2_ReadCoefFile) reading coef #%d: %e\n",n,z);
#endif

	*pfield++ = z;		/* stuff into record field */
	*pval++   = (z*0.5) + 1.0;	/* ... and force h/w update (catch 0 too) */

	count--;
	n++;

      }

    } /* end count */

    ploc++;			/* next loc */

  } /* end nloc */


  if (comment) {
    if (fgets(comment, CF2_K_COEF_CM_LEN, fp) == NULL) {
      msg = "comment read error";
      goto Error;
    }
    else {	/* remove trailing newline */
      char *p = strchr(comment,'\n');
      if (p) *p = 0;
    }
  }

  if (fclose(fp)) {
    msg = "close error";
    goto Error;
  }

  if (msgBuf)  strncpy(msgBuf, msg, msgBufLen);
  return OK;

/* error exit */
Error:
  if (msgBuf) strncpy(msgBuf, msg, msgBufLen);
  P2RF_Printf(__FILE__, FN, "%s: %s, file \"%s\"", "Comb2", msg, file);
  return ERROR;
}


static long InitRecord (P2RfCf2Record  *rec)
/*
 *   Description
 *   -----------
 *   Initialize the record.  Many fields of the record are filled with data from
 *   the hardware.  Depending on the start-up type (cold or warm) some record
 *   fields will either set up the hardware or get their values from a restore
 *   file.  Interrupts from the board are enabled at the end of the
 *   initialization.
 *
 *   Parameters
 *   ----------
 *          rec - A pointer to the record
 *
 *   Returns
 *   -------
 *   status
 */
{
  Function ("InitRecord");

  struct vxiio   *vxiIo = NULL;
  Cf2Board       *brd;
  long            status;
  void           *drvPvt;
  char           *msg   = "CF2 module initialization failed";

  int             i;

  static char  buf[P2RF_K_BUFSIZE];

  /* rec.out must be of type VXI_IO */
  if (rec->out.type != VXI_IO) {
    recGblRecordError (S_db_badField, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "Illegal OUT field"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return(S_db_badField);
  }

  /* Allocate the device private block */
  if ((brd = calloc (1, sizeof (*brd))) == NULL) {
    recGblRecordError (ERROR, rec,
                       P2RF_Sprintf (buf, __FILE__, FN,
                                     "No memory for CF2 board descriptor"));
    strncpy (rec->val, msg, sizeof (rec->val));
    return (ERROR);
  }

  /* Register the module to get a driver handle */
  vxiIo = &rec->out.value.vxiio;
  status = P2RF_RegisterModule(vxiIo->flag,
			       vxiIo->frame,
			       vxiIo->slot,
			       vxiIo->la,
			       CF2_K_MODEL,
			       CF2_K_NAME,
			       CF2_K_DRAWING,
			       Cf2Isr,
			       brd,
			       Cf2Shutdown,
			       brd,
			       &drvPvt);
  if (status) {
    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "P2RF_RegisterModule"));
    free (brd);
    rec->dpvt = NULL;
    strncpy (rec->val, msg, sizeof (rec->val));
    return (status);
  }

  /* Set up the device private block and save a pointer to it in the record */
  brd->drvPvt = drvPvt;
  brd->rec    = rec;
  rec->dpvt   = brd;


  /* ---------------- init callback stuff ---------------- */

  /* reset */
  callbackSetCallback ((void(*)())ResetCallback,     &brd->resetBlk.callback);
  callbackSetPriority (           priorityHigh,      &brd->resetBlk.callback);
  callbackSetUser     (           rec,               &brd->resetBlk.callback);
  brd->resetBlk.drvPvt = drvPvt;

  /* coef save */
  callbackSetCallback ((void(*)())SaveCoefCallback,  &brd->svCoefBlk.callback);
  callbackSetPriority (           priorityLow,       &brd->svCoefBlk.callback);
  callbackSetUser     (           rec,               &brd->svCoefBlk.callback);
  brd->svCoefBlk.drvPvt = drvPvt;

  /* coef load */
  callbackSetCallback ((void(*)())LoadCoefCallback,  &brd->ldCoefBlk.callback);
  callbackSetPriority (           priorityLow,       &brd->ldCoefBlk.callback);
  callbackSetUser     (           rec,               &brd->ldCoefBlk.callback);
  brd->ldCoefBlk.drvPvt = drvPvt;

  /*--------------------------------*/

  /* get history */
  callbackSetCallback ((void(*)())GetHistCallback,   &brd->histBlk.callback);
  callbackSetPriority (           priorityLow,       &brd->histBlk.callback);
  callbackSetUser     (           rec,               &brd->histBlk.callback);
  brd->histBlk.drvPvt = drvPvt;

  /* load play-mem  */
  callbackSetCallback ((void(*)())LdMemCallback,     &brd->ldMemBlk.callback);
  callbackSetPriority (           priorityLow,       &brd->ldMemBlk.callback);
  callbackSetUser     (           rec,               &brd->ldMemBlk.callback);
  brd->ldMemBlk.drvPvt = drvPvt;

  /* common prm */
  {
    Cf2MemPrm *prm = &brd->memPrm;
    prm->id        = NULL;		/* filled in when button pushed */
    prm->index     = NULL;		/* filled in when button pushed */
  }


  /* ---- init coefficient parameter blocks ---- */

/*--------------------------------------------------------------*/
#define COEFBLKINIT(LC,UC,BANK,FIELD,L1,S1,F1,C1,Z1,L2,S2,F2,C2,Z2)\
  {								\
    Cf2CoefPrm *prm = &brd->LC##BANK##Prm;			\
								\
    prm->id     =        CF2_K_##UC##_ID;			\
    prm->bank   =        &cf2_##LC##_banks[BANK];		\
    prm->field  =        &rec->FIELD;	/* first coef field */	\
								\
    prm->lbut1  =        &rec->L1;	/* load */		\
    prm->sbut1  =        &rec->S1;	/* save */		\
    prm->file1  = (char*)&rec->F1;	/* filename */		\
    prm->comm1  = (char*)&rec->C1;	/* comment */		\
    prm->stat1  =        &rec->Z1;	/* status */		\
								\
    prm->lbut2  =        &rec->L2;				\
    prm->sbut2  =        &rec->S2;				\
    prm->file2  = (char*)&rec->F2;				\
    prm->comm2  = (char*)&rec->C2;				\
    prm->stat2  =        &rec->Z2;				\
  }								\
/*--------------------------------------------------------------*/

  COEFBLKINIT( cmb,CMB,0,c000, cl10,cs10,cf10,cc10,cz10, cl20,cs20,cf20,cc20,cz20);
  COEFBLKINIT( cmb,CMB,1,c100, cl11,cs11,cf11,cc11,cz11, cl21,cs21,cf21,cc21,cz21);

  COEFBLKINIT( equ,EQU,0,e000, el10,es10,ef10,ec10,ez10, el20,es20,ef20,ec20,ez20);
  COEFBLKINIT( equ,EQU,1,e100, el11,es11,ef11,ec11,ez11, el21,es21,ef21,ec21,ez21);

  /* for int, repeat file1/etc... will be ignored */
  COEFBLKINIT( int,INT,0,i0ia, il00,is00,if00,ic00,iz00, il00,is00,if00,ic00,iz00);
  COEFBLKINIT( int,INT,1,i1ia, il01,is01,if01,ic01,iz01, il01,is01,if01,ic01,iz01);
  COEFBLKINIT( int,INT,2,i2ia, il02,is02,if02,ic02,iz02, il02,is02,if02,ic02,iz02);
  COEFBLKINIT( int,INT,3,i3ia, il03,is03,if03,ic03,iz03, il03,is03,if03,ic03,iz03);

#undef COEFBLKINIT

  /* alloc local mem for copies of coefficients ("old") values
   */

  for (i = 0; i < 3; i++) {		/* for all filters... */

    cf2_bank_t *pbank = cf2_all_banks[i];	/* get ptr to filter's bank array */

    while (pbank->nloc > 0) {			/* for all banks... */
      cf2_loc_t *ploc = pbank->ploc;			/* ptr to cf2_loc array */
      int        nloc = pbank->nloc;			/* len of cf2_loc array */

      while (nloc--) {					/* for all address blocks... */

	if (NULL == (ploc->pval = calloc(ploc->count,sizeof(double)))) {
	  recGblRecordError (ERROR, rec,
			     P2RF_Sprintf (buf, __FILE__, FN,
					   "malloc() failed for CF2 coef array"));
	  strncpy (rec->val, msg, sizeof (rec->val));
	  return (ERROR);
	}

#if 0
printf("(devP2RfCf2.c::InitRecord) calloc %s: 0x%08X (%d words)\n",
       ploc->name,ploc->pval,ploc->count);
#endif

	if (NULL == (ploc->pkk = calloc(ploc->count,sizeof(ushort)))) {
	  recGblRecordError (ERROR, rec,
			     P2RF_Sprintf (buf, __FILE__, FN,
					   "malloc() failed for CF2 coef array"));
	  strncpy (rec->val, msg, sizeof (rec->val));
	  return (ERROR);
	}

	ploc++; 
      }
      pbank++;						/* next bank for this filter */
    }
  }

  /* Initialize the module and the database fields
   *  ... also loads all h/w coef regs via ColdInit()
   */
  if ((status = InitFields (brd, P2RF_K_COLDSTART))) {

    recGblRecordError (status, rec,
                       P2RF_Sprintf (buf, __FILE__, FN, "InitFields"));
    free (brd);
    rec->dpvt = NULL;
    if (!rec->stik) {
      strncpy (rec->val, msg, sizeof (rec->val));
    }
    return (ERROR);
  }

#if 0
  /* Enable module interrupts and update the database copy */
  P2RF_ModIntEnable (drvPvt);
  READREG(INTCTRL, &rec->ictl);
#endif

#ifdef DEBUG
  printf("(devP2RfCf2.c) InitRecord done (OK).................\n");
#endif

  return (OK);
}

/********************************************************************************/

static long InitFields (Cf2Board *brd,
                        int       initType)
/*
 *   Description
 *   -----------
 *   Function to initialize the fields in the database record and/or the module,
 *   depending on the initialization type.
 *
 *   Parameters
 *   ----------
 *          brd - A pointer to the device private block
 *     initType - Type of initialization.
 *
 *   Returns
 *   -------
 *   Status
 */
{
  /*Function ("InitFields");*/

  P2RfCf2Record  *rec    = brd->rec;
  void           *drvPvt = brd->drvPvt;
  long            status;

  unsigned short  sernHi;
  unsigned short  sernLo;

  /* reset "sticky error" flag */
  rec->stik = 0;

  /* Reset the module, if it's a cold startup.  This takes a while... */
  if (initType == P2RF_K_COLDSTART) P2RF_ResetModule(drvPvt);

  /* Load the record fields with device data */
  READREG(MANID,     &rec->mid );
  READREG(MODELNO,   &rec->mtyp);
  READREG(STATUS,    &rec->mstt);
  READREG(OFFSET,    &rec->a24o);
  READREG(ATTRIBUTE, &rec->vatt);

  READREG(SERIALHI,  &sernHi   );
  READREG(SERIALLO,  &sernLo   );
  rec->sern = (sernHi << 16) | sernLo;

  READREG(VERSION,   &rec->vern);
  rec->verh = P2RF_HWVER(rec->vern);  /* upper nibble of hardware version */
  rec->verf = P2RF_FWVER(rec->vern);  /* lower nibble of firmware version */

  /*================================================================
   * from Bill Ross 3/31/2005:
   * The model number is still 0x101.  The way to tell the Comb Version-2
   * from a Comb Version-1 is by looking at the Version Number Register.
   * It will show 0x1121 for the new Version-2 Comb.  (The old Comb reads
   * 0x1111.)
   *================================================================
   */
  if (rec->vern != 0x1121) return ERROR;	/* not a version 2 Comb (CF2) */

  READREG(SUBCLASS,  &rec->vscl);

  /* Write some registers if we're doing a grounds-up initialization */
  if (initType == P2RF_K_COLDSTART) status = ColdInit (brd, rec);
  else                              status = WarmInit (brd, rec);

  /* set some bits in MCTL ... first, copy from MSTT */
  rec->mctl  = rec->mstt & (CF2_M_SFTRST | CF2_M_SYSFAILINH | CF2_M_A24A32);
  rec->mctl |= CF2_M_DDCRCOEF;
  rec->mctl |= CF2_M_RSIODCM;
  rec->mctl |= CF2_M_DSIO;
  rec->mctl |= CF2_M_DSIOLOOP;
  rec->mctl |= CF2_M_ANATYPE; /* 2 fields */

  WRITEREG(CONTROL,  rec->mctl);
  READREG(STATUS,   &rec->mstt);

  /*
  |  Reading the Interrupt Status Register clears the outstanding Software
  |  Interrupt Status bit, but does not clear the pending interrupt.  Thus
  |  reading the register here would confuse the ISR when interrupts are
..............................?
  |  enabled and the pending software interrupt is taken: the ISR would
  |  not be able to find the source of the interrupt.
  */

  /* Update the database copy of the Comb Status and Comb control registers */
  READREG(COMBSTAT, &rec->cstt);
  READREG(COMBCTRL, &rec->cctl);

  return (status);
}


int decode_slot0_reg( UINT32 base,UINT16 offset )
{
  static const UINT16  max  = CPU_A16_REG_BCNT-2;
  UINT16  *adrs_p = (UINT16 *)base + offset;

  if ( (offset%2) || (offset>max)){
    printf("Invalid byte offset (0 to 0x%2.2x (must be on word boundry)\n",max);
    return(ERROR);
  }

  switch( offset ) {
     case 0:
       decode_slot0_id(adrs_p);
       break;

     case 2:
       decode_slot0_dtype(adrs_p);
       break;

     case 4:
       decode_slot0_status(adrs_p);
       break;

     case 8:
       decode_slot0_protocol(adrs_p);
       break;

     case 0xa:
       decode_slot0_response(adrs_p);
       break;

     case 0xe:
       decode_slot0_dataLo(adrs_p);
       break;

     case 0x20:
       decode_slot0_sernoHi(adrs_p);
       break;

     case 0x22:
       decode_slot0_suffixLo(adrs_p);
       break;

     case 0x24:
       decode_slot0_sernoHi(adrs_p);
       break;

     case 0x26:
       decode_slot0_sernoLo(adrs_p);
       break;

     case 0x28:
       decode_slot0_modId(adrs_p);
       break;

     case 0x2a:
       decode_slot0_intStatus(adrs_p);
       break;

     case 0x2c:
       decode_slot0_intCtrl(adrs_p);
       break;

     case 0x2e:
       decode_slot0_trigIntSrc(adrs_p);
       break;

     case 0x38:
       decode_slot0_statusId(adrs_p);
       break;

     case 0x3c:
       decode_slot0_rdSignal(adrs_p);
       break;

     case 0x3e:
       decode_slot0_version(adrs_p);
       break;

    default: 
       printf("(0x%8.8x): is a Reserved register\n",(unsigned int)adrs_p);
       break;
  }
  return(OK);
}


long myResman(void)
{
   long      status=OK;
   char     *adrs;
   int       delay;
   int       current;          
   int       mode = VX_READ;  
   UINT16    slot_a[NVXIADDR];
   UINT16    nr_cards=0;
   UINT16    slot0_la=0;
   UINT16    model;
   UINT16    id,type,csr,offset,attribute;
   UINT16    sernoHi,sernoLo,ver;
   UINT16   *device_aps[NVXIADDR];  
   UINT16    brd,slot,la;
   UINT16    sc_la = 256;
   static UINT16 const  enb=1;
   static UINT16 const  dis=0;
  


   delay = sysClkRateGet() * 6;
   current = tickGet();
   if ( current<delay ) {
     printf("VXI Resman: waiting for selftest to complete...");
     taskDelay(delay-current);
     printf("\n");     
   }

   vxiinit();
   status = InitVXIlibrary();
   if ( status<0 ) return(status);


   /* Get local VME Address for base address
    * of LA device configuration registers 
    */
   if ( !getSlot0BaseAdrs() ) return(ERROR);
   
   /* Get the model number of the slot-0 controller */  
   slot0_la = GetMyLA();
   adrs   = localAdrs_p + 2;
   status = vxMemProbe(adrs,mode,sizeof(model),(char *)&model);
   if (status==OK) 
     printf("Slot-0 Model:  0x%4.4x  la = 0x%2.2x\n",model,slot0_la);
   else
     return(errnoGet());

   /* 
    * Loop through slot0-controller A16 memory and 
    * find SC devices and DC devices
    */
   nr_cards = 0;
   for (la=0; la<0x100; la++) { 
     adrs = localAdrs_p + (0x40 * la);

     for ( slot=0; (slot<13); slot++ ) {
       brd = 1<<slot;
       status = SetMODID( enb,brd );   /* Set MODID signal for board */
       if ( status<OK ) {
         printf("An error occurred in SetMODID enable for brd=%d\n",brd);
         continue;
       }

       /* 
	* Determine if there is a module at this address
	* by reading the status register from the configuration
	* registers in this device block, which is 64 bytes
	* in length.
	*/
       status = vxMemProbe(adrs+4,mode,sizeof(csr),(char *)&csr);
       if ( status==OK ) {
         /* 
	  * Yes! Now need to determine if the module is 
	  * statically configurable (SC) or dynamically
	  * configurable (DC)? 
	  * */
         status = vxMemProbe(adrs,mode,sizeof(id),(char *)&id);  
         if (status==OK) {
           /* 
	    * Since we can access the ID register it looks 
	    * like we have a DC module?
            */
           status = vxMemProbe(adrs+2,mode,sizeof(type),  (char *)&type);
           status = vxMemProbe(adrs+4,mode,sizeof(csr),   (char *)&csr);
           status = vxMemProbe(adrs+6,mode,sizeof(offset),(char *)&offset);
           status = vxMemProbe(adrs+8,mode,sizeof(attribute),(char *)&attribute);
           status = vxMemProbe(adrs+0xa,mode,sizeof(sernoHi),(char *)&sernoHi);
           status = vxMemProbe(adrs+0xc,mode,sizeof(sernoLo),(char *)&sernoLo);
           status = vxMemProbe(adrs+0xe,mode,sizeof(ver),(char *)&ver);

           /* Print out a short report for this module */
           printf("DC Module found in ");
           printf("slot=%d\tla=0x%4.4x\tadrs=0x%8.8x",slot,la,(UINT32)adrs);
           printf("\tid=0x%4.4x\ttype=0x%4.4x\tcsr=0x%4.4x",id,type,csr);
           printf("\toffs=0x%4.4x\tattr=0x%4.4x\n",offset,attribute);
           printf("\tsernoHi=0x%4.4x\tsernoLo=0x%4.4x\tver=%hd\n",sernoHi,sernoLo,ver);
           slot_a[nr_cards]       = la;
           device_aps[nr_cards++] = (UINT16 *)adrs;
	 }
         else {
	   /* 
	    * No access to the ID register indicates
	    * that this is a SC module.
	    */
           printf("SC Module found in ");
           printf("\tslot=%d\tla=0x%4.4x\tadrs=0x%8.8x status=0x%4.4x",
                   slot,sc_la,(UINT32)adrs,csr);
           slot_a[nr_cards]       = sc_la++;
           device_aps[nr_cards++] = (UINT16 *)adrs;
	 }
       }
       status = SetMODID( dis,brd ); /* Clear MODID signal for board */
       if ( status<OK ) 
         printf("An error occurred in SetMODID disable for brd=%d\n",brd);
       if (la==slot0_la) break;

     }/* End of slot FOR loop */
  }/* End of la FOR loop */

   /* List all cards found */
   printf("Number of cards found:  %d\n",nr_cards);
   return(OK);
}


int mytest( UINT16 clk_slot )
{
   int       status;
   UINT16    levels = 1<<(MY_INT_LEVEL-1);
   UINT16    slot = 2;  
   
   if ( clk_slot ) slot = clk_slot;
   status = initClk(slot);
   if (status!=OK) return(status);
  

   status = rebootHookAdd(myShutdown);
   if ( status!=OK ) 
     printf("rebootHookAdd failed\n");
   else {
     status = SetVXIintHandler(levels,(NIVXI_HVXIINT *)myIsr);
     if (status<0) 
       printf("SetVXIintHandler failed - level=%d\n",MY_INT_LEVEL);
     else {
       /*       mycrate();  */   /* get logical addresses     */
       clkInitFields(0xc8);      /* cold init of clock module */
       rfpInitFields(0xca);
       rf_modIntEnb();
     } 
   } 
   return( status );
}

int rf_intEnb( void )
{
   int     status;
   UINT16  levels     = 1<< (MY_INT_LEVEL-1);
   UINT16  sroute     = 0;
   INT16   controller = -1;


   status = EnableVXIint( controller,levels);
   if ( status!=OK ) 
     printf("Failed to enable RF interrupt level %d (0x%2.2x)\n",
            MY_INT_LEVEL,levels);
   else
     RouteVXIint( controller,sroute );
   return(status);
}

int rf_clk( UINT16 la )
{
  int               status=OK,i;
  int               j=0x20;
  int               len  = sizeof(short);
  int               mode = VX_READ;
  int               num_regs=9;
  char             *base_p;
  char             *adrs_p;
  UINT16            data;
  static const char *reg_ac[]={"Trigger Control",
                               "Harmonic Number Readback",
                               "Delay Control",
                               "Sync/Calibrate Commond Register",
                               "39.3MHz PLL Constant #1",
                               "Sync Width/39.3 MHz PLL Const #2",
                               "471.1 MHz PLL COnstant",
                               "Calibration PLL Constant #1",
                               "Calibration PLL Constant #2"};
  status = rd_reg( la );
  if ( status!=OK ) return(status);

  if (!localAdrs_p) getSlot0BaseAdrs();
  base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));

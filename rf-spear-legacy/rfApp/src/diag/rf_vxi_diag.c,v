void mycrate(void)
{
  int          status=OK;
  UINT16       field=0;
  INT16        la=0; 
  INT16        manuf     = -1;
  INT16        model     = -1;
  INT16        devclass  = -1;
  INT16        slot      = -1;
  INT16        mainframe = -1;
  INT16        cmdla     = -1;
  char         name_a[14];


  num_modules = 0;
  memset(name_a,'\0',sizeof(name_a));
  memset(vxi_a,0,sizeof(vxi_a));
  for (slot=1; slot<13; slot++) {
     status = FindDevLA(name_a,
                        manuf,
                        model,
                        devclass,
                        slot,
                        mainframe,
                        cmdla,
                        &la);
     if (status==OK) {
       vxi_a[num_modules] = la;
       status = GetDevInfo(la,field,&devInfo_as[num_modules]);
       if ( status<OK ) {
         if (status==-1)
           printf("FindDevLA falied - Device not found for LA=0x%2.2x\n",la);
         else if (status==-2) 
           printf("FindDevLA failed - Invalid field (%d) specified for LA=0x%2.2x\n",
                  field,la);
         else
           printf("FindDevLA failed - Unknown error for LA=0x%2.2x status=%d\n",
                  la,status);
       }
       else 
         num_modules++;
     }
     else 
       printf("Device not found in slot %d\n",slot);
   }/* End of FOR loop */

   return;
}

void myIsr( INT16  controller,
                   UINT16 level,
                   UINT32 statusId )
{
   UINT16                   la=statusId & 0xff;
   static char              lock = FALSE;
   volatile VXICSR          *csr_ps;
   UINT16                   sftIntMask=0x0020;

   if (!sysBusTas(&lock)) {
      logMsg("ISR Interrupted w/  statusId=0x%4.4x level=0x%4.4x\n",
              (int)statusId,(int)level,0,0,0,0);
      return;
   }

   logMsg("I'm in the myIsr w/statusId=0x%4.4x level=0x%4.4x\n",
           (int)statusId,(int)level,0,0,0,0);
   
   return;

   /* Get logical address */
   if (!localAdrs_p) getSlot0BaseAdrs(); 
   csr_ps = (VXICSR *)localAdrs_p + (la<<VXIDEVBITS);
   taskDelay(2*sysClkRateGet());

   /*
    * Determine what caused the interrupt.
    * Do we have a software interrupt? 
    */
   if (csr_ps->dir.r.status & sftIntMask)
     csr_ps->dir.w.control &= ~sftIntMask;   /*reset sft interrupt */  
   lock = FALSE;
   return;

}

int rfpInitFields( UINT16 la )
{
    int                    status = OK;
    char                  *base_p;
    char                  *adrs_p;
    char                  *ext_p;
    p2Rf_int_ctrl_tu       ictrl_u;
    p2Rf_ctrl_tu           ctrl_u;
    UINT16                 idata;
    UINT16                 odata;
    int                    len=sizeof(short);
    UINT16                 buf[256];
    FILE                  *fp;
    char                  *file_c;
    char                  *id_c;
    register UINT16       *dsp_p;
    register UINT16       *buf_p=buf;
    register int           i;



    if (!localAdrs_p) getSlot0BaseAdrs();

    /* Base address of module A16 space */ 
    base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));
  
    /* Reset module */
    adrs_p = base_p + 0x4;
    /* Clear the RF module control register */
    odata = 0;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&odata );

    /* Read the rf status register */
    status = vxMemProbe(adrs_p,VX_READ,len,(char *)&idata ); 

    /* Set the rf control register */
    ctrl_u._i = idata & 0xfffc;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)ctrl_u._a ); 
    ctrl_u._s.sft_reset;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)ctrl_u._a ); 
    ctrl_u._i = 0;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)ctrl_u._a ); 
    ctrl_u._i = idata;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)ctrl_u._a ); 
    taskDelay(1* sysClkRateGet());

     
   /* 
    * Set interrupt control register
    * Enable all interrupts (imsk=0) and set the
    * interrupt level to 5
    */
    ictrl_u._i = 0;
    ictrl_u._s.irq  = MY_INT_LEVEL;
    ictrl_u._s.imsk = 0xc5;        /* 197 decimal */
    ictrl_u._i      = ~ictrl_u._i;
    adrs_p = base_p + 0x1c;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)ictrl_u._a );
    if ( status!=OK )
      printf("Failed to set RFP module interrupt control register\n");
    
    /* 
     * Set RF module control register 
     * clear serial link error and rf fault.
     */
    odata  = 0x30; /* reset serial link error and rf fault latch */
    adrs_p = base_p + 0x20;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&odata );
 
    /* Now set module in to LOAD state */
    odata   = 0x40;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&odata ); 
    status = vxMemProbe(adrs_p,VX_READ, len,(char *)&idata ); 
    /* Reset DSP */
    odata  &= ~0xfffb;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&odata );

    /* Load DSP (A24 space)*/
    status = sysBusToLocalAdrs (VME_AM_STD_SUP_DATA,
                                base_p+0x6,
                               (char **)&ext_p);
    file_c = "/dsp/rippleRfp";
    status = DWN_LdDspExe(file_c,(UINT32)ext_p,FALSE,TRUE);
    if ( status!=OK ) 
      printf("Failed to load RFP module DSP\n");

    /* Initialize octal dac's */
    for ( i=0x8000; i<=0x806e; i++ ) {
       ;
    }

    /* Load the DAC I table */
    file_c = "/tbl/NOISE_I_BL_SMALL";
    id_c  = "RFP DAC I RAM";
    i = 0x808a;
    dsp_p = (unsigned short *)&ext_p[i];
    fp = fopen(file_c,"rb");
    if ( !fp ) 
      printf("Unable to open DAC I file %s\n",file_c);
    else {
      status = fread( buf,strlen(id_c),1,fp );
      if ( status==0 )
        printf("RFP DAC I table %s is empty\n",file_c);
      else if (status>1)
        printf("RFP DAC I table %s ID is too long\n",file_c); 
      else if ( strncmp((char *)buf,id_c,strlen(id_c))!=0 ) 
        printf("RFP DAC I table %s has unexpected ID\n",file_c);
      else {
        i = 0x8000/256;
	while (i--) {
          status = fread( buf,sizeof(short),256,fp );
          if ( status!= 256 ) {
            printf("RFP DAC I table %s is of improper length\n",file_c);
            break;
          }
          while (buf_p < &buf[256]) {
             *dsp_p =*buf_p++; 
          }
	}
      }
      fclose(fp); 
      fp = NULL;
    }

    /* Load the DAC Q table */
    file_c = "/tbl/NOISE_Q_BL_SMALL";
    id_c   = "RFP DAC Q RAM";
    i = 0x080c;
    dsp_p  = (unsigned short *) &ext_p[i]; 
    if ( !fp ) 
      printf("Unable to open DAC Q file %s\n",file_c);
    else {
      status = fread(buf,strlen(id_c),1,fp );
      if ( status==0 )
        printf("RFP DAC Q table %s has is empty\n",file_c);
      else if (status>1)
        printf("RFP DAC Q table %s ID is too long\n",file_c); 
      else if (strncmp((char *)buf,id_c,strlen(id_c))!=0)
        printf("RFP DAC Q table %s has unexpected ID\n",file_c);
      else {
        i = 0x8000/256;
	while (i--) {
          status = fread( buf,sizeof(short),256,fp );
          if ( status!= 256 ) {
            printf("RFP DAC I table %s is of improper length\n",file_c);
            break;
          }
          while (buf_p < &buf[256]) {
             *dsp_p =*buf_p++; 
          }
	}
      }
      fclose(fp);
      fp = NULL;
    }

    adrs_p = base_p + 0x20;
    odata   = 0xf8c4;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&odata); 

    /* Read the status register */
    adrs_p = base_p + 0x04;
    status = vxMemProbe(adrs_p,VX_READ,len,(char *)&ctrl_u._i);
    if ( status==OK ) {
      /* Set the control register */
      ctrl_u._s.sft_reset = 1;
      ctrl_u._s.sysfail_inhibit = 1; 
      ctrl_u._s.ext_mem = 1;  
      status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&ctrl_u._i);
      if ( status!=OK )
        printf("Failed RFP module Cold Init, due to control register WT error\n");
    }
    else {
      printf("Failed RFP module Cold Init, due to status register RD error\n");
    }
    return(status);
}

int clkInitFields( UINT16 la )
{
  int                    status = OK;
  char                  *base_p;
  char                  *adrs_p;
  p2Rf_int_ctrl_tu       ictrl_u;
  p2Rf_ctrl_tu           ctrl_u;
  int                    len = sizeof(short);
  UINT16                 harmNo;
  UINT16                 data;
  UINT16                 ver;
  float                  x;



   if ( !localAdrs_p ) getSlot0BaseAdrs();

  /* Base address of module A16 space */ 
  base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));
  
  /* 
   * Set interrupt control register
   * Enable all interrupts (imsk=0) and set the
   * interrupt level to 5
   */ 
  adrs_p = base_p + 0x1c;
  ictrl_u._s.irq = MY_INT_LEVEL;
  status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)ictrl_u._a );
  if ( status!=OK ) {
    printf("Failed to set CLK module interrupt control register\n");
    return(status);
  }
  
  /* Set trigger control register */
  adrs_p = base_p + 0x20;
  data   = 0;
  status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
  if ( status!=OK ) {
    printf("Failed to set CLK module trigger control register\n");
    return(status);
  }

  /* Read harmonic number readback register */
  adrs_p = base_p + 0x22;
  status = vxMemProbe(adrs_p,VX_READ,len,(char *)&harmNo );
  if ( status!=OK ) {
    printf("Failed to read CLK module Harmonic number RBK register\n");
    return(status);
  }

  /* Read harmonic number readback register */
  adrs_p = base_p + 0xe;
  status = vxMemProbe(adrs_p,VX_READ,len,(char *)&ver );
  ver &= 0xf;
  if (ver==1)
     x = 2.0 * (0x10000 - harmNo); 
  else
     x = 2.0 * (0x10000 - harmNo + 1);

  if (harmNo != 3492.0 )
     printf("Unexpected CLK (V%d) module harmonic number readback of %f (%hd)\n",
            ver,x,harmNo);


  /* Set delay control register */
  adrs_p = base_p + 0x24;
  data   = 0xc80;
  status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
  if ( status!=OK ) {
    printf("Failed to set CLK module delay control register\n");
    return(status);
  }


  /* Set phase-locked loop constang register */
  if (ver==1) {
    adrs_p = base_p + 0x28;
    data   = CLK_39CONST;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
    if ( status!=OK ) 
       printf("Failed to set CLK module 39.3 Mhz Phase-Locked Loop register\n");

    adrs_p = base_p + 0x2c;
    data   = CLK_471NORM;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
    if ( status!=OK ) 
       printf("Failed to set CLK module 471.1 Mhz Phase-Locked Loop register\n");

    adrs_p = base_p + 0x26;
    data   = 0;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
    if ( status!=OK )
       printf("Failed to set CLK module synch/calibrate register\n");
  }
  else {
  /* 
   * Set the re-synchronize command register. Writing anything to 
   * this register causes all clocks to be re-synchronized
   * to the external trigger.
   */
    adrs_p = base_p + 0x26;
    data   = 0;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
    if ( status!=OK ) 
      printf("Failed to set CLK codule re-synchronized command register\n");

    data |= 0x10;
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
     if ( status!=OK ) 
      printf("Failed to set CLK codule re-synchronized command register (2)\n");
    taskDelay( sysClkRateGet()/10);

    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&data );
    if ( status!=OK ) 
      printf("Failed to set CLK codule re-synchronized command register (3)\n");
    taskDelay( sysClkRateGet()/10);
  }

  /* Read the status register */
  adrs_p = base_p + 0x04;
  status = vxMemProbe(adrs_p,VX_READ,len,(char *)&ctrl_u._i);
  if ( status==OK ) {
    /* Set the control register */
    ctrl_u._s.sft_reset = 1;
    ctrl_u._s.sysfail_inhibit = 1; 
    status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)&ctrl_u._i);
    if ( status!=OK )
      printf("Failed CLK module Cold Init, due to control register WT error\n");
  }
  else 
    printf("Failed CLK module Cold Init, due to status register RD error\n");
  return(status);
}


static int myShutdown( void )
{ 
  rf_modIntDis();  /* Clear Rf module interrupts from the bus */
  return(OK);
}



int rf_status( UINT16 la )
{
  int               status;
  int               len  = sizeof(short);
  int               mode = VX_READ;
  char             *base_p;
  char             *adrs_p;
  p2Rf_status_tu    data_u;


  if (!localAdrs_p) getSlot0BaseAdrs();

  base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));
  adrs_p = base_p + 0x4;
  status = vxMemProbe(adrs_p,mode,len,(char *)data_u._a);
  if (status==OK) {
    printf("Status Register (0x%8.8x):  0x%4.4x\n",
           (UINT32)adrs_p,data_u._i);
    printf("\tSoftware Reset: %s\n",
           data_u._s.sft_reset ? "RESET MODULE" : "OFF");
    printf("\tSYSFAIL Inhibit: %s\n",
           data_u._s.sysfail_inhibit ? "INHIBIT" : "OFF");
    printf("\tSelftest: %s\n",
           data_u._s.passed ? "PASSED" : "FAILED");
    printf("\tReady: %s\n",
           data_u._s.rdy ? "On" : "Off");
    printf("\tSoftware Interrupt: %s\n",
           data_u._s.sft_int ? "Interrupt" : "Off");
    printf("\tMODID Line: %s\n",
           data_u._s.modid ? "On" : "Off");
  }
  return(status);
}

int rf_ctrl( UINT16 la,UINT16 type, UINT16 data )
{
   int           status;
   int           len  = sizeof(short);
   char         *base_p;
   char         *adrs_p;
   p2Rf_ctrl_tu  data_u;


   if (!localAdrs_p) getSlot0BaseAdrs();

   base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));
   adrs_p = base_p + 0x4;
   status = vxMemProbe(adrs_p,VX_READ,len,(char *)data_u._a);
   if (status==OK ) {
     if (type==0) 
       data_u._i &= ~data;    /* clear bits */
     else  
       data_u._i |= data;     /* set bits   */
     status = vxMemProbe(adrs_p,VX_WRITE,len,(char *)data_u._a);
     if ( status!=OK ) {
       printf("Failed to set CTRL register for la=0x%2.2x\n",la);
       status = errnoGet();
     }
   }
   else {
     printf("Failed to read CTRL register for la=0x%2.2x\n",la);
     status = errnoGet();
   }
   return(status);
}


int rf_intStatus( UINT16 la )
{
  int                status;
  int                len  = sizeof(short);
  int                mode = VX_READ;
  char              *adrs_p;
  char              *base_p;
  p2Rf_int_status_tu data_u;
  p2Rf_int_mask_tu   imsk_u;
  UINT16             model;

  if (!localAdrs_p) getSlot0BaseAdrs();

  base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));
  adrs_p  = base_p + 0x1a;
  status = vxMemProbe(adrs_p,mode,len,(char *)data_u._a);
  if ( status!=OK ) {
    printf("Failed to read LA=0x%4.4x Interrupt Status Register\n",la);
    return(ERROR);
  }
  status = vxMemProbe(base_p+0x2,mode,len,(char *)&model);
  if (status!=OK) {
     printf("Failed to read LA=0x%4.4x Device Type Register\n",la);
     return(ERROR);
  }
  model &= 0xfff;
  printf("LA=0x%4.4x   Model=0x%3.3x\n",la,model);
  printf("Interrupt Status Register (0x%8.8x):  0x%4.4x\n",
         (UINT32)adrs_p,data_u._i );
  if (model==0x106) {
    printf("\tLogical Address:  0x%2.2x\n",data_u._s.la );
    printf("\tIMSK: 0x%2.2x\n",data_u._s.imsk); 
    imsk_u._i = data_u._s.imsk;
    if ( model==0x106) {
      printf("\t\tFiducial counter error: %s\n",
           imsk_u.clk_s.fl ? "COUNT ERROR" : "OK");

      printf("\t\tFiducial loss of signal: %s\n",
           imsk_u.clk_s.fl ? "LOSS OF SIGNAL" : "OK");

      printf("\t\t39MHz PLL unlocked: %s\n",
           imsk_u.clk_s.p1u ? "UNLOCKED" : "OK");

      printf("\t\t471MHz PLL unlocked: %s\n",
           imsk_u.clk_s.p2u ? "UNLOCKED" : "OK");

      printf("\t\tInvalid Address: %s\n",
           imsk_u.clk_s.ia ? "DISABLE" : "ENABLED");

      printf("\t\tSoftware Interrupt: %s\n",
           imsk_u.clk_s.si ? "DISABLE" : "ENABLED");
    }
    else if ( model == 0x103 ) {
      printf("\t\tNo 479MHz RF reference detected: %s\n",
           imsk_u.rfp_s.no_476MHz ? "no RF" : "RF On");

      printf("\t\tInvalid state machine: %s\n",
           imsk_u.rfp_s.inv_st_op ? "ERROR" : "OK");

      printf("\t\tInvalid operation: %s\n",
           imsk_u.rfp_s.inv_op ? "ERROR" : "OK");

      printf("\t\tADC Overflow: %s\n",
           imsk_u.rfp_s.adc_overflow ? "OVERFLOW" : "OK");

      printf("\t\t80,40,10MHz or ripple clk not present: %s\n",
           imsk_u.rfp_s.no_ripple_clk ? "Missing" : "OK");

      printf("\t\tRipple loop serial link error: %s\n",
           imsk_u.rfp_s.ripple_loop_err ? "Error" : "OK");

      printf("\t\tMessage from DSP: %s\n",
           imsk_u.rfp_s.dsp_msg_rdy ? "Ready" : "Idle");
    }
  }
  return(status);
}


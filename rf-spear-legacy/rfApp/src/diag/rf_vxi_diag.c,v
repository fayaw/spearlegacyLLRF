int rd_wd_test(UINT32 adrs,UINT16 num,int loop,int all)
{
  int            status=OK;
  int            i,j,nloop;
  int            mode=VX_READ;
  int            width=sizeof(unsigned short);
  unsigned short rval,val;
  unsigned short chan=0;
  unsigned short first_chan=0;
  unsigned short expected_chan=0;
  unsigned short mask = 0xfff;
  volatile char *base_p=(char *)adrs;

  nloop = loop;
  if (nloop<=0) nloop=1;
  for (j=0; j<nloop; j++) {
    for (i=0; (i<num) && (status==OK); i++) {
      status = vxMemProbe((char *)base_p,mode,width,(char *)&rval);
      if (status!=OK)
        printf("Failed to read address %p\n",base_p);
      else {
        if ( i==0 ) first_chan=chan;
        chan = rval >> 12;
        val  = rval & mask;
        if ( i==0 ){
          first_chan=chan; 
          expected_chan=first_chan;
          if (!all)  printf("\nFirst Read: Chan=%d\n",chan);
	}
        else 
          expected_chan++;      
        
        if ( all )
          printf("%p (%d): Data=0x%4.4x Raw=0x%4.4x Chan: rd=%d expected=%d\n",
                  base_p,i,val,rval,chan,expected_chan);
        else if ( chan!=first_chan+i )          
           printf("%p (%d):Data=0x%4.4x Raw=0x%4.4x Chan: rd=%d expected=%d\n",
                  base_p,i,val,rval,chan,expected_chan);
      }
    }/* End of i FOR loop */
    if (nloop>1) printf("Loop Test #%d\n",j); 
  } /* End of j FOR loop */
  return(status);
}

int rd_addr(UINT32 adrs,UINT16 num,int width)
{
  int            status=OK;
  int            i;
  int            mode=VX_READ;
  unsigned char  bval;
  unsigned short sval;
  unsigned long  lval;
  volatile char *base_p=(char *)adrs;


  for (i=0; (i<num) && (status==OK); i++,base_p+=width) {
    switch( width ) {
       case 1:
         status = vxMemProbe((char *)base_p,mode,width,(char *)&bval);
         if (status==OK) printf("%p: 0x%2.2x\n",base_p,bval);
         break;

       case 2:
         status = vxMemProbe((char *)base_p,mode,width,(char *)&sval);
         if (status==OK) printf("%p: 0x%4.4x\n",base_p,sval);
         break;
         break;

       case 4:        
         status = vxMemProbe((char *)base_p,mode,width,(char *)&lval);
         if (status==OK) printf("%p: 0x%8.8lx\n",base_p,lval);
         break;
 
       default:
         printf("Invalid width (1,2,4)\n");
         status=ERROR;
         break;
    }
  }
  return(status);
}

int wt_wd_test( UINT32 adrs, UINT16 num,UINT16 type,UINT8 nloop, UINT16 imask )
{
#define BASIC_PATTERNS  0
#define BIT_WALK_ONES   1
#define BIT_WALK_ZEROS  2
#define BIT_WALK_LOOP   3
#define NUM_PATTERNS    6
  int          status=OK;
  int          i;
  UINT8        ntrys;
  UINT16       mask=0xfff0;
  UINT16       pattern_a[NUM_PATTERNS]={0xa5a5,
                                        0x5a5a,
                                        0xffff,
                                        0xabcd,
                                        0x0f0f0,
                                        0x1234 };
  if (mask) mask=imask;
  switch( type ) {
     case BASIC_PATTERNS: 
       for (i=0; (i<NUM_PATTERNS) && (status==OK); i++) {
	 printf("\nTesting Pattern 0x%4.4hx\n",pattern_a[i]);
         status = wt_wd_addr(adrs,num,pattern_a[i],mask);
       }
       break;

     case BIT_WALK_ONES:
       ntrys = max(nloop,1); 
       for (i=0; (i<ntrys) && (status==OK); i++) {
         printf("\nTesting Walking Zeros - #%d\n",i+1);
         status = walk_ones(adrs,num);
       }
       break;

    case BIT_WALK_ZEROS:
       ntrys = max(nloop,1); 
       for (i=0; (i<ntrys) && (status==OK); i++) {
         printf("\nTesting Walking Zeros - #%d\n",i+1);
         status = walk_zeros(adrs,num);
       }
       break;

    case BIT_WALK_LOOP:
      ntrys = max(nloop,1); 
      for (i=0; (i<ntrys) &&(status==OK); i++) {
         printf("\nTesting Walking Zeros - #%d\n",i+1);
         status = walk_ones(adrs,num);
         if (status==OK) {
            printf("\nTesting Walking Zeros - #%d\n",i+1);
           status = walk_zeros(adrs,num);
	 }
       }
       break;

    default:
       printf("Unknown test type\n");
       break;
  }
  return(status);
}

int walk_ones( UINT32 adrs, int num  )
{
  int      status=OK;
  int      i,j,range,offset;
  UINT16   bmask=1;
  UINT16   mask=0xfff0;
  
  range=max(1,num);
  for (j=0,offset=0; (j<range) && (status==OK); j++,offset+=2) {
    for (i=0,bmask=1; (i<16) && (status==OK); i++,bmask<<=1) {
      status= wt_wd_addr(adrs+offset,1,bmask,mask);
    }
  }
  return(status);
}


int walk_zeros( UINT32 adrs, int num )
{
  int      status=OK;
  int      i,j,range,offset;
  UINT16   bmask=1,val=0;
  UINT16   mask=0xfff0;
  
  range=max(1,num);
  for (j=0,offset=0; (j<range) && (status==OK); j++,offset+=2) {
    for (i=0,bmask=1; (i<16) && (status==OK); i++,bmask<<=1) {
       val=~bmask;
       status= wt_wd_addr(adrs+offset,1,val,mask);
    }
  }
  return(status);
}


int wt_wd_addr( UINT32 adrs, UINT16 num, UINT16 data, UINT16 mask )
{
  int             status=OK;
  int             i,j=0;
  UINT16          rval,mval;
  int             width=sizeof(rval);
  static char    *state_c[2]={"SUCCESS","FAILURE"};
  volatile char  *base_p = (volatile char *)adrs;

  for ( i=0; (i<num) && (status==OK); i++,base_p+=width ) {
      EIEIO_SYNC;
      status = vxMemProbe((char *)base_p,VX_WRITE,width,(char *)&data);
      EIEIO_SYNC;
      if (status==OK) {
         status = vxMemProbe((char *)base_p,VX_READ,width,(char *)&rval);
         mval = rval & mask;
         if (mval != (data & mask)) j=1;
         printf("%p (%d):  wt=0x%hx  rd=0x%hx (raw=0x%hx) - %s\n",
                 base_p,i,data,mval,rval,state_c[j] ); 

      }
  }
  return(status);
}


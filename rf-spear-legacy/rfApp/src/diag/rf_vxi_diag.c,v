/* This function can only be prior to resman being run */
int rd_module_a16( UINT16 slot )
{
   int  status;
   int  i;
   UINT16 data;
   UINT16 bcnt=sizeof(data);
   UINT16 mask = 1;
   UINT16 enb=1;
   UINT16 dis=0;
   UINT16 mode=1;   
   UINT16 adrs = 0xffc0;
   static const  char *reg_ac[]={ "Manuf ID",
                                  "Status",
                                  "Offset",
                                  "Attributes",
                                  "Serial Number Hi",
                                  "Serial Number Lo",
                                  "Version Number"}; 
   mask <<= slot;
   status = SetMODID(enb,mask);
   if ( status!=OK ) 
     printf("Failed to set MODID on slot %hd\n",slot);
   else {
      printf("\nReading A16 registers for module in slot %hd\n",slot);
      for (i=0; (i<7) && (status==OK); i++, adrs+=2) {
        
        status = VXIin( mode,adrs,bcnt,(void *)&data );
        if ( status==OK )
           printf("0x%4.4x (%d): %s Register 0x%4.4hx\n",adrs,i,reg_ac[i],data);
        else
           printf("%s Register read failed - status=%d\n",reg_ac[i],status);
      } /* End of FOR loop */
      status = SetMODID(dis,mask);
      if (status!=OK )
        printf("Failed to clear MODID on slot %hd\n",slot);
   }
   return(status);
}

int rd_reg( UINT16 la )
{
  int               status=OK,i,j,k;
  int               len  = sizeof(short);
  int               mode = VX_READ;
  int               num_regs_a[2]={7,10};
  int               offset_a[2]  ={0,0x1a};
  char             *base_p;
  char             *adrs_p;
  UINT16            data;
  static const char *reg_ac[]={ "Manuf ID",
                                "Device Type",
                                "Offset",
                                "Attributes",
                                "Serial Number Hi ",
                                "Serial Number Lo ",
                                "Version Number   ",
                                "Interrupt Status ",
                                "Interrupt Control",
                                "Subclass" }; 

  printf("\nReading registers for LA=%hd\n",la);
  if (!localAdrs_p) getSlot0BaseAdrs();
  base_p = (char *)(localAdrs_p + (la<<VXIDEVBITS));

  for (i=0,j=0,k; j<2 && (status==OK); j++) {
    for ( k=offset_a[j]; 
          (i<num_regs_a[j]) && (status==OK); 
          i++, k+=2) {
      adrs_p = base_p + k;
      status=vxMemProbe( adrs_p,mode,len,(char *)&data );
      if (status==OK) 
        printf("0x%8.8x: %s Register 0x%4.4x\n",(UINT32)adrs_p,reg_ac[i],data);
      else
        printf("%s Register read failed at 0x%8.8x\n",reg_ac[i],(UINT32)adrs_p);
    }/* End of FOR loop */
  } /* ENd of FOR loop */
  return(status);
}

int initClk( UINT16 slot )
{
   int    status,iss;
   UINT16 enb=1;
   UINT16 dis=0;
   UINT16 mask = 1<<slot;
   UINT32 la = 0xffc0;
   UINT16 version;
   UINT16 mode = 1;
   UINT16 data;


   vxiinit();
   status = SetMODID(enb,mask);
   if ( status!=OK )
     printf("Failed to set MODID line in slot=%hd\n",slot);
   else { 
      /* Read hw version */
      status = VXIin(mode,la+CLK_VERSION,sizeof(version),(void *)&version );
      if (status !=OK )
        printf("Failed to read CLK module version register (S=%hd)\n",slot);
      else {
        version &= 0xf;
        if (version==1) {
           data = 0x800;
           status = VXIout(mode,la+CLK_CLKCTRL,sizeof(data),data);
           if ( status==OK ) {
             data = CLK_39CONST;
             status = VXIout(mode,la+CLK_39MHZ_PLL,sizeof(data),data);
             if (status==OK) {
               data = CLK_471NORM;
               status = VXIout(mode,la+CLK_471MHZ_PLL,sizeof(data),data);
               if ( status!=OK )
                  printf("Failed to set CLK 471 PLL register\n");
	     }
             else
               printf("Failed to set CLK 39Mhz PLL register\n");
	   }
           else 
             printf("Failed to set CLK ctrl register\n");
	}
        else {
          data   = 0xc00;
          status = VXIout(mode,la+CLK_V2_DLYCTRL,sizeof(data),data);
          if (status!=OK)
             printf("Failed to set CLK (v2) ctrl register\n");
	} 
      }
        
      iss = SetMODID(dis,mask);
      if ( iss!=OK ) {
        printf("Failed to clear MODID line in slot=%hd\n",slot);
        if (status==OK) status=iss;
      }
      if (status==OK) printf("Successfully initialized CLK module\n");
   }
   return(status);   
}


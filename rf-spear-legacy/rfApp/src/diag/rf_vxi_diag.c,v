  datatype_tu     mask_u;

  data_u._l = outval;
  mask_u._l = mask;
  switch( width ) {
     case 1:    
         status = wt_byte_addr(adrs,num,data_u._a[0],mask_u._a[0] );
         break;

     case 2:
         status = wt_wd_addr(adrs,num,data_u._i[0],mask_u._i[0] );
         break;

     case 4:
         status = wt_wd_addr(adrs,num,data_u._l,mask_u._l );
         break;
  
     default:
         printf("Invalid width (1,2,4)\n");
         status=ERROR;
         break;

   }/* End of switch statement */
   return(status);
}

int myslot0(UINT16 offset)
{
   int    status=OK;           


   /* Get local VME Address for base address
    * of LA device configuration registers 
    */
   if ( !getSlot0BaseAdrs() ) return(ERROR);
   if ( !offset ) 
     status = rd_slot0_reg( (UINT32)localAdrs_p ); /* read all registers */
   else
     status = decode_slot0_reg( (UINT32)localAdrs_p,offset );
   return(status);
}
 
int rd_slot0( void )
{
    slot0_rd_regs_ts *reg_ps;
    unsigned short    data;

    if (!getSlot0BaseAdrs()) return(ERROR);

    
    reg_ps = (slot0_rd_regs_ts *)localAdrs_p;
    data = reg_ps->id;
    decode_slot0_id( &data );

    data = reg_ps->device_type;
    decode_slot0_dtype( &data );

    data = reg_ps->status;
    decode_slot0_status( &data );

    data = reg_ps->protocol;
    decode_slot0_protocol( &data );

    data = reg_ps->response;
    decode_slot0_response( &data );

    data = reg_ps->data_lo;
    decode_slot0_dataLo( &data );

    decode_slot0_suffix( reg_ps->suffix_hi,reg_ps->suffix_lo );
    decode_slot0_serno( reg_ps->serno_hi,reg_ps->serno_lo );

    data = reg_ps->modid;
    decode_slot0_modId( &data );

    data = reg_ps->int_status;
    decode_slot0_intStatus( &data );
    
    data = reg_ps->int_ctrl;
    decode_slot0_intCtrl( &data );

    data = reg_ps->trig_int_src;
    decode_slot0_trigIntSrc( &data );

    data = reg_ps->int_statusId;
    decode_slot0_statusId( &data );

    data = reg_ps->rd_signal;
    decode_slot0_rdSignal( &data );
   
    data = reg_ps->ver;
    decode_slot0_version( &data );
    return(OK);
}


static char * getSlot0BaseAdrs( void )
{
   int   adrsSpace=VME_AM_SUP_SHORT_IO;
   int   status=OK;


   if ( localAdrs_p==NULL ) {
     status  = sysBusToLocalAdrs(adrsSpace,busAdrs_p,&localAdrs_p);
     if ( status!=OK ) {
       localAdrs_p = NULL;
       printErrno(errnoGet());
     }
   }
   return(localAdrs_p);
}

static int rd_slot0_reg( UINT32 adrs )
{
   int           status = OK;
   char         *adrs_p;
   short         i,j;
   int           bcnt = sizeof(short);
   int           mode = VX_READ;
   volatile UINT16   data;


   /* Read slot-0 read registers */
   for (i=0;  (i<CPU_NUM_RD_REGS) && (status==OK); i++) {
     j = rd_offset_a[i];              /* register byte offset    */
     adrs_p = (char *)adrs + j;       /* A16 address of regsiter */
     status = vxMemProbe( adrs_p,
                          mode,
                          bcnt,
                          (char *)&data );  

     /* 
      * If read was successful display register data.
      * Otherwise, return and error code.
      */
     if ( status==OK )
       printf("%s (0x%8.8x): 0x%4.4x\n",
              rd_name_ap[i],
              (unsigned int)adrs_p,
              data );
   }
   return(status);
}   
 

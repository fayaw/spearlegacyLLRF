@/*
 *   ld1600 info file for 32K IROM layout - MAP2 (EXM=1, PRLOW=0)
 *
 *		      addr			memory
 *	X side:	0x0000 to 0xbfff		erom
 *		0xc000 to 0xffff		empty	(ram1-ram16)
 *
 *	Y side:	0x0000 to 0x3fff		ram	(ram1-ram16)
 *		0x4000 to 0x40ff		io
 *		0x4100 to 0x7fff		eramlo
 *		0x8000 to 0xffff		eramhi
 *
 *	The map above represents X & Y as two parallel address spaces which is
 *	precisely how the DSP16xx treats them.  However, the linker currently
 *	expects one linear address space.  For that reason, the memory map
 *	below defines X & Y as two contiguous address spaces: X from 0x0000 to
 *	0xffff, and Y from 0x10000 to 0x1ffff.  Don't be dismayed, the linker
 *	correctly relocates symbols in Y space within the range 0x0000 to
 *	0xffff.
 */

MEMORY
{
    /* X space */
	erom  (RX):	org = 0x0000	len = 0xc000

    /* Y space */
	ram  (RW):	org = 0x10000	len = 0x4000
	eram (RW):	org = 0x14000	len = 0xc000
}

SECTIONS
{
	.erom:	{ }	>erom

	.ram:	{ }	>ram
	.eram:	{ }	>eram
}

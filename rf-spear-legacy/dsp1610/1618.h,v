@#ifndef D1618_H
#define D1618_H
/*
 *	DSP1618 registers and conditions which were removed from the as1600
 *	grammar to make the assembler truly generic:
 */


	/* shortcut to defining the chip's peripherals */
	/* simply define or undef the identifier for the */
	/* particular unit to include or exclude it */

/* DSP1618 has the following peripherals ... */
#define		_HIF_
#define		_BIO_
#define		_SIO_
#define		_SIO2_
#define		_TIMER0_
#define		_BMU_


#define		ioc	reg42
#define		powerc 	reg56

/* DSP1618 registers for ECCP */
#define edr	reg57
#define	ear	reg62
#define	eir	reg47
#define	ebusy	uflag28

/* ECCP instructions (written to eir) */
#define UpdateMLSE	0
#define UpdateConv	1
#define TraceBack	2
#define ResetECCP	4
#define TestECCP	5

/* ECCP internal registers */
#define NS	0x000	/* start of next state memory */
#define PS	0x200	/* start of present state memory */
#define SYC	0x400	/* current symbol pointer */
#define	ECON	0x401	/* ECCP control register */
#define	TBLR	0x402	/* Traceback Length register */
#define	S5H5	0x403	/* Coded Symbol 5 (S5) or Channel Tap 5 (HI5,HQ5) */
#define	S4H4	0x404	/* Coded Symbol 4 (S4) or Channel Tap 4 (HI4,HQ4) */
#define	S3H3	0x405	/* Coded Symbol 3 (S3) or Channel Tap 3 (HI3,HQ3) */
#define	S2H2	0x406	/* Coded Symbol 2 (S2) or Channel Tap 2 (HI2,HQ2) */
#define	S1H1	0x407	/* Coded Symbol 1 (S1) or Channel Tap 1 (HI1,HQ1) */
#define	S0H0	0x408	/* Coded Symbol 0 (S0) or Channel Tap 0 (HI0,HQ0) */
#define	DSR	0x409	/* Decoded Symbol register */
#define ZIG10	0x40a	/* Received Symbol (ZI) or Generating Poly. (G1,G0) */
#define ZQG32	0x40b	/* Received Symbol (ZQ) or Generating Poly. (G3,G2) */
#define G54	0x40c	/* Generating Poly. (G5,G4) */
#define MIDX	0x40d	/* Minimum Cost State Index */
#define MACH	0x40e	/* Minimum Accumulated Cost (high 8 bits) */
#define MACL	0x40f	/* Minimum Accumulated Cost (low 16 bits) */
#define TBSR	0x410	/* Traceback Shift Register */

#define BM	0x700	/* Branch Metric (for testing only) */
#define BMCST	0x701	/* BMC State Count (for testing only) */
#define BMCTST	0x702	/* BMC Test Register (for testing only) */
#define TBD	0x703	/* Update Unit Traceback Data reg. (for testing only) */
#define ETR	0x704	/* ECCP Test register (for testing only) */

/* DSP1618 registers pertaining to the HIF */
#ifdef	_HIF_
	/* registers */
#define 	phifc	reg28
#define		pdx0	reg29
#endif /* _HIF_ */

/* pertaining to the BIO */
#ifdef	_BIO_
	/* registers */
#define		cbit	reg40
#define		sbit	reg41
	/* conditionals */
#define		allt	uflag18
#define		allf	uflag19
#define		somet	uflag20
#define		somef	uflag21
#endif

#ifdef _SIO_
	/* registers */
#define		sioc	reg24
#define		srta	reg25
#define		sdx	reg26
#define		tdms	reg27
#define		saddx	reg35
#endif

#ifdef _SIO2_
#define		sdx2	reg34
#define		sioc2	reg39
#define		saddx2	reg38
#define		tdms2	reg54
#define		srta2	reg55
#endif

#ifdef	_TIMER0_
#define		timerc	reg52
#define		timer0	reg53
#endif

#ifdef	_BMU_
	/* registers */
#define		ar0	reg58
#define		ar1	reg59
#define		ar2	reg60
#define		ar3	reg61
	/* conditionals */
#define		oddp	uflag22
#define		evenp	uflag23
#define		mns1	uflag24
#define		nmns1	uflag25

	.f4	/* this directive enables the generic f4 unit in */
		/* the as1600 parser */
	.bmu	/* this directive enables the BMU instructions in */
		/* the as1600 parser.  */
#endif

	.core1_1	/* 1618 uses the new core */

#ifdef SIZECHECK
        /* new size directives */
	.size	j	-16
	.size	k	-16
	.size	i	-16
	.size	p	-16
	.size	x	-16
	.size	y	-16
        .size   auc      9
        .size   c0      -8
        .size   c1      -8
        .size   c2      -8
        .size   cloop    7
        .size   a0	-16
        .size   a1	-16
	.size	sioc	10
	.size	sioc2	10
	.size	tdms	10
	.size	tdms2	10
	.size	timerc	 7
	.size	ioc	15
	.size	phifc	 7
#endif

#endif /* D1618_H */
@
